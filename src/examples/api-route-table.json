  "simulations": [
    {
      "id": "busy-afternoon",
      "title": "A busy afternoon",
      "description": "Forty app requests and thirty carrier events a second for half a minute. Watch each route's colour reach its own service, the old app's requests refused 404 at the gateway, and carrier events queue up.",
      "seed": 41,
      "durationMs": 40000,
      "traffic": [
        {
          "id": "app-traffic",
          "node": "app",
          "label": "App requests",
          "shape": {
            "kind": "constant",
            "ratePerSec": 40,
            "fromMs": 0,
            "durationMs": 30000
          }
        },
        {
          "id": "carrier-traffic",
          "node": "carriers",
          "label": "Carrier events",
          "shape": {
            "kind": "constant",
            "ratePerSec": 30,
            "fromMs": 0,
            "durationMs": 30000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 1000,
          "action": {
            "do": "note",
            "text": "Each route has its own colour and marker; the gateway's table sends it to its service.",
            "focus": ["gateway"]
          }
        },
        {
          "atMs": 8000,
          "action": {
            "do": "note",
            "text": "Requests from the old app match no rule: the gateway refuses them 404.",
            "focus": ["gateway"]
          }
        },
        {
          "atMs": 16000,
          "action": {
            "do": "note",
            "text": "Carrier events arrive at 30/s; their service takes 20/s, so its backlog grows.",
            "focus": ["events"]
          }
        }
      ],
      "expectations": [
        {
          "id": "refused",
          "label": "Old app requests are refused",
          "metric": {
            "node": "gateway",
            "field": "rejected"
          },
          "op": ">",
          "value": 0,
          "when": "end"
        },
        {
          "id": "backlog",
          "label": "Carrier events back up",
          "metric": {
            "node": "events",
            "field": "backlog"
          },
          "op": ">",
          "value": 100,
          "when": "eventually"
        }
      ]
    },
    {
      "id": "canary-down",
      "title": "The pricing canary goes down",
      "description": "Five seconds in, the pricing canary stops. The table keeps its 90/10 split, so about one quote in ten still goes to the canary and is lost there: the outage stays visible instead of quietly moving to Pricing.",
      "seed": 43,
      "durationMs": 25000,
      "traffic": [
        {
          "id": "app-traffic",
          "node": "app",
          "label": "App requests",
          "shape": {
            "kind": "constant",
            "ratePerSec": 40,
            "fromMs": 0,
            "durationMs": 20000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 5000,
          "action": {
            "do": "status",
            "node": "pricing-canary",
            "status": "down"
          }
        },
        {
          "atMs": 5000,
          "action": {
            "do": "note",
            "text": "The canary is down. Its 10% of quotes still go to it: weights don't move by themselves.",
            "focus": ["pricing-canary", "gateway"]
          }
        }
      ],
      "expectations": [
        {
          "id": "lost",
          "label": "Quotes sent to the down canary are lost",
          "metric": {
            "node": "pricing-canary",
            "field": "dropped"
          },
          "op": ">",
          "value": 0,
          "when": "end"
        },
        {
          "id": "no-404",
          "label": "Only the old app is refused",
          "metric": {
            "node": "gateway",
            "field": "rejected"
          },
          "op": "<=",
          "value": 45,
          "when": "end"
        }
      ]
    }
  ]
