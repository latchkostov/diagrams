  "title": "Parcel API behind a route table",
  "description": "Parcelpoint, an invented parcel platform, puts one Kong-style gateway in front of its services. The mobile app sends four kinds of request in fixed proportions and carriers post webhooks; the gateway's ordered route table sends each to its service, with a 10% pricing canary. Requests from an old app version match no rule and are refused 404. Carrier events arrive faster than their service can take them, so its backlog grows. Each route has its own colour and marker in Live.",
  "direction": "LR",
  "nodes": [
    {
      "id": "app",
      "stencil": "client.mobile",
      "label": "Parcelpoint app",
      "sublabel": "40 req/s · 4 routes",
      "props": {
        "ratePerSec": 40,
        "trafficMix": {
          "mode": "shares",
          "entries": [
            {
              "routeId": "track-parcel",
              "share": 0.55
            },
            {
              "routeId": "get-quote",
              "share": 0.25
            },
            {
              "routeId": "buy-label",
              "share": 0.15
            },
            {
              "routeId": "old-tracking",
              "share": 0.05
            }
          ]
        }
      },
      "x": 40,
      "y": 120
    },
    {
      "id": "carriers",
      "stencil": "generic.webhook",
      "label": "Carrier webhooks",
      "sublabel": "30 events/s",
      "props": {
        "trafficMix": {
          "mode": "rates",
          "entries": [
            {
              "routeId": "carrier-event",
              "ratePerSec": 30
            }
          ]
        }
      },
      "x": 40,
      "y": 420
    },
    {
      "id": "gateway",
      "stencil": "kong",
      "label": "API gateway",
      "sublabel": "Route table · 4 rules",
      "props": {
        "latencyMs": 20,
        "jitter": 0,
        "routeTable": {
          "rules": [
            {
              "id": "parcels",
              "label": "Tracking",
              "match": {
                "methods": ["GET"],
                "path": {
                  "kind": "template",
                  "value": "/v1/parcels/{id}"
                }
              },
              "targets": [
                {
                  "edgeId": "to-tracking",
                  "weight": 1
                }
              ]
            },
            {
              "id": "quotes",
              "label": "Pricing with canary",
              "match": {
                "methods": ["POST"],
                "path": {
                  "kind": "exact",
                  "value": "/v1/quotes"
                }
              },
              "targets": [
                {
                  "edgeId": "to-pricing",
                  "weight": 90
                },
                {
                  "edgeId": "to-pricing-canary",
                  "weight": 10
                }
              ]
            },
            {
              "id": "labels",
              "label": "Labels",
              "match": {
                "methods": ["POST"],
                "path": {
                  "kind": "exact",
                  "value": "/v1/labels"
                }
              },
              "targets": [
                {
                  "edgeId": "to-labels",
                  "weight": 1
                }
              ]
            },
            {
              "id": "hooks",
              "label": "Carrier hooks",
              "match": {
                "path": {
                  "kind": "prefix",
                  "value": "/hooks/"
                }
              },
              "targets": [
                {
                  "edgeId": "to-events",
                  "weight": 1
                }
              ]
            }
          ]
        }
      },
      "x": 380,
      "y": 270
    },
    {
      "id": "tracking",
      "stencil": "service.go",
      "label": "Tracking",
      "sublabel": "GET /v1/parcels/{id}",
