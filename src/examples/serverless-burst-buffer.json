  "simulations": [
    {
      "id": "burst",
      "title": "Twenty jobs at once",
      "description": "Direct calls exceed the reserved allocation. A bounded invoker pulls queued jobs at 2/s. This explicit pacing is not a model of SQS trigger retries; managed allocation is instant and cold starts are excluded.",
      "seed": 41,
      "scale": 1,
      "traffic": [
        {
          "id": "requests",
          "node": "requests",
          "messageType": "Job",
          "shape": {
            "kind": "burst",
            "count": 20,
            "atMs": 1000,
            "spreadMs": 200
          }
        }
      ],
      "timeline": [
        {
          "atMs": 2000,
          "action": {
            "do": "note",
            "text": "Reserved concurrency is simultaneous executions, not requests per second. Direct excess is rejected; SQS waits behind a bounded invoker, which protects the async allocation.",
            "focus": ["direct", "queue", "invoker"]
          }
        }
      ],
