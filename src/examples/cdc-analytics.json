      "y": 160,
      "group": "platform",
      "props": {
        "partitions": 12
      }
    },
    {
      "id": "customers-topic",
      "stencil": "kafka.topic",
      "label": "retail.dbo.customers",
      "sublabel": "CDC envelope · key: customer_id",
