      "y": 400,
      "group": "platform",
      "props": {
        "partitions": 6
      }
    },
    {
      "id": "processor",
      "stencil": "service.java",
      "label": "Retail projections",
      "sublabel": "Kafka Streams · group: retail-projector",
      "x": 1120,
      "y": 280,
      "group": "platform",
      "props": {
        "group": "retail-projector",
        "processingGuarantee": "exactly_once_v2"
      }
    },
    {
      "id": "search",
      "stencil": "elasticsearch",
      "label": "Retail search",
      "sublabel": "orders-v1 · customer-v1 indexes",
      "x": 1480,
      "y": 160,
      "props": {}
    },
    {
      "id": "warehouse",
      "stencil": "snowflake",
      "label": "Retail warehouse",
      "sublabel": "RETAIL_ANALYTICS · MERGE by key",
      "x": 1480,
      "y": 400,
      "props": {}
    },
    {
      "id": "s3-sink",
