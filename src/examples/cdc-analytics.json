      "x": 1480,
      "y": 520,
      "props": {}
    },
    {
      "id": "registry",
      "stencil": "kafka.schema-registry",
      "label": "CDC schemas",
      "sublabel": "Avro envelopes · compatibility checks",
      "x": 760,
      "y": 40,
      "group": "platform",
      "props": {}
    }
