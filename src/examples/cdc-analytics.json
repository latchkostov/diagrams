      "x": 360,
      "y": 0,
      "width": 1020,
      "height": 632
    }
  ],
  "nodes": [
    {
      "id": "sql",
      "stencil": "sqlserver",
      "label": "Retail SQL Server",
      "sublabel": "retail-prod · CDC enabled",
      "x": 40,
      "y": 280,
      "group": "onprem",
      "props": {
        "ratePerSec": 120
      }
    },
    {
      "id": "debezium",
      "stencil": "kafka.connect",
      "label": "Debezium SQL Server",
      "sublabel": "retail-cdc · snapshot then tail",
