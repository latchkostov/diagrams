{
  "format": "diagrams/v1",
  "title": "CDC search and analytics",
  "description": "Debezium captures retail table changes for search projections, a warehouse and raw lake retention.",
  "direction": "LR",
  "groups": [
    {
      "id": "onprem",
      "label": "On-prem · retail datacenter",
      "tone": "onprem",
      "x": 0,
      "y": 240,
