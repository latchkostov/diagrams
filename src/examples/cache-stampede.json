            "field": "p95"
          },
          "op": "<",
          "value": 300,
          "when": "end"
        },
        {
          "id": "fetches",
          "label": "Launch page fetches in flight < 5, always",
          "metric": {
            "node": "cdn",
            "field": "itemFetches"
          },
          "op": "<",
          "value": 5,
          "when": "always"
        }
      ]
    },
