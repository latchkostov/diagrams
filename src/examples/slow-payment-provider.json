  },
  "title": "A slow payment provider",
  "description": "At three seconds the payment provider slows tenfold. Compare no timeout, a 600 ms timeout, forty connections with threads freed, and the same pool holding threads. Every run includes order-status requests; timeouts do not cancel provider work.",
  "nodes": [
    {
      "id": "shop",
      "stencil": "client.user",
      "label": "Shop",
      "x": 0,
      "y": 180,
      "props": {
        "ratePerSec": 120,
        "trafficMix": {
          "mode": "rates",
          "entries": [
            {
              "routeId": "checkout",
              "ratePerSec": 120
            },
            {
              "routeId": "status",
              "ratePerSec": 20
            }
          ]
        }
      }
    },
    {
      "id": "gateway",
      "stencil": "generic.adc",
      "label": "API gateway",
      "sublabel": "5 s timeout",
      "x": 320,
      "y": 180
    },
    {
      "id": "checkout",
      "stencil": "generic.service",
      "label": "Checkout",
      "sublabel": "4 replicas · 25 threads each",
      "x": 660,
      "y": 180,
      "props": {
        "replicas": 4,
        "concurrency": 25,
        "latencyMs": 10,
        "jitter": 0
      }
    },
    {
      "id": "payment",
      "stencil": "generic.external-api",
      "label": "Payment provider",
      "sublabel": "200 ms · slows ×10 at 3 s",
      "x": 1020,
      "y": 180,
      "props": {
        "latencyMs": 200,
        "api": {
          "latencyMs": 200
        },
        "jitter": 0
      }
    },
    {
      "id": "orders",
      "stencil": "generic.database",
      "label": "Orders DB",
      "x": 1020,
      "y": 420,
      "props": {
        "latencyMs": 5,
        "jitter": 0
      }
    }
  ],
  "edges": [
    {
      "id": "browse",
      "from": "shop",
      "to": "gateway",
      "kind": "sync",
      "props": {
        "travelMs": 100
      }
    },
    {
      "id": "route",
      "from": "gateway",
      "to": "checkout",
      "kind": "sync",
      "props": {
        "travelMs": 100,
        "caller": {
          "deadlineMs": 5000
        }
      }
    },
    {
      "id": "pay",
      "from": "checkout",
      "to": "payment",
      "kind": "sync",
      "props": {
        "travelMs": 200,
        "requestFilter": {
          "methods": ["POST"]
        }
      }
    },
    {
      "id": "save",
      "from": "checkout",
      "to": "orders",
      "kind": "sync",
      "props": {
        "travelMs": 100,
        "requestFilter": {
          "methods": ["GET"]
        }
      }
    }
  ],
  "simulations": [
    {
      "id": "no-timeouts",
      "title": "No timeouts",
      "description": "Checkout fills all 100 threads after the slowdown. Its queue keeps growing; the gateway eventually returns 504s after waiting five seconds.",
      "seed": 17,
      "scale": 1,
      "durationMs": 20000,
      "traffic": [
        {
          "id": "orders",
          "node": "shop",
          "messageType": "Checkout",
          "shape": {
            "kind": "constant",
            "ratePerSec": 120,
            "durationMs": 20000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 3000,
          "action": {
            "do": "fault",
            "fault": {
              "kind": "slow",
              "node": "payment",
              "factor": 10
            }
          }
        }
      ],
      "expectations": [
        {
          "id": "gateway-timeouts",
          "label": "No API gateway timeouts",
          "metric": {
            "node": "gateway",
            "field": "timedOut"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        },
        {
          "value": 0,
          "id": "expected-failure-gateway",
          "metric": {
            "field": "dropped",
            "node": "gateway"
          },
          "when": "eventually",
          "label": "API gateway reports failed checkouts",
          "op": ">"
        },
        {
          "value": 0,
          "id": "expected-failure-shop",
          "metric": {
            "field": "dropped",
            "node": "shop"
          },
          "when": "eventually",
          "label": "Shop reports failed checkouts",
          "op": ">"
        },
        {
          "id": "status",
          "label": "Orders DB order-status work falls behind",
          "metric": {
            "node": "orders",
            "field": "processed"
          },
          "op": "<",
          "value": 300,
          "when": "end"
        }
      ]
    },
    {
      "id": "timeout-600",
      "title": "A 600 ms timeout",
      "description": "Payments time out, then their late replies are discarded. Checkout releases each thread after 600 ms and the gateway never times out: degradation instead of a stall.",
