{
  "format": "diagrams/v1",
  "title": "Kafka order pipeline",
  "description": "Order placement with independent consumer groups, local stores and payment confirmation events.",
  "direction": "LR",
  "groups": [
    {
      "id": "aks",
      "label": "AKS · commerce workloads + Kafka",
      "tone": "k8s",
      "x": 720,
      "y": 120,
      "width": 1020,
      "height": 392
    }
  ],
  "nodes": [
    {
      "id": "shopper",
      "stencil": "client.browser",
      "label": "Storefront",
      "sublabel": "Browser / mobile checkout",
      "x": 40,
      "y": 280,
      "props": {
        "ratePerSec": 25,
        "messageType": "OrderRequest"
      }
    },
    {
      "id": "gateway",
      "stencil": "nginx",
      "label": "Commerce gateway",
      "sublabel": "TLS termination · /api/orders",
      "x": 400,
      "y": 280,
      "props": {}
    },
    {
      "id": "orders",
      "stencil": "service.dotnet",
      "label": "Order service",
      "sublabel": ".NET 10 · group: orders-payments",
      "x": 760,
      "y": 280,
      "group": "aks",
      "props": {
        "group": "orders-payments",
        "idempotent": true,
        "concurrency": 64,
        "latencyMs": 150,
        "emits": {
          "OrderRequest": "OrderPlaced",
          "PaymentCompleted": "OrderUpdated"
        }
      }
    },
    {
      "id": "order-events",
      "stencil": "kafka.topic",
      "label": "orders.created.v1",
      "sublabel": "OrderPlaced · keyed by orderId",
      "x": 1120,
      "y": 280,
      "group": "aks",
      "props": {
        "partitions": 64,
        "replicationFactor": 3
      }
    },
    {
      "id": "inventory",
      "stencil": "service.java",
      "label": "Inventory service",
      "sublabel": "group: inventory-reservations",
      "x": 1480,
      "y": 160,
      "group": "aks",
      "props": {
        "group": "inventory-reservations",
        "concurrency": 64,
        "latencyMs": 150,
        "emits": "InventoryReserved"
      }
    },
    {
      "id": "payments",
      "stencil": "service.go",
      "label": "Payments service",
      "sublabel": "group: payment-authorizations",
      "x": 1480,
      "y": 280,
      "group": "aks",
      "props": {
        "group": "payment-authorizations",
        "concurrency": 64,
        "latencyMs": 150,
        "emits": "PaymentCompleted"
      }
    },
    {
      "id": "notifications",
      "stencil": "service.node",
      "label": "Notification service",
      "sublabel": "group: customer-notifications",
      "x": 1480,
      "y": 400,
      "group": "aks",
      "props": {
        "group": "customer-notifications",
        "concurrency": 64,
        "latencyMs": 150,
        "emits": "NotificationRequested"
      }
    },
    {
      "id": "stock-db",
      "stencil": "postgres",
      "label": "Inventory database",
      "sublabel": "Reservations · SKU availability",
      "x": 1840,
      "y": 160,
      "props": {}
    },
    {
      "id": "payment-db",
      "stencil": "postgres",
      "label": "Payment ledger",
      "sublabel": "Idempotency keys · authorizations",
      "x": 1840,
      "y": 280,
      "props": {}
    },
    {
      "id": "notify-cache",
      "stencil": "redis.cache",
      "label": "Notification dedupe",
      "sublabel": "Order / template key · TTL 24h",
      "x": 1840,
      "y": 400,
      "props": {}
    },
    {
      "id": "payment-events",
      "stencil": "kafka.topic",
      "label": "payments.completed.v1",
      "sublabel": "PaymentCompleted · keyed by orderId",
      "x": 1120,
      "y": 520,
      "props": {
        "partitions": 64,
        "replicationFactor": 3
      }
    },
    {
      "id": "order-db",
      "stencil": "postgres",
      "label": "Orders database",
      "sublabel": "Order state · transactional outbox",
      "x": 760,
      "y": 520,
      "props": {}
    },
    {
      "id": "schemas",
      "stencil": "kafka.schema-registry",
      "label": "Schema registry",
      "sublabel": "Avro · backward compatible",
      "x": 1120,
      "y": 40,
      "props": {
        "compatibility": "BACKWARD"
      }
    },
    {
      "id": "metrics",
      "stencil": "prometheus",
      "label": "Commerce metrics",
      "sublabel": "Scrape interval: 15s",
      "x": 1480,
      "y": 640,
      "props": {
        "scrapeIntervalSec": 15
      }
    },
    {
      "id": "dashboard",
      "stencil": "grafana",
      "label": "Order operations",
      "sublabel": "Lag · checkout latency · failures",
      "x": 1840,
      "y": 640,
      "props": {}
    }
  ],
  "edges": [
    {
      "id": "shopper-to-gateway",
      "from": "shopper",
      "to": "gateway",
      "label": "HTTPS",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "gateway-to-orders",
      "from": "gateway",
      "to": "orders",
      "label": "POST /orders",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "orders-to-order-db",
      "from": "orders",
      "to": "order-db",
      "label": "Commit order + outbox",
      "kind": "sync",
      "props": {
        "travelMs": 200,
        "filter": [
          "OrderPlaced",
          "OrderUpdated"
        ]
      }
    },
    {
      "id": "orders-to-order-events",
      "from": "orders",
      "to": "order-events",
      "label": "OrderPlaced",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "OrderPlaced"
        ]
      }
    },
    {
      "id": "order-events-to-inventory",
      "from": "order-events",
      "to": "inventory",
      "label": "Reserve inventory",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "OrderPlaced"
        ],
        "group": "inventory-reservations"
      }
    },
    {
      "id": "order-events-to-payments",
      "from": "order-events",
      "to": "payments",
      "label": "Authorize payment",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "OrderPlaced"
        ],
        "group": "payment-authorizations"
      }
    },
    {
      "id": "order-events-to-notifications",
      "from": "order-events",
      "to": "notifications",
      "label": "Send confirmation",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "OrderPlaced"
        ],
        "group": "customer-notifications"
      }
    },
    {
      "id": "inventory-to-stock-db",
      "from": "inventory",
      "to": "stock-db",
      "label": "Reserve SKUs",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "payments-to-payment-db",
      "from": "payments",
      "to": "payment-db",
      "label": "Record authorization",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "notifications-to-notify-cache",
      "from": "notifications",
      "to": "notify-cache",
      "label": "SET NX · dedupe",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "payments-to-payment-events",
      "from": "payments",
      "to": "payment-events",
      "label": "PaymentCompleted",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "payment-events-to-orders",
      "from": "payment-events",
      "to": "orders",
      "label": "group: orders-payments",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "PaymentCompleted"
        ],
        "group": "orders-payments"
      }
    },
    {
      "id": "orders-to-schemas",
      "from": "orders",
      "to": "schemas",
      "label": "Fetch Avro schema",
      "kind": "sync",
      "props": {
        "travelMs": 200,
        "filter": [
          "OrderPlaced"
        ]
      }
    },
    {
      "id": "metrics-to-orders",
      "from": "metrics",
      "to": "orders",
      "label": "GET /metrics",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "dashboard-to-metrics",
      "from": "dashboard",
      "to": "metrics",
      "label": "PromQL",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    }
  ],
  "simulations": [
    {
      "id": "black-friday",
      "title": "Black Friday: 500 orders in 10 s",
      "seed": 7,
      "traffic": [
        {
          "id": "ramp",
          "node": "shopper",
          "messageType": "OrderRequest",
          "label": "Checkout demand ramps up",
          "shape": {
            "kind": "ramp",
            "stages": [
              {
                "durationMs": 10000,
                "targetRate": 60
              }
            ]
          }
        },
        {
          "id": "spike",
          "node": "shopper",
          "messageType": "OrderRequest",
          "label": "Flash-sale spike",
          "shape": {
            "kind": "spike",
            "baseRate": 10,
            "peakRate": 60,
            "atMs": 4000,
            "peakMs": 2000,
            "durationMs": 10000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "500 checkouts. Each order fans out to inventory, payments and notifications.",
            "focus": [
              "shopper",
              "order-events"
            ]
          }
        },
        {
          "atMs": 6000,
          "action": {
            "do": "note",
            "text": "PaymentCompleted updates the order without creating another order.",
            "focus": [
              "payments",
              "payment-events",
              "orders"
            ]
          }
        }
      ],
      "expectations": [
        {
          "id": "stock",
          "label": "All 500 orders reserve stock",
          "metric": {
            "node": "stock-db",
            "field": "processed"
          },
          "op": "==",
          "value": 500,
          "when": "end"
        },
        {
          "id": "payments",
          "label": "All 500 payments are recorded",
          "metric": {
            "node": "payment-db",
            "field": "processed"
          },
          "op": "==",
          "value": 500,
          "when": "end"
        },
        {
          "id": "notifications",
          "label": "Notifications",
          "metric": {
            "node": "notify-cache",
            "field": "processed"
          },
          "op": "==",
          "value": 500,
          "when": "end"
        },
        {
          "id": "orders",
          "label": "500 orders created and 500 payment updates",
          "metric": {
            "node": "order-db",
            "field": "processed"
          },
          "op": "==",
          "value": 1000,
          "when": "end"
        },
        {
          "id": "no-dlq",
          "label": "No dlq",
          "metric": {
            "node": "order-events",
            "field": "deadLettered"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        },
        {
          "id": "no-drop",
          "label": "No drop",
          "metric": {
            "node": "order-events",
            "field": "dropped"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        }
      ]
    },
    {
      "id": "payments-outage",
      "title": "Payments service goes down",
      "seed": 7,
      "traffic": [
        {
          "id": "checkouts",
          "node": "shopper",
          "messageType": "OrderRequest",
          "label": "300 checkouts during an outage",
          "shape": {
            "kind": "constant",
            "ratePerSec": 50,
            "durationMs": 6000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "Inventory and notifications have independent consumer groups.",
            "focus": [
              "order-events"
            ]
          }
        },
        {
          "atMs": 4000,
          "action": {
            "do": "status",
            "node": "payments",
            "status": "down"
          }
        },
        {
          "atMs": 4000,
          "action": {
            "do": "note",
            "text": "Payments is offline. Its group accumulates lag while the other groups continue.",
            "focus": [
              "payments",
              "order-events"
            ],
            "pause": true
          }
        },
        {
          "atMs": 12000,
          "action": {
            "do": "status",
            "node": "payments",
            "status": "up"
          }
        },
        {
          "atMs": 12000,
          "action": {
            "do": "note",
            "text": "Payments is back. Watch its backlog drain and the ledger catch up.",
            "focus": [
              "payments",
              "payment-db"
            ]
          }
        }
      ],
      "expectations": [
        {
          "id": "outage-lag",
          "label": "Payment lag grows during the outage",
          "metric": {
            "node": "order-events",
            "field": "lag",
            "group": "payment-authorizations"
          },
          "op": ">",
          "value": 0,
          "when": "at",
          "atMs": 11000
        },
        {
          "id": "recovered",
          "label": "Recovered",
          "metric": {
            "node": "order-events",
            "field": "lag",
            "group": "payment-authorizations"
          },
          "op": "==",
          "value": 0,
          "when": "eventually"
        },
        {
          "id": "drained",
          "label": "Drained",
          "metric": {
            "node": "order-events",
            "field": "lag",
            "group": "payment-authorizations"
          },
          "op": "==",
          "value": 0,
          "when": "end"
        },
        {
          "id": "payments",
          "label": "Payments",
          "metric": {
            "node": "payment-db",
            "field": "processed"
          },
          "op": "==",
          "value": 300,
          "when": "end"
        },
        {
          "id": "stock",
          "label": "Stock",
          "metric": {
            "node": "stock-db",
            "field": "processed"
          },
          "op": "==",
          "value": 300,
          "when": "end"
        }
      ]
    }
  ]
}
