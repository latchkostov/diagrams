{
  "language": "uk",
  "register": "ви (lowercase)",
  "quotes": "«…»",
  "notes": [
    "Buttons and menu commands use the infinitive, as Windows and macOS do in Ukrainian (Зберегти, Експортувати як, Закрити).",
    "Address the person as ви, lowercase; avoid gendered past-tense forms where a neutral wording exists.",
    "Diagram is діаграма (feminine); app names inside sentences go in «…» to keep the nominative («Ваші діаграми»).",
    "AI is ШІ; app is застосунок (not додаток).",
    "Keyboard labels follow docs/research/keyboard-key-names.md; macOS modifier keys use ⌘⌃⌥⇧. Tokens used to match key events remain English."
  ],
  "terms": {
    "topic": {
      "use": "топік",
      "match": ["топік"],
      "avoid": [" тема", " теми", " тему", " темі"],
      "note": "As dou.ua writes; тема is the colour theme. Avoid forms have a leading space so that «система» doesn't trip them."
    },
    "queue": {
      "use": "черга",
      "match": ["черг"]
    },
    "consumer": {
      "use": "споживач",
      "match": ["споживач"],
      "except": ["menu.setConsumerGroup"]
    },
    "consumer group": {
      "use": "група споживачів",
      "match": ["споживач", "consumer group"]
    },
    "producer": {
      "use": "виробник",
      "match": ["виробник"],
      "note": "Pairs with споживач."
    },
    "partition": {
      "use": "партиція",
      "match": ["партиці"]
    },
    "broker": {
      "use": "брокер",
      "match": ["брокер"]
    },
    "dead-letter queue": {
      "use": "черга недоставлених повідомлень (DLQ)",
      "match": ["недоставлен", "dlq"],
      "note": "DLQ alone as the short label."
    },
    "throughput": {
      "use": "пропускна здатність",
      "match": ["пропускн"]
    },
    "latency": {
      "use": "затримка",
      "match": ["затримк"]
    },
    "replica": {
      "use": "репліка",
      "match": ["реплік"]
    },
    "load balancer": {
      "use": "балансувальник навантаження",
      "match": ["балансувальник"]
    },
    "gateway": {
      "use": "шлюз",
      "match": ["шлюз"],
      "note": "API-шлюз."
    },
    "cache": {
      "use": "кеш",
      "match": ["кеш"]
    },
    "message": {
      "use": "повідомлення",
      "match": ["повідомлен"]
    },
    "event": {
      "use": "подія",
      "match": ["поді"]
    },
    "subscription": {
      "use": "підписка",
      "match": ["підписк", "Підписка", "Підписки"],
      "note": " Messaging subscription forms coexist with cloud-account subscription terminology."
    },
    "offset": {
      "use": "зміщення",
      "match": ["зміщен", "offset"]
    },
    "backlog": {
      "use": "необроблені повідомлення",
      "match": ["необроблен", "backlog"]
    },
    "retry": {
      "use": "повтор",
      "match": ["повтор"],
      "note": "Button: Повторити. Redo is Повернути."
    },
    "diagram": {
      "use": "діаграма",
      "match": ["діаграм"],
      "except": ["cloud.dropboxFileMissing", "cloud.oneDriveRefusedToActionLiveDiagramsCan"],
      "note": "Diagrams in these cloud errors is the existing folder name."
    },
    "node": {
      "use": "вузол",
      "match": ["вузол", "вузл"],
      "note": "вузла, вузли, вузлів."
    },
    "edge": {
      "use": "зв’язок",
      "match": ["зв’яз", "зв'яз"],
      "except": [
        "shortcuts.mouse.boundary",
        "menu.leftEdges",
        "menu.rightEdges",
        "menu.topEdges",
        "menu.bottomEdges",
        "chrome.gatewaysLoadBalancersAndEdgeNetworksInFrontOfServices",
        "chrome.peopleDevicesAndExternalSystemsAtTheEdgeOfThe",
        "stencil.vercelDescription",
        "stencil.netlifyDescription",
        "stencil.cloudflareWorkersDescription",
        "stencil.subtitleEdgeFunction",
        "stencil.supabaseDescription",
        "stencil.azureFrontDoorDescription",
        "stencil.cloudflareDescription",
        "stencil.envoyDescription",
        "stencil.genericCdnDescription",
        "stencil.subtitleEdge",
        "stencil.genericRouterDescription",
        "stencil.ciscoIsrDescription",
        "stencil.subtitleEdgeRouter",
        "stencil.juniperMxDescription",
        "stencil.clientIotDescription"
      ],
      "note": "In shortcuts.mouse.boundary 'edge' is the border of a boundary (край), not a connection."
    },
    "stencil": {
      "use": "елемент",
      "match": ["елемент"],
      "note": "The rail is «Елементи»."
    },
    "boundary": {
      "use": "межа",
      "match": ["меж"],
      "note": "межі, межу."
    },
    "simulation": {
      "use": "симуляція",
      "match": ["симуляці"]
    },
    "live": {
      "use": "режим реального часу",
      "match": ["реальн", "наживо", "live"],
      "note": "The mode where messages flow."
    },
    "present": {
      "use": "презентація",
      "match": ["презентаці"]
    },
    "embed": {
      "use": "вбудувати",
      "match": ["вбуд"],
      "note": "вбудовування (noun), вбудований."
    },
    "share link": {
      "use": "посилання для спільного доступу",
      "match": ["посилан"],
      "note": "Menu item: «Поділитися посиланням…»."
    },
    "export": {
      "use": "експорт",
      "match": ["експорт"]
    },
    "import": {
      "use": "імпорт",
      "match": ["імпорт"]
    },
    "private": {
      "use": "приватна",
      "match": ["приватн"],
      "note": "Agrees with діаграма. Never секретна or конфіденційна; the Privacy menu is «Конфіденційність»."
    },
    "this device": {
      "use": "цей пристрій",
      "match": ["пристр"],
      "note": "на цьому пристрої, з цього пристрою."
    },
    "capacity": {
      "use": "ємність",
      "match": ["ємніст"]
    },
    "checks": {
      "use": "перевірки",
      "match": ["перевір"]
    },
    "annotation": {
      "use": "анотація",
      "match": ["анотаці"]
    },
    "shard": {
      "use": "Шарди",
      "match": ["Шарди"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "binding": {
      "use": "Прив’язка",
      "match": ["Прив’язки", "Прив’язка"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "firewall": {
      "use": "брандмауер",
      "match": ["брандмауер"],
      "avoid": ["брандмауру", "пожежні стінки", "фейрури", "файрушки", "фейрміни"]
    }
  },
  "keys": {
    "ctrl": "Ctrl",
    "shift": "Shift",
    "alt": "Alt",
    "delete": "Del",
    "backspace": "Backspace",
    "escape": "Esc",
    "enter": "Enter",
    "tab": "Tab",
    "space": "Пробіл",
    "drag": "Перетягування"
  }
}
