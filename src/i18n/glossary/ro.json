{
  "language": "ro",
  "register": "dumneavoastră (formal plural): commands in the formal imperative (Salvați, Deschideți), possessive „dvs.“",
  "quotes": "„…”",
  "notes": [
    "ș and ț with comma below (U+0219, U+021B), never the cedilla ş ţ.",
    "Buttons and commands in the formal imperative (Salvați, Exportați, Anulați); gesture names as nouns (Glisare, Dublu clic).",
    "Keep „topic“ (topic-uri) and „live“ as Romanian developers do; the colour theme is „temă“.",
    "Plural „other“ (20 and up) takes „de“: 20 de noduri.",
    "Keyboard labels follow docs/research/keyboard-key-names.md; macOS modifier keys use ⌘⌃⌥⇧. Tokens used to match key events remain English."
  ],
  "terms": {
    "topic": {
      "use": "topic",
      "keepEnglish": true,
      "match": ["topic"],
      "note": "topicul, topic-uri; „temă“ is the colour theme"
    },
    "queue": {
      "use": "coadă",
      "match": ["coad", "cozi"]
    },
    "consumer": {
      "use": "consumator",
      "match": ["consumat"],
      "except": [
        "menu.setConsumerGroup",
        "broker.group",
        "stencil.kafkaTopicDescription",
        "stencil.redisStreamDescription"
      ],
      "note": " The canonical consumer-group label is kept in English."
    },
    "consumer group": {
      "use": "consumer group",
      "keepEnglish": true,
      "match": ["consumer group"]
    },
    "producer": {
      "use": "producător",
      "match": ["producăt"]
    },
    "partition": {
      "use": "partiție",
      "match": ["partiți"]
    },
    "broker": {
      "use": "broker",
      "match": ["broker"]
    },
    "dead-letter queue": {
      "use": "coadă de mesaje nelivrate",
      "match": ["nelivrat", "dlq"]
    },
    "throughput": {
      "use": "debit",
      "match": ["debit"]
    },
    "latency": {
      "use": "latență",
      "match": ["latenț"]
    },
    "replica": {
      "use": "replică",
      "match": ["replic"]
    },
    "load balancer": {
      "use": "echilibrator de încărcare",
      "match": ["echilibrator", "echilibrato"]
    },
    "gateway": {
      "use": "gateway",
      "keepEnglish": true,
      "match": ["gateway"]
    },
    "cache": {
      "use": "cache",
      "keepEnglish": true,
      "match": ["cache"]
    },
    "message": {
      "use": "mesaj",
      "match": ["mesaj"]
    },
    "event": {
      "use": "eveniment",
      "match": ["eveniment"]
    },
    "subscription": {
      "use": "abonament",
      "match": ["abonament", "Abonament", "Abonamente"],
      "note": " Messaging subscription forms coexist with cloud-account subscription terminology."
    },
    "offset": {
      "use": "offset",
      "keepEnglish": true,
      "match": ["offset"]
    },
    "backlog": {
      "use": "backlog",
      "keepEnglish": true,
      "match": ["backlog"]
    },
    "retry": {
      "use": "reîncercați",
      "match": ["reîncerc"]
    },
    "diagram": {
      "use": "diagramă",
      "match": ["diagram"],
      "except": ["cloud.dropboxFileMissing", "cloud.oneDriveRefusedToActionLiveDiagramsCan"],
      "note": "Diagrams in these cloud errors is the existing folder name."
    },
    "node": {
      "use": "nod",
      "match": ["nod"],
      "note": "nod, noduri, 20 de noduri"
    },
    "edge": {
      "use": "conexiune",
      "match": ["conexiun"],
      "except": [
        "shortcuts.mouse.boundary",
        "menu.leftEdges",
        "menu.rightEdges",
        "menu.topEdges",
        "menu.bottomEdges",
        "chrome.gatewaysLoadBalancersAndEdgeNetworksInFrontOfServices",
        "chrome.peopleDevicesAndExternalSystemsAtTheEdgeOfThe",
        "stencil.vercelDescription",
        "stencil.netlifyDescription",
        "stencil.cloudflareWorkersDescription",
        "stencil.subtitleEdgeFunction",
        "stencil.supabaseDescription",
        "stencil.azureFrontDoorDescription",
        "stencil.cloudflareDescription",
        "stencil.envoyDescription",
        "stencil.genericCdnDescription",
        "stencil.subtitleEdge",
        "stencil.genericRouterDescription",
        "stencil.ciscoIsrDescription",
        "stencil.subtitleEdgeRouter",
        "stencil.juniperMxDescription",
        "stencil.clientIotDescription"
      ],
      "note": "In shortcuts.mouse.boundary 'edge' is the boundary's border (margine)."
    },
    "stencil": {
      "use": "șablon",
      "match": ["șablo"],
      "note": "Visio's Romanian word; plural șabloane"
    },
    "boundary": {
      "use": "limită",
      "match": ["limit"]
    },
    "simulation": {
      "use": "simulare",
      "match": ["simulăr", "simular"]
    },
    "live": {
      "use": "live",
      "keepEnglish": true,
      "match": ["live"]
    },
    "present": {
      "use": "prezentați",
      "match": ["prezent"],
      "note": "Prezentați, prezentare"
    },
    "embed": {
      "use": "încorporați",
      "match": ["încorpor"],
      "note": "încorporare (noun)"
    },
    "share link": {
      "use": "link de partajare",
      "match": ["link"]
    },
    "export": {
      "use": "exportați",
      "match": ["export"]
    },
    "import": {
      "use": "importați",
      "match": ["import"]
    },
    "private": {
      "use": "privat",
      "match": ["privat"],
      "note": "diagramă privată; „Confidențialitate“ is only the Privacy menu, as in Microsoft and Google"
    },
    "this device": {
      "use": "acest dispozitiv",
      "match": ["dispozitiv"],
      "avoid": ["calculator"]
    },
    "capacity": {
      "use": "capacitate",
      "match": ["capacit"]
    },
    "checks": {
      "use": "verificări",
      "match": ["verific"]
    },
    "annotation": {
      "use": "adnotare",
      "match": ["adnot"]
    },
    "shard": {
      "use": "Sharduri",
      "match": ["Sharduri"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "binding": {
      "use": "Legătură",
      "match": ["Legături", "Legătură"],
      "note": "P2 broker vocabulary; singular and plural forms."
    }
  },
  "keys": {
    "ctrl": "Ctrl",
    "shift": "Shift",
    "alt": "Alt",
    "delete": "Del",
    "backspace": "Backspace",
    "escape": "Esc",
    "enter": "Enter",
    "tab": "Tab",
    "space": "Spațiu",
    "drag": "Tragere"
  }
}
