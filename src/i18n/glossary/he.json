{
  "language": "he",
  "register": "gender-neutral: plural imperative (לחצו, תוכלו) in sentences, nouns for commands",
  "quotes": "\"…\" (straight)",
  "notes": [
    "Buttons and menu items use action nouns (שמירה, פתיחה…, סגירה) so they stay gender-neutral; instructions use the plural (גררו, פתחו).",
    "Latin names stay inline in Latin script, joined to a Hebrew prefix with a hyphen (ב-GitHub, ו-Mermaid); no bidi control characters.",
    "\"Your diagrams\" is \"הדיאגרמות שלך\" everywhere; in straight quotes when named inside a sentence.",
    "דיאגרמה is feminine: private diagram = דיאגרמה פרטית; it = אותה.",
    "Topic, offset, backlog, Live and AI stay in English; ערכת נושא is the colour theme.",
    "Keyboard labels follow docs/research/keyboard-key-names.md; macOS modifier keys use ⌘⌃⌥⇧. Tokens used to match key events remain English."
  ],
  "terms": {
    "topic": {
      "use": "Topic",
      "keepEnglish": true,
      "avoid": ["נושא"],
      "note": "ערכת נושא is the app's colour theme."
    },
    "queue": {
      "use": "תור",
      "match": ["תור"]
    },
    "consumer": {
      "use": "צרכן",
      "match": ["צרכן", "צרכנ"],
      "except": [
        "menu.setConsumerGroup",
        "broker.group",
        "stencil.kafkaTopicDescription",
        "stencil.redisStreamDescription",
        "tutorials.partitions.idleDone",
        "tutorials.partitions.editDone",
        "tutorials.kafkaTopic.title",
        "tutorials.kafkaTopic.emailDone",
        "tutorials.kafkaTopic.watchDone",
        "tutorials.kafkaTopic.finish"
      ],
      "note": " The canonical consumer-group label is kept in English."
    },
    "consumer group": {
      "use": "Consumer Group",
      "keepEnglish": true,
      "match": ["consumer group", "קבוצת צרכנים"]
    },
    "producer": {
      "use": "יצרן",
      "match": ["יצרן", "יצרנ"]
    },
    "partition": {
      "use": "מחיצה",
      "match": ["מחיצ", "partition"]
    },
    "broker": {
      "use": "ברוקר",
      "match": ["ברוקר", "broker"]
    },
    "dead-letter queue": {
      "use": "תור הודעות מתות",
      "match": ["הודעות מתות", "dlq"]
    },
    "throughput": {
      "use": "תפוקה",
      "match": ["תפוק"]
    },
    "latency": {
      "use": "השהיה",
      "match": ["השהי"]
    },
    "replica": {
      "use": "רפליקה",
      "match": ["רפליק", "העתק"]
    },
    "load balancer": {
      "use": "מאזן עומסים",
      "match": ["מאזן עומסים", "מאזני עומסים"]
    },
    "gateway": {
      "use": "שער",
      "match": ["שער", "gateway"]
    },
    "cache": {
      "use": "מטמון",
      "match": ["מטמון"]
    },
    "message": {
      "use": "הודעה",
      "match": ["הודע"]
    },
    "event": {
      "use": "אירוע",
      "match": ["אירוע"]
    },
    "subscription": {
      "use": "מינוי",
      "match": ["מינוי", "מינויים"],
      "note": " Messaging subscription forms coexist with cloud-account subscription terminology."
    },
    "offset": {
      "use": "offset",
      "keepEnglish": true
    },
    "backlog": {
      "use": "backlog",
      "keepEnglish": true,
      "match": ["backlog", "הודעות ממתינות"]
    },
    "retry": {
      "use": "ניסיון חוזר",
      "match": ["ניסיון חוזר", "לנסות שוב", "נסו שוב"]
    },
    "diagram": {
      "use": "דיאגרמה",
      "match": ["דיאגרמ"],
      "note": "feminine.; Diagrams in these cloud errors is the existing folder name.",
      "except": ["cloud.dropboxFileMissing", "cloud.oneDriveRefusedToActionLiveDiagramsCan"]
    },
    "node": {
      "use": "צומת",
      "match": ["צומת", "צמת"],
      "note": "plural צמתים."
    },
    "edge": {
      "use": "חיבור",
      "match": ["חיבור"],
      "except": [
        "shortcuts.mouse.boundary",
        "menu.leftEdges",
        "menu.rightEdges",
        "menu.topEdges",
        "menu.bottomEdges",
        "chrome.gatewaysLoadBalancersAndEdgeNetworksInFrontOfServices",
        "chrome.peopleDevicesAndExternalSystemsAtTheEdgeOfThe",
        "stencil.vercelDescription",
        "stencil.netlifyDescription",
        "stencil.cloudflareWorkersDescription",
        "stencil.subtitleEdgeFunction",
        "stencil.supabaseDescription",
        "stencil.azureFrontDoorDescription",
        "stencil.cloudflareDescription",
        "stencil.envoyDescription",
        "stencil.genericCdnDescription",
        "stencil.subtitleEdge",
        "stencil.genericRouterDescription",
        "stencil.ciscoIsrDescription",
        "stencil.subtitleEdgeRouter",
        "stencil.juniperMxDescription",
        "stencil.clientIotDescription"
      ],
      "note": "In shortcuts.mouse.boundary \"edge\" is a boundary's border (קצה)."
    },
    "stencil": {
      "use": "סטנסיל",
      "match": ["סטנסיל"]
    },
    "boundary": {
      "use": "גבול",
      "match": ["גבול"],
      "note": "Never קבוצה (group)."
    },
    "simulation": {
      "use": "סימולציה",
      "match": ["סימולצי"]
    },
    "live": {
      "use": "Live",
      "keepEnglish": true,
      "note": "The mode's name: תצוגת Live."
    },
    "present": {
      "use": "הצגה",
      "match": ["הצגה", "מצגת"],
      "note": "presentation: מצגת."
    },
    "embed": {
      "use": "הטמעה",
      "match": ["הטמע", "להטמיע"]
    },
    "share link": {
      "use": "קישור לשיתוף",
      "match": ["קישור לשיתוף", "קישורים לשיתוף", "קישור שיתוף", "קישורי שיתוף"]
    },
    "export": {
      "use": "ייצוא",
      "match": ["ייצוא", "לייצא", "ייצאו", "ייצאת"]
    },
    "import": {
      "use": "ייבוא",
      "match": ["ייבוא", "לייבא"]
    },
    "private": {
      "use": "פרטי",
      "match": ["פרטי"],
      "avoid": ["סודי", "חסוי"]
    },
    "this device": {
      "use": "המכשיר הזה",
      "match": ["מכשיר הזה"],
      "avoid": ["מחשב", "דיסק"]
    },
    "capacity": {
      "use": "קיבולת",
      "match": ["קיבול"]
    },
    "checks": {
      "use": "בדיקות",
      "match": ["בדיק"]
    },
    "annotation": {
      "use": "הערה",
      "match": ["הער", "ביאור"]
    },
    "shard": {
      "use": "רסיסים",
      "match": ["רסיסים"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "binding": {
      "use": "קישור",
      "match": ["קישורים", "קישור"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "firewall": {
      "use": "חומת אש",
      "match": ["חומות אש", "קירות אש"]
    }
  },
  "keys": {
    "ctrl": "Ctrl",
    "shift": "Shift",
    "alt": "Alt",
    "delete": "Del",
    "backspace": "Backspace",
    "escape": "Esc",
    "enter": "Enter",
    "tab": "Tab",
    "space": "רווח",
    "drag": "גרירה"
  }
}
