{
  "language": "sk",
  "register": "vy (formal, lowercase); buttons and menu items in the infinitive, as Microsoft Slovak does (Uložiť, Zavrieť)",
  "quotes": "„…“",
  "notes": [
    "Buttons and commands in the infinitive (Uložiť, Exportovať, Zdieľať); descriptions address the person with vy.",
    "Theme (light/dark) is „motív“, as in Microsoft Slovak, so „téma“ stays free for the Kafka topic.",
    "„Vaše diagramy“ is the library's name, inflected in running text (vo Vašich diagramoch).",
    "Keyboard labels follow docs/research/keyboard-key-names.md; macOS modifier keys use ⌘⌃⌥⇧. Tokens used to match key events remain English."
  ],
  "terms": {
    "topic": {
      "use": "téma",
      "match": ["tém"],
      "note": "Microsoft's word; the colour theme is „motív“, so no clash."
    },
    "queue": {
      "use": "front",
      "match": ["front"],
      "note": "Microsoft Slovak: front (frontu, fronty)."
    },
    "consumer": {
      "use": "konzument",
      "match": ["konzument"],
      "except": [
        "menu.setConsumerGroup",
        "broker.group",
        "stencil.kafkaTopicDescription",
        "stencil.redisStreamDescription",
        "tutorials.partitions.idleDone",
        "tutorials.partitions.editDone",
        "tutorials.kafkaTopic.title",
        "tutorials.kafkaTopic.emailDone",
        "tutorials.kafkaTopic.watchDone",
        "tutorials.kafkaTopic.finish"
      ],
      "note": " The canonical consumer-group label is kept in English."
    },
    "consumer group": {
      "use": "consumer group",
      "keepEnglish": true,
      "match": ["consumer group"],
      "note": "Kept in English, as the research recommends everywhere except cs, hu, sv, pt-PT."
    },
    "producer": {
      "use": "producent",
      "match": ["producent"]
    },
    "partition": {
      "use": "partícia",
      "match": ["partíci"]
    },
    "broker": {
      "use": "broker",
      "match": ["broker"]
    },
    "dead-letter queue": {
      "use": "front nedoručených správ",
      "match": ["nedoručen", "dlq"],
      "note": "DLQ as the short label."
    },
    "throughput": {
      "use": "priepustnosť",
      "match": ["priepustn"]
    },
    "latency": {
      "use": "latencia",
      "match": ["latenci"]
    },
    "replica": {
      "use": "replika",
      "match": ["replik"]
    },
    "load balancer": {
      "use": "vyrovnávač zaťaženia",
      "match": ["vyrovnávač"]
    },
    "gateway": {
      "use": "brána",
      "match": ["brán"]
    },
    "cache": {
      "use": "vyrovnávacia pamäť",
      "match": ["vyrovnávac", "cache"]
    },
    "message": {
      "use": "správa",
      "match": ["správ"]
    },
    "event": {
      "use": "udalosť",
      "match": ["udalos"]
    },
    "subscription": {
      "use": "predplatné",
      "match": ["predplatn", "Odber", "Odbery"],
      "note": " Messaging subscription forms coexist with cloud-account subscription terminology."
    },
    "offset": {
      "use": "offset",
      "keepEnglish": true,
      "match": ["offset"]
    },
    "backlog": {
      "use": "backlog",
      "keepEnglish": true,
      "match": ["backlog"]
    },
    "retry": {
      "use": "skúsiť znova",
      "match": ["znova", "opakova"]
    },
    "diagram": {
      "use": "diagram",
      "match": ["diagram"],
      "except": ["cloud.dropboxFileMissing", "cloud.oneDriveRefusedToActionLiveDiagramsCan"],
      "note": "Diagrams in these cloud errors is the existing folder name."
    },
    "node": {
      "use": "uzol",
      "match": ["uzol", "uzl"],
      "note": "uzol, uzla, uzly, uzlov"
    },
    "edge": {
      "use": "spojenie",
      "match": ["spojen"],
      "except": [
        "shortcuts.mouse.boundary",
        "menu.leftEdges",
        "menu.rightEdges",
        "menu.topEdges",
        "menu.bottomEdges",
        "chrome.gatewaysLoadBalancersAndEdgeNetworksInFrontOfServices",
        "chrome.peopleDevicesAndExternalSystemsAtTheEdgeOfThe",
        "stencil.vercelDescription",
        "stencil.netlifyDescription",
        "stencil.cloudflareWorkersDescription",
        "stencil.subtitleEdgeFunction",
        "stencil.supabaseDescription",
        "stencil.azureFrontDoorDescription",
        "stencil.cloudflareDescription",
        "stencil.envoyDescription",
        "stencil.genericCdnDescription",
        "stencil.subtitleEdge",
        "stencil.genericRouterDescription",
        "stencil.ciscoIsrDescription",
        "stencil.subtitleEdgeRouter",
        "stencil.juniperMxDescription",
        "stencil.clientIotDescription"
      ],
      "note": "In shortcuts.mouse.boundary 'edge' is the boundary's border (okraj)."
    },
    "stencil": {
      "use": "vzorkovnica",
      "match": ["vzorkovn"],
      "note": "Visio's Slovak word; one item is „prvok vzorkovnice“."
    },
    "boundary": {
      "use": "hranica",
      "match": ["hranic"]
    },
    "simulation": {
      "use": "simulácia",
      "match": ["simulác"]
    },
    "live": {
      "use": "naživo",
      "match": ["naživo"],
      "note": "zobrazenie naživo"
    },
    "present": {
      "use": "prezentovať",
      "match": ["prezent"],
      "note": "Prezentovať, prezentácia"
    },
    "embed": {
      "use": "vložiť",
      "match": ["vlož"],
      "note": "vloženie (noun), vložiť (verb)"
    },
    "share link": {
      "use": "odkaz na zdieľanie",
      "match": ["odkaz"]
    },
    "export": {
      "use": "exportovať",
      "match": ["export"]
    },
    "import": {
      "use": "importovať",
      "match": ["import"]
    },
    "private": {
      "use": "súkromný",
      "match": ["súkrom"],
      "avoid": ["dôvern"],
      "note": "súkromný diagram; súkromie (privacy)"
    },
    "this device": {
      "use": "toto zariadenie",
      "match": ["zariaden"],
      "avoid": ["počítač"]
    },
    "capacity": {
      "use": "kapacita",
      "match": ["kapacit"]
    },
    "checks": {
      "use": "kontroly",
      "match": ["kontrol"]
    },
    "annotation": {
      "use": "anotácia",
      "match": ["anotáci"]
    },
    "shard": {
      "use": "Shardy",
      "match": ["Shardy"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "binding": {
      "use": "Väzba",
      "match": ["Väzba", "Väzby"],
      "note": "P2 broker vocabulary; singular and plural forms."
    },
    "firewall": {
      "use": "firewall"
    }
  },
  "keys": {
    "ctrl": "Ctrl",
    "shift": "Shift",
    "alt": "Alt",
    "delete": "Del",
    "backspace": "Backspace",
    "escape": "Esc",
    "enter": "Enter",
    "tab": "Tab",
    "space": "Medzerník",
    "drag": "Ťahanie"
  }
}
