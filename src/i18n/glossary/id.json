{
  "language": "id",
  "register": "Anda (capital A)",
  "quotes": "“…”",
  "notes": [
    "Buttons and menu items use the imperative base form as in Microsoft and Google Indonesian UIs (Simpan, Buka, Tutup, Batal); sentence case.",
    "Standard spelling per KBBI: antrean (not antrian), topik, konsumen, produsen; tautan for link, sematkan for embed.",
    "Developers keep dead-letter queue, throughput, consumer group, offset, backlog, node and broker in English.",
    "Sentences end with a full stop; keep the ellipsis … and the · separator."
  ],
  "terms": {
    "topic": { "use": "topik", "match": ["topik"], "avoid": ["tema"], "note": "tema is the colour theme." },
    "queue": { "use": "antrean", "match": ["antrean"], "avoid": ["antrian"], "note": "KBBI spelling." },
    "consumer": { "use": "konsumen", "match": ["konsumen"] },
    "consumer group": { "use": "consumer group", "keepEnglish": true, "match": ["consumer group"] },
    "producer": { "use": "produsen", "match": ["produsen"] },
    "partition": { "use": "partisi", "match": ["partisi"] },
    "broker": { "use": "broker", "keepEnglish": true, "match": ["broker"] },
    "dead-letter queue": {
      "use": "dead-letter queue",
      "keepEnglish": true,
      "match": ["dead-letter queue", "dlq"]
    },
    "throughput": { "use": "throughput", "keepEnglish": true, "match": ["throughput"] },
    "latency": { "use": "latensi", "match": ["latensi"] },
    "replica": { "use": "replika", "match": ["replika"] },
    "load balancer": { "use": "penyeimbang beban", "match": ["penyeimbang beban", "load balancer"] },
    "gateway": { "use": "gateway", "keepEnglish": true, "match": ["gateway"] },
    "cache": { "use": "cache", "keepEnglish": true, "match": ["cache"] },
    "message": { "use": "pesan", "match": ["pesan"] },
    "event": { "use": "event", "keepEnglish": true, "match": ["event", "peristiwa"] },
    "subscription": { "use": "langganan", "match": ["langganan", "subscription"] },
    "offset": { "use": "offset", "keepEnglish": true, "match": ["offset"] },
    "backlog": { "use": "backlog", "keepEnglish": true, "match": ["backlog"] },
    "retry": { "use": "coba lagi", "match": ["coba lagi", "coba ulang"] },
    "diagram": { "use": "diagram", "match": ["diagram"] },
    "node": {
      "use": "node",
      "keepEnglish": true,
      "match": ["node"],
      "note": "Developers say node; simpul is textbook."
    },
    "edge": {
      "use": "koneksi",
      "match": ["koneksi"],
      "except": ["shortcuts.mouse.boundary"],
      "note": "The line between two nodes. In shortcuts.mouse.boundary 'edge' is the boundary's rim (tepi)."
    },
    "stencil": { "use": "stensil", "match": ["stensil"], "note": "Visio's Indonesian word." },
    "boundary": { "use": "batas", "match": ["batas"], "avoid": ["grup", "kelompok"], "note": "Never 'group'." },
    "simulation": { "use": "simulasi", "match": ["simulasi"] },
    "live": {
      "use": "Live",
      "keepEnglish": true,
      "match": ["live"],
      "note": "The mode's name: mode Live, tampilan Live."
    },
    "present": { "use": "presentasi", "match": ["presentasi"], "note": "Presentasikan for the button." },
    "embed": { "use": "sematkan", "match": ["semat"], "note": "sematan for the noun." },
    "share link": { "use": "tautan berbagi", "match": ["tautan berbagi"] },
    "export": { "use": "ekspor", "match": ["ekspor"] },
    "import": { "use": "impor", "match": ["impor"] },
    "private": { "use": "pribadi", "match": ["pribadi"], "avoid": ["rahasia"] },
    "this device": { "use": "perangkat ini", "match": ["perangkat ini"], "avoid": ["komputer", "lokal"] },
    "capacity": { "use": "kapasitas", "match": ["kapasitas"] },
    "checks": { "use": "pemeriksaan", "match": ["pemeriksaan", "periksa"] },
    "annotation": { "use": "anotasi", "match": ["anotasi"] }
  }
}
