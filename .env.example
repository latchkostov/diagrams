# Google Drive integration (optional). Copy to .env.local (git-ignored) and fill in.
# Without both VITE_GOOGLE_CLIENT_ID and VITE_GOOGLE_API_KEY, every Drive menu item is hidden
# and no Google script is ever loaded. Step-by-step setup: docs/INTEROP.md, "Google Drive setup".
#
# These values are baked into the static build at `vite build` time and are visible to anyone who
# opens the site. That is expected and safe for these two: the OAuth client id is public by design,
# and the API key is locked to the Picker API and to your site's referrers.

# OAuth 2.0 Client ID (type "Web application"), e.g. 123456789012-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# API key restricted to the Google Picker API + HTTP referrers
VITE_GOOGLE_API_KEY=

# Optional: Cloud project NUMBER (not the project id). Defaults to the numeric prefix of the client id.
VITE_GOOGLE_APP_ID=
