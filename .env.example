# ---- Self-hosting (docs/SELF-HOSTING.md) ----
# Each switch is off unless set to 1. `pnpm build:internal` sets the first, third and fifth for you.
# VITE_DISABLE_SHARE_LINKS=1   no share links, links with a password or embed codes
# VITE_DISABLE_LINK_OPEN=1     links people send (#d=, #e=) don't open
# VITE_DISABLE_AI_TOOLS=1      no tools for browser agents (WebMCP), Copy for AI or copied prompts
# VITE_DISABLE_ONDEVICE=1      no on-device model (Chrome's built-in one)
# VITE_PRIVATE_BY_DEFAULT=1    "New diagrams are private" starts on
# VITE_BRAND_NAME=Acme Diagrams (internal)
# VITE_ENABLE_COLLAB=1         Edit together (rooms); off unless set (livediagrams.dev sets it); needs share links
# Where a room finds the others (unset: the two approved public trackers and Cloudflare STUN, no TURN):
# VITE_COLLAB_TRACKERS=wss://tracker.example.com
# VITE_COLLAB_STUN=stun:stun.example.com:3478          (or none)
# VITE_COLLAB_TURN=turns:turn.example.com:5349         with the two below (visible in the page, like every value)
# VITE_COLLAB_TURN_USERNAME=
# VITE_COLLAB_TURN_CREDENTIAL=

# Optional cloud storage. Every provider is optional: with none of these set (the default), the app is
# fully usable, every cloud menu entry is hidden, and no Google, Microsoft or Dropbox code or request is
# ever loaded. Set only the ones you want. Step-by-step setup: docs/INTEROP.md, "Storage providers".
#
# Local dev: copy this file to .env.local (git-ignored) and restart `pnpm dev`.
# Production (Vercel): Project → Settings → Environment Variables, then redeploy.
#
# Values are baked into the static build at `vite build` time and are visible to anyone who opens the
# site. That is expected and safe: OAuth client ids and app keys are public for PKCE apps, and the
# Google API key is locked to the Picker API and your site's referrers. Never put a client secret or
# app secret here: none of these providers needs one.

# ---- Google Drive (needs both) ----
# OAuth 2.0 Client ID (type "Web application"), e.g. 123456789012-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
# API key restricted to the Google Picker API + HTTP referrers
VITE_GOOGLE_API_KEY=
# Optional: Cloud project NUMBER (not the project id). Defaults to the numeric prefix of the client id.
VITE_GOOGLE_APP_ID=

# ---- OneDrive ----
# Entra ID "Application (client) ID" (a GUID) of a Single-page application registration.
VITE_ONEDRIVE_CLIENT_ID=
# Optional: common (default; personal and work accounts), consumers, organizations, or a tenant id.
VITE_ONEDRIVE_TENANT=

# ---- Dropbox ----
# App key of a Scoped access, App folder app with PKCE allowed (never the app secret).
VITE_DROPBOX_APP_KEY=
