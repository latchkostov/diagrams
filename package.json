{
  "name": "diagrams",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "dev": "vite",
    "build": "node scripts/gen-schemas.mjs && tsc --noEmit && vite build",
    "schemas": "node scripts/gen-schemas.mjs",
    "skill:release": "node scripts/skill-release.mjs",
    "skill:check": "node scripts/skill-release.mjs --check",
    "i18n": "node scripts/i18n.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/parity && tsc --noEmit -p tests/bench && pnpm --filter @livediagrams/server typecheck && pnpm --filter @livediagrams/confluence-forge typecheck",
    "typecheck:legacy": "tsc6 --noEmit && tsc6 --noEmit -p tests/parity && tsc6 --noEmit -p tests/bench",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && eslint . && vitest run && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "parity": "node scripts/parity.mjs",
    "parity:update": "node scripts/parity.mjs --update",
    "parity:node": "node scripts/parity.mjs --tier node",
    "test:engines": "playwright test -c tests/engines/playwright.config.ts",
    "parity:browser": "node scripts/parity.mjs --tier browser",
    "size": "pnpm build:viewer-bundle && node scripts/bundle-budget.mjs && pnpm --filter @livediagrams/confluence-forge build",
    "bench": "node scripts/bench/run.mjs",
    "bench:gates": "node scripts/bench/run.mjs --mode gates",
    "bench:quick": "node scripts/bench/run.mjs --mode quick",
    "bench:prepare": "node scripts/bench/run.mjs --only workloads",
    "bench:node": "node scripts/bench/run.mjs --only node",
    "bench:ui": "node scripts/bench/run.mjs --only ui",
    "bench:sim": "node scripts/bench/run.mjs --only node,ui --node sim --ui live",
    "bench:bundle": "node scripts/bench/run.mjs --only bundle",
    "bench:compare": "node scripts/bench/compare.mjs",
    "build:viewer-bundle": "node scripts/build-viewer-bundle.mjs",
    "build:internal": "node scripts/build-internal.mjs",
    "headers:self-host": "node scripts/headers-self-host.mjs",
    "self-host:verify": "node scripts/verify-instance.mjs",
    "self-host:prepare": "node scripts/prepare-host-site.mjs",
    "self-host:image": "node scripts/build-host-image.mjs",
    "self-host:smoke": "node scripts/self-host-smoke.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "review": "bash scripts/review/run.sh",
    "notes": "node scripts/notes.mjs",
    "regen": "pnpm schemas && pnpm skill:release && pnpm i18n check",
    "sync": "node scripts/sync.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@xyflow/react": "^12.8.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "homepage": "https://www.livediagrams.dev"
}
