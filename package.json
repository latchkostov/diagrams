{
  "name": "diagrams",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-schemas.mjs && tsc --noEmit && vite build",
    "schemas": "node scripts/gen-schemas.mjs",
    "skill:release": "node scripts/skill-release.mjs",
    "skill:check": "node scripts/skill-release.mjs --check",
    "i18n": "node scripts/i18n.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/parity",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && eslint . && vitest run && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "parity": "node scripts/parity.mjs",
    "parity:update": "node scripts/parity.mjs --update",
    "parity:node": "node scripts/parity.mjs --tier node",
    "parity:browser": "node scripts/parity.mjs --tier browser",
    "size": "node scripts/bundle-budget.mjs",
    "build:internal": "node scripts/build-internal.mjs",
    "headers:self-host": "node scripts/headers-self-host.mjs",
    "self-host:verify": "node scripts/verify-instance.mjs",
    "self-host:prepare": "node scripts/prepare-host-site.mjs",
    "self-host:image": "node scripts/build-host-image.mjs",
    "self-host:smoke": "node scripts/self-host-smoke.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "review": "bash scripts/review/run.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@xyflow/react": "^12.8.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@10.0.0",
  "homepage": "https://www.livediagrams.dev"
}
