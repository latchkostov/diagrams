{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.livediagrams.dev/schema/diagram.v2.json",
  "title": "Live Diagrams planning file (diagrams/v2)",
  "description": "A .diagram.json file for Live Diagrams (https://www.livediagrams.dev). Coordinates are canvas pixels. The AI panel's Advanced paste box also accepts a file without x/y (it lays the nodes out) and plain-word stencils such as 'Kafka topic'.",
  "type": "object",
  "required": [
    "format",
    "title",
    "nodes",
    "edges",
    "planning"
  ],
  "properties": {
    "format": {
      "const": "diagrams/v2"
    },
    "planning": {
      "type": "object",
      "required": [
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "enum": [
            "p1",
            "p2",
            "p3"
          ]
        },
        "sharedQuotas": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "unit",
              "amount",
              "windowMs",
              "algorithm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "unit": {
                "enum": [
                  "requests",
                  "tokens",
                  "inputTokens",
                  "outputTokens",
                  "costPoints",
                  "bytes"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0.000001,
                "maximum": 1000000000000
              },
              "windowMs": {
                "type": "number",
                "minimum": 1,
                "maximum": 86400000
              },
              "algorithm": {
                "type": "string",
                "enum": [
                  "token-bucket"
                ]
              },
              "burst": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "sharedGroup": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "sharedAllocations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "maxInFlight"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxInFlight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "color": {
      "type": "string",
      "pattern": "^(?:white|neutral|yellow|green|blue|purple|red|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$",
      "description": "Background canvas tint colour (hex or predefined annotation color id)."
    },
    "direction": {
      "type": "string",
      "enum": [
        "LR",
        "TB"
      ],
      "default": "LR",
      "description": "Main flow direction."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Boundary"
      },
      "description": "Boundaries (boxes around nodes)."
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Annotation"
      }
    },
    "simulations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Simulation"
      }
    },
    "layerOrder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Back-to-front order of node and annotation ids."
    },
    "private": {
      "type": "boolean",
      "description": "true for a Private diagram: the app keeps it on the device (no share links, no cloud saves, no AI tools) and it stays private when opened again. Agents must not share or upload a file that has it."
    },
    "checks": {
      "$ref": "#/$defs/Checks"
    }
  },
  "$defs": {
    "Checks": {
      "type": "object",
      "description": "Architecture checks a person turned off or ignored for this diagram. Only people change it: agents report findings (check_diagram) and fix them, never silence them.",
      "properties": {
        "off": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,49}$"
          },
          "description": "Rule ids turned off for this diagram, e.g. 'dead-letter'."
        },
        "ignore": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": [
              "rule",
              "target"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,49}$"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "The finding's element id. Dropped when that element is removed."
              },
              "reason": {
                "type": "string",
                "maxLength": 200,
                "description": "Why it's fine here."
              }
            }
          }
        }
      }
    },
    "Node": {
      "type": "object",
      "required": [
        "id",
        "stencil",
        "label",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique across nodes, edges, boundaries and annotations: they share one id space."
        },
        "stencil": {
          "type": "string",
          "description": "A stencil id from https://www.livediagrams.dev/schema/stencils.json, e.g. 'kafka.topic'. Unknown ids render as a generic box."
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "sublabel": {
          "type": "string",
          "maxLength": 200,
          "description": "Second line, e.g. a topic name."
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "group": {
          "type": "string",
          "description": "Id of the boundary it sits in."
        },
        "props": {
          "$ref": "#/$defs/NodeProps"
        }
      }
    },
    "NodeProps": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quotas": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "unit",
                  "amount",
                  "windowMs",
                  "algorithm"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "unit": {
                    "enum": [
                      "requests",
                      "tokens",
                      "inputTokens",
                      "outputTokens",
                      "costPoints",
                      "bytes"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0.000001,
                    "maximum": 1000000000000
                  },
                  "windowMs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 86400000
                  },
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "token-bucket"
                    ]
                  },
                  "burst": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "sharedGroup": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            },
            "maxInFlight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "sharedConcurrency": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "latencyMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 600000
            },
            "errorRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "costPerRequest": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1
                },
                "tokens": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "inputTokens": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "outputTokens": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "costPoints": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "bytes": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              }
            }
          }
        },
        "endpoints": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "method",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "OPTIONS",
                  "TRACE"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^/"
              },
              "behaviour": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quotas": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "unit",
                        "amount",
                        "windowMs",
                        "algorithm"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "unit": {
                          "enum": [
                            "requests",
                            "tokens",
                            "inputTokens",
                            "outputTokens",
                            "costPoints",
                            "bytes"
                          ]
                        },
                        "amount": {
                          "type": "number",
                          "minimum": 0.000001,
                          "maximum": 1000000000000
                        },
                        "windowMs": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 86400000
                        },
                        "algorithm": {
                          "type": "string",
                          "enum": [
                            "token-bucket"
                          ]
                        },
                        "burst": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000000000000
                        },
                        "sharedGroup": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    }
                  },
                  "maxInFlight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "sharedConcurrency": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "latencyMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "errorRate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "costPerRequest": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "requests": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 1
                      },
                      "tokens": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "inputTokens": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "outputTokens": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "costPoints": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "bytes": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "scaling": {
          "type": "string",
          "enum": [
            "fixed",
            "auto"
          ]
        },
        "maxConcurrency": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "preset": {
          "type": "string",
          "enum": [
            "processor-lesson",
            "device-size",
            "lambda-account",
            "stripe-live",
            "stripe-sandbox",
            "api-gateway-account",
            "managed-measured"
          ]
        },
        "presetRevision": {
          "type": "string",
          "enum": [
            "1",
            "2026-10-14"
          ]
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "querySlots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "ingestUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "ratePerSec": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 600000
        },
        "concurrency": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "replicas": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "failureRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retry": {
          "type": "string",
          "enum": [
            "requeue",
            "inplace"
          ]
        },
        "retryBackoffMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 600000
        },
        "maxDeliveryCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "partitions": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "messageType": {
          "type": "string"
        },
        "emits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "size": {
          "type": "string",
          "enum": [
            "branch",
            "campus",
            "datacentre"
          ]
        },
        "gbps": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "messageKB": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000000
        },
        "ha": {
          "type": "string",
          "enum": [
            "standalone",
            "active-standby",
            "active-active"
          ]
        },
        "failoverMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 600000
        },
        "healthChecks": {
          "type": "boolean"
        }
      }
    },
    "Edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique across nodes, edges, boundaries and annotations: they share one id space."
        },
        "from": {
          "type": "string",
          "description": "Node id (or a shape annotation's id)."
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "async",
            "sync"
          ],
          "default": "async",
          "description": "async = messages/events (dashed); sync = request/response (solid). Only meaningful for flows."
        },
        "relation": {
          "type": "string",
          "enum": [
            "flow",
            "config",
            "secret",
            "identity",
            "telemetry",
            "deploy",
            "depends"
          ],
          "default": "flow",
          "description": "What the connection means. flow carries messages or requests; the others are dependencies (dotted, no traffic, ignored by the simulation) and point from the thing that needs it to the dependency: config, secret, identity (gets tokens from), telemetry (reports to), deploy (from the actor to its target), depends."
        },
        "relationOrigin": {
          "type": "string",
          "enum": [
            "inferred",
            "explicit"
          ],
          "description": "Who set relation. inferred: from the stencils at its ends, so it follows them when a node's stencil changes. explicit: chosen on purpose, never changed by a stencil change. Omitted: a flow becomes the dependency its ends imply when a stencil changes; a dependency stays."
        },
        "sourceSide": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "description": "Side of the from node it attaches to. Omitted = chosen from the positions."
        },
        "targetSide": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "description": "Side of the to node it attaches to."
        },
        "props": {
          "$ref": "#/$defs/EdgeProps"
        }
      }
    },
    "EdgeProps": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "caller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deadlineMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 600000
            },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxAttempts",
                "backoffMs",
                "strategy",
                "retryOn"
              ],
              "properties": {
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "backoffMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "strategy": {
                  "enum": [
                    "fixed",
                    "exponential"
                  ]
                },
                "jitter": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "retryOn": {
                  "type": "array",
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "throttled",
                      "transient",
                      "timeout"
                    ]
                  }
                },
                "idempotent": {
                  "type": "boolean"
                }
              }
            },
            "poolConnections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "group": {
          "type": "string"
        },
        "groupOrigin": {
          "type": "string",
          "enum": [
            "inferred"
          ]
        },
        "share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dlq": {
          "type": "boolean"
        },
        "travelMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 600000
        },
        "networkDelayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 600000
        },
        "emits": {
          "type": "string"
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "boolean"
        },
        "settings": {
          "type": "array",
          "maxItems": 200,
          "description": "Config connections only: the settings it reads. secret = the value is a reference to a secret store (e.g. a Key Vault reference). Names only, never values.",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 200
              },
              "secret": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "Boundary": {
      "type": "object",
      "required": [
        "id",
        "label",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique across nodes, edges, boundaries and annotations: they share one id space."
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "tone": {
          "type": "string",
          "pattern": "^(?:azure|aws|gcp|k8s|onprem|neutral|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "group": {
          "type": "string",
          "description": "Id of the outer boundary it sits in."
        }
      }
    },
    "Annotation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text",
        "x",
        "y",
        "width",
        "height"
      ],
      "description": "Documentation only: never part of the simulation.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique across nodes, edges, boundaries and annotations: they share one id space."
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "note",
            "zone",
            "shape"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "rounded",
            "ellipse",
            "diamond",
            "cylinder"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^(?:white|neutral|yellow|green|blue|purple|red|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
        },
        "textSize": {
          "type": "string",
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ]
        },
        "group": {
          "type": "string",
          "description": "Id of the boundary it sits in."
        }
      }
    },
    "Simulation": {
      "type": "object",
      "required": [
        "id",
        "title",
        "traffic"
      ],
      "description": "A saved, scripted run replayed in live view. Times are milliseconds from the start.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "seed": {
          "type": "integer"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "description": "Real messages per simulated message."
        },
        "multipliers": {
          "type": "object",
          "properties": {
            "traffic": {
              "type": "number"
            },
            "capacity": {
              "type": "number"
            }
          }
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "description": "Auto-stop after this long."
        },
        "setup": {
          "type": "object",
          "properties": {
            "status": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "up",
                  "paused",
                  "down"
                ]
              }
            },
            "props": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/NodeProps"
              }
            }
          }
        },
        "traffic": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "node",
              "shape"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "node": {
                "type": "string",
                "description": "Node id where messages start."
              },
              "messageType": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "shape": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "count"
                    ],
                    "properties": {
                      "kind": {
                        "const": "burst"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "atMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      },
                      "spreadMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "ratePerSec",
                      "durationMs"
                    ],
                    "properties": {
                      "kind": {
                        "const": "constant"
                      },
                      "ratePerSec": {
                        "type": "number",
                        "minimum": 0,
                        "description": "per second"
                      },
                      "fromMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      },
                      "durationMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "stages"
                    ],
                    "properties": {
                      "kind": {
                        "const": "ramp"
                      },
                      "fromMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      },
                      "startRate": {
                        "type": "number",
                        "minimum": 0,
                        "description": "per second"
                      },
                      "stages": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "durationMs",
                            "targetRate"
                          ],
                          "properties": {
                            "durationMs": {
                              "type": "number",
                              "minimum": 0,
                              "description": ""
                            },
                            "targetRate": {
                              "type": "number",
                              "minimum": 0,
                              "description": "per second"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "baseRate",
                      "peakRate",
                      "atMs",
                      "peakMs",
                      "durationMs"
                    ],
                    "properties": {
                      "kind": {
                        "const": "spike"
                      },
                      "baseRate": {
                        "type": "number",
                        "minimum": 0,
                        "description": "per second"
                      },
                      "peakRate": {
                        "type": "number",
                        "minimum": 0,
                        "description": "per second"
                      },
                      "atMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      },
                      "peakMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      },
                      "durationMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "atMs",
              "action"
            ],
            "properties": {
              "atMs": {
                "type": "number",
                "minimum": 0,
                "description": ""
              },
              "action": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "do",
                      "node",
                      "status"
                    ],
                    "properties": {
                      "do": {
                        "const": "status"
                      },
                      "node": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "up",
                          "paused",
                          "down"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "do",
                      "node",
                      "props"
                    ],
                    "properties": {
                      "do": {
                        "const": "props"
                      },
                      "node": {
                        "type": "string"
                      },
                      "props": {
                        "$ref": "#/$defs/NodeProps"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "do",
                      "node",
                      "count"
                    ],
                    "properties": {
                      "do": {
                        "const": "inject"
                      },
                      "node": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "messageType": {
                        "type": "string"
                      },
                      "spreadMs": {
                        "type": "number",
                        "minimum": 0,
                        "description": ""
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "do",
                      "text"
                    ],
                    "properties": {
                      "do": {
                        "const": "note"
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "focus": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "pause": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "do",
                      "node"
                    ],
                    "properties": {
                      "do": {
                        "const": "trace"
                      },
                      "node": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "metric",
              "op",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "metric": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "node",
                      "field"
                    ],
                    "properties": {
                      "node": {
                        "type": "string"
                      },
                      "field": {
                        "type": "string",
                        "enum": [
                          "processed",
                          "backlog",
                          "inFlight",
                          "failed",
                          "deadLettered",
                          "dropped",
                          "blocked",
                          "rejected",
                          "throughput",
                          "lag"
                        ]
                      },
                      "group": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "system"
                    ],
                    "properties": {
                      "system": {
                        "const": "inSystem"
                      }
                    }
                  }
                ]
              },
              "op": {
                "type": "string",
                "enum": [
                  "<",
                  "<=",
                  "==",
                  ">=",
                  ">"
                ]
              },
              "value": {
                "type": "number"
              },
              "when": {
                "type": "string",
                "enum": [
                  "always",
                  "eventually",
                  "end",
                  "at"
                ],
                "default": "end"
              },
              "atMs": {
                "type": "number",
                "minimum": 0,
                "description": ""
              }
            }
          }
        }
      }
    }
  }
}
