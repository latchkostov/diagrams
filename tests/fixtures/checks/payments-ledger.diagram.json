      "sublabel": "Charges cards",
      "x": 300,
      "y": 120
    },
    {
      "id": "payments",
      "stencil": "kafka.topic",
      "label": "payments.v1",
      "sublabel": "Avro · key: orderId",
      "x": 620,
      "y": 120
    },
    { "id": "ledger", "stencil": "azure.functions", "label": "Ledger writer", "x": 940, "y": 120 },
    {
      "id": "db",
      "stencil": "azure.cosmos-db",
      "label": "Ledger",
      "sublabel": "One entry per payment",
      "x": 1260,
      "y": 120
    },
    {
      "id": "kv",
      "stencil": "azure.key-vault",
