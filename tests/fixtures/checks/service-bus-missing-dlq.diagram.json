{
  "format": "diagrams/v1",
  "title": "Invoice intake without a ledger DLQ",
  "description": "Partner invoices fan out through filtered Service Bus subscriptions; commands use retries and dead lettering.",
  "direction": "LR",
  "groups": [
    {
      "id": "azure",
      "label": "Azure · enterprise integration",
      "tone": "azure",
      "x": 380,
      "y": 0,
      "width": 2240,
      "height": 632
    }
  ],
  "nodes": [
    {
      "id": "partner",
      "stencil": "client.partner",
      "label": "Contoso ERP",
      "sublabel": "Invoice integration · OAuth2",
      "x": 40,
      "y": 280,
      "props": {
        "ratePerSec": 8
      }
    },
    {
      "id": "apim",
      "stencil": "azure.api-management",
      "label": "Partner API",
      "sublabel": "/v1/invoices · JWT validation",
      "x": 420,
      "y": 280,
      "group": "azure",
      "props": {}
    },
    {
      "id": "ingest",
      "stencil": "azure.functions",
      "label": "Invoice intake",
      "sublabel": "Validate · normalize · publish",
      "x": 800,
      "y": 280,
      "group": "azure",
      "props": {
        "concurrency": 64,
        "latencyMs": 150,
        "emits": {
          "InvoiceSubmitted": "InvoiceAccepted"
        }
      }
    },
    {
      "id": "invoices",
      "stencil": "azure.service-bus.topic",
      "label": "invoices",
      "sublabel": "InvoiceAccepted · session: tenantId",
      "x": 1180,
      "y": 280,
      "group": "azure",
      "props": {
        "sessionEnabled": true,
        "partitions": 64
      }
    },
    {
      "id": "approval-sub",
      "stencil": "generic.queue",
      "label": "approval-workflow",
      "sublabel": "Subscription · amount > 10000",
      "x": 1560,
      "y": 160,
      "group": "azure",
      "props": {
        "filter": "amount > 10000",
        "maxDeliveryCount": 10
      }
    },
    {
      "id": "posting-sub",
      "stencil": "generic.queue",
      "label": "ledger-posting",
      "sublabel": "Subscription · all accepted invoices",
      "x": 1560,
      "y": 400,
      "group": "azure",
      "props": {
        "maxDeliveryCount": 10
      }
    },
    {
      "id": "workflow",
      "stencil": "azure.logic-apps",
      "label": "Invoice approval",
      "sublabel": "Finance approval workflow",
      "x": 1940,
      "y": 160,
      "group": "azure",
      "props": {
        "concurrency": 64,
        "latencyMs": 150,
        "emits": "PostInvoice"
      }
    },
    {
      "id": "worker",
      "stencil": "azure.container-apps",
      "label": "Ledger worker",
      "sublabel": "KEDA · group: ledger-posting",
      "x": 1940,
      "y": 400,
      "group": "azure",
      "props": {
        "group": "ledger-posting",
        "concurrency": 64,
        "latencyMs": 150,
        "emits": "InvoicePosted"
      }
    },
    {
      "id": "commands",
      "stencil": "azure.service-bus.queue",
      "label": "invoice.commands",
      "sublabel": "PostInvoice · session: tenantId",
      "x": 2320,
      "y": 160,
      "group": "azure",
      "props": {
        "maxDeliveryCount": 5,
        "lockDurationSec": 60,
        "sessionEnabled": true
      }
    },
    {
      "id": "dlq",
      "stencil": "azure.service-bus.queue",
      "label": "invoice.commands DLQ",
      "sublabel": "$DeadLetterQueue · operator replay",
      "x": 2320,
      "y": 40,
      "group": "azure",
      "props": {
        "isDeadLetter": true
      }
    },
    {
      "id": "cosmos",
      "stencil": "azure.cosmos-db",
      "label": "Invoice ledger",
      "sublabel": "Partition key: /tenantId",
      "x": 2320,
      "y": 400,
      "group": "azure",
      "props": {}
    },
    {
      "id": "blob",
      "stencil": "azure.blob-storage",
      "label": "Invoice originals",
      "sublabel": "invoices-raw · immutable archive",
      "x": 1180,
      "y": 520,
      "group": "azure",
      "props": {}
    },
    {
      "id": "vault",
      "stencil": "azure.key-vault",
      "label": "Integration secrets",
      "sublabel": "ERP credentials · managed identity",
      "x": 800,
      "y": 40,
      "group": "azure",
      "props": {}
    },
    {
      "id": "insights",
      "stencil": "azure.app-insights",
      "label": "Integration telemetry",
      "sublabel": "Trace by invoiceId · DLQ alerts",
      "x": 800,
      "y": 520,
      "group": "azure",
      "props": {}
    }
  ],
  "edges": [
    {
      "id": "partner-to-apim",
      "from": "partner",
      "to": "apim",
      "label": "HTTPS",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "apim-to-ingest",
      "from": "apim",
      "to": "ingest",
      "label": "POST /v1/invoices",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "ingest-to-invoices",
      "from": "ingest",
      "to": "invoices",
      "label": "InvoiceAccepted",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "invoices-to-approval-sub",
      "from": "invoices",
      "to": "approval-sub",
      "label": "amount > 10000",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": ["InvoiceHighValue"],
        "group": "finance-approval"
      }
    },
    {
      "id": "invoices-to-posting-sub",
      "from": "invoices",
      "to": "posting-sub",
      "label": "All invoices",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": ["InvoiceAccepted"],
        "group": "ledger-posting"
      }
    },
    {
      "id": "approval-sub-to-workflow",
      "from": "approval-sub",
      "to": "workflow",
      "label": "Peek-lock delivery",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "posting-sub-to-worker",
      "from": "posting-sub",
      "to": "worker",
      "label": "Peek-lock delivery",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": ["InvoiceAccepted"]
      }
    },
    {
      "id": "workflow-to-commands",
      "from": "workflow",
      "to": "commands",
      "label": "PostInvoice",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "commands-to-worker",
      "from": "commands",
      "to": "worker",
      "label": "Execute command",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": ["PostInvoice"]
      }
    },
    {
      "id": "commands-to-dlq",
      "from": "commands",
      "to": "dlq",
      "label": "After 5 failed deliveries",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "worker-to-cosmos",
      "from": "worker",
      "to": "cosmos",
      "label": "Upsert ledger",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "ingest-to-blob",
      "from": "ingest",
      "to": "blob",
      "label": "Archive original PDF",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "ingest-to-vault",
      "from": "ingest",
      "to": "vault",
      "kind": "sync",
      "relation": "secret"
    },
    {
      "id": "ingest-to-insights",
      "from": "ingest",
      "to": "insights",
      "label": "Traces / exceptions",
      "kind": "async",
      "relation": "telemetry"
    }
  ],
  "simulations": [
    {
      "id": "month-end",
      "title": "Month-end invoice batch",
      "seed": 7,
      "traffic": [
        {
          "id": "batch",
          "node": "ingest",
          "messageType": "InvoiceHighValue",
          "label": "300 high-value month-end invoices",
          "shape": {
            "kind": "burst",
            "count": 300,
            "spreadMs": 3000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "The ERP submits 300 high-value invoices. Only the approval subscription accepts them.",
            "focus": ["partner", "invoices", "approval-sub"]
          }
        },
        {
          "atMs": 5000,
          "action": {
            "do": "note",
            "text": "Approved invoices become PostInvoice commands; originals remain archived.",
            "focus": ["workflow", "commands", "cosmos"]
          }
        }
      ],
      "expectations": [
        {
          "id": "ledger",
          "label": "Ledger",
          "metric": {
            "node": "cosmos",
            "field": "processed"
          },
          "op": "==",
          "value": 300,
          "when": "end"
        },
        {
          "id": "archive",
          "label": "Archive",
          "metric": {
            "node": "blob",
            "field": "processed"
          },
          "op": "==",
          "value": 300,
          "when": "end"
        },
        {
          "id": "approval",
          "label": "Approval",
          "metric": {
            "node": "workflow",
            "field": "processed"
          },
          "op": "==",
          "value": 300,
          "when": "end"
        },
        {
          "id": "no-dlq",
          "label": "No dlq",
          "metric": {
            "node": "commands",
            "field": "deadLettered"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        }
      ],
      "scale": 2
    },
    {
      "id": "poison",
      "title": "Poison invoices",
      "seed": 7,
      "traffic": [
        {
          "id": "poison-batch",
          "node": "ingest",
          "messageType": "InvoiceHighValue",
          "label": "30 malformed posting requests",
          "shape": {
            "kind": "burst",
            "count": 30,
            "spreadMs": 1000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "A schema mismatch makes every ledger attempt fail. Commands are retried five times.",
            "focus": ["worker", "commands"]
          }
        },
        {
          "atMs": 10000,
          "action": {
            "do": "note",
            "text": "Poison commands are quarantined in the DLQ for operator replay.",
            "focus": ["commands", "dlq"],
            "pause": true
          }
        },
        {
          "atMs": 12000,
          "action": {
            "do": "props",
            "node": "worker",
            "props": {
              "failureRate": 0
            }
          }
        }
      ],
      "expectations": [
        {
          "id": "quarantined",
          "label": "Poison invoices reach the DLQ",
          "metric": {
            "node": "commands",
            "field": "deadLettered"
          },
          "op": ">",
          "value": 0,
          "when": "end"
        },
        {
          "id": "dlq-retains",
          "label": "All 30 poison invoices are retained",
          "metric": {
            "node": "dlq",
            "field": "backlog"
          },
          "op": "==",
          "value": 30,
          "when": "end"
        },
        {
          "id": "no-ledger-write",
          "label": "No ledger write",
          "metric": {
            "node": "cosmos",
            "field": "processed"
          },
          "op": "==",
          "value": 0,
          "when": "end"
        }
      ],
      "setup": {
        "props": {
          "worker": {
            "failureRate": 1,
            "retry": "inplace",
            "retryBackoffMs": 100
          }
        }
      },
      "durationMs": 20000,
      "scale": 1
    }
  ]
}
