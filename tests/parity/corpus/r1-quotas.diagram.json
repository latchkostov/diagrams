              ],
              "quotas": [
                {
                  "id": "account",
                  "unit": "requests",
                  "amount": 25,
                  "windowMs": 1000,
                  "algorithm": "token-bucket",
                  "sharedGroup": "account"
                }
              ]
            },
            {
              "id": "search",
              "match": {
                "path": {
                  "kind": "prefix",
                  "value": "/search"
                }
              },
              "targets": [
                {
                  "edgeId": "kong-search",
                  "weight": 1
                }
              ],
              "quotas": [
                {
                  "id": "account",
                  "unit": "requests",
                  "amount": 25,
                  "windowMs": 1000,
                  "algorithm": "token-bucket",
                  "sharedGroup": "account"
                },
                {
                  "id": "search-limit",
                  "unit": "requests",
                  "amount": 15,
                  "windowMs": 1000,
                  "algorithm": "token-bucket"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "orders",
      "stencil": "generic.service",
      "label": "Orders",
