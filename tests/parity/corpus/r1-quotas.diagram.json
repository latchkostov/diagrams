            {
              "routeId": "unused-get",
              "ratePerSec": 0
            }
          ]
        }
      }
    },
    {
      "id": "kong",
      "stencil": "nginx",
      "label": "Gateway",
      "x": 240,
      "y": 120,
      "props": {
        "latencyMs": 5,
        "jitter": 0,
        "routeTable": {
          "rules": [
            {
              "id": "orders",
              "match": {
                "methods": ["POST"],
                "path": {
                  "kind": "exact",
                  "value": "/orders"
                }
              },
              "targets": [
                {
                  "edgeId": "kong-orders",
                  "weight": 90
                },
                {
                  "edgeId": "kong-canary",
                  "weight": 10
