  "title": "R1: rates, quotas and sampling",
  "nodes": [
    {
      "id": "app",
      "stencil": "client.mobile",
      "label": "Mobile app",
      "x": 0,
      "y": 120,
      "props": {
        "ratePerSec": 100,
        "trafficMix": {
          "mode": "rates",
          "entries": [
            {
              "routeId": "orders-post",
              "ratePerSec": 10
