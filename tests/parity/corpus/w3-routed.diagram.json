{
  "format": "diagrams/v2",
  "title": "routed",
  "planning": {
    "revision": "p3-w3",
    "requestRoutes": [
      {
        "id": "page",
        "address": {
          "method": "GET",
          "path": "/pages/a"
        }
      },
      {
        "id": "refused",
        "address": {
          "method": "GET",
          "path": "/blocked"
        }
      }
    ]
  },
  "nodes": [
    {
      "id": "source",
      "stencil": "client.browser",
      "label": "Readers",
      "x": 0,
      "y": 100,
      "props": {
        "ratePerSec": 200,
        "trafficMix": {
          "mode": "shares",
          "entries": [
            {
              "routeId": "page",
              "share": 1
            },
            {
              "routeId": "refused",
              "share": 1
            }
          ]
        }
      }
    },
    {
      "id": "cache",
      "stencil": "generic.cdn",
      "label": "Edge cache",
      "x": 320,
      "y": 100,
      "props": {
        "latencyMs": 0,
        "jitter": 0,
        "cache": {
          "rules": [
            {
              "id": "page",
              "match": {
                "methods": ["GET"],
                "path": {
                  "kind": "template",
                  "value": "/pages/{id}"
                }
              },
              "policy": {
                "ttlMs": 5000,
                "keys": 20
              }
            }
          ]
        },
        "routeTable": {
          "rules": [
            {
              "id": "pages",
              "match": {
                "path": {
                  "kind": "prefix",
                  "value": "/pages/"
                }
              },
              "targets": [
                {
                  "edgeId": "fetch",
                  "weight": 1
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "origin",
      "stencil": "generic.database",
      "label": "Origin",
      "x": 640,
      "y": 100,
      "props": {
        "latencyMs": 50,
        "jitter": 0
      }
    }
  ],
  "edges": [
    {
      "id": "input",
      "from": "source",
      "to": "cache",
      "kind": "sync",
      "props": {
        "travelMs": 10
      }
    },
    {
      "id": "fetch",
      "from": "cache",
      "to": "origin",
      "kind": "sync",
      "props": {
        "travelMs": 10
      }
    }
  ],
  "simulations": [
    {
      "id": "steady",
      "title": "Steady requests",
      "seed": 7,
      "scale": 1,
      "durationMs": 10000,
      "traffic": [
        {
          "node": "source",
          "shape": {
            "kind": "constant",
            "ratePerSec": 200,
            "durationMs": 8000
          }
        }
      ]
    }
  ]
}
