<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-g77dz5" name="A pool of 40">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="A shared Checkout handles payments and order-status requests. Payment calls have forty connections. Blocking pool waits still hold threads; non-blocking waits protect the DB-only status route while payments queue." dg_simulations="[{&quot;id&quot;:&quot;pool-40&quot;,&quot;title&quot;:&quot;A pool of 40&quot;,&quot;description&quot;:&quot;Payment calls wait off-thread for one of forty connections. Order status only calls Orders DB and keeps completing during the slowdown. Payments queued longer than the gateway’s five-second timeout fail there; provider work continues.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:1,&quot;durationMs&quot;:20000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payment&quot;,&quot;factor&quot;:10}}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;status&quot;,&quot;label&quot;:&quot;Order status keeps completing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;expected-shop&quot;,&quot;label&quot;:&quot;shop reports payment failures&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shop&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;expected-gateway&quot;,&quot;label&quot;:&quot;gateway reports payment failures&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;gateway&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;eventually&quot;}]},{&quot;id&quot;:&quot;blocking-pool&quot;,&quot;title&quot;:&quot;Blocking waits still hold threads&quot;,&quot;description&quot;:&quot;The same pool holds waiting threads as well as connections. Order-status work queues behind them. Payments queued longer than the gateway’s five-second timeout fail there; provider work continues.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:1,&quot;durationMs&quot;:20000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payment&quot;,&quot;factor&quot;:10}}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;status&quot;,&quot;label&quot;:&quot;Order status keeps completing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;expected-shop&quot;,&quot;label&quot;:&quot;shop reports payment failures&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shop&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;expected-gateway&quot;,&quot;label&quot;:&quot;gateway reports payment failures&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;gateway&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;eventually&quot;}],&quot;setup&quot;:{&quot;edges&quot;:{&quot;pay&quot;:{&quot;caller&quot;:{&quot;wait&quot;:&quot;blocking&quot;,&quot;poolConnections&quot;:40}}}}}]" dg_planning="{&quot;revision&quot;:&quot;p3-w1&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;checkout&quot;,&quot;label&quot;:&quot;Checkout&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/checkout&quot;}},{&quot;id&quot;:&quot;status&quot;,&quot;label&quot;:&quot;Order status&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/status&quot;}}]}">
