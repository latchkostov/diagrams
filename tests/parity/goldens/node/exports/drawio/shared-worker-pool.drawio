<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-3fte6" name="Two inputs, one worker pool">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Acme merges orders and refunds into one four-slot worker: two consumer policies share capacity, so six events a second build lag despite plentiful partitions." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;shared-slots&quot;,&quot;title&quot;:&quot;Six events, four slots&quot;,&quot;description&quot;:&quot;Both inputs consume the same worker budget; extra partitions cannot create processor slots.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;orders&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:3,&quot;durationMs&quot;:6000}},{&quot;id&quot;:&quot;refunds&quot;,&quot;node&quot;:&quot;refunds&quot;,&quot;messageType&quot;:&quot;RefundRequested&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:3,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Properties shows two Consumes rows, but one 4/s pool. At 6/s total, waiting work grows by about 2/s.&quot;,&quot;focus&quot;:[&quot;worker&quot;,&quot;order-log&quot;,&quot;refund-log&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;order-log-lag-at&quot;,&quot;label&quot;:&quot;order-log: lag &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-log&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:5000},{&quot;id&quot;:&quot;refund-log-lag-at&quot;,&quot;label&quot;:&quot;refund-log: lag &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;refund-log&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:5000},{&quot;id&quot;:&quot;ledger-processed-end&quot;,&quot;label&quot;:&quot;ledger: processed == 36&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ledger&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:36,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;measured-faster&quot;,&quot;title&quot;:&quot;Measured faster work&quot;,&quot;description&quot;:&quot;A 500 ms measured service time doubles the same four-slot pool to 8/s, above the combined 6/s demand.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;orders&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:3,&quot;durationMs&quot;:6000}},{&quot;id&quot;:&quot;refunds&quot;,&quot;node&quot;:&quot;refunds&quot;,&quot;messageType&quot;:&quot;RefundRequested&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:3,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[{&quot;id&quot;:&quot;ledger-processed-end&quot;,&quot;label&quot;:&quot;ledger: processed == 36&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ledger&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:36,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;order-log-lag-end&quot;,&quot;label&quot;:&quot;order-log: lag == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-log&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;refund-log-lag-end&quot;,&quot;label&quot;:&quot;refund-log: lag == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;refund-log&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}],&quot;setup&quot;:{&quot;props&quot;:{&quot;worker&quot;:{&quot;latencyMs&quot;:500}}}}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-orders" label="Acme orders&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;3 orders/s&lt;/span&gt;" dg_id="orders" dg_stencil="generic.webhook" dg_props="{&quot;ratePerSec&quot;:3,&quot;messageType&quot;:&quot;OrderPlaced&quot;}">
