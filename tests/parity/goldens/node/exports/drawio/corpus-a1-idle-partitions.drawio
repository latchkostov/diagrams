<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1qxp14x" name="idle-partitions">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented image-processing pipeline: a Kafka topic buffers uploads while HPA starts workers. The saved burst shows backlog building, replicas becoming ready and the backlog draining within ten simulated seconds. This teaching model explicitly uses a 1 s sync, 1 s metric window, 2 s startup and 30 s downscale stabilization; these are not Kubernetes defaults. Open a worker’s Live details for replica history." dg_simulations="[{&quot;id&quot;:&quot;scenario&quot;,&quot;title&quot;:&quot;idle-partitions&quot;,&quot;seed&quot;:42,&quot;scale&quot;:1,&quot;durationMs&quot;:48000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;burst&quot;,&quot;node&quot;:&quot;source&quot;,&quot;messageType&quot;:&quot;ImageUploaded&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:48,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-source" label="Upload clients" dg_id="source" dg_stencil="client.browser" dg_props="{&quot;ratePerSec&quot;:4}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-uploads" label="Image uploads&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;6 partitions&lt;/span&gt;" dg_id="uploads" dg_stencil="kafka.topic" dg_props="{&quot;partitions&quot;:3}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#7C3AED1A;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="440" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-worker" label="Thumbnail workers" dg_id="worker" dg_stencil="service.go" dg_props="{&quot;replicas&quot;:1,&quot;concurrency&quot;:4,&quot;latencyMs&quot;:250,&quot;jitter&quot;:0,&quot;resources&quot;:{&quot;preset&quot;:&quot;io-service&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;cpuMsPerMessage&quot;:40,&quot;baselineMemoryMiB&quot;:128,&quot;memoryMiBPerMessage&quot;:2,&quot;cpuRequestMilli&quot;:500,&quot;cpuLimitMilli&quot;:1000,&quot;memoryRequestMiB&quot;:256,&quot;memoryLimitMiB&quot;:512,&quot;startup&quot;:{&quot;delayMs&quot;:2000,&quot;jitterFraction&quot;:0},&quot;terminationGraceMs&quot;:30000},&quot;autoscaling&quot;:{&quot;mode&quot;:&quot;on&quot;,&quot;modelRevision&quot;:&quot;a1&quot;,&quot;preset&quot;:&quot;hpa-service&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;controller&quot;:{&quot;kind&quot;:&quot;hpa&quot;,&quot;minReplicas&quot;:8,&quot;maxReplicas&quot;:10,&quot;initialReplicas&quot;:8,&quot;settings&quot;:{&quot;syncMs&quot;:1000,&quot;tolerance&quot;:0.1,&quot;initialReadinessDelayMs&quot;:0,&quot;cpuInitializationPeriodMs&quot;:0,&quot;metrics&quot;:[{&quot;source&quot;:{&quot;kind&quot;:&quot;resource&quot;,&quot;resource&quot;:&quot;cpu&quot;},&quot;target&quot;:{&quot;kind&quot;:&quot;utilization&quot;,&quot;percentOfRequest&quot;:70},&quot;windowMs&quot;:1000,&quot;metricDelayMs&quot;:0}],&quot;up&quot;:{&quot;stabilizationMs&quot;:0,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Pods&quot;,&quot;value&quot;:4,&quot;periodMs&quot;:15000},{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]},&quot;down&quot;:{&quot;stabilizationMs&quot;:30000,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]}}}}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#00ADD81A;strokeColor=#00ADD8;fontSize=12;" vertex="1" parent="1">
