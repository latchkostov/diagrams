        <object id="dg-e-pay" label="" dg_id="pay" dg_kind="sync" dg_props="{&quot;travelMs&quot;:100,&quot;requestRouteId&quot;:&quot;checkout&quot;,&quot;caller&quot;:{&quot;wait&quot;:&quot;non-blocking&quot;,&quot;deadlineMs&quot;:300,&quot;retry&quot;:{&quot;maxAttempts&quot;:3,&quot;backoffMs&quot;:0,&quot;strategy&quot;:&quot;fixed&quot;,&quot;retryOn&quot;:[&quot;throttled&quot;,&quot;transient&quot;,&quot;timeout&quot;]}}}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-checkout" target="dg-n-payments">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-orders-flow" label="" dg_id="orders-flow" dg_kind="async" dg_props="{&quot;travelMs&quot;:100}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#7C8597;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dg-n-checkout" target="dg-n-orders">
