        <object id="dg-n-payments" label="Payments&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;48 threads · 80 ms · 600 attempts/s&lt;/span&gt;" dg_id="payments" dg_stencil="generic.service" dg_props="{&quot;replicas&quot;:4,&quot;concurrency&quot;:12,&quot;latencyMs&quot;:80,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="730" y="166" width="180" height="60" as="geometry" />
