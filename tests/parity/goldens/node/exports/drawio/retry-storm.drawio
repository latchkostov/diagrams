          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#8B5CF61A;strokeColor=#8B5CF6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="730" y="406" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-checkouts" label="" dg_id="checkouts" dg_kind="sync" dg_props="{&quot;travelMs&quot;:100,&quot;requestRouteId&quot;:&quot;checkout&quot;}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-shop" target="dg-n-checkout">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
