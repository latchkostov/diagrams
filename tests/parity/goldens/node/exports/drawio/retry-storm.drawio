<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-10xg3n7" name="A retry storm">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Payments has 48 threads: 600 attempts/s at 80 ms, 50% busy with 300 checkouts/s. A five-second slowdown triggers a retry storm. Jitter stays stuck; a 20% retry budget recovers around 38 seconds in this 60-second run." dg_simulations="[{&quot;id&quot;:&quot;three-quick-retries&quot;,&quot;title&quot;:&quot;Three quick retries&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:60000,&quot;setup&quot;:{&quot;edges&quot;:{&quot;pay&quot;:{&quot;caller&quot;:{&quot;retry&quot;:{&quot;maxAttempts&quot;:3,&quot;backoffMs&quot;:0,&quot;strategy&quot;:&quot;fixed&quot;,&quot;retryOn&quot;:[&quot;throttled&quot;,&quot;transient&quot;,&quot;timeout&quot;]}}}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:60000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0.1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:5}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:1}}},{&quot;atMs&quot;:1200,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Watch Checkout's attempts per request and the Payments queue. At 3 s, Payments slows for five seconds: quick retries pile up. Repeating a POST can run it twice.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:3500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Three attempts amplify the load. The 48 Payments threads can handle 600/s when healthy, but retries approach 900/s.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;At 8 s, Payments is fast again with about 3,600 requests already queued. Timeouts do not cancel that work.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:15000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Over 9,000 requests are queued. The slowdown has gone; the retry storm remains.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;goodput&quot;,&quot;label&quot;:&quot;Shop goodput â‰¥ 270/s at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shop&quot;,&quot;field&quot;:&quot;goodput&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:270,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Payments backlog &lt; 100 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;amplification&quot;,&quot;label&quot;:&quot;Checkout attempts per request &lt; 1.5 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;checkout&quot;,&quot;field&quot;:&quot;amplification&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:1.5,&quot;when&quot;:&quot;end&quot;}],&quot;description&quot;:&quot;Three attempts amplify 300 checkouts/s to about 900 attempts/s. After the slowdown clears at 8 s, the queue keeps growing past 9,000 at 15 s. Goodput stays near zero through 60 s.&quot;},{&quot;id&quot;:&quot;jittered-backoff&quot;,&quot;title&quot;:&quot;Jittered backoff&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:60000,&quot;setup&quot;:{&quot;edges&quot;:{&quot;pay&quot;:{&quot;caller&quot;:{&quot;retry&quot;:{&quot;maxAttempts&quot;:3,&quot;backoffMs&quot;:100,&quot;strategy&quot;:&quot;exponential&quot;,&quot;retryOn&quot;:[&quot;throttled&quot;,&quot;transient&quot;,&quot;timeout&quot;],&quot;maxBackoffMs&quot;:1000,&quot;jitter&quot;:1}}}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:60000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0.1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:5}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:1}}},{&quot;atMs&quot;:1200,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Watch Checkout's attempts per request and the Payments queue. At 3 s, Payments slows for five seconds: jitter spreads retries, but does the queue drain? Repeating a POST can run it twice.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:3500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Jitter spreads the retries. It cannot remove the excess attempts.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;At 8 s, Payments is fast again with about 3,500 requests already queued.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:15000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;About 9,000 requests are queued. Jitter smooths the waves; it does not fix the retry storm.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;goodput&quot;,&quot;label&quot;:&quot;Shop goodput â‰¥ 270/s at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shop&quot;,&quot;field&quot;:&quot;goodput&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:270,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Payments backlog &lt; 100 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;amplification&quot;,&quot;label&quot;:&quot;Checkout attempts per request &lt; 1.5 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;checkout&quot;,&quot;field&quot;:&quot;amplification&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:1.5,&quot;when&quot;:&quot;end&quot;}],&quot;description&quot;:&quot;Full jitter spreads retries but still approaches three attempts per checkout. Payments queues about 9,000 requests at 15 s and stays stuck through 60 s.&quot;},{&quot;id&quot;:&quot;retry-budget&quot;,&quot;title&quot;:&quot;A retry budget&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:60000,&quot;setup&quot;:{&quot;edges&quot;:{&quot;pay&quot;:{&quot;caller&quot;:{&quot;retry&quot;:{&quot;maxAttempts&quot;:3,&quot;backoffMs&quot;:100,&quot;strategy&quot;:&quot;exponential&quot;,&quot;retryOn&quot;:[&quot;throttled&quot;,&quot;transient&quot;,&quot;timeout&quot;],&quot;maxBackoffMs&quot;:1000,&quot;jitter&quot;:1,&quot;budget&quot;:{&quot;percent&quot;:20,&quot;minPerSec&quot;:10}}}}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:60000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0.1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:5}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:1}}},{&quot;atMs&quot;:1200,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Watch Checkout's attempts per request and Shop's goodput. At 3 s, Payments slows for five seconds: the retry budget caps extra calls. Watch its queue drain and goodput recover later in this 60-second run. Repeating a POST can run it twice.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:3500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The budget limits extra attempts over ten seconds, instead of retrying every timeout twice.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;At 8 s, Payments is fast again with about 1,300 queued requests still to finish.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:15000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;About 3,000 requests remain queued. The budget lets abandoned work drain; Shop recovers around 38 s.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;goodput&quot;,&quot;label&quot;:&quot;Shop goodput â‰¥ 270/s at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shop&quot;,&quot;field&quot;:&quot;goodput&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:270,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Payments backlog &lt; 100 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;amplification&quot;,&quot;label&quot;:&quot;Checkout attempts per request &lt; 1.5 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;checkout&quot;,&quot;field&quot;:&quot;amplification&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:1.5,&quot;when&quot;:&quot;end&quot;}],&quot;description&quot;:&quot;A 20% budget limits extra attempts over ten seconds. Queued work peaks around 4,000; Shop recovers to at least 270/s with fewer than 100 queued around 38 s. All chips pass at 60 s.&quot;},{&quot;id&quot;:&quot;circuit-breaker&quot;,&quot;title&quot;:&quot;A circuit breaker&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:60000,&quot;setup&quot;:{&quot;edges&quot;:{&quot;pay&quot;:{&quot;caller&quot;:{&quot;retry&quot;:{&quot;maxAttempts&quot;:3,&quot;backoffMs&quot;:100,&quot;strategy&quot;:&quot;exponential&quot;,&quot;retryOn&quot;:[&quot;throttled&quot;,&quot;transient&quot;,&quot;timeout&quot;],&quot;maxBackoffMs&quot;:1000,&quot;jitter&quot;:1,&quot;budget&quot;:{&quot;percent&quot;:20,&quot;minPerSec&quot;:10}},&quot;breaker&quot;:{}}}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:60000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0.1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;fail&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;rate&quot;:0}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:5}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;factor&quot;:1}}},{&quot;atMs&quot;:1200,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Watch the Payments connection and queue. At 3 s, Payments slows for five seconds: the breaker pauses failing calls, then tests recovery. Watch for Closed and calls succeeding.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:3500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The slowdown pushes calls past their timeout. Once failures fill the window, the breaker opens and fails fast.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Payments is fast again. The open breaker gives its queue room to drain before testing five calls.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}},{&quot;atMs&quot;:15000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The breaker tests a few calls after each pause. If they still fail, it opens again so the queue can keep draining.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;checkout&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;goodput&quot;,&quot;label&quot;:&quot;Shop goodput â‰¥ 270/s at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shop&quot;,&quot;field&quot;:&quot;goodput&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:270,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Payments backlog &lt; 100 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;amplification&quot;,&quot;label&quot;:&quot;Checkout attempts per request &lt; 1.5 at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;checkout&quot;,&quot;field&quot;:&quot;amplification&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:1.5,&quot;when&quot;:&quot;end&quot;}],&quot;description&quot;:&quot;A circuit breaker fails fast while Payments drains abandoned work, then tests recovery with five calls.&quot;}]" dg_planning="{&quot;revision&quot;:&quot;p3-w2&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;checkout&quot;,&quot;label&quot;:&quot;Checkout&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/checkout&quot;}}]}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
