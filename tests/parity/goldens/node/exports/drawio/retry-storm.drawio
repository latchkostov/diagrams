        <object id="dg-n-checkout" label="Checkout" dg_id="checkout" dg_stencil="generic.service" dg_props="{&quot;replicas&quot;:4,&quot;concurrency&quot;:100,&quot;latencyMs&quot;:5,&quot;jitter&quot;:0}">
