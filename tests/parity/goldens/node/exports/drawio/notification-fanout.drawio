<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-wmeapy" name="Notification fan-out">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="One shipping event fans out by customer preference to email, SMS and push queues, each sender respecting its provider's rate limit; failures dead-letter per channel and the senders sign in with a managed identity." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;shipping-wave&quot;,&quot;title&quot;:&quot;Holiday shipping wave&quot;,&quot;description&quot;:&quot;2,000 parcels ship in five seconds. Email and push keep up; SMS queues behind its 50-a-second limit.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:10,&quot;traffic&quot;:[{&quot;id&quot;:&quot;scans&quot;,&quot;node&quot;:&quot;carrier&quot;,&quot;messageType&quot;:&quot;ParcelScanned&quot;,&quot;label&quot;:&quot;400 parcels/s for 5 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:5000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every shipped parcel becomes one OrderShipped event. The router reads the customer's preferences and fans out to the channels they chose. Each dot is 10 events.&quot;,&quot;focus&quot;:[&quot;events&quot;,&quot;router&quot;,&quot;preferences&quot;]}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;SMS is limited to 50 a second to stay inside the provider's throughput. Its queue grows while email and push keep pace.&quot;,&quot;focus&quot;:[&quot;sms-q&quot;,&quot;sms-limiter&quot;,&quot;email-q&quot;,&quot;push-q&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The SMS queue drains at its own pace. Separate queues mean one slow channel never delays the others.&quot;,&quot;focus&quot;:[&quot;sms-q&quot;,&quot;twilio&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;sms-backlog&quot;,&quot;label&quot;:&quot;SMS queues behind its rate limit&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;sms-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:5000},{&quot;id&quot;:&quot;email-current&quot;,&quot;label&quot;:&quot;Email keeps up&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&lt;=&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;sms-drained&quot;,&quot;label&quot;:&quot;Every SMS is eventually sent&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;sms-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;preferences&quot;,&quot;label&quot;:&quot;Preferences read for all 2,000&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;preferences&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:2000,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;sms-outage&quot;,&quot;title&quot;:&quot;SMS provider outage&quot;,&quot;description&quot;:&quot;Twilio errors for five seconds; the circuit breaker pauses SMS while email and push carry on.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;scans&quot;,&quot;node&quot;:&quot;carrier&quot;,&quot;messageType&quot;:&quot;ParcelScanned&quot;,&quot;label&quot;:&quot;40 parcels/s for 8 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:40,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1500,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;sms-limiter&quot;,&quot;status&quot;:&quot;paused&quot;}},{&quot;atMs&quot;:1500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Twilio starts returning errors. The circuit breaker opens and SMS sending pauses; messages wait in the queue instead of failing.&quot;,&quot;focus&quot;:[&quot;sms-limiter&quot;,&quot;twilio&quot;,&quot;sms-q&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:6500,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;sms-limiter&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:6500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The breaker closes. The backlog drains at 50 a second; email and push never noticed.&quot;,&quot;focus&quot;:[&quot;sms-q&quot;,&quot;sms-limiter&quot;,&quot;sendgrid&quot;,&quot;push&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;waiting&quot;,&quot;label&quot;:&quot;SMS waits during the outage&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;sms-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:6000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The SMS backlog drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;sms-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;email&quot;,&quot;label&quot;:&quot;Email is unaffected&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&lt;=&quot;,&quot;value&quot;:10,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;all-routed&quot;,&quot;label&quot;:&quot;All 320 events are routed&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;preferences&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:320,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
