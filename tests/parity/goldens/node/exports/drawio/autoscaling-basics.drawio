          </mxCell>
        </object>
        <object id="dg-n-render-requests" label="Render requests&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;3 partitions&lt;/span&gt;" dg_id="render-requests" dg_stencil="kafka.topic" dg_props="{&quot;partitions&quot;:3}">
