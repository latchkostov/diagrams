<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1a9u3ze" name="Autoscaling basics">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Two invented pipelines, one per autoscaler. Image workers scale on CPU with a Kubernetes HPA while Kafka buffers an upload burst; poster render workers sleep at zero until KEDA sees Kafka lag, wake, drain the burst and return to zero. Teaching timings (1 s syncs and polling, 1-2 s startup, short stabilization and cooldown) are deliberately shorter than the published defaults. Open a worker's Live details for replica history." dg_simulations="[{&quot;id&quot;:&quot;upload-burst&quot;,&quot;title&quot;:&quot;HPA: image workers absorb a burst&quot;,&quot;seed&quot;:42,&quot;scale&quot;:1,&quot;durationMs&quot;:24000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;burst&quot;,&quot;node&quot;:&quot;uploader&quot;,&quot;messageType&quot;:&quot;ImageUploaded&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:48,&quot;durationMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Demand is above one worker’s target. New replicas start while Kafka holds the backlog.&quot;,&quot;focus&quot;:[&quot;uploads&quot;,&quot;image-workers&quot;]}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Ready workers drain the upload burst. Open Live details to see desired and ready replicas over time.&quot;,&quot;focus&quot;:[&quot;image-workers&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;buffered&quot;,&quot;label&quot;:&quot;Uploads wait for starting workers&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uploads&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;thumbnails&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:2000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Every upload finishes&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;image-workers&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:192,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;empty&quot;,&quot;label&quot;:&quot;The topic backlog drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uploads&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;thumbnails&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;wake-on-burst&quot;,&quot;title&quot;:&quot;KEDA: render workers wake from zero&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:10000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;burst&quot;,&quot;node&quot;:&quot;poster-studio&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:80,&quot;atMs&quot;:1000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Eighty render requests arrive while no worker runs. KEDA sees the group's lag and wakes one.&quot;,&quot;focus&quot;:[&quot;render-requests&quot;,&quot;render-workers&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;HPA takes over from one replica and scales on lag; the backlog drains, then the workers return to zero.&quot;,&quot;focus&quot;:[&quot;render-workers&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;woke&quot;,&quot;label&quot;:&quot;A render worker starts from zero&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;render-requests&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;renders&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:2000},{&quot;id&quot;:&quot;rendered&quot;,&quot;label&quot;:&quot;All 80 posters render&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;render-workers&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:80,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The lag drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;render-requests&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;renders&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-uploader" label="Upload clients" dg_id="uploader" dg_stencil="client.browser" dg_props="{&quot;ratePerSec&quot;:4}">
