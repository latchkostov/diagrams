<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-jgdc1y" name="Where the time goes">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Kafka carries 2,000 orders/s to Billing. A spike at 4 s turns a 0.3 s async path into seconds of waiting; hover for sampled p50, p95 and p99." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;billing-spike&quot;,&quot;title&quot;:&quot;Where the time goes&quot;,&quot;description&quot;:&quot;A spike at 4 s builds a Billing backlog. Hover Billing or Receipts to see sampled latency and where time went.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:100,&quot;durationMs&quot;:9400,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;checkout&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:2000,&quot;peakRate&quot;:10000,&quot;atMs&quot;:4000,&quot;peakMs&quot;:5400,&quot;durationMs&quot;:9400}}],&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;At 4 s, the spike exceeds Billing capacity. Orders wait in Kafka; the work still takes 300 ms. Hover Billing to see where the time goes.&quot;,&quot;focus&quot;:[&quot;billing&quot;,&quot;orders&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Billing’s p95 went from 0.3 s to 3.9 s; 78% of that is waiting in Kafka. Hover Billing for the split.&quot;,&quot;focus&quot;:[&quot;billing&quot;,&quot;receipts&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;no-loss&quot;,&quot;label&quot;:&quot;No orders dropped at Billing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;billing&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;steady-orders&quot;,&quot;title&quot;:&quot;Room for steady orders&quot;,&quot;description&quot;:&quot;Two thousand orders per second fit. The same 300 ms work stays quick without a spike.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:100,&quot;durationMs&quot;:9400,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;checkout&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:2000,&quot;durationMs&quot;:9400}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[{&quot;id&quot;:&quot;no-loss&quot;,&quot;label&quot;:&quot;No orders dropped at Billing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;billing&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
