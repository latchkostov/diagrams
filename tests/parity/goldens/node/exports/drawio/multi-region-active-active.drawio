<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-126esoc" name="Multi-region active/active">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Route 53 sends each customer to the nearest healthy region; both regions take writes and a DynamoDB global table replicates them." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;failover&quot;,&quot;title&quot;:&quot;Region outage and failover&quot;,&quot;description&quot;:&quot;us-east-1's API fails; requests in flight error until health checks trip, then Route 53 sends everyone to eu-west-1.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:2,&quot;traffic&quot;:[{&quot;id&quot;:&quot;before&quot;,&quot;node&quot;:&quot;users&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;label&quot;:&quot;Latency routing: 100 checkouts/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:100,&quot;durationMs&quot;:5500}},{&quot;id&quot;:&quot;after&quot;,&quot;node&quot;:&quot;users&quot;,&quot;messageType&quot;:&quot;CheckoutFailover&quot;,&quot;label&quot;:&quot;After failover: eu-west-1 only&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:100,&quot;fromMs&quot;:5500,&quot;durationMs&quot;:5500}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Both regions are live. Route 53 sends each customer to the closer one, and every write replicates to the other region in about a second. Each dot is two checkouts.&quot;,&quot;focus&quot;:[&quot;r53&quot;,&quot;table-us&quot;,&quot;table-eu&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;alb-us&quot;,&quot;status&quot;:&quot;down&quot;}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;us-east-1 has an outage. Until Route 53's health checks fail, requests sent there error out.&quot;,&quot;focus&quot;:[&quot;alb-us&quot;,&quot;api-us&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:5500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Health checks trip and Route 53 stops answering with us-east-1. eu-west-1 is sized to carry everyone.&quot;,&quot;focus&quot;:[&quot;r53&quot;,&quot;alb-eu&quot;,&quot;api-eu&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;No data was stranded: everything us-east-1 wrote before the outage had already replicated to eu-west-1.&quot;,&quot;focus&quot;:[&quot;table-us&quot;,&quot;table-eu&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;blip&quot;,&quot;label&quot;:&quot;A short error blip before failover&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;alb-us&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;eu-carries&quot;,&quot;label&quot;:&quot;eu-west-1 holds every committed order&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;table-eu&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1004,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-eu-drops&quot;,&quot;label&quot;:&quot;eu-west-1 never drops a request&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;alb-eu&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;both-write&quot;,&quot;title&quot;:&quot;Both regions take writes&quot;,&quot;description&quot;:&quot;A sale peaks at 600 checkouts a second; each region serves half and the replicas converge.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:10,&quot;traffic&quot;:[{&quot;id&quot;:&quot;sale&quot;,&quot;node&quot;:&quot;users&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;label&quot;:&quot;Sale: 200 → 600 checkouts/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:200,&quot;peakRate&quot;:600,&quot;atMs&quot;:3000,&quot;peakMs&quot;:3000,&quot;durationMs&quot;:9000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Active/active: both regions serve customers and accept writes. Neither waits for the other. Each dot is 10 checkouts.&quot;,&quot;focus&quot;:[&quot;api-us&quot;,&quot;api-eu&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The sale peaks at 600 a second. Each region carries half, with room to take all of it if the other fails.&quot;,&quot;focus&quot;:[&quot;alb-us&quot;,&quot;alb-eu&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Writes replicate asynchronously in both directions; conflicting updates resolve last-writer-wins. When the sale ends, the two replicas hold the same orders.&quot;,&quot;focus&quot;:[&quot;table-us&quot;,&quot;table-eu&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;us&quot;,&quot;label&quot;:&quot;us-east-1 holds all 3,000 orders&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;table-us&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:3000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;eu&quot;,&quot;label&quot;:&quot;eu-west-1 holds all 3,000 orders&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;table-eu&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:3000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;alb-us&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]">
          <mxCell />
        </object>
