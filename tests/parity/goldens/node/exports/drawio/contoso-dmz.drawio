      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Contoso web traffic crosses a router, firewall, BIG-IP and switch to the app and database; a separate probe is blocked at the firewall, never counted as a failure." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;web-and-probes&quot;,&quot;title&quot;:&quot;Web and blocked probes&quot;,&quot;description&quot;:&quot;Allowed web calls reach storage; admin probes stop at the firewall.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;visitors&quot;,&quot;node&quot;:&quot;visitors&quot;,&quot;messageType&quot;:&quot;WebRequest&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:8,&quot;durationMs&quot;:6000}},{&quot;id&quot;:&quot;probes&quot;,&quot;node&quot;:&quot;probes&quot;,&quot;messageType&quot;:&quot;AdminProbe&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:2,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Blocked is a firewall decision, separate from processing failures and lost messages. All capacities here are illustrative device presets.&quot;,&quot;focus&quot;:[&quot;firewall&quot;,&quot;admin&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;database-processed-end&quot;,&quot;label&quot;:&quot;database: processed == 48&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;database&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:48,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;admin-processed-end&quot;,&quot;label&quot;:&quot;admin: processed == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;admin&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;firewall-blocked-end&quot;,&quot;label&quot;:&quot;firewall: blocked == 12&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;blocked&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:12,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;firewall-dropped-always&quot;,&quot;label&quot;:&quot;firewall: dropped == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;web-only&quot;,&quot;title&quot;:&quot;Web-only baseline&quot;,&quot;description&quot;:&quot;The same path carries normal web requests with no blocked traffic.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;visitors&quot;,&quot;node&quot;:&quot;visitors&quot;,&quot;messageType&quot;:&quot;WebRequest&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:8,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[{&quot;id&quot;:&quot;database-processed-end&quot;,&quot;label&quot;:&quot;database: processed == 48&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;database&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:48,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;firewall-blocked-end&quot;,&quot;label&quot;:&quot;firewall: blocked == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;blocked&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]">
