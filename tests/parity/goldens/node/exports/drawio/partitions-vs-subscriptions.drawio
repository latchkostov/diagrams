        <object id="dg-n-audit" label="Audit subscription&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;8 replicas · independent copy&lt;/span&gt;" dg_id="audit" dg_stencil="service.go" dg_props="{&quot;preset&quot;:&quot;processor-lesson&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;replicas&quot;:8,&quot;concurrency&quot;:1,&quot;latencyMs&quot;:1000,&quot;jitter&quot;:0,&quot;failureRate&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#00ADD81A;strokeColor=#00ADD8;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="700" y="366" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-publish-log" label="Append" dg_id="publish-log" dg_kind="async" dg_props="{&quot;travelMs&quot;:200}">
