          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#5FA04E1A;strokeColor=#5FA04E;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="366" width="180" height="60" as="geometry" />
          </mxCell>
