<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1cktvgy" name="Partitions versus subscriptions">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Northwind publishes the same events to a three-partition Kafka topic and SNS: five Kafka readers sit idle while both subscriptions use all eight workers." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;compare&quot;,&quot;title&quot;:&quot;Same events, different assignment&quot;,&quot;description&quot;:&quot;Watch the Kafka lag and five idle readers; SNS delivers a full copy to each subscription.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;publisher&quot;,&quot;node&quot;:&quot;publisher&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:6,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Kafka assigns three of eight replicas. Each SNS subscription can use all eight; subscriptions receive independent copies.&quot;,&quot;focus&quot;:[&quot;log-readers&quot;,&quot;receipts&quot;,&quot;audit&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;log-lag-at&quot;,&quot;label&quot;:&quot;log: lag &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;log&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:5000},{&quot;id&quot;:&quot;log-readers-processed-end&quot;,&quot;label&quot;:&quot;log-readers: processed == 36&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;log-readers&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:36,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;receipts-processed-end&quot;,&quot;label&quot;:&quot;receipts: processed == 36&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;receipts&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:36,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;audit-processed-end&quot;,&quot;label&quot;:&quot;audit: processed == 36&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;audit&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:36,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;more-partitions&quot;,&quot;title&quot;:&quot;Give every reader a partition&quot;,&quot;description&quot;:&quot;Eight partitions remove the assignment bottleneck without changing the reader fleets.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;publisher&quot;,&quot;node&quot;:&quot;publisher&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:6,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Only the Kafka partition count changed. SNS has no partition setting.&quot;,&quot;focus&quot;:[&quot;log&quot;,&quot;fanout&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;log-lag-end&quot;,&quot;label&quot;:&quot;log: lag == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;log&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;log-readers-processed-end&quot;,&quot;label&quot;:&quot;log-readers: processed == 36&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;log-readers&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:36,&quot;when&quot;:&quot;end&quot;}],&quot;setup&quot;:{&quot;props&quot;:{&quot;log&quot;:{&quot;partitions&quot;:8}}}}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-publisher" label="Northwind events&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;6 events/s to both brokers&lt;/span&gt;" dg_id="publisher" dg_stencil="generic.webhook" dg_props="{&quot;ratePerSec&quot;:6,&quot;messageType&quot;:&quot;OrderPlaced&quot;}">
