<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-uc0rx7" name="Zone outage drill">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Two availability zones serve the same checkout traffic. At 3 s zone b goes down; health checks route every new checkout to zone a. Compare the second drill to see requests lost without health checks." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;health-checks&quot;,&quot;title&quot;:&quot;Zone outage: health checks&quot;,&quot;description&quot;:&quot;Zone b fails at 3 s. Compare how the load balancer chooses its next target.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:9000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;visitors&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:10,&quot;durationMs&quot;:8000}}],&quot;setup&quot;:{&quot;props&quot;:{&quot;entry&quot;:{&quot;healthChecks&quot;:true}}},&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;boundary&quot;,&quot;boundary&quot;:&quot;zone-b&quot;,&quot;down&quot;:true},&quot;drill&quot;:&quot;zone-outage&quot;}},{&quot;atMs&quot;:3200,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Zone b is down. Health checks have shifted new checkouts to zone a. Nothing is lost.&quot;}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;api-a-loss&quot;,&quot;label&quot;:&quot;Nothing lost at api-a&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;api-a&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;api-b-loss&quot;,&quot;label&quot;:&quot;Nothing lost at api-b&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;api-b&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;orders-a-loss&quot;,&quot;label&quot;:&quot;Nothing lost at orders-a&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-a&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;orders-b-loss&quot;,&quot;label&quot;:&quot;Nothing lost at orders-b&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-b&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;surviving-zone&quot;,&quot;label&quot;:&quot;Zone a continues serving checkouts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-a&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;no-health-checks&quot;,&quot;title&quot;:&quot;Zone outage: no health checks&quot;,&quot;description&quot;:&quot;Zone b fails at 3 s. Compare how the load balancer chooses its next target.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:9000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;visitors&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:10,&quot;durationMs&quot;:8000}}],&quot;setup&quot;:{&quot;props&quot;:{&quot;entry&quot;:{&quot;healthChecks&quot;:false}}},&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;boundary&quot;,&quot;boundary&quot;:&quot;zone-b&quot;,&quot;down&quot;:true},&quot;drill&quot;:&quot;zone-outage&quot;}},{&quot;atMs&quot;:3200,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Zone b is down. Without health checks the load balancer still sends half the checkouts there: watch the dropped count.&quot;}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;api-a-loss&quot;,&quot;label&quot;:&quot;Nothing lost at api-a&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;api-a&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;api-b-loss&quot;,&quot;label&quot;:&quot;Without health checks, checkouts are lost at api-b&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;api-b&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:10,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;orders-a-loss&quot;,&quot;label&quot;:&quot;Nothing lost at orders-a&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-a&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;orders-b-loss&quot;,&quot;label&quot;:&quot;Nothing lost at orders-b&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-b&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;surviving-zone&quot;,&quot;label&quot;:&quot;Zone a continues serving checkouts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-a&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
