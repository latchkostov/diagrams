<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1w7d6bz" name="Food delivery dispatch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented delivery company, Quayside Eats. Courier pings stream through MQTT and Kafka into a geo index by H3 cell; ready orders are matched to nearby couriers every two seconds, scored by an ETA model, and offered by push. KEDA scales the indexer up to the topic's partitions." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;dinner-rush&quot;,&quot;title&quot;:&quot;Friday dinner rush&quot;,&quot;description&quot;:&quot;Orders climb from 30 to 90 a second and couriers report more often. KEDA scales the geo indexer on Kafka lag, and the dispatch matcher hits the maps provider's 50 calls a second: the excess is rejected, so ETAs fall back to the model.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:20,&quot;durationMs&quot;:30000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;diners&quot;,&quot;label&quot;:&quot;Diner app&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:0,&quot;startRate&quot;:150,&quot;stages&quot;:[{&quot;durationMs&quot;:6000,&quot;targetRate&quot;:450},{&quot;durationMs&quot;:14000,&quot;targetRate&quot;:450},{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:150}]}},{&quot;id&quot;:&quot;ready&quot;,&quot;node&quot;:&quot;restaurants&quot;,&quot;label&quot;:&quot;Orders ready&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:2000,&quot;startRate&quot;:30,&quot;stages&quot;:[{&quot;durationMs&quot;:6000,&quot;targetRate&quot;:90},{&quot;durationMs&quot;:14000,&quot;targetRate&quot;:90},{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:30}]}},{&quot;id&quot;:&quot;pings&quot;,&quot;node&quot;:&quot;couriers&quot;,&quot;label&quot;:&quot;Courier pings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:0,&quot;startRate&quot;:1000,&quot;stages&quot;:[{&quot;durationMs&quot;:6000,&quot;targetRate&quot;:1500},{&quot;durationMs&quot;:18000,&quot;targetRate&quot;:1500}]}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Two streams meet in dispatch: orders that are ready, and couriers' locations indexed by H3 cell.&quot;,&quot;focus&quot;:[&quot;ready-topic&quot;,&quot;locations-topic&quot;,&quot;matcher&quot;,&quot;geo-index&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The rush starts. Location lag rises and KEDA adds geo indexers, one per partition at most.&quot;,&quot;focus&quot;:[&quot;locations-topic&quot;,&quot;geo-indexer&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Ninety ready orders a second, but the maps API allows 50 calls: the rest are rejected and the matcher uses the model's ETA.&quot;,&quot;focus&quot;:[&quot;matcher&quot;,&quot;maps&quot;,&quot;eta-model&quot;]}},{&quot;atMs&quot;:20000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The rush eases. Every ready order got a courier offer.&quot;,&quot;focus&quot;:[&quot;offers&quot;,&quot;notifications&quot;,&quot;push-sender&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;maps-limited&quot;,&quot;label&quot;:&quot;The maps API rejects calls over its quota&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;maps&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;offers-sent&quot;,&quot;label&quot;:&quot;Couriers get offers&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fcm&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:1500,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;located&quot;,&quot;label&quot;:&quot;Location lag drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;locations-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;geo-index&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;partition-ceiling&quot;,&quot;title&quot;:&quot;Eight partitions, a stadium's worth of couriers&quot;,&quot;description&quot;:&quot;A stadium lets out and 3,600 pings a second arrive. KEDA wants more geo indexers, but a consumer group can't use more readers than the topic has partitions: eight. Lag grows until the team raises the topic to 24 partitions.&quot;,&quot;seed&quot;:42,&quot;scale&quot;:50,&quot;durationMs&quot;:30000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;pings&quot;,&quot;node&quot;:&quot;couriers&quot;,&quot;label&quot;:&quot;Courier pings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:3600,&quot;durationMs&quot;:22000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;3,600 pings a second. Each geo indexer handles about 400.&quot;,&quot;focus&quot;:[&quot;couriers&quot;,&quot;mqtt&quot;,&quot;loc-ingest&quot;,&quot;locations-topic&quot;]}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;KEDA scales to eight indexers and stops: the topic has eight partitions, so lag keeps growing.&quot;,&quot;focus&quot;:[&quot;locations-topic&quot;,&quot;geo-indexer&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;locations-topic&quot;,&quot;props&quot;:{&quot;partitions&quot;:24}}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;geo-indexer&quot;,&quot;props&quot;:{&quot;autoscaling&quot;:{&quot;mode&quot;:&quot;on&quot;,&quot;modelRevision&quot;:&quot;a2&quot;,&quot;preset&quot;:&quot;keda-kafka&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;controller&quot;:{&quot;kind&quot;:&quot;keda&quot;,&quot;minReplicas&quot;:3,&quot;maxReplicas&quot;:24,&quot;initialReplicas&quot;:3,&quot;pollingMs&quot;:1000,&quot;cooldownMs&quot;:5000,&quot;initialCooldownMs&quot;:0,&quot;triggers&quot;:[{&quot;type&quot;:&quot;kafka&quot;,&quot;source&quot;:{&quot;node&quot;:&quot;locations-topic&quot;,&quot;group&quot;:&quot;geo-index&quot;},&quot;target&quot;:500,&quot;activation&quot;:0,&quot;useCachedMetrics&quot;:false,&quot;allowIdleConsumers&quot;:false}],&quot;settings&quot;:{&quot;syncMs&quot;:1000,&quot;tolerance&quot;:0.1,&quot;initialReadinessDelayMs&quot;:0,&quot;cpuInitializationPeriodMs&quot;:0,&quot;metrics&quot;:[],&quot;up&quot;:{&quot;stabilizationMs&quot;:0,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Pods&quot;,&quot;value&quot;:4,&quot;periodMs&quot;:3000},{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:3000}]},&quot;down&quot;:{&quot;stabilizationMs&quot;:300000,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]}}}}}}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The team raises the topic to 24 partitions and KEDA's maximum to match. KEDA adds indexers and the lag drains.&quot;,&quot;focus&quot;:[&quot;locations-topic&quot;,&quot;geo-indexer&quot;,&quot;geo-index&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;capped&quot;,&quot;label&quot;:&quot;Lag builds at eight partitions&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;locations-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;geo-index&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:1000,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:11000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Lag drains after the change&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;locations-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;geo-index&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;browse-menu&quot;,&quot;label&quot;:&quot;Browse menu&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/v2/restaurants/311/menu&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:1,&quot;marker&quot;:&quot;square&quot;}},{&quot;id&quot;:&quot;place-order&quot;,&quot;label&quot;:&quot;Place order&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/v2/orders&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:0,&quot;marker&quot;:&quot;circle&quot;}},{&quot;id&quot;:&quot;order-ready&quot;,&quot;label&quot;:&quot;Order ready&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/v2/restaurant/orders/9071/ready&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:2,&quot;marker&quot;:&quot;diamond&quot;}}]}">
          <mxCell />
        </object>
