<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1rkb9o9" name="Nightly batch ELT">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Airflow runs a nightly Airbyte sync from app, CRM and billing sources into Snowflake, then dbt builds marts for Tableau." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;nightly-run&quot;,&quot;title&quot;:&quot;The nightly run&quot;,&quot;description&quot;:&quot;Extract and load 300 table batches, then build 120 dbt models. Time is compressed: an hour takes a few seconds.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;app&quot;,&quot;node&quot;:&quot;app-db&quot;,&quot;messageType&quot;:&quot;AppTableBatch&quot;,&quot;label&quot;:&quot;02:00 · 150 app table batches&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:150,&quot;spreadMs&quot;:1500}},{&quot;id&quot;:&quot;crm&quot;,&quot;node&quot;:&quot;crm&quot;,&quot;messageType&quot;:&quot;CrmObjectBatch&quot;,&quot;label&quot;:&quot;02:00 · 75 CRM batches&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:75,&quot;spreadMs&quot;:1500}},{&quot;id&quot;:&quot;billing&quot;,&quot;node&quot;:&quot;billing&quot;,&quot;messageType&quot;:&quot;BillingObjectBatch&quot;,&quot;label&quot;:&quot;02:00 · 75 billing batches&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:75,&quot;spreadMs&quot;:1500}},{&quot;id&quot;:&quot;dbt&quot;,&quot;node&quot;:&quot;dbt&quot;,&quot;messageType&quot;:&quot;DbtModel&quot;,&quot;label&quot;:&quot;03:00 · dbt builds 120 models&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;atMs&quot;:7000,&quot;count&quot;:120,&quot;spreadMs&quot;:500}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;02:00. Airflow starts the nightly DAG: Airbyte copies whatever changed since yesterday from three sources into raw tables.&quot;,&quot;focus&quot;:[&quot;airflow&quot;,&quot;airbyte&quot;,&quot;raw&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;03:00. The load is done, so dbt rebuilds the marts and runs its tests. A failing test posts to Slack.&quot;,&quot;focus&quot;:[&quot;airflow&quot;,&quot;dbt&quot;,&quot;marts&quot;,&quot;slack&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;06:00. Tableau refreshes. Simple and cheap, but dashboards show yesterday. Compare the event-driven data platform, where rows land in seconds.&quot;,&quot;focus&quot;:[&quot;marts&quot;,&quot;tableau&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;loaded&quot;,&quot;label&quot;:&quot;300 batches loaded&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;built&quot;,&quot;label&quot;:&quot;120 marts built&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;marts&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:120,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;alerted&quot;,&quot;label&quot;:&quot;A failing test alerts the team&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;slack&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;late-load&quot;,&quot;title&quot;:&quot;Slow source, stale marts&quot;,&quot;description&quot;:&quot;Salesforce throttles the bulk API, the load overruns, and dbt starts on schedule with partial data.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;setup&quot;:{&quot;props&quot;:{&quot;airbyte&quot;:{&quot;latencyMs&quot;:900}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;app&quot;,&quot;node&quot;:&quot;app-db&quot;,&quot;messageType&quot;:&quot;AppTableBatch&quot;,&quot;label&quot;:&quot;02:00 · 150 app table batches&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:150,&quot;spreadMs&quot;:1500}},{&quot;id&quot;:&quot;crm&quot;,&quot;node&quot;:&quot;crm&quot;,&quot;messageType&quot;:&quot;CrmObjectBatch&quot;,&quot;label&quot;:&quot;02:00 · 75 CRM batches&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:75,&quot;spreadMs&quot;:1500}},{&quot;id&quot;:&quot;billing&quot;,&quot;node&quot;:&quot;billing&quot;,&quot;messageType&quot;:&quot;BillingObjectBatch&quot;,&quot;label&quot;:&quot;02:00 · 75 billing batches&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:75,&quot;spreadMs&quot;:1500}},{&quot;id&quot;:&quot;dbt&quot;,&quot;node&quot;:&quot;dbt&quot;,&quot;messageType&quot;:&quot;DbtModel&quot;,&quot;label&quot;:&quot;03:00 · dbt builds 120 models&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;atMs&quot;:7000,&quot;count&quot;:120,&quot;spreadMs&quot;:500}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Tonight Salesforce throttles its bulk API, so every sync runs about three times slower.&quot;,&quot;focus&quot;:[&quot;crm&quot;,&quot;airbyte&quot;]}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;03:00 arrives and the load isn't finished. A time-based schedule starts dbt anyway, so some marts are built from partial data.&quot;,&quot;focus&quot;:[&quot;airbyte&quot;,&quot;raw&quot;,&quot;dbt&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The fix: make dbt wait for the load (a sensor or a data-aware schedule), or stream the data so there's no window to miss.&quot;,&quot;focus&quot;:[&quot;airflow&quot;,&quot;dbt&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;overrun&quot;,&quot;label&quot;:&quot;The load is unfinished at 03:00&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:7000},{&quot;id&quot;:&quot;loaded&quot;,&quot;label&quot;:&quot;All 300 batches land eventually&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;built&quot;,&quot;label&quot;:&quot;dbt built 120 marts anyway&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;marts&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:120,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
