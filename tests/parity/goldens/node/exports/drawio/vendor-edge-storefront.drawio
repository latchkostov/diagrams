      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Fastly and a Cloudflare WAF pass shop requests to Fastly Compute, which calls Square and stores receipts in Cloudflare R2. LaunchDarkly supplies configuration and Cognito supplies identity. CDN caching and vendor performance are not simulated." dg_direction="LR" dg_simulations="[]">
