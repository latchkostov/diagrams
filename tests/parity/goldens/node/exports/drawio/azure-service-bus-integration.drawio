<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-x3ueg1" name="Azure invoice integration">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Partner invoices fan out through filtered Service Bus subscriptions; commands use retries and dead lettering." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;month-end&quot;,&quot;title&quot;:&quot;Month-end invoice batch&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;batch&quot;,&quot;node&quot;:&quot;ingest&quot;,&quot;messageType&quot;:&quot;InvoiceHighValue&quot;,&quot;label&quot;:&quot;300 high-value month-end invoices&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:300,&quot;spreadMs&quot;:3000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The ERP submits 300 high-value invoices. Only the approval subscription accepts them.&quot;,&quot;focus&quot;:[&quot;partner&quot;,&quot;invoices&quot;,&quot;approval-sub&quot;]}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Approved invoices become PostInvoice commands; originals remain archived.&quot;,&quot;focus&quot;:[&quot;workflow&quot;,&quot;commands&quot;,&quot;cosmos&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;ledger&quot;,&quot;label&quot;:&quot;Ledger&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;cosmos&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;archive&quot;,&quot;label&quot;:&quot;Archive&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;blob&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;approval&quot;,&quot;label&quot;:&quot;Approval&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;workflow&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;No dlq&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;commands&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}],&quot;scale&quot;:2},{&quot;id&quot;:&quot;poison&quot;,&quot;title&quot;:&quot;Poison invoices&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;poison-batch&quot;,&quot;node&quot;:&quot;ingest&quot;,&quot;messageType&quot;:&quot;InvoiceHighValue&quot;,&quot;label&quot;:&quot;30 malformed posting requests&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:30,&quot;spreadMs&quot;:1000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A schema mismatch makes every ledger attempt fail. Commands are retried five times.&quot;,&quot;focus&quot;:[&quot;worker&quot;,&quot;commands&quot;]}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Poison commands are quarantined in the DLQ. Triage alerts finance operations, who replay them once the schema is fixed.&quot;,&quot;focus&quot;:[&quot;commands&quot;,&quot;dlq&quot;,&quot;dlq-triage&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;worker&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;quarantined&quot;,&quot;label&quot;:&quot;Poison invoices reach the DLQ&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;commands&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;triaged&quot;,&quot;label&quot;:&quot;All 30 poison invoices reach DLQ triage&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;dlq-triage&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:30,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-ledger-write&quot;,&quot;label&quot;:&quot;No ledger write&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;cosmos&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}],&quot;setup&quot;:{&quot;props&quot;:{&quot;worker&quot;:{&quot;failureRate&quot;:1,&quot;retry&quot;:&quot;inplace&quot;,&quot;retryBackoffMs&quot;:100}}},&quot;durationMs&quot;:20000,&quot;scale&quot;:1}]">
          <mxCell />
        </object>
