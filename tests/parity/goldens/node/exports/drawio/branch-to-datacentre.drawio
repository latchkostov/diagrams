<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1ry0p1f" name="Branch office to data centre">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="A branch and internet customers reach a data centre through edge routers, an active-standby firewall pair, a spine and leaf fabric and a load balancer pair. The firewall's rules allow web traffic and deny the branch any path to the payments zone." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;firewall-failover&quot;,&quot;title&quot;:&quot;One firewall fails over&quot;,&quot;description&quot;:&quot;The active firewall dies mid-traffic. The standby takes over in a few seconds: requests wait at the pair, none are lost.&quot;,&quot;seed&quot;:3,&quot;traffic&quot;:[{&quot;id&quot;:&quot;shop&quot;,&quot;node&quot;:&quot;customers&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;label&quot;:&quot;Checkouts: 400/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:12000}},{&quot;id&quot;:&quot;office&quot;,&quot;node&quot;:&quot;staff&quot;,&quot;messageType&quot;:&quot;BackOffice&quot;,&quot;label&quot;:&quot;Back office: 40/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:40,&quot;durationMs&quot;:12000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Customers come in over the internet and the branch over SD-WAN. Both pass the firewall pair: one unit carries the traffic, the other stands by.&quot;,&quot;focus&quot;:[&quot;firewall&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;firewall&quot;,&quot;props&quot;:{&quot;replicas&quot;:1}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The active firewall fails. For a few seconds, while the standby notices and takes over its sessions, requests wait at the pair.&quot;,&quot;focus&quot;:[&quot;firewall&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:7500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The standby carries everything now, at the same throughput: nothing was dropped. Until the failed unit is back, though, the pair has no spare.&quot;,&quot;focus&quot;:[&quot;firewall&quot;,&quot;adc&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;waits&quot;,&quot;label&quot;:&quot;Requests wait while it fails over&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:50,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;The firewall never drops a request&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;payments-denied&quot;,&quot;title&quot;:&quot;The firewall blocks the branch from payments&quot;,&quot;description&quot;:&quot;Someone at the branch tries Payments' admin API. The firewall's deny rule stops every request: blocked on purpose, not lost.&quot;,&quot;seed&quot;:5,&quot;traffic&quot;:[{&quot;id&quot;:&quot;shop&quot;,&quot;node&quot;:&quot;customers&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;label&quot;:&quot;Checkouts: 400/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:10000}},{&quot;id&quot;:&quot;office&quot;,&quot;node&quot;:&quot;staff&quot;,&quot;messageType&quot;:&quot;BackOffice&quot;,&quot;label&quot;:&quot;Back office: 40/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:40,&quot;durationMs&quot;:10000}},{&quot;id&quot;:&quot;admin&quot;,&quot;node&quot;:&quot;staff&quot;,&quot;messageType&quot;:&quot;PaymentAdmin&quot;,&quot;label&quot;:&quot;Payment admin attempts: 20/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:6000,&quot;fromMs&quot;:2000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The branch reaches the shop's back office through the firewall. Its rules allow web traffic, and deny the branch any path to Payments, which sits in the PCI zone.&quot;,&quot;focus&quot;:[&quot;firewall&quot;,&quot;payments&quot;]}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Someone at the branch starts calling Payments' admin API.&quot;,&quot;focus&quot;:[&quot;staff&quot;,&quot;branch-router&quot;]}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every one of those requests stops at the firewall: the deny rule blocks it. Blocked isn't lost; it's the rule working.&quot;,&quot;focus&quot;:[&quot;firewall&quot;,&quot;payments&quot;],&quot;pause&quot;:true}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;blocked&quot;,&quot;label&quot;:&quot;The firewall blocks the admin requests&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;blocked&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;Nothing is dropped at the firewall&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;firewall&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]">
          <mxCell />
        </object>
