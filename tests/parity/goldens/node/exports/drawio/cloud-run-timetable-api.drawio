<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-18fnzp0" name="Timetable API sleeps overnight">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented commuter timetable API on Cloud Run. It sleeps overnight, starts instances on demand for the first requests, and hits its maximum in the morning rush; Check diagram suggests a higher one. Timings are shortened for teaching." dg_simulations="[{&quot;id&quot;:&quot;morning-rush&quot;,&quot;title&quot;:&quot;Overnight, then the morning rush&quot;,&quot;seed&quot;:23,&quot;durationMs&quot;:60000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;rush&quot;,&quot;node&quot;:&quot;source&quot;,&quot;label&quot;:&quot;Morning rush&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:4000,&quot;stages&quot;:[{&quot;durationMs&quot;:8000,&quot;targetRate&quot;:150},{&quot;durationMs&quot;:16000,&quot;targetRate&quot;:150},{&quot;durationMs&quot;:6000,&quot;targetRate&quot;:0}]}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Overnight: no instances, nothing running.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;First requests wait while instances start on demand.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}},{&quot;atMs&quot;:20000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The rush hits the maximum of 6 instances. Check diagram suggests a higher maximum.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}},{&quot;atMs&quot;:44000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The rush ends; idle instances shut down, back to zero.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}}]},{&quot;id&quot;:&quot;quiet-sunday&quot;,&quot;title&quot;:&quot;A quiet Sunday&quot;,&quot;seed&quot;:29,&quot;durationMs&quot;:30000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;few&quot;,&quot;node&quot;:&quot;source&quot;,&quot;label&quot;:&quot;A few commuters&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:4,&quot;fromMs&quot;:3000,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;One instance starts for a few requests, then sleeps again.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-source" label="Commuter apps" dg_id="source" dg_stencil="client.browser" dg_props="{&quot;ratePerSec&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-worker" label="Timetable API&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;80 requests per instance&lt;/span&gt;" dg_id="worker" dg_stencil="gcp.cloud-run" dg_props="{&quot;replicas&quot;:1,&quot;concurrency&quot;:80,&quot;latencyMs&quot;:250,&quot;jitter&quot;:0,&quot;resources&quot;:{&quot;preset&quot;:&quot;io-service&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;cpuMsPerMessage&quot;:40,&quot;baselineMemoryMiB&quot;:128,&quot;memoryMiBPerMessage&quot;:2,&quot;cpuRequestMilli&quot;:500,&quot;cpuLimitMilli&quot;:1000,&quot;memoryRequestMiB&quot;:256,&quot;memoryLimitMiB&quot;:512,&quot;startup&quot;:{&quot;delayMs&quot;:2000,&quot;jitterFraction&quot;:0},&quot;terminationGraceMs&quot;:30000,&quot;modelRevision&quot;:&quot;a2&quot;},&quot;autoscaling&quot;:{&quot;mode&quot;:&quot;on&quot;,&quot;modelRevision&quot;:&quot;a3&quot;,&quot;preset&quot;:&quot;cloud-run&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;controller&quot;:{&quot;kind&quot;:&quot;cloudRun&quot;,&quot;minReplicas&quot;:0,&quot;initialReplicas&quot;:0,&quot;maxReplicas&quot;:6,&quot;targetConcurrencyPct&quot;:60,&quot;targetCpuPct&quot;:60,&quot;evaluationMs&quot;:2000,&quot;cpuWindowMs&quot;:6000,&quot;concurrencyWindowsMs&quot;:[6000,12000],&quot;scaleInDelayMs&quot;:4000}}}">
