<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-awkgzl" name="Black Friday commerce platform">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented retailer, Larkspur Outfitters. A route table splits storefront traffic by path and rate-limits checkout; Checkout scales on CPU; an outbox feeds Kafka; KEDA wakes fulfilment on order lag; a bad deploy parks events in a DLQ while other consumer groups carry on." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;doors-open&quot;,&quot;title&quot;:&quot;Black Friday: doors open&quot;,&quot;description&quot;:&quot;Storefront traffic jumps five times in three seconds. The gateway caps checkout at 150 requests a second (429 for the rest), Checkout's HPA adds pods on CPU, and KEDA scales fulfilment on order lag.&quot;,&quot;seed&quot;:11,&quot;scale&quot;:50,&quot;traffic&quot;:[{&quot;id&quot;:&quot;web-traffic&quot;,&quot;node&quot;:&quot;web&quot;,&quot;label&quot;:&quot;Web shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:300,&quot;peakRate&quot;:1500,&quot;atMs&quot;:3000,&quot;peakMs&quot;:12000,&quot;durationMs&quot;:30000}},{&quot;id&quot;:&quot;app-traffic&quot;,&quot;node&quot;:&quot;app&quot;,&quot;label&quot;:&quot;App shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:200,&quot;peakRate&quot;:1000,&quot;atMs&quot;:3000,&quot;peakMs&quot;:12000,&quot;durationMs&quot;:30000}},{&quot;id&quot;:&quot;scans&quot;,&quot;node&quot;:&quot;carriers&quot;,&quot;label&quot;:&quot;Carrier scans&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:30000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A normal morning: 500 requests a second. The gateway's route table sends each path to its own service.&quot;,&quot;focus&quot;:[&quot;cdn&quot;,&quot;gateway&quot;,&quot;catalog-bff&quot;,&quot;search-api&quot;,&quot;cart-api&quot;,&quot;checkout-api&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Doors open: 2,500 requests a second. The checkout route is capped at 150 a second; the rest get 429 and retry.&quot;,&quot;focus&quot;:[&quot;gateway&quot;,&quot;checkout-api&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Checkout's CPU passes 70%, so its HPA starts more pods. Open its Live details for the replica history.&quot;,&quot;focus&quot;:[&quot;checkout-api&quot;,&quot;payments&quot;,&quot;orders-db&quot;]}},{&quot;atMs&quot;:13000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Orders reach Kafka through the outbox. Fulfilment lag rises and KEDA adds workers, up to the 24 partitions.&quot;,&quot;focus&quot;:[&quot;outbox-relay&quot;,&quot;orders&quot;,&quot;fulfilment&quot;]}},{&quot;atMs&quot;:22000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Traffic falls back. Lag drains, and every consumer group catches up without a dead letter.&quot;}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;shed&quot;,&quot;label&quot;:&quot;The gateway sheds excess checkouts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;gateway&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;No order event is dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Fulfilment catches up&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;fulfilment&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;poison-deploy&quot;,&quot;title&quot;:&quot;A bad Loyalty deploy&quot;,&quot;description&quot;:&quot;Argo CD rolls out a Loyalty build that can't read a new order field. Its events fail three times and park in orders.dlq; the other consumer groups never notice. After the rollback, triage replays the parked events.&quot;,&quot;seed&quot;:12,&quot;scale&quot;:10,&quot;setup&quot;:{&quot;status&quot;:{&quot;dlq-triage&quot;:&quot;paused&quot;}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;web-traffic&quot;,&quot;node&quot;:&quot;web&quot;,&quot;label&quot;:&quot;Web shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:20000}},{&quot;id&quot;:&quot;app-traffic&quot;,&quot;node&quot;:&quot;app&quot;,&quot;label&quot;:&quot;App shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:200,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Five consumer groups read order events, each at its own pace and offset.&quot;,&quot;focus&quot;:[&quot;orders&quot;,&quot;fulfilment&quot;,&quot;loyalty&quot;,&quot;status-projector&quot;,&quot;notifier&quot;,&quot;lake-sink&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;loyalty&quot;,&quot;props&quot;:{&quot;failureRate&quot;:1}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Argo CD rolls out Loyalty 4.2. It can't read the new gift-card field, so every order event fails.&quot;,&quot;focus&quot;:[&quot;argocd&quot;,&quot;loyalty&quot;]}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;After three tries each event parks in orders.dlq. Fulfilment, status and notifications carry on: their offsets are their own.&quot;,&quot;focus&quot;:[&quot;orders&quot;,&quot;orders-dlq&quot;,&quot;fulfilment&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;loyalty&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;dlq-triage&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Rolled back. New events succeed again, and DLQ triage replays the parked ones into Loyalty.&quot;,&quot;focus&quot;:[&quot;argocd&quot;,&quot;loyalty&quot;,&quot;dlq-triage&quot;,&quot;loyalty-db&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;parked&quot;,&quot;label&quot;:&quot;Failed events park in the DLQ&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;fulfilment-ok&quot;,&quot;label&quot;:&quot;Fulfilment never fails&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfilment&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;replayed&quot;,&quot;label&quot;:&quot;Triage replays every parked event&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-dlq&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;triage&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;partner-quota&quot;,&quot;title&quot;:&quot;The warehouse partner throttles&quot;,&quot;description&quot;:&quot;A sustained peak at the 3PL warehouse API, which allows 60 pick requests a second. KEDA keeps fulfilment lag low by adding workers, but every worker calls the same partner: the quota rejects the excess. Scaling consumers moved the bottleneck.&quot;,&quot;seed&quot;:13,&quot;scale&quot;:50,&quot;setup&quot;:{&quot;props&quot;:{&quot;wms&quot;:{&quot;api&quot;:{&quot;maxInFlight&quot;:100,&quot;quotas&quot;:[{&quot;id&quot;:&quot;wms-rate&quot;,&quot;unit&quot;:&quot;requests&quot;,&quot;amount&quot;:60,&quot;windowMs&quot;:1000,&quot;algorithm&quot;:&quot;token-bucket&quot;}]}}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;web-traffic&quot;,&quot;node&quot;:&quot;web&quot;,&quot;label&quot;:&quot;Web shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1000,&quot;durationMs&quot;:15000}},{&quot;id&quot;:&quot;app-traffic&quot;,&quot;node&quot;:&quot;app&quot;,&quot;label&quot;:&quot;App shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:700,&quot;durationMs&quot;:15000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A sustained peak: about 130 orders a second reach Kafka.&quot;,&quot;focus&quot;:[&quot;checkout-api&quot;,&quot;orders-db&quot;,&quot;outbox-relay&quot;,&quot;orders&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;KEDA adds fulfilment workers to keep lag near its target of 20 per worker.&quot;,&quot;focus&quot;:[&quot;orders&quot;,&quot;fulfilment&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every worker calls the 3PL API, which allows 60 picks a second, so the rest are rejected. More workers can't raise a partner's quota: batch picks, or agree a higher limit.&quot;,&quot;focus&quot;:[&quot;fulfilment&quot;,&quot;wms&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;throttled&quot;,&quot;label&quot;:&quot;The 3PL rejects picks over its quota&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;wms&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;kept-up&quot;,&quot;label&quot;:&quot;Fulfilment still keeps up with Kafka&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;fulfilment&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;browse&quot;,&quot;label&quot;:&quot;Product page&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/products/8812&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:0,&quot;marker&quot;:&quot;circle&quot;}},{&quot;id&quot;:&quot;search&quot;,&quot;label&quot;:&quot;Search&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/search/parka&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:1,&quot;marker&quot;:&quot;square&quot;}},{&quot;id&quot;:&quot;cart&quot;,&quot;label&quot;:&quot;Add to cart&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/cart/items&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:2,&quot;marker&quot;:&quot;diamond&quot;}},{&quot;id&quot;:&quot;checkout&quot;,&quot;label&quot;:&quot;Checkout&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/checkout&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:3,&quot;marker&quot;:&quot;triangle&quot;}},{&quot;id&quot;:&quot;order-status&quot;,&quot;label&quot;:&quot;Order status&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/orders/5531&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:4,&quot;marker&quot;:&quot;circle&quot;}},{&quot;id&quot;:&quot;beacon&quot;,&quot;label&quot;:&quot;Analytics beacon&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/collect&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:5,&quot;marker&quot;:&quot;diamond&quot;}},{&quot;id&quot;:&quot;carrier-scan&quot;,&quot;label&quot;:&quot;Carrier scan&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/hooks/carriers/scan&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:6,&quot;marker&quot;:&quot;square&quot;}}]}">
