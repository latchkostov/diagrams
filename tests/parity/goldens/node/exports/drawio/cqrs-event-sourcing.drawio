<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1sbxp8o" name="CQRS with event sourcing">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Commands append events to an event store; projections build read models that queries hit, and an outbound feed shares events." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;busy-day&quot;,&quot;title&quot;:&quot;Payday: reads outnumber writes&quot;,&quot;description&quot;:&quot;400 commands and 1,600 queries; writes and reads scale independently.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:5,&quot;traffic&quot;:[{&quot;id&quot;:&quot;deposits&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;Deposit&quot;,&quot;label&quot;:&quot;Deposits: 40/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:40,&quot;durationMs&quot;:8000}},{&quot;id&quot;:&quot;withdrawals&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;Withdraw&quot;,&quot;label&quot;:&quot;Withdrawals: 10/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:10,&quot;durationMs&quot;:8000}},{&quot;id&quot;:&quot;balances&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;GetBalance&quot;,&quot;label&quot;:&quot;Balance checks: 150/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:150,&quot;durationMs&quot;:8000}},{&quot;id&quot;:&quot;statements&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;GetStatement&quot;,&quot;label&quot;:&quot;Statement searches: 50/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Payday. Commands go to the write side; queries never touch it. Each dot is five requests.&quot;,&quot;focus&quot;:[&quot;gateway&quot;,&quot;command-handler&quot;,&quot;query-api&quot;]}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The event store is the source of truth: an append-only log of what happened. Each projection keeps its own position in it.&quot;,&quot;focus&quot;:[&quot;event-store&quot;,&quot;balance-proj&quot;,&quot;statement-proj&quot;,&quot;publisher&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Queries read denormalized tables, so reads stay fast however long an account's history grows.&quot;,&quot;focus&quot;:[&quot;query-api&quot;,&quot;balances-db&quot;,&quot;statements&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;appended&quot;,&quot;label&quot;:&quot;All 400 commands are appended&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;event-store&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:400,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;published&quot;,&quot;label&quot;:&quot;All 400 events are shared&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;integration-topic&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:400,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;statements&quot;,&quot;label&quot;:&quot;Statements: 400 entries + 400 searches&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;statements&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:800,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;caught-up&quot;,&quot;label&quot;:&quot;Projections catch up&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;event-store&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;rebuild&quot;,&quot;title&quot;:&quot;Rebuild a read model&quot;,&quot;description&quot;:&quot;A new statement projection replays 2,000 historical events while live traffic continues.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:5,&quot;traffic&quot;:[{&quot;id&quot;:&quot;deposits&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;Deposit&quot;,&quot;label&quot;:&quot;Deposits: 40/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:40,&quot;durationMs&quot;:10000}},{&quot;id&quot;:&quot;balances&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;GetBalance&quot;,&quot;label&quot;:&quot;Balance checks: 100/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:100,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Statements need a new field. Instead of migrating the index, we deploy a new projection and rebuild it from the log.&quot;,&quot;focus&quot;:[&quot;statement-proj&quot;,&quot;statements&quot;]}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;statement-proj&quot;,&quot;status&quot;:&quot;paused&quot;}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The old projection stops. New events wait in its subscription; balances and the public feed are unaffected.&quot;,&quot;focus&quot;:[&quot;event-store&quot;,&quot;statement-proj&quot;,&quot;balance-proj&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;statement-proj&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;inject&quot;,&quot;node&quot;:&quot;statement-proj&quot;,&quot;count&quot;:2000,&quot;messageType&quot;:&quot;MoneyDeposited&quot;,&quot;spreadMs&quot;:500}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Version 2 replays 2,000 historical events from position zero, then picks up the live ones. Statements are briefly stale; nothing is lost.&quot;,&quot;focus&quot;:[&quot;statement-proj&quot;,&quot;statements&quot;],&quot;pause&quot;:true}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;behind&quot;,&quot;label&quot;:&quot;Statements fall behind during the rebuild&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;event-store&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;statements&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:5000},{&quot;id&quot;:&quot;balances-current&quot;,&quot;label&quot;:&quot;Balances keep up&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;event-store&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;balances&quot;},&quot;op&quot;:&quot;&lt;=&quot;,&quot;value&quot;:40,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;rebuilt&quot;,&quot;label&quot;:&quot;History and live events are indexed&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;statements&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:2400,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;caught-up&quot;,&quot;label&quot;:&quot;The new projection catches up&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;event-store&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;statements&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
