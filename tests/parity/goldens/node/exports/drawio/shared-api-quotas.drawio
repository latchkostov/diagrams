        </object>
        <object id="dg-n-assistant" label="Answer and review&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;Each question makes two model calls&lt;/span&gt;" dg_id="assistant" dg_stencil="service.python" dg_props="{&quot;preset&quot;:&quot;processor-lesson&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;replicas&quot;:2,&quot;concurrency&quot;:4,&quot;latencyMs&quot;:100,&quot;jitter&quot;:0,&quot;failureRate&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#3776AB1A;strokeColor=#3776AB;fontSize=12;" vertex="1" parent="1">
