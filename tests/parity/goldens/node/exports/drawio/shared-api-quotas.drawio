<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-7plxj1" name="Shared API and token quotas">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Acme answers and reviews questions against one fictional 6,000-token/minute project budget, while billing calls meet a separate five-request/second payment cap." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;launch-burst&quot;,&quot;title&quot;:&quot;Assistant launch burst&quot;,&quot;description&quot;:&quot;The shared token budget binds before RPM. Payment calls have their own rate budget. These are fictional contracts, not vendor tier defaults.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;questions&quot;,&quot;node&quot;:&quot;questions&quot;,&quot;messageType&quot;:&quot;Question&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:24,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:200}},{&quot;id&quot;:&quot;billing&quot;,&quot;node&quot;:&quot;billing&quot;,&quot;messageType&quot;:&quot;Payment&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:30,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:200}}],&quot;timeline&quot;:[{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Two model boxes spend one project budget. Rejected is separate from failed; no upstream timeout or retry is simulated.&quot;,&quot;focus&quot;:[&quot;answer&quot;,&quot;review&quot;,&quot;payments&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;answer-rejected-end&quot;,&quot;label&quot;:&quot;answer: rejected &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;answer&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;review-rejected-end&quot;,&quot;label&quot;:&quot;review: rejected &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;review&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;payments-rejected-end&quot;,&quot;label&quot;:&quot;payments: rejected &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;answer-failed-end&quot;,&quot;label&quot;:&quot;answer: failed == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;answer&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;payments-failed-end&quot;,&quot;label&quot;:&quot;payments: failed == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;within-budget&quot;,&quot;title&quot;:&quot;A small batch fits&quot;,&quot;description&quot;:&quot;Four questions spend 4,000 shared tokens; three payment calls fit the local bucket.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;questions&quot;,&quot;node&quot;:&quot;questions&quot;,&quot;messageType&quot;:&quot;Question&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:4,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:200}},{&quot;id&quot;:&quot;billing&quot;,&quot;node&quot;:&quot;billing&quot;,&quot;messageType&quot;:&quot;Payment&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:3,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:200}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[{&quot;id&quot;:&quot;answer-processed-end&quot;,&quot;label&quot;:&quot;answer: processed == 4&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;answer&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:4,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;review-processed-end&quot;,&quot;label&quot;:&quot;review: processed == 4&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;review&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:4,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;payments-processed-end&quot;,&quot;label&quot;:&quot;payments: processed == 3&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:3,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;answer-rejected-end&quot;,&quot;label&quot;:&quot;answer: rejected == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;answer&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;review-rejected-end&quot;,&quot;label&quot;:&quot;review: rejected == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;review&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;payments-rejected-end&quot;,&quot;label&quot;:&quot;payments: rejected == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payments&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-questions" label="Acme help desk&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;2 questions/s&lt;/span&gt;" dg_id="questions" dg_stencil="client.browser" dg_props="{&quot;ratePerSec&quot;:2,&quot;messageType&quot;:&quot;Question&quot;}">
