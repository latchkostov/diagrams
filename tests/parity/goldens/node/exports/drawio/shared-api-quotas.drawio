        </object>
        <object id="dg-n-answer" label="Answer model&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;500 tokens/call · shared project&lt;/span&gt;" dg_id="answer" dg_stencil="openai" dg_props="{&quot;preset&quot;:&quot;managed-measured&quot;,&quot;presetRevision&quot;:&quot;2026-10-14&quot;,&quot;jitter&quot;:0,&quot;failureRate&quot;:0,&quot;latencyMs&quot;:250,&quot;api&quot;:{&quot;maxInFlight&quot;:20,&quot;costPerRequest&quot;:{&quot;tokens&quot;:500},&quot;quotas&quot;:[{&quot;id&quot;:&quot;assistant-tokens&quot;,&quot;unit&quot;:&quot;tokens&quot;,&quot;amount&quot;:6000,&quot;windowMs&quot;:60000,&quot;algorithm&quot;:&quot;token-bucket&quot;,&quot;sharedGroup&quot;:&quot;assistant-tokens&quot;},{&quot;id&quot;:&quot;assistant-requests&quot;,&quot;unit&quot;:&quot;requests&quot;,&quot;amount&quot;:60,&quot;windowMs&quot;:60000,&quot;algorithm&quot;:&quot;token-bucket&quot;,&quot;sharedGroup&quot;:&quot;assistant-requests&quot;}]}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#10A37F1A;strokeColor=#10A37F;fontSize=12;" vertex="1" parent="1">
