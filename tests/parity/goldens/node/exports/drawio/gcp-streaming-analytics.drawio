<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-qdncvl" name="GCP streaming analytics">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Clickstream events flow through Pub/Sub and a Dataflow streaming job into BigQuery for Looker, with a raw archive and dead letters." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;morning-ramp&quot;,&quot;title&quot;:&quot;Morning ramp to 2,000 events/s&quot;,&quot;description&quot;:&quot;Traffic ramps from 200 to 2,000 events a second; a bad SDK release sends 200 malformed events.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:50,&quot;setup&quot;:{&quot;props&quot;:{&quot;dataflow&quot;:{&quot;replicas&quot;:24}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;clicks&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;ClickEvent&quot;,&quot;label&quot;:&quot;Ramp 200 → 2,000 events/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;startRate&quot;:200,&quot;stages&quot;:[{&quot;durationMs&quot;:8000,&quot;targetRate&quot;:2000}]}},{&quot;id&quot;:&quot;malformed&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;MalformedEvent&quot;,&quot;label&quot;:&quot;200 malformed events&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:200,&quot;atMs&quot;:4000,&quot;spreadMs&quot;:1000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Clicks ramp up as people wake up. Pub/Sub keeps each subscription separate: Dataflow and the raw archive each get every event. Each dot is 50 events.&quot;,&quot;focus&quot;:[&quot;app&quot;,&quot;pubsub-topic&quot;,&quot;dataflow&quot;,&quot;raw-archive&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A bad SDK release sends malformed events. Dataflow routes them to a dead-letter topic instead of failing the pipeline.&quot;,&quot;focus&quot;:[&quot;dataflow&quot;,&quot;dead-letters&quot;,&quot;dead-bucket&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Sessions stream into BigQuery within seconds, so Looker's dashboards are current.&quot;,&quot;focus&quot;:[&quot;bigquery&quot;,&quot;looker&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;archive&quot;,&quot;label&quot;:&quot;Every event is archived raw&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw-archive&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:9000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;sessions&quot;,&quot;label&quot;:&quot;8,800 valid events reach BigQuery&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;bigquery&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:8800,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;dead&quot;,&quot;label&quot;:&quot;200 malformed events are kept for replay&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;dead-bucket&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;autoscale&quot;,&quot;title&quot;:&quot;Backlog until Dataflow autoscales&quot;,&quot;description&quot;:&quot;600 events a second meet two workers; the subscription backlog grows until autoscaling adds six more.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:20,&quot;setup&quot;:{&quot;props&quot;:{&quot;dataflow&quot;:{&quot;replicas&quot;:2}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;clicks&quot;,&quot;node&quot;:&quot;app&quot;,&quot;messageType&quot;:&quot;ClickEvent&quot;,&quot;label&quot;:&quot;600 events/s for 10 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:600,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Two Dataflow workers handle about 200 events a second, but 600 arrive. Unacknowledged messages pile up in the subscription.&quot;,&quot;focus&quot;:[&quot;pubsub-topic&quot;,&quot;dataflow&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;dataflow&quot;,&quot;props&quot;:{&quot;replicas&quot;:8}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Autoscaling sees the backlog and adds six workers. The raw archive was never behind: its subscription is independent.&quot;,&quot;focus&quot;:[&quot;dataflow&quot;,&quot;raw-archive&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;With 800 events a second of capacity, the backlog drains and BigQuery catches up.&quot;,&quot;focus&quot;:[&quot;pubsub-topic&quot;,&quot;bigquery&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Backlog grows with two workers&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;pubsub-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;dataflow&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:3500},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Backlog drains after autoscaling&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;pubsub-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;dataflow&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;sessions&quot;,&quot;label&quot;:&quot;All 6,000 events reach BigQuery&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;bigquery&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:6000,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
