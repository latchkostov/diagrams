  <diagram id="dg-u8k5op" name="Kafka order pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Order placement with independent consumer groups, local stores and payment confirmation events." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;black-friday&quot;,&quot;title&quot;:&quot;Black Friday: 2,000 orders/s&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;shopper&quot;,&quot;messageType&quot;:&quot;OrderRequest&quot;,&quot;label&quot;:&quot;Black Friday: 2,000 orders per second&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:2000,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;20,000 checkouts at 2,000 orders/s. Each dot represents 50 orders; independent groups reserve stock, authorize payment and notify customers.&quot;,&quot;focus&quot;:[&quot;shopper&quot;,&quot;order-events&quot;]}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;PaymentCompleted updates the order without creating another order.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;payment-events&quot;,&quot;orders&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;stock&quot;,&quot;label&quot;:&quot;All 20,000 orders reserve stock&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;stock-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;payments&quot;,&quot;label&quot;:&quot;All 20,000 payments are recorded&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payment-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;notifications&quot;,&quot;label&quot;:&quot;Notifications&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;notify-cache&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;orders&quot;,&quot;label&quot;:&quot;20,000 orders created and 20,000 payment updates&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:40000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;No dlq&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-events&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;no-drop&quot;,&quot;label&quot;:&quot;No drop&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-events&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}],&quot;scale&quot;:50,&quot;description&quot;:&quot;20,000 checkouts in ten seconds; each dot represents 50 orders.&quot;,&quot;setup&quot;:{&quot;props&quot;:{&quot;orders&quot;:{&quot;replicas&quot;:12},&quot;inventory&quot;:{&quot;replicas&quot;:6},&quot;payments&quot;:{&quot;replicas&quot;:6},&quot;notifications&quot;:{&quot;replicas&quot;:6}}}},{&quot;id&quot;:&quot;payments-outage&quot;,&quot;title&quot;:&quot;Payments service goes down&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;shopper&quot;,&quot;messageType&quot;:&quot;OrderRequest&quot;,&quot;label&quot;:&quot;300 checkouts during an outage&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Inventory and notifications have independent consumer groups.&quot;,&quot;focus&quot;:[&quot;order-events&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;status&quot;:&quot;down&quot;}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Payments is offline. Its group accumulates lag while the other groups continue.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;order-events&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;payments&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Payments is back. Watch its backlog drain and the ledger catch up.&quot;,&quot;focus&quot;:[&quot;payments&quot;,&quot;payment-db&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;outage-lag&quot;,&quot;label&quot;:&quot;Payment lag grows during the outage&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;payment-authorizations&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:11000},{&quot;id&quot;:&quot;recovered&quot;,&quot;label&quot;:&quot;Recovered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;payment-authorizations&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Drained&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;order-events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;payment-authorizations&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;payments&quot;,&quot;label&quot;:&quot;Payments&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payment-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;stock&quot;,&quot;label&quot;:&quot;Stock&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;stock-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;}],&quot;scale&quot;:1}]">
