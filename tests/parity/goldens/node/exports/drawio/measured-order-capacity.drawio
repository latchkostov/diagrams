<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-gpb7a3" name="Measured order capacity">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Northwind compares the pinned processor lesson with a measured one-second payment workload: today fits, but at three times traffic the two-slot payment worker saturates." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;today&quot;,&quot;title&quot;:&quot;Measured baseline&quot;,&quot;description&quot;:&quot;One order a second fits the measured two-per-second payment budget.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;orders&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[{&quot;id&quot;:&quot;ledger-processed-end&quot;,&quot;label&quot;:&quot;ledger: processed == 6&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ledger&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:6,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;queue-lag-end&quot;,&quot;label&quot;:&quot;queue: lag == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;triple&quot;,&quot;title&quot;:&quot;Three times the orders&quot;,&quot;description&quot;:&quot;Traffic is multiplied by three, capacity stays fixed. The default intake has headroom; the measured payment worker is the bottleneck.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;orders&quot;,&quot;messageType&quot;:&quot;OrderPlaced&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Three orders/s exceed the measured 2/s payment capacity. Show capacity or open Payment worker Properties to see the arithmetic.&quot;,&quot;focus&quot;:[&quot;payment-worker&quot;,&quot;queue&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;queue-lag-at&quot;,&quot;label&quot;:&quot;queue: lag &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:6000},{&quot;id&quot;:&quot;ledger-processed-end&quot;,&quot;label&quot;:&quot;ledger: processed == 24&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ledger&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:24,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;queue-dropped-always&quot;,&quot;label&quot;:&quot;queue: dropped == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}],&quot;multipliers&quot;:{&quot;traffic&quot;:3}}]">
          <mxCell />
        </object>
