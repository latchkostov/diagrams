<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-ui7kq1" name="Cell-based bookings in three regions">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented travel company, Tidewater Travel. DNS spreads travellers across three active regions; each region hashes customers to two cells that share nothing on the request path. DynamoDB global tables replicate every booking, so a region can go dark and a bad deploy stays in one cell." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;region-evacuation&quot;,&quot;title&quot;:&quot;us-east-1 goes dark&quot;,&quot;description&quot;:&quot;Five seconds in, us-east-1's load balancer stops answering. DNS health checks send its travellers to the other two regions, whose cells were sized to absorb one region's share. Bookings keep flowing; the region returns at 18 s.&quot;,&quot;seed&quot;:21,&quot;scale&quot;:5,&quot;durationMs&quot;:30000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;web&quot;,&quot;node&quot;:&quot;travellers&quot;,&quot;label&quot;:&quot;Web bookings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:26000}},{&quot;id&quot;:&quot;app&quot;,&quot;node&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;App bookings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:90,&quot;durationMs&quot;:26000}},{&quot;id&quot;:&quot;partners&quot;,&quot;node&quot;:&quot;agents&quot;,&quot;label&quot;:&quot;Agent bookings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:30,&quot;durationMs&quot;:26000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Three regions take bookings. Each region splits customers across two cells; no request ever leaves its cell.&quot;,&quot;focus&quot;:[&quot;dns&quot;,&quot;east-alb&quot;,&quot;west-alb&quot;,&quot;eu-alb&quot;]}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;east-alb&quot;,&quot;status&quot;:&quot;down&quot;}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;us-east-1 goes dark. DNS health checks stop sending travellers there within one check.&quot;,&quot;focus&quot;:[&quot;dns&quot;,&quot;east-alb&quot;,&quot;east-router&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;us-west-2 and eu-west-1 take the extra half each. Their cells run hotter but stay under capacity: that headroom is the design.&quot;,&quot;focus&quot;:[&quot;west-c1-api&quot;,&quot;west-c2-api&quot;,&quot;eu-c1-api&quot;,&quot;eu-c2-api&quot;]}},{&quot;atMs&quot;:18000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;east-alb&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:18000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;us-east-1 is back and DNS sends its share home. Global tables replicated every booking while it was away.&quot;,&quot;focus&quot;:[&quot;dns&quot;,&quot;east-alb&quot;,&quot;east-c1-db&quot;,&quot;west-c1-db&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;west-serves&quot;,&quot;label&quot;:&quot;us-west-2 keeps booking&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;west-c1-api&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;eu-serves&quot;,&quot;label&quot;:&quot;eu-west-1 keeps booking&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;eu-c2-api&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;emails&quot;,&quot;label&quot;:&quot;Confirmations still go out&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:4000,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;bad-cell-deploy&quot;,&quot;title&quot;:&quot;A bad deploy stays in one cell&quot;,&quot;description&quot;:&quot;The release pipeline deploys to one canary cell first. The new build fails most bookings, but only in Cell 1 of us-east-1: about a sixth of traffic. The cell's alarm stops the rollout and rolls it back at 12 s.&quot;,&quot;seed&quot;:22,&quot;scale&quot;:5,&quot;durationMs&quot;:25000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;web&quot;,&quot;node&quot;:&quot;travellers&quot;,&quot;label&quot;:&quot;Web bookings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:20000}},{&quot;id&quot;:&quot;app&quot;,&quot;node&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;App bookings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:90,&quot;durationMs&quot;:20000}},{&quot;id&quot;:&quot;partners&quot;,&quot;node&quot;:&quot;agents&quot;,&quot;label&quot;:&quot;Agent bookings&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:30,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Six cells, each a complete copy of the booking stack. The pipeline deploys to one cell at a time.&quot;,&quot;focus&quot;:[&quot;pipeline&quot;,&quot;east-c1-api&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;east-c1-api&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0.8}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Build 7.3 reaches the canary cell and fails most of its bookings.&quot;,&quot;focus&quot;:[&quot;pipeline&quot;,&quot;east-c1-api&quot;,&quot;east-c1-db&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Only that cell's customers notice. The other five cells, and every other region, carry on untouched.&quot;,&quot;focus&quot;:[&quot;east-c1-api&quot;,&quot;east-c2-api&quot;,&quot;west-c1-api&quot;,&quot;eu-c1-api&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;east-c1-api&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The cell's CloudWatch alarm halts the rollout and rolls it back. Bookings succeed again.&quot;,&quot;focus&quot;:[&quot;metrics&quot;,&quot;pipeline&quot;,&quot;east-c1-api&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;contained&quot;,&quot;label&quot;:&quot;The bad build fails bookings in its cell&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;east-c1-api&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;neighbour-ok&quot;,&quot;label&quot;:&quot;The neighbouring cell never fails&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;east-c2-api&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;west-ok&quot;,&quot;label&quot;:&quot;Other regions never fail&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;west-c1-api&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
