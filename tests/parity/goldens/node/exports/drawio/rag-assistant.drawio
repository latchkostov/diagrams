<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-5pqwp2" name="RAG support assistant">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Changed docs are chunked and embedded into a vector index; questions retrieve context for an LLM, and ratings feed an eval loop." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;launch-day&quot;,&quot;title&quot;:&quot;Launch day questions&quot;,&quot;description&quot;:&quot;Questions climb to 40 a second after a product launch; a quarter of answers are rated and graded.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;questions&quot;,&quot;node&quot;:&quot;user&quot;,&quot;messageType&quot;:&quot;Question&quot;,&quot;label&quot;:&quot;Questions ramp from 5 to 40 a second&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;startRate&quot;:5,&quot;stages&quot;:[{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:40},{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:40}]}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;trace&quot;,&quot;node&quot;:&quot;rag-api&quot;}},{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each question checks the semantic cache, retrieves the closest chunks from the vector index, and sends them to the LLM as context.&quot;,&quot;focus&quot;:[&quot;rag-api&quot;,&quot;cache&quot;,&quot;vector-db&quot;,&quot;llm&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Generation is the slow step, about two seconds. Plenty of requests in flight keeps throughput up while each answer streams.&quot;,&quot;focus&quot;:[&quot;llm&quot;]}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;About a quarter of answers get a rating. An eval job asks the LLM to grade them for groundedness, and the scores feed a dashboard.&quot;,&quot;focus&quot;:[&quot;feedback&quot;,&quot;eval-job&quot;,&quot;quality&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;retrieved&quot;,&quot;label&quot;:&quot;Every question retrieves context&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;vector-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:250,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;rated&quot;,&quot;label&quot;:&quot;Rated answers are graded&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;quality&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:30,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;llm-keeps-up&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;llm&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;reindex&quot;,&quot;title&quot;:&quot;Re-index the knowledge base&quot;,&quot;description&quot;:&quot;A docs migration changes 1,200 pages at once; the ingest queue absorbs them while questions are still answered.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:4,&quot;traffic&quot;:[{&quot;id&quot;:&quot;questions&quot;,&quot;node&quot;:&quot;user&quot;,&quot;messageType&quot;:&quot;Question&quot;,&quot;label&quot;:&quot;Questions: 20 a second&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:12000}},{&quot;id&quot;:&quot;migration&quot;,&quot;node&quot;:&quot;docs&quot;,&quot;messageType&quot;:&quot;PageChanged&quot;,&quot;label&quot;:&quot;1,200 pages change at once&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:1200,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:1000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A docs migration touches 1,200 pages at once. The queue takes them all; four workers embed about 80 pages a second. Each dot is four messages.&quot;,&quot;focus&quot;:[&quot;docs&quot;,&quot;ingest-q&quot;,&quot;embed-worker&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Questions are still answered while the backlog drains. The index gets fresher page by page.&quot;,&quot;focus&quot;:[&quot;rag-api&quot;,&quot;vector-db&quot;]}},{&quot;atMs&quot;:11000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The queue is empty and every page is re-embedded. Nothing was lost, even though the burst outran the workers.&quot;,&quot;focus&quot;:[&quot;ingest-q&quot;,&quot;embeddings&quot;,&quot;vector-db&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;The queue absorbs the burst&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ingest-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:4000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Every job finishes&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ingest-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;embedded&quot;,&quot;label&quot;:&quot;1,200 pages re-embedded&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;embeddings&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1200,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;index&quot;,&quot;label&quot;:&quot;Index: 1,200 upserts + 240 searches&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;vector-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1440,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
