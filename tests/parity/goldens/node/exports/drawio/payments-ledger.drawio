<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1ht5byx" name="Payments platform with a ledger">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented payments company, Kestrel Pay. Idempotency keys, a PCI zone for card data, a durable workflow and a weighted PSP router authorize payments; an outbox feeds a double-entry ledger, merchant webhooks and a lake that a nightly job reconciles against PSP settlement files." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;psp-brownout&quot;,&quot;title&quot;:&quot;Adyen browns out&quot;,&quot;description&quot;:&quot;The PSP router sends 70% of card payments to Adyen and 30% to Stripe. Four seconds in, Adyen starts failing most authorizations; weights don't move by themselves. At nine seconds the on-call engineer shifts the router to Stripe, inside Stripe's contracted rate.&quot;,&quot;seed&quot;:31,&quot;scale&quot;:5,&quot;durationMs&quot;:22000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;merchant-traffic&quot;,&quot;node&quot;:&quot;merchants&quot;,&quot;label&quot;:&quot;Merchant API&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:18000}},{&quot;id&quot;:&quot;wallet-traffic&quot;,&quot;node&quot;:&quot;wallets&quot;,&quot;label&quot;:&quot;Wallet payments&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:18000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each payment checks its idempotency key, is tokenized inside the PCI zone, scored, and authorized by a durable workflow.&quot;,&quot;focus&quot;:[&quot;payments-api&quot;,&quot;idem&quot;,&quot;tokenizer&quot;,&quot;risk&quot;,&quot;saga&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;adyen&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0.6}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Adyen starts failing 60% of authorizations. The router keeps its 70/30 split: weights don't move by themselves.&quot;,&quot;focus&quot;:[&quot;psp-router&quot;,&quot;adyen&quot;,&quot;stripe&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;psp-router&quot;,&quot;props&quot;:{&quot;routeTable&quot;:{&quot;rules&quot;:[],&quot;default&quot;:{&quot;targets&quot;:[{&quot;edgeId&quot;:&quot;psp-router--adyen&quot;,&quot;weight&quot;:0},{&quot;edgeId&quot;:&quot;psp-router--stripe&quot;,&quot;weight&quot;:100}]}}}}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;On-call shifts every card to Stripe. Stripe's contracted 500 requests a second covers the whole load, so failures stop.&quot;,&quot;focus&quot;:[&quot;psp-router&quot;,&quot;stripe&quot;]}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every authorization, failed or not, is recorded through the outbox: the ledger and merchant webhooks never miss one.&quot;,&quot;focus&quot;:[&quot;payments-db&quot;,&quot;outbox-relay&quot;,&quot;payment-events&quot;,&quot;poster&quot;,&quot;hooks-out&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;adyen-failed&quot;,&quot;label&quot;:&quot;Adyen fails authorizations&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;adyen&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;stripe-fits&quot;,&quot;label&quot;:&quot;Stripe takes over the load&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;stripe&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:1500,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;ledger-complete&quot;,&quot;label&quot;:&quot;The ledger posts every payment event&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payment-events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;ledger&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;poison-dispute&quot;,&quot;title&quot;:&quot;A poison dispute notification&quot;,&quot;description&quot;:&quot;Adyen starts sending a new dispute format. The Disputes handler can't parse it: each one fails three times and lands in the PSP events DLQ, while charge updates in the same queue keep flowing. After the fix ships, redrive replays the parked disputes.&quot;,&quot;seed&quot;:32,&quot;scale&quot;:1,&quot;durationMs&quot;:22000,&quot;setup&quot;:{&quot;status&quot;:{&quot;psp-redrive&quot;:&quot;paused&quot;}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;charges&quot;,&quot;node&quot;:&quot;psp-hooks&quot;,&quot;label&quot;:&quot;Charge notifications&quot;,&quot;messageType&quot;:&quot;ChargeSucceeded&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:16000}},{&quot;id&quot;:&quot;disputes&quot;,&quot;node&quot;:&quot;psp-hooks&quot;,&quot;label&quot;:&quot;New-format disputes&quot;,&quot;messageType&quot;:&quot;DisputeOpened&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:12,&quot;atMs&quot;:3000,&quot;spreadMs&quot;:2000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;PSP notifications are verified, queued, and filtered by type: charge updates and disputes have their own consumers.&quot;,&quot;focus&quot;:[&quot;psp-hooks&quot;,&quot;hook-ingest&quot;,&quot;psp-q&quot;,&quot;psp-events&quot;,&quot;disputes&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;disputes&quot;,&quot;props&quot;:{&quot;failureRate&quot;:1}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Disputes arrive in a new format the handler can't parse.&quot;,&quot;focus&quot;:[&quot;psp-q&quot;,&quot;disputes&quot;]}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each fails three times and parks in the DLQ. Charge updates keep flowing past them.&quot;,&quot;focus&quot;:[&quot;psp-q&quot;,&quot;psp-dlq&quot;,&quot;psp-events&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;disputes&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;psp-redrive&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The fix ships. Redrive replays the parked disputes and they succeed.&quot;,&quot;focus&quot;:[&quot;psp-dlq&quot;,&quot;psp-redrive&quot;,&quot;disputes&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;parked&quot;,&quot;label&quot;:&quot;Every new-format dispute is dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;psp-q&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:12,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;charges-flow&quot;,&quot;label&quot;:&quot;Charge updates never fail&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;psp-events&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;replayed&quot;,&quot;label&quot;:&quot;Redrive replays every parked dispute&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;psp-dlq&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;create-payment&quot;,&quot;label&quot;:&quot;Create payment&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/v1/payments&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:0,&quot;marker&quot;:&quot;circle&quot;}},{&quot;id&quot;:&quot;get-payment&quot;,&quot;label&quot;:&quot;Read payment&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/v1/payments/pay_42&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:1,&quot;marker&quot;:&quot;square&quot;}},{&quot;id&quot;:&quot;refund&quot;,&quot;label&quot;:&quot;Refund&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/v1/refunds&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:3,&quot;marker&quot;:&quot;triangle&quot;}}]}">
