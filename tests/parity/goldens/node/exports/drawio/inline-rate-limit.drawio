<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-fem7pz" name="An inline request rate limit">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="A fictional partner sends 20 requests/s through a 10 requests/s token bucket. Go Live to see rejections within seconds, then double-click the limiter and change Rate limit in Simulation.">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-partner" label="Partner client" dg_id="partner" dg_stencil="client.user" dg_props="{&quot;ratePerSec&quot;:20}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#0EA5E91A;strokeColor=#0EA5E9;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="20" y="6" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-limiter" label="Rate limiter" dg_id="limiter" dg_stencil="generic.rate-limiter" dg_props="{&quot;latencyMs&quot;:0,&quot;jitter&quot;:0,&quot;api&quot;:{&quot;quotas&quot;:[{&quot;id&quot;:&quot;local-rate&quot;,&quot;unit&quot;:&quot;requests&quot;,&quot;amount&quot;:10,&quot;windowMs&quot;:1000,&quot;algorithm&quot;:&quot;token-bucket&quot;,&quot;burst&quot;:10}]}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#CA8A041A;strokeColor=#CA8A04;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="320" y="6" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-api" label="Catalog API" dg_id="api" dg_stencil="generic.service" dg_props="{&quot;latencyMs&quot;:10,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="620" y="6" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-partner-limiter" label="" dg_id="partner-limiter" dg_kind="sync">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-partner" target="dg-n-limiter">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-limiter-api" label="" dg_id="limiter-api" dg_kind="sync">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-limiter" target="dg-n-api">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
