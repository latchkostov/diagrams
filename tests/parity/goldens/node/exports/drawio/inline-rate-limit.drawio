<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-fem7pz" name="An inline request rate limit">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="A fictional partner sends 20 requests/s through a 10 requests/s token bucket. Go Live to see rejections within seconds, then double-click the limiter and change Rate limit in Simulation. Rounded boundaries align the partner, rate limit and catalog regions; the dashed rounded zone marks the request path.">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-a-request-path" label="Request path" dg_id="request-path" dg_annotation="zone" dg_color="purple" dg_text="Request path" dg_border_radius="32">
          <mxCell style="rounded=1;arcSize=64;absoluteArcSize=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#EDE7FE;fillOpacity=55;strokeColor=#8B5CF6;fontColor=#8B5CF6;" vertex="1" parent="1">
            <mxGeometry x="-60" y="-150" width="940" height="330" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-g-partner-region" label="Partner" dg_id="partner-region" dg_tone="neutral" dg_border_radius="28">
          <mxCell style="rounded=1;arcSize=56;absoluteArcSize=1;dashed=1;spacingLeft=12;spacingTop=4;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;fillColor=none;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#94A3B8;strokeColor=#94A3B8;" vertex="1" parent="1">
            <mxGeometry x="-30" y="-70" width="280" height="200" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-g-limit-region" label="Rate limit" dg_id="limit-region" dg_tone="azure" dg_border_radius="28">
          <mxCell style="rounded=1;arcSize=56;absoluteArcSize=1;dashed=1;spacingLeft=12;spacingTop=4;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;fillColor=none;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#0078D4;strokeColor=#0078D4;" vertex="1" parent="1">
            <mxGeometry x="270" y="-70" width="280" height="200" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-g-catalog-region" label="Catalog" dg_id="catalog-region" dg_tone="gcp" dg_border_radius="28">
          <mxCell style="rounded=1;arcSize=56;absoluteArcSize=1;dashed=1;spacingLeft=12;spacingTop=4;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;fillColor=none;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#4285F4;strokeColor=#4285F4;" vertex="1" parent="1">
            <mxGeometry x="570" y="-70" width="280" height="200" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-partner" label="Partner client" dg_id="partner" dg_stencil="client.user" dg_props="{&quot;ratePerSec&quot;:20}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#0EA5E91A;strokeColor=#0EA5E9;fontSize=12;" vertex="1" parent="dg-g-partner-region">
            <mxGeometry x="50" y="76" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-limiter" label="Rate limiter" dg_id="limiter" dg_stencil="generic.rate-limiter" dg_props="{&quot;latencyMs&quot;:0,&quot;jitter&quot;:0,&quot;api&quot;:{&quot;quotas&quot;:[{&quot;id&quot;:&quot;local-rate&quot;,&quot;unit&quot;:&quot;requests&quot;,&quot;amount&quot;:10,&quot;windowMs&quot;:1000,&quot;algorithm&quot;:&quot;token-bucket&quot;,&quot;burst&quot;:10}]}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#CA8A041A;strokeColor=#CA8A04;fontSize=12;" vertex="1" parent="dg-g-limit-region">
            <mxGeometry x="50" y="76" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-api" label="Catalog API" dg_id="api" dg_stencil="generic.service" dg_props="{&quot;latencyMs&quot;:10,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="dg-g-catalog-region">
            <mxGeometry x="50" y="76" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-partner-limiter" label="" dg_id="partner-limiter" dg_kind="sync">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-partner" target="dg-n-limiter">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-limiter-api" label="" dg_id="limiter-api" dg_kind="sync">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-limiter" target="dg-n-api">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
