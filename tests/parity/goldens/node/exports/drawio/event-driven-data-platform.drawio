<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-5j2bqv" name="Event-driven data platform">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Operational events stream through Kafka into Snowflake; dbt builds marts and reverse ETL publishes segments back to Kafka." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;one-order&quot;,&quot;title&quot;:&quot;Follow one order end to end&quot;,&quot;description&quot;:&quot;One checkout travels through Kafka, Snowflake and dbt, then comes back out as a segment change.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;order&quot;,&quot;node&quot;:&quot;storefront&quot;,&quot;messageType&quot;:&quot;CheckoutRequest&quot;,&quot;label&quot;:&quot;One checkout&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:1}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;trace&quot;,&quot;node&quot;:&quot;checkout&quot;}},{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A shopper checks out. Follow this one order through Kafka, Snowflake and dbt, and back out to Kafka as a segment change.&quot;,&quot;focus&quot;:[&quot;storefront&quot;,&quot;checkout&quot;,&quot;orders-topic&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The Snowflake Kafka connector streams the event into a RAW table within about a second. There is no nightly batch window.&quot;,&quot;focus&quot;:[&quot;orders-topic&quot;,&quot;snowpipe&quot;,&quot;raw&quot;]}},{&quot;atMs&quot;:2600,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;dbt's incremental models turn the raw row into marts. This order moves the customer into a new segment.&quot;,&quot;focus&quot;:[&quot;raw&quot;,&quot;dbt&quot;,&quot;marts&quot;]}},{&quot;atMs&quot;:5600,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Reverse ETL compares the mart with its last sync and publishes only the changed row to customer-segments.v1.&quot;,&quot;focus&quot;:[&quot;marts&quot;,&quot;reverse-etl&quot;,&quot;segments-topic&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Personalization and the marketing tool consume the change like any other event, each in its own consumer group.&quot;,&quot;focus&quot;:[&quot;segments-topic&quot;,&quot;personalization&quot;,&quot;marketing&quot;],&quot;pause&quot;:true}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;raw&quot;,&quot;label&quot;:&quot;The order lands in RAW&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;marts&quot;,&quot;label&quot;:&quot;dbt builds it into the marts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;marts&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;cache&quot;,&quot;label&quot;:&quot;Personalization caches the new segment&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;segment-cache&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;marketing&quot;,&quot;label&quot;:&quot;The marketing tool receives it&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;marketing&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;load-spike&quot;,&quot;title&quot;:&quot;Warehouse load spike&quot;,&quot;description&quot;:&quot;Month-end invoices spike to 600/s on top of steady orders and CDC; Kafka absorbs the burst while the loader catches up.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:20,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;storefront&quot;,&quot;messageType&quot;:&quot;CheckoutRequest&quot;,&quot;label&quot;:&quot;Steady orders: 200/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:200,&quot;durationMs&quot;:10000}},{&quot;id&quot;:&quot;invoices&quot;,&quot;node&quot;:&quot;billing-webhooks&quot;,&quot;messageType&quot;:&quot;InvoicePaid&quot;,&quot;label&quot;:&quot;Month-end invoices peak at 600/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:20,&quot;peakRate&quot;:600,&quot;atMs&quot;:3000,&quot;peakMs&quot;:3000,&quot;durationMs&quot;:10000}},{&quot;id&quot;:&quot;accounts&quot;,&quot;node&quot;:&quot;accounts-db&quot;,&quot;messageType&quot;:&quot;AccountChanged&quot;,&quot;label&quot;:&quot;Account changes: 50/s&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Orders, invoices and account changes all stream into Snowflake. Each dot is 20 events. The connector loads about 600 rows a second.&quot;,&quot;focus&quot;:[&quot;orders-topic&quot;,&quot;billing-topic&quot;,&quot;accounts-topic&quot;,&quot;snowpipe&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Month-end: invoice webhooks jump to 600 a second. The loader falls behind, and Kafka absorbs the burst as consumer lag.&quot;,&quot;focus&quot;:[&quot;billing-webhooks&quot;,&quot;billing-topic&quot;,&quot;snowpipe&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:6500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Producers never slowed down. Once the spike passes, the connector drains the lag and RAW catches up.&quot;,&quot;focus&quot;:[&quot;snowpipe&quot;,&quot;raw&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Only order-driven segment changes flow back out through reverse ETL. Invoices and account rows stay in the marts.&quot;,&quot;focus&quot;:[&quot;marts&quot;,&quot;reverse-etl&quot;,&quot;segments-topic&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag&quot;,&quot;label&quot;:&quot;The loader falls behind during the spike&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;billing-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;snowflake-sink&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:5500},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Lag drains to zero&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;billing-topic&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;snowflake-sink&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;raw&quot;,&quot;label&quot;:&quot;All 4,440 events land in RAW&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:4440,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drop&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;billing-topic&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;segments&quot;,&quot;label&quot;:&quot;2,000 segment changes reach marketing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;marketing&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:2000,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
