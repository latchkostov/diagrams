          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#7C3AED1A;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="440" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-worker" label="Thumbnail workers" dg_id="worker" dg_stencil="service.go" dg_props="{&quot;replicas&quot;:1,&quot;concurrency&quot;:4,&quot;latencyMs&quot;:250,&quot;jitter&quot;:0,&quot;resources&quot;:{&quot;preset&quot;:&quot;io-service&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;cpuMsPerMessage&quot;:40,&quot;baselineMemoryMiB&quot;:128,&quot;memoryMiBPerMessage&quot;:2,&quot;cpuRequestMilli&quot;:500,&quot;cpuLimitMilli&quot;:1000,&quot;memoryRequestMiB&quot;:256,&quot;memoryLimitMiB&quot;:512,&quot;startup&quot;:{&quot;delayMs&quot;:2000,&quot;jitterFraction&quot;:0},&quot;terminationGraceMs&quot;:30000},&quot;autoscaling&quot;:{&quot;mode&quot;:&quot;on&quot;,&quot;modelRevision&quot;:&quot;a1&quot;,&quot;preset&quot;:&quot;hpa-service&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;controller&quot;:{&quot;kind&quot;:&quot;hpa&quot;,&quot;minReplicas&quot;:1,&quot;maxReplicas&quot;:6,&quot;initialReplicas&quot;:1,&quot;settings&quot;:{&quot;syncMs&quot;:1000,&quot;tolerance&quot;:0.1,&quot;initialReadinessDelayMs&quot;:0,&quot;cpuInitializationPeriodMs&quot;:0,&quot;metrics&quot;:[{&quot;source&quot;:{&quot;kind&quot;:&quot;resource&quot;,&quot;resource&quot;:&quot;cpu&quot;},&quot;target&quot;:{&quot;kind&quot;:&quot;utilization&quot;,&quot;percentOfRequest&quot;:70},&quot;windowMs&quot;:1000,&quot;metricDelayMs&quot;:0}],&quot;up&quot;:{&quot;stabilizationMs&quot;:0,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Pods&quot;,&quot;value&quot;:4,&quot;periodMs&quot;:15000},{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]},&quot;down&quot;:{&quot;stabilizationMs&quot;:30000,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]}}}}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#00ADD81A;strokeColor=#00ADD8;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="800" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-images" label="Thumbnails" dg_id="images" dg_stencil="aws.s3" dg_props="{&quot;latencyMs&quot;:10,&quot;jitter&quot;:0}">
          <mxCell style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#7AA116;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
            <mxGeometry x="1222" y="188" width="56" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-publish" label="" dg_id="publish" dg_kind="async" dg_props="{&quot;travelMs&quot;:10}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#7C8597;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dg-n-source" target="dg-n-uploads">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-consume" label="" dg_id="consume" dg_kind="async" dg_props="{&quot;travelMs&quot;:10,&quot;group&quot;:&quot;thumbnails&quot;}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#7C8597;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dg-n-uploads" target="dg-n-worker">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
