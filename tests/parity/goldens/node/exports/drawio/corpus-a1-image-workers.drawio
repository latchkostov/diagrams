<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1o8e86z" name="Image workers absorb a burst">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented image-processing pipeline: a Kafka topic buffers uploads while HPA starts workers. The saved burst shows backlog building, replicas becoming ready and the backlog draining within ten simulated seconds. This teaching model explicitly uses a 1 s sync, 1 s metric window, 2 s startup and 30 s downscale stabilization; these are not Kubernetes defaults. Open a worker’s Live details for replica history." dg_simulations="[{&quot;id&quot;:&quot;upload-burst&quot;,&quot;title&quot;:&quot;Upload burst&quot;,&quot;seed&quot;:42,&quot;scale&quot;:1,&quot;durationMs&quot;:24000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;burst&quot;,&quot;node&quot;:&quot;source&quot;,&quot;messageType&quot;:&quot;ImageUploaded&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:48,&quot;durationMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Demand is above one worker’s target. New replicas start while Kafka holds the backlog.&quot;,&quot;focus&quot;:[&quot;uploads&quot;,&quot;worker&quot;]}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Ready workers drain the upload burst. Open Live details to see desired and ready replicas over time.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;buffered&quot;,&quot;label&quot;:&quot;Uploads wait for starting workers&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uploads&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;thumbnails&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:2000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Every upload finishes&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;worker&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:192,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;empty&quot;,&quot;label&quot;:&quot;The topic backlog drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uploads&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;thumbnails&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;settle-down&quot;,&quot;title&quot;:&quot;Quiet after the burst&quot;,&quot;seed&quot;:42,&quot;scale&quot;:1,&quot;durationMs&quot;:48000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;burst&quot;,&quot;node&quot;:&quot;source&quot;,&quot;messageType&quot;:&quot;ImageUploaded&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:48,&quot;durationMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Demand is above one worker’s target. New replicas start while Kafka holds the backlog.&quot;,&quot;focus&quot;:[&quot;uploads&quot;,&quot;worker&quot;]}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Ready workers drain the upload burst. Open Live details to see desired and ready replicas over time.&quot;,&quot;focus&quot;:[&quot;worker&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;buffered&quot;,&quot;label&quot;:&quot;Uploads wait for starting workers&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uploads&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;thumbnails&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:2000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Every upload finishes&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;worker&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:192,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;empty&quot;,&quot;label&quot;:&quot;The topic backlog drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uploads&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;thumbnails&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-source" label="Upload clients" dg_id="source" dg_stencil="client.browser" dg_props="{&quot;ratePerSec&quot;:4}">
