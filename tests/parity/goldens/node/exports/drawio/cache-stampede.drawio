        <object id="dg-e-read" label="" dg_id="read" dg_kind="sync" dg_props="{&quot;caller&quot;:{&quot;wait&quot;:&quot;blocking&quot;}}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-origin" target="dg-n-db">
