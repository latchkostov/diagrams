<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-53e0g7" name="A cache stampede">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="A small store serves 400 requests/s: 80% want one launch item, kept for five seconds. A four-thread Product API can handle the warm product tail, but repeated expiry herds grow from about 65 to 640 fetches in flight, leaving thousands queued and shoppers waiting five seconds. Compare the same seed with One fetch per item: one launch fetch per expiry, a backlog below 10 and p95 below 300 ms. Many CDNs collapse requests like this by default." dg_simulations="[{&quot;id&quot;:&quot;ttl-only&quot;,&quot;title&quot;:&quot;TTL only&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:40000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;shoppers&quot;,&quot;node&quot;:&quot;shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:40000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Watch Edge CDN: 320 requests/s want one launch item. It expires every five seconds; the Product API has four threads.&quot;,&quot;focus&quot;:[&quot;cdn&quot;,&quot;origin&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each miss fetches the same item. Queuing makes the next reply slower, so more requests join the herd.&quot;,&quot;focus&quot;:[&quot;cdn&quot;,&quot;origin&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Product API backlog &lt; 50, always&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;origin&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:50,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;latency&quot;,&quot;label&quot;:&quot;Shoppers p95 &lt; 300 ms at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shoppers&quot;,&quot;field&quot;:&quot;p95&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;fetches&quot;,&quot;label&quot;:&quot;Launch page fetches in flight &lt; 5, always&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;cdn&quot;,&quot;field&quot;:&quot;itemFetches&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:5,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;one-fetch&quot;,&quot;title&quot;:&quot;One fetch per item&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;durationMs&quot;:40000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;shoppers&quot;,&quot;node&quot;:&quot;shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:40000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Watch Edge CDN: 320 requests/s want one launch item. It expires every five seconds; the Product API has four threads.&quot;,&quot;focus&quot;:[&quot;cdn&quot;,&quot;origin&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;One origin fetch serves everyone waiting for the same item.&quot;,&quot;focus&quot;:[&quot;cdn&quot;,&quot;origin&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;backlog&quot;,&quot;label&quot;:&quot;Product API backlog &lt; 50, always&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;origin&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:50,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;latency&quot;,&quot;label&quot;:&quot;Shoppers p95 &lt; 300 ms at the end&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;shoppers&quot;,&quot;field&quot;:&quot;p95&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;fetches&quot;,&quot;label&quot;:&quot;Launch page fetches in flight &lt; 5, always&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;cdn&quot;,&quot;field&quot;:&quot;itemFetches&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:5,&quot;when&quot;:&quot;always&quot;}],&quot;setup&quot;:{&quot;props&quot;:{&quot;cdn&quot;:{&quot;cache&quot;:{&quot;rules&quot;:[{&quot;id&quot;:&quot;launch&quot;,&quot;label&quot;:&quot;Launch page&quot;,&quot;match&quot;:{&quot;path&quot;:{&quot;kind&quot;:&quot;exact&quot;,&quot;value&quot;:&quot;/launch&quot;}},&quot;policy&quot;:{&quot;ttlMs&quot;:5000,&quot;keys&quot;:1,&quot;coalesce&quot;:true}},{&quot;id&quot;:&quot;products&quot;,&quot;label&quot;:&quot;Other products&quot;,&quot;match&quot;:{&quot;path&quot;:{&quot;kind&quot;:&quot;prefix&quot;,&quot;value&quot;:&quot;/products/&quot;}},&quot;policy&quot;:{&quot;ttlMs&quot;:300000,&quot;keys&quot;:20000,&quot;popularity&quot;:&quot;typical&quot;}}]}}}}}]" dg_planning="{&quot;revision&quot;:&quot;p3-w3&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;launch&quot;,&quot;label&quot;:&quot;Launch page&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/launch&quot;}},{&quot;id&quot;:&quot;products&quot;,&quot;label&quot;:&quot;Other products&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/products/example&quot;}}]}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-shoppers" label="Shoppers" dg_id="shoppers" dg_stencil="client.browser" dg_props="{&quot;ratePerSec&quot;:400,&quot;trafficMix&quot;:{&quot;mode&quot;:&quot;shares&quot;,&quot;entries&quot;:[{&quot;routeId&quot;:&quot;launch&quot;,&quot;share&quot;:0.8},{&quot;routeId&quot;:&quot;products&quot;,&quot;share&quot;:0.2}]}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="20" y="166" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-cdn" label="Edge CDN" dg_id="cdn" dg_stencil="generic.cdn" dg_props="{&quot;latencyMs&quot;:5,&quot;jitter&quot;:0,&quot;cache&quot;:{&quot;rules&quot;:[{&quot;id&quot;:&quot;launch&quot;,&quot;label&quot;:&quot;Launch page&quot;,&quot;match&quot;:{&quot;path&quot;:{&quot;kind&quot;:&quot;exact&quot;,&quot;value&quot;:&quot;/launch&quot;}},&quot;policy&quot;:{&quot;ttlMs&quot;:5000,&quot;keys&quot;:1}},{&quot;id&quot;:&quot;products&quot;,&quot;label&quot;:&quot;Other products&quot;,&quot;match&quot;:{&quot;path&quot;:{&quot;kind&quot;:&quot;prefix&quot;,&quot;value&quot;:&quot;/products/&quot;}},&quot;policy&quot;:{&quot;ttlMs&quot;:300000,&quot;keys&quot;:20000,&quot;popularity&quot;:&quot;typical&quot;}}]}}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#06B6D41A;strokeColor=#06B6D4;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="350" y="166" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-origin" label="Product API&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;4 threads · 60 ms · blocking&lt;/span&gt;" dg_id="origin" dg_stencil="generic.service" dg_props="{&quot;replicas&quot;:1,&quot;concurrency&quot;:4,&quot;latencyMs&quot;:60,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="680" y="166" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-db" label="Catalog DB" dg_id="db" dg_stencil="generic.database" dg_props="{&quot;latencyMs&quot;:20,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#0D94881A;strokeColor=#0D9488;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1010" y="166" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-requests" label="" dg_id="requests" dg_kind="sync" dg_props="{&quot;networkDelayMs&quot;:15}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-shoppers" target="dg-n-cdn">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-fetch" label="" dg_id="fetch" dg_kind="sync" dg_props="{&quot;networkDelayMs&quot;:50,&quot;caller&quot;:{&quot;deadlineMs&quot;:2000}}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-cdn" target="dg-n-origin">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
