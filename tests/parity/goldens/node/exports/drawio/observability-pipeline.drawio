<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-zhbi64" name="Observability pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented platform team, Halyard Ops. Every request a shop service handles sends logs, spans and metrics to node agents, then through load-balanced gateway collectors that tail-sample traces, into Kafka. Kafka buffers each signal for its own backends, so an outage or a log storm in one never stalls the rest." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;log-storm&quot;,&quot;title&quot;:&quot;An incident log storm&quot;,&quot;description&quot;:&quot;A bad Checkout deploy logs every retry: telemetry jumps fivefold for ten seconds. Gateway collectors scale on CPU, Kafka absorbs the burst, and the log ingesters work through their lag without slowing traces or metrics.&quot;,&quot;seed&quot;:81,&quot;scale&quot;:20,&quot;durationMs&quot;:40000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;shop&quot;,&quot;node&quot;:&quot;shoppers&quot;,&quot;label&quot;:&quot;Shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:30000}},{&quot;id&quot;:&quot;storm&quot;,&quot;node&quot;:&quot;agent-shop&quot;,&quot;label&quot;:&quot;Checkout's retry logs&quot;,&quot;messageType&quot;:&quot;RetryLog&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1600,&quot;fromMs&quot;:3000,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every request sends telemetry to the node agents, then to gateway collectors behind a load balancer that hashes by trace ID.&quot;,&quot;focus&quot;:[&quot;agent-shop&quot;,&quot;otlp-lb&quot;,&quot;gateways&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A bad Checkout deploy logs every retry: five times the telemetry. The gateway collectors' CPU climbs and their HPA adds pods.&quot;,&quot;focus&quot;:[&quot;agent-shop&quot;,&quot;gateways&quot;,&quot;tenant-limits&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Kafka absorbs the logs. The ingesters fall behind for a while; traces and metrics, in their own topics, don't.&quot;,&quot;focus&quot;:[&quot;logs&quot;,&quot;ingesters&quot;,&quot;spans&quot;,&quot;metrics&quot;]}},{&quot;atMs&quot;:20000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The deploy is rolled back and the ingesters catch up. Nothing was dropped.&quot;,&quot;focus&quot;:[&quot;logs&quot;,&quot;ingesters&quot;,&quot;loki-store&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag&quot;,&quot;label&quot;:&quot;Log ingestion falls behind&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;logs&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;loki&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:500,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;caught-up&quot;,&quot;label&quot;:&quot;Log ingestion catches up&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;logs&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;loki&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;spans-flow&quot;,&quot;label&quot;:&quot;Traces never fall behind&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;spans&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;tempo&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;loki-outage&quot;,&quot;title&quot;:&quot;Drill: Loki is down for ten seconds&quot;,&quot;description&quot;:&quot;Loki's write path fails. Kafka keeps every log for the ingesters while dashboards for traces and metrics carry on; when Loki returns, the backlog drains in order.&quot;,&quot;seed&quot;:82,&quot;scale&quot;:10,&quot;durationMs&quot;:35000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;shop&quot;,&quot;node&quot;:&quot;shoppers&quot;,&quot;label&quot;:&quot;Shoppers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:25000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Logs, spans and metrics each have their own topic and consumers.&quot;,&quot;focus&quot;:[&quot;logs&quot;,&quot;spans&quot;,&quot;metrics&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;boundary&quot;,&quot;boundary&quot;:&quot;loki&quot;,&quot;down&quot;:true}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Drill: take down the Loki boundary. Kafka keeps the logs: nothing is lost, it just waits.&quot;,&quot;focus&quot;:[&quot;logs&quot;,&quot;ingesters&quot;,&quot;loki-store&quot;]}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;boundary&quot;,&quot;boundary&quot;:&quot;loki&quot;,&quot;down&quot;:false}}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Loki is back and the ingesters drain the backlog. ClickHouse and the archive never stopped.&quot;,&quot;focus&quot;:[&quot;logs&quot;,&quot;ingesters&quot;,&quot;ch-sink&quot;,&quot;s3-sink&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;held&quot;,&quot;label&quot;:&quot;Logs wait in Kafka during the outage&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;logs&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;loki&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:1000,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:13000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The backlog drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;logs&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;loki&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-loss&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ingesters&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
