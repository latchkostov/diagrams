        <object id="dg-e-replay-to-exchange" label="Republish" dg_id="replay-to-exchange" dg_kind="async" dg_props="{&quot;travelMs&quot;:300}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#7C8597;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dg-n-replay" target="dg-n-exchange">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-operator-to-replay" label="Start replay" dg_id="operator-to-replay" dg_kind="async" dg_relation="depends">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.25;fontSize=11;labelBackgroundColor=default;strokeColor=#556075;dashed=1;dashPattern=1 4;dfRelation=depends;" edge="1" parent="1" source="dg-n-operator" target="dg-n-replay">
            <mxGeometry relative="1" as="geometry" />
