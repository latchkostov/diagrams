<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-xyngd3" name="Webhook ingestion at scale">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Partner webhooks are verified and acknowledged fast, buffered in RabbitMQ, retried with backoff, dead-lettered and replayed on demand." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;bulk-sync&quot;,&quot;title&quot;:&quot;Partner bulk sync: 5,000 in 5 seconds&quot;,&quot;description&quot;:&quot;A partner replays a day of changes at 1,000 webhooks a second; receivers ack immediately and the queue absorbs the rest.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:20,&quot;traffic&quot;:[{&quot;id&quot;:&quot;bulk&quot;,&quot;node&quot;:&quot;partners&quot;,&quot;messageType&quot;:&quot;WebhookEvent&quot;,&quot;label&quot;:&quot;1,000 webhooks/s for 5 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1000,&quot;durationMs&quot;:5000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A partner sends 1,000 webhooks a second. The receiver only verifies the signature, stores the body and publishes, so it answers 202 in milliseconds. Each dot is 20 webhooks.&quot;,&quot;focus&quot;:[&quot;partners&quot;,&quot;receiver&quot;,&quot;raw&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Workers apply about 400 a second. The queue holds the difference, so the partner never sees a timeout and never retries.&quot;,&quot;focus&quot;:[&quot;queue&quot;,&quot;workers&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The backlog drains. Event IDs are recorded, so a partner's duplicate delivery is applied once.&quot;,&quot;focus&quot;:[&quot;workers&quot;,&quot;dedupe&quot;,&quot;integration-db&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;buffered&quot;,&quot;label&quot;:&quot;The queue absorbs the burst&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:4000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The backlog drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;applied&quot;,&quot;label&quot;:&quot;All 5,000 changes applied&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;integration-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:5000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;stored&quot;,&quot;label&quot;:&quot;All 5,000 bodies stored for replay&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;raw&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:5000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;Nothing is dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;outage-replay&quot;,&quot;title&quot;:&quot;Database outage, then replay&quot;,&quot;description&quot;:&quot;The integration database fails for six seconds. Retries with backoff save some events; the rest are dead-lettered and replayed by the on-call engineer.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;setup&quot;:{&quot;status&quot;:{&quot;dlq&quot;:&quot;paused&quot;}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;steady&quot;,&quot;node&quot;:&quot;partners&quot;,&quot;messageType&quot;:&quot;WebhookEvent&quot;,&quot;label&quot;:&quot;30 webhooks/s for 8 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:30,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;workers&quot;,&quot;props&quot;:{&quot;failureRate&quot;:1}}},{&quot;atMs&quot;:1000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The integration database goes down. Workers reject each delivery, and it comes back after a short backoff.&quot;,&quot;focus&quot;:[&quot;workers&quot;,&quot;integration-db&quot;,&quot;queue&quot;]}},{&quot;atMs&quot;:6500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;After five tries a webhook is parked in the dead-letter queue rather than retried forever. Nothing is lost: partners already got their 202.&quot;,&quot;focus&quot;:[&quot;queue&quot;,&quot;dlq&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;workers&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The database is back. Webhooks still retrying go through by themselves.&quot;,&quot;focus&quot;:[&quot;workers&quot;,&quot;integration-db&quot;]}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;dlq&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The on-call engineer replays the DLQ. Republished events run through the same idempotent workers.&quot;,&quot;focus&quot;:[&quot;operator&quot;,&quot;replay&quot;,&quot;dlq&quot;,&quot;exchange&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;parked&quot;,&quot;label&quot;:&quot;Webhooks are parked, not dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:9500},{&quot;id&quot;:&quot;applied&quot;,&quot;label&quot;:&quot;All 240 webhooks are applied&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;integration-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:240,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;dlq-empty&quot;,&quot;label&quot;:&quot;The DLQ is empty after the replay&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;dlq&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drop&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-g-k8s" label="Kubernetes" dg_id="k8s" dg_tone="k8s">
