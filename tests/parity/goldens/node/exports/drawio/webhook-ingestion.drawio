            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-receiver-to-exchange" label="Publish" dg_id="receiver-to-exchange" dg_kind="async" dg_props="{&quot;travelMs&quot;:300}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#7C8597;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dg-n-receiver" target="dg-n-exchange">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-exchange-to-queue" label="webhook.#" dg_id="exchange-to-queue" dg_kind="async" dg_props="{&quot;travelMs&quot;:300,&quot;group&quot;:&quot;process&quot;}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#7C8597;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dg-n-exchange" target="dg-n-queue">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-queue-to-workers" label="Prefetch 4" dg_id="queue-to-workers" dg_kind="async" dg_props="{&quot;travelMs&quot;:300}">
