  <diagram id="dg-2092ne" name="AWS order fan-out">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="An order API publishes SNS events to isolated fulfillment, archive and receipt queues, with scheduled reconciliation." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;steady-spike&quot;,&quot;title&quot;:&quot;Steady traffic then spike&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;OrderRequest&quot;,&quot;label&quot;:&quot;290 orders: steady demand and a flash sale&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:15,&quot;peakRate&quot;:100,&quot;atMs&quot;:3000,&quot;peakMs&quot;:2000,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;SNS fans each order into isolated fulfillment, archive and receipt queues.&quot;,&quot;focus&quot;:[&quot;sns&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The flash sale peaks at 100 orders per second.&quot;,&quot;focus&quot;:[&quot;client&quot;,&quot;fulfillment-q&quot;,&quot;archive-q&quot;,&quot;receipt-q&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;fulfillment&quot;,&quot;label&quot;:&quot;Fulfillment&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ddb&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:290,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;archive&quot;,&quot;label&quot;:&quot;Archive&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;s3&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:290,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;receipts&quot;,&quot;label&quot;:&quot;Receipts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;receipt-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:290,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;No dlq&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}],&quot;scale&quot;:2},{&quot;id&quot;:&quot;throttle&quot;,&quot;title&quot;:&quot;Lambda throttling&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;OrderRequest&quot;,&quot;label&quot;:&quot;300 orders under reserved-concurrency pressure&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;fulfill&quot;,&quot;props&quot;:{&quot;concurrency&quot;:1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Fulfillment is throttled to one Lambda worker. The other queues remain independent.&quot;,&quot;focus&quot;:[&quot;fulfill&quot;,&quot;fulfillment-q&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;fulfill&quot;,&quot;props&quot;:{&quot;concurrency&quot;:64}}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Reserved concurrency is restored; fulfillment catches up.&quot;,&quot;focus&quot;:[&quot;fulfill&quot;,&quot;ddb&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag-grows&quot;,&quot;label&quot;:&quot;Lag grows&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:8000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Drained&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;fulfillment&quot;,&quot;label&quot;:&quot;Fulfillment&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ddb&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;archive&quot;,&quot;label&quot;:&quot;Archive&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;s3&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;receipts&quot;,&quot;label&quot;:&quot;Receipts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;receipt-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;}],&quot;scale&quot;:2}]">
          <mxCell />
        </object>
