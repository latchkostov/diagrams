<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1h6k1h4" name="Video-on-demand pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented creator video platform, Lumen Studio. Uploads start an ingest workflow that fans out 4K, HD and audio encodes to queues, where KEDA scales encoders on depth; packaging fetches DRM keys and publishes HLS and DASH. Viewers stream through a CDN whose route table sends almost every segment to the edge cache." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;premiere-uploads&quot;,&quot;title&quot;:&quot;Premiere day: where the encode time goes&quot;,&quot;description&quot;:&quot;A studio delivers a festival slate: masters arrive six times faster for six seconds. Each becomes three encode jobs; KEDA adds 4K and HD encoders on queue depth. Hover the encoders and the packager for sampled p50, p95 and p99: the spike doubles them, and the growth is waiting, not encoding. Teaching timings: 1 s polling, 2 s startup.&quot;,&quot;seed&quot;:71,&quot;scale&quot;:1,&quot;durationMs&quot;:40000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;masters&quot;,&quot;node&quot;:&quot;studios&quot;,&quot;label&quot;:&quot;Festival slate&quot;,&quot;messageType&quot;:&quot;StudioMaster&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:1,&quot;peakRate&quot;:6,&quot;atMs&quot;:4000,&quot;peakMs&quot;:6000,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each master lands in Originals; an S3 event starts the ingest workflow, which fans out one job per rendition ladder.&quot;,&quot;focus&quot;:[&quot;originals&quot;,&quot;media-events&quot;,&quot;workflow&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The slate arrives: six masters a second. A 4K encode takes two seconds, so jobs wait while KEDA adds encoders.&quot;,&quot;focus&quot;:[&quot;uhd-q&quot;,&quot;uhd-enc&quot;,&quot;hd-q&quot;,&quot;hd-enc&quot;]}},{&quot;atMs&quot;:12000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Hover 4K encoders: p95 has doubled to about five seconds. An encode still takes two; the rest is waiting for an encoder.&quot;,&quot;focus&quot;:[&quot;uhd-q&quot;,&quot;uhd-enc&quot;]}},{&quot;atMs&quot;:20000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Packaging fetches content keys under the DRM service's 40-a-second limit and publishes each title.&quot;,&quot;focus&quot;:[&quot;ready-q&quot;,&quot;packager&quot;,&quot;drm&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;uhd&quot;,&quot;label&quot;:&quot;Every 4K encode finishes&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uhd-enc&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The 4K queue drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uhd-q&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;Nothing is dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;encode-dlq&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;corrupt-source&quot;,&quot;title&quot;:&quot;A batch of corrupt sources&quot;,&quot;description&quot;:&quot;A creator's export tool writes broken 4K masters for twenty seconds. Those encode jobs fail three times and go to the dead-letter queue; triage flags each upload and emails its creator. HD and audio renditions are unaffected.&quot;,&quot;seed&quot;:72,&quot;scale&quot;:1,&quot;durationMs&quot;:50000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;uploads&quot;,&quot;node&quot;:&quot;creators&quot;,&quot;label&quot;:&quot;Creator uploads&quot;,&quot;messageType&quot;:&quot;UploadVideo&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1,&quot;durationMs&quot;:30000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Uploads arrive steadily; three ladders encode each one independently.&quot;,&quot;focus&quot;:[&quot;uhd-q&quot;,&quot;hd-q&quot;,&quot;audio-q&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;uhd-enc&quot;,&quot;props&quot;:{&quot;failureRate&quot;:1}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A batch of 4K masters is corrupt. The 4K encoder fails them; SQS makes each visible again for a retry.&quot;,&quot;focus&quot;:[&quot;uhd-q&quot;,&quot;uhd-enc&quot;]}},{&quot;atMs&quot;:23000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;uhd-enc&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;After three receives a job goes to the dead-letter queue, where triage flags its upload and emails the creator.&quot;,&quot;focus&quot;:[&quot;uhd-q&quot;,&quot;encode-dlq&quot;,&quot;triage&quot;]}},{&quot;atMs&quot;:23000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The export tool is fixed. New 4K jobs encode again; HD and audio never stopped.&quot;,&quot;focus&quot;:[&quot;uhd-q&quot;,&quot;uhd-enc&quot;,&quot;hd-enc&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;parked&quot;,&quot;label&quot;:&quot;Corrupt 4K jobs are dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;uhd-q&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;hd-ok&quot;,&quot;label&quot;:&quot;HD never fails&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hd-enc&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;told&quot;,&quot;label&quot;:&quot;Triage handles every dead letter&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;encode-dlq&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;premiere-night&quot;,&quot;title&quot;:&quot;Premiere night: the edge cache carries it&quot;,&quot;description&quot;:&quot;The premiere goes live and viewers triple in seconds. The CDN's route table sends 97% of segment requests to the edge cache; only misses reach the origin bucket, and playback starts ask the API for a manifest and a DRM licence.&quot;,&quot;seed&quot;:73,&quot;scale&quot;:20,&quot;durationMs&quot;:24000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;viewers&quot;,&quot;node&quot;:&quot;viewers&quot;,&quot;label&quot;:&quot;Viewers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:0,&quot;startRate&quot;:400,&quot;stages&quot;:[{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:1200},{&quot;durationMs&quot;:12000,&quot;targetRate&quot;:1200},{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:400}]}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Almost every request is a video segment; a few start playback and need a manifest and a licence.&quot;,&quot;focus&quot;:[&quot;viewers&quot;,&quot;cdn&quot;,&quot;edge-cache&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Three times the viewers. The edge cache answers 97% of segments; the origin bucket only sees misses.&quot;,&quot;focus&quot;:[&quot;viewers&quot;,&quot;cdn&quot;,&quot;edge-cache&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Playback starts reach the API, which checks rights with the catalog and asks for a DRM licence.&quot;,&quot;focus&quot;:[&quot;playback-api&quot;,&quot;licences&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;cached&quot;,&quot;label&quot;:&quot;The edge cache serves most segments&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;edge-cache&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:15000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-loss&quot;,&quot;label&quot;:&quot;Playback never drops a request&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;playback-api&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;segment&quot;,&quot;label&quot;:&quot;Video segment&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/v/7731/1080p/seg-0042.m4s&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:0,&quot;marker&quot;:&quot;circle&quot;}},{&quot;id&quot;:&quot;playback&quot;,&quot;label&quot;:&quot;Start playback&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/v1/playback/7731&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:3,&quot;marker&quot;:&quot;triangle&quot;}}]}">
          <mxCell />
        </object>
