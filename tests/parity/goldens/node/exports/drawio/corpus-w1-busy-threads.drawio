<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-v2aq26" name="Scale on busy threads">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="A modelled custom metric sees held threads that CPU scaling misses. Compare blocking on four pods, busy-thread scaling to about ten, and non-blocking calls on four. Sampling stays at two requests per dot; partner latency varies by 10%. This lesson uses one-second metric windows and cadence, five-second startup and five-second scale-down stabilization, capped at ten pods." dg_simulations="[{&quot;id&quot;:&quot;blocking&quot;,&quot;title&quot;:&quot;Blocking: CPU says all is well&quot;,&quot;description&quot;:&quot;At 400 requests/s the 64 threads fill. CPU scaling stays at four replicas while Applications pile up.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:2,&quot;durationMs&quot;:50000,&quot;traffic&quot;:[{&quot;node&quot;:&quot;source&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:40000},&quot;id&quot;:&quot;applications-0&quot;,&quot;label&quot;:&quot;Applications&quot;,&quot;messageType&quot;:&quot;ApplicationSubmitted&quot;}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag&quot;,&quot;label&quot;:&quot;Applications lag stays below 1,000&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;applications&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:1000,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;busy-threads&quot;,&quot;title&quot;:&quot;Scale on busy threads&quot;,&quot;description&quot;:&quot;Busy threads at 70% of Concurrency: more pods start within ten seconds and the lag drains.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:2,&quot;durationMs&quot;:50000,&quot;traffic&quot;:[{&quot;node&quot;:&quot;source&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:40000},&quot;id&quot;:&quot;applications-0&quot;,&quot;label&quot;:&quot;Applications&quot;,&quot;messageType&quot;:&quot;ApplicationSubmitted&quot;}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag&quot;,&quot;label&quot;:&quot;Applications lag stays below 1,000&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;applications&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;}],&quot;setup&quot;:{&quot;props&quot;:{&quot;caller&quot;:{&quot;autoscaling&quot;:{&quot;mode&quot;:&quot;on&quot;,&quot;modelRevision&quot;:&quot;a1&quot;,&quot;preset&quot;:&quot;hpa-service&quot;,&quot;presetRevision&quot;:&quot;1&quot;,&quot;controller&quot;:{&quot;kind&quot;:&quot;hpa&quot;,&quot;initialReplicas&quot;:4,&quot;minReplicas&quot;:4,&quot;maxReplicas&quot;:10,&quot;settings&quot;:{&quot;syncMs&quot;:1000,&quot;tolerance&quot;:0.1,&quot;initialReadinessDelayMs&quot;:30000,&quot;cpuInitializationPeriodMs&quot;:300000,&quot;metrics&quot;:[{&quot;source&quot;:{&quot;kind&quot;:&quot;pods&quot;,&quot;metric&quot;:&quot;busyThreads&quot;},&quot;target&quot;:{&quot;kind&quot;:&quot;utilization&quot;,&quot;percentOfRequest&quot;:70},&quot;windowMs&quot;:1000,&quot;metricDelayMs&quot;:0}],&quot;up&quot;:{&quot;stabilizationMs&quot;:0,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Pods&quot;,&quot;value&quot;:4,&quot;periodMs&quot;:15000},{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]},&quot;down&quot;:{&quot;stabilizationMs&quot;:5000,&quot;selectPolicy&quot;:&quot;Max&quot;,&quot;policies&quot;:[{&quot;type&quot;:&quot;Percent&quot;,&quot;value&quot;:100,&quot;periodMs&quot;:15000}]}}}}}}}},{&quot;id&quot;:&quot;free-thread&quot;,&quot;title&quot;:&quot;Free the thread while waiting&quot;,&quot;description&quot;:&quot;The same traffic runs on four pods when waiting calls free their threads.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:2,&quot;durationMs&quot;:50000,&quot;traffic&quot;:[{&quot;node&quot;:&quot;source&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:400,&quot;durationMs&quot;:40000},&quot;id&quot;:&quot;applications-0&quot;,&quot;label&quot;:&quot;Applications&quot;,&quot;messageType&quot;:&quot;ApplicationSubmitted&quot;}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag&quot;,&quot;label&quot;:&quot;Applications lag stays below 1,000&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;applications&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&lt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;end&quot;}],&quot;setup&quot;:{&quot;edges&quot;:{&quot;call&quot;:{&quot;caller&quot;:{&quot;wait&quot;:&quot;non-blocking&quot;}}}}}]" dg_planning="{&quot;revision&quot;:&quot;p3-w1&quot;}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
