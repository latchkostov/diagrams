<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1hg1qy0" name="AKS orders API with App Configuration">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Bold lines carry requests and events. Dotted lines are dependencies: where the API gets its settings (two are Key Vault references), its identity, and where it reports." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;lunch-rush&quot;,&quot;title&quot;:&quot;Lunch rush&quot;,&quot;description&quot;:&quot;Steady orders: every request writes to SQL and publishes OrderCreated. Config, secrets and tokens were read at startup, so nothing moves on the dotted lines.&quot;,&quot;seed&quot;:3,&quot;scale&quot;:2,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;web&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;400 orders over 10 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:40,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Orders flow through Front Door to the API, then to SQL and Service Bus.&quot;,&quot;focus&quot;:[&quot;fd&quot;,&quot;api&quot;,&quot;sql&quot;,&quot;sb&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;No messages go to App Configuration or Key Vault: the API read them at startup and keeps them cached.&quot;,&quot;focus&quot;:[&quot;api&quot;,&quot;appcfg&quot;,&quot;kv&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;written&quot;,&quot;label&quot;:&quot;Every order is written&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;sql&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:400,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;confirmed&quot;,&quot;label&quot;:&quot;Every order is confirmed&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;notify&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:400,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;api&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;flash-sale&quot;,&quot;title&quot;:&quot;Flash sale&quot;,&quot;description&quot;:&quot;A spike to 300 orders a second for three seconds. Three replicas absorb it; the dependencies stay quiet.&quot;,&quot;seed&quot;:5,&quot;scale&quot;:5,&quot;traffic&quot;:[{&quot;id&quot;:&quot;spike&quot;,&quot;node&quot;:&quot;web&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;1,110 orders: steady, then a three-second sale&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:30,&quot;peakRate&quot;:300,&quot;atMs&quot;:3000,&quot;peakMs&quot;:3000,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The sale starts: 300 orders a second for three seconds.&quot;,&quot;focus&quot;:[&quot;web&quot;,&quot;api&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;written&quot;,&quot;label&quot;:&quot;Every order is written&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;sql&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1110,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;confirmed&quot;,&quot;label&quot;:&quot;Every order is confirmed&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;notify&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1110,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;api&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]">
          <mxCell />
        </object>
