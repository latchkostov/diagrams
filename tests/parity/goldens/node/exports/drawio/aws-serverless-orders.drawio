<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-vspac9" name="AWS serverless orders">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="API Gateway and Lambda write orders to DynamoDB; its stream feeds EventBridge rules that fan out to a Step Functions payment workflow, an isolated fulfillment queue, an archive queue and SNS notifications, with a scheduled reconciliation." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;flash-sale&quot;,&quot;title&quot;:&quot;Flash sale: 300 orders/s&quot;,&quot;description&quot;:&quot;Steady traffic jumps to 300 orders a second for three seconds; Lambda scales out and nothing queues for long.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:10,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;1,040 orders with a flash-sale peak&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;spike&quot;,&quot;baseRate&quot;:20,&quot;peakRate&quot;:300,&quot;atMs&quot;:3000,&quot;peakMs&quot;:3000,&quot;durationMs&quot;:10000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every write to the orders table lands on its stream. One Lambda turns stream records into EventBridge events; rules route them by type. Each dot is 10 orders.&quot;,&quot;focus&quot;:[&quot;orders-table&quot;,&quot;stream-fn&quot;,&quot;bus&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The flash sale peaks at 300 orders a second. API Gateway and Lambda scale out; there are no servers to add.&quot;,&quot;focus&quot;:[&quot;client&quot;,&quot;apigw&quot;,&quot;create-order&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:5500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The payment workflow writes PAID back to the table. That change comes round the stream as OrderPaid, which the other two rules pick up.&quot;,&quot;focus&quot;:[&quot;sfn&quot;,&quot;orders-table&quot;,&quot;fulfillment-q&quot;,&quot;sns&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;writes&quot;,&quot;label&quot;:&quot;Each order is written twice: placed, then paid&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-table&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:2080,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;shipments&quot;,&quot;label&quot;:&quot;1,040 shipments requested&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;three-pl&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1040,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;receipts&quot;,&quot;label&quot;:&quot;1,040 email receipts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1040,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;Nothing is dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;three-pl-outage&quot;,&quot;title&quot;:&quot;3PL outage and DLQ redrive&quot;,&quot;description&quot;:&quot;The warehouse API fails for five seconds; SQS retries after a visibility timeout, parks failures in the DLQ, and an operator redrives them.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;setup&quot;:{&quot;status&quot;:{&quot;dlq&quot;:&quot;paused&quot;}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;160 orders over 8 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;fulfillment-fn&quot;,&quot;props&quot;:{&quot;failureRate&quot;:1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The 3PL's API is down. Each shipment request fails, becomes visible again after the timeout, and is retried.&quot;,&quot;focus&quot;:[&quot;fulfillment-fn&quot;,&quot;three-pl&quot;,&quot;fulfillment-q&quot;]}},{&quot;atMs&quot;:4500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;After three receives, SQS moves the message to the dead-letter queue. Payments and receipts are unaffected.&quot;,&quot;focus&quot;:[&quot;fulfillment-q&quot;,&quot;dlq&quot;,&quot;email&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:7000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;fulfillment-fn&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0}}},{&quot;atMs&quot;:9500,&quot;action&quot;:{&quot;do&quot;:&quot;status&quot;,&quot;node&quot;:&quot;dlq&quot;,&quot;status&quot;:&quot;up&quot;}},{&quot;atMs&quot;:9500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The 3PL is back, so an operator redrives the DLQ. Every parked shipment goes through.&quot;,&quot;focus&quot;:[&quot;dlq&quot;,&quot;fulfillment-q&quot;,&quot;three-pl&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;parked&quot;,&quot;label&quot;:&quot;Failures are dead-lettered, not lost&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:9000},{&quot;id&quot;:&quot;receipts&quot;,&quot;label&quot;:&quot;Receipts are unaffected&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:160,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;shipped&quot;,&quot;label&quot;:&quot;All 160 shipments are requested&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;three-pl&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:160,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;empty&quot;,&quot;label&quot;:&quot;The DLQ is empty after the redrive&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;dlq&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;throttle&quot;,&quot;title&quot;:&quot;Fulfillment Lambda is throttled&quot;,&quot;description&quot;:&quot;Reserved concurrency for RequestShipment drops to one. Its queue grows while payments, the archive and receipts carry on; when concurrency is restored, the backlog drains.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:2,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;240 orders over 8 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:30,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each EventBridge rule feeds its own queue, so one slow consumer can't hold up the others.&quot;,&quot;focus&quot;:[&quot;bus&quot;,&quot;fulfillment-q&quot;,&quot;archive-q&quot;,&quot;sns&quot;]}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;fulfillment-fn&quot;,&quot;props&quot;:{&quot;concurrency&quot;:1}}},{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;RequestShipment is throttled to one concurrent execution. Its queue grows; the archive and receipts are unaffected.&quot;,&quot;focus&quot;:[&quot;fulfillment-q&quot;,&quot;fulfillment-fn&quot;,&quot;archive-q&quot;,&quot;email&quot;]}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;fulfillment-fn&quot;,&quot;props&quot;:{&quot;concurrency&quot;:50}}},{&quot;atMs&quot;:10000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Reserved concurrency is restored and fulfillment catches up.&quot;,&quot;focus&quot;:[&quot;fulfillment-fn&quot;,&quot;three-pl&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;lag-grows&quot;,&quot;label&quot;:&quot;Fulfillment lag grows while throttled&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:8000},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Fulfillment drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;fulfillment-q&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;archived&quot;,&quot;label&quot;:&quot;Every order event is archived&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;archive-s3&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:480,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;receipts&quot;,&quot;label&quot;:&quot;Receipts are unaffected&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:240,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
