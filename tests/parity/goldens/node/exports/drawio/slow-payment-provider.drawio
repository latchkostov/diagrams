<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-m4od8s" name="A slow payment provider">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="At three seconds the payment provider slows tenfold. Compare Checkout filling its threads with a 600 ms timeout: payments fail fast while Checkout keeps serving requests. Timeouts do not cancel the provider's work." dg_simulations="[{&quot;id&quot;:&quot;no-timeouts&quot;,&quot;title&quot;:&quot;No timeouts&quot;,&quot;description&quot;:&quot;Checkout fills all 100 threads after the slowdown. Its queue keeps growing; the gateway eventually returns 504s after waiting five seconds.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:1,&quot;durationMs&quot;:20000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payment&quot;,&quot;factor&quot;:10}}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;gateway-timeouts&quot;,&quot;label&quot;:&quot;No gateway timeouts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;gateway&quot;,&quot;field&quot;:&quot;timedOut&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;value&quot;:0,&quot;id&quot;:&quot;expected-failure-gateway&quot;,&quot;metric&quot;:{&quot;field&quot;:&quot;dropped&quot;,&quot;node&quot;:&quot;gateway&quot;},&quot;when&quot;:&quot;eventually&quot;,&quot;label&quot;:&quot;gateway reports failed checkouts&quot;,&quot;op&quot;:&quot;&gt;&quot;},{&quot;value&quot;:0,&quot;id&quot;:&quot;expected-failure-shop&quot;,&quot;metric&quot;:{&quot;field&quot;:&quot;dropped&quot;,&quot;node&quot;:&quot;shop&quot;},&quot;when&quot;:&quot;eventually&quot;,&quot;label&quot;:&quot;shop reports failed checkouts&quot;,&quot;op&quot;:&quot;&gt;&quot;}]},{&quot;id&quot;:&quot;timeout-600&quot;,&quot;title&quot;:&quot;A 600 ms timeout&quot;,&quot;description&quot;:&quot;Payments time out, then their late replies are discarded. Checkout releases each thread after 600 ms and the gateway never times out: degradation instead of a stall.&quot;,&quot;seed&quot;:17,&quot;scale&quot;:1,&quot;durationMs&quot;:20000,&quot;setup&quot;:{&quot;edges&quot;:{&quot;pay&quot;:{&quot;caller&quot;:{&quot;deadlineMs&quot;:600}}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;orders&quot;,&quot;node&quot;:&quot;shop&quot;,&quot;messageType&quot;:&quot;Checkout&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;payment&quot;,&quot;factor&quot;:10}}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;gateway-timeouts&quot;,&quot;label&quot;:&quot;No gateway timeouts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;gateway&quot;,&quot;field&quot;:&quot;timedOut&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;payments-timeout&quot;,&quot;label&quot;:&quot;Payments fail fast&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;checkout&quot;,&quot;field&quot;:&quot;timedOut&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;eventually&quot;},{&quot;value&quot;:0,&quot;id&quot;:&quot;expected-failure-checkout&quot;,&quot;metric&quot;:{&quot;field&quot;:&quot;dropped&quot;,&quot;node&quot;:&quot;checkout&quot;},&quot;when&quot;:&quot;eventually&quot;,&quot;label&quot;:&quot;checkout reports failed checkouts&quot;,&quot;op&quot;:&quot;&gt;&quot;},{&quot;value&quot;:0,&quot;id&quot;:&quot;expected-failure-gateway&quot;,&quot;metric&quot;:{&quot;field&quot;:&quot;dropped&quot;,&quot;node&quot;:&quot;gateway&quot;},&quot;when&quot;:&quot;eventually&quot;,&quot;label&quot;:&quot;gateway reports failed checkouts&quot;,&quot;op&quot;:&quot;&gt;&quot;},{&quot;value&quot;:0,&quot;id&quot;:&quot;expected-failure-shop&quot;,&quot;metric&quot;:{&quot;field&quot;:&quot;dropped&quot;,&quot;node&quot;:&quot;shop&quot;},&quot;when&quot;:&quot;eventually&quot;,&quot;label&quot;:&quot;shop reports failed checkouts&quot;,&quot;op&quot;:&quot;&gt;&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-w1&quot;}">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
        <object id="dg-n-shop" label="Shop" dg_id="shop" dg_stencil="client.user" dg_props="{&quot;ratePerSec&quot;:120}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#0EA5E91A;strokeColor=#0EA5E9;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="20" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-gateway" label="API gateway&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;5 s timeout&lt;/span&gt;" dg_id="gateway" dg_stencil="generic.adc">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#0EA5E91A;strokeColor=#0EA5E9;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="340" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-checkout" label="Checkout&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;4 replicas · 25 threads each&lt;/span&gt;" dg_id="checkout" dg_stencil="generic.service" dg_props="{&quot;replicas&quot;:4,&quot;concurrency&quot;:25,&quot;latencyMs&quot;:10,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="680" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-payment" label="Payment provider&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6B7280;&quot;&gt;200 ms · slows ×10 at 3 s&lt;/span&gt;" dg_id="payment" dg_stencil="generic.external-api" dg_props="{&quot;latencyMs&quot;:200,&quot;api&quot;:{&quot;latencyMs&quot;:200},&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#6366F11A;strokeColor=#6366F1;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1040" y="186" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-n-orders" label="Orders DB" dg_id="orders" dg_stencil="generic.database" dg_props="{&quot;latencyMs&quot;:5,&quot;jitter&quot;:0}">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#0D94881A;strokeColor=#0D9488;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1040" y="426" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-browse" label="" dg_id="browse" dg_kind="sync" dg_props="{&quot;travelMs&quot;:100}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-shop" target="dg-n-gateway">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-route" label="" dg_id="route" dg_kind="sync" dg_props="{&quot;travelMs&quot;:100,&quot;caller&quot;:{&quot;deadlineMs&quot;:5000}}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-gateway" target="dg-n-checkout">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-pay" label="" dg_id="pay" dg_kind="sync" dg_props="{&quot;travelMs&quot;:200}">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;strokeColor=#475569;" edge="1" parent="1" source="dg-n-checkout" target="dg-n-payment">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="dg-e-save" label="" dg_id="save" dg_kind="sync" dg_props="{&quot;travelMs&quot;:100}">
