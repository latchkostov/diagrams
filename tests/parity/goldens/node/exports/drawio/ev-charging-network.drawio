<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-15vkwor" name="EV charging network">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented charge-point operator, Voltaic Charge. Depot chargers reach Azure through a firewall pair and an SD-WAN edge; street chargers come in over LTE. Event Hubs fans charger events out to twins, fault detection, metering and a cold path, while drivers start sessions and firmware rolls out in waves." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;vendor-shell&quot;,&quot;title&quot;:&quot;The depot firewall blocks a vendor shell&quot;,&quot;description&quot;:&quot;Depot chargers report over the SD-WAN edge while the charger vendor tries to open a remote shell on them. The firewall's rule lets OCPP out and denies the shell: blocked on purpose, never counted as lost.&quot;,&quot;seed&quot;:51,&quot;scale&quot;:5,&quot;durationMs&quot;:20000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;depot&quot;,&quot;node&quot;:&quot;depot-chargers&quot;,&quot;label&quot;:&quot;Depot chargers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:60,&quot;durationMs&quot;:16000}},{&quot;id&quot;:&quot;street&quot;,&quot;node&quot;:&quot;street&quot;,&quot;label&quot;:&quot;Street chargers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:16000}},{&quot;id&quot;:&quot;shell&quot;,&quot;node&quot;:&quot;vendor&quot;,&quot;label&quot;:&quot;Remote shell attempts&quot;,&quot;messageType&quot;:&quot;VendorRemoteShell&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:10,&quot;fromMs&quot;:3000,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Depot chargers reach the cloud through the switch, a firewall pair and the SD-WAN edge. Street chargers come in over LTE.&quot;,&quot;focus&quot;:[&quot;depot-chargers&quot;,&quot;depot-switch&quot;,&quot;depot-fw&quot;,&quot;depot-router&quot;,&quot;street&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The charger vendor tries to open a remote shell into the depot. Its sessions reach the firewall.&quot;,&quot;focus&quot;:[&quot;vendor&quot;,&quot;depot-router&quot;,&quot;depot-fw&quot;]}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The firewall's deny rule stops every one. Blocked is the rule working, not a loss; vendor support goes through a ticketed jump host instead.&quot;,&quot;focus&quot;:[&quot;depot-fw&quot;,&quot;depot-switch&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;blocked&quot;,&quot;label&quot;:&quot;The firewall blocks the vendor shell&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;depot-fw&quot;,&quot;field&quot;:&quot;blocked&quot;},&quot;op&quot;:&quot;&gt;=&quot;,&quot;value&quot;:50,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;The firewall drops nothing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;depot-fw&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;telemetry&quot;,&quot;label&quot;:&quot;Depot telemetry keeps flowing&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ingress&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:5000,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;reboot-storm&quot;,&quot;title&quot;:&quot;A firmware wave reboots the street fleet&quot;,&quot;description&quot;:&quot;A firmware wave reboots the street chargers, and every one reconnects with a BootNotification at once. Event Hubs absorbs the burst; each consumer group drains its own lag at its own pace.&quot;,&quot;seed&quot;:52,&quot;scale&quot;:20,&quot;durationMs&quot;:30000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;depot&quot;,&quot;node&quot;:&quot;depot-chargers&quot;,&quot;label&quot;:&quot;Depot chargers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:60,&quot;durationMs&quot;:24000}},{&quot;id&quot;:&quot;street&quot;,&quot;node&quot;:&quot;street&quot;,&quot;label&quot;:&quot;Street chargers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:24000}},{&quot;id&quot;:&quot;boots&quot;,&quot;node&quot;:&quot;street&quot;,&quot;label&quot;:&quot;Reconnect burst&quot;,&quot;messageType&quot;:&quot;BootNotification&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:12000,&quot;atMs&quot;:4000,&quot;spreadMs&quot;:3000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Four consumer groups read charger events: twins, fault detection, metering and capture to the lake.&quot;,&quot;focus&quot;:[&quot;events&quot;,&quot;state&quot;,&quot;faults&quot;,&quot;state-db&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The firmware wave lands: 12,000 reconnect messages in three seconds.&quot;,&quot;focus&quot;:[&quot;street&quot;,&quot;ingress&quot;,&quot;ocpp&quot;,&quot;events&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Event Hubs holds the burst. The twin updater works through its lag; fault detection and metering keep their own pace.&quot;,&quot;focus&quot;:[&quot;events&quot;,&quot;state&quot;,&quot;state-db&quot;]}},{&quot;atMs&quot;:18000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every group has caught up, and nothing was dropped.&quot;}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;absorbed&quot;,&quot;label&quot;:&quot;The twin updater falls behind for a while&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;state&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:1000,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Every reconnect reaches the twins&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;state&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;nothing-lost&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ocpp&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;firewall-failover&quot;,&quot;title&quot;:&quot;The depot firewall fails over&quot;,&quot;description&quot;:&quot;The active depot firewall dies. For three seconds, while the standby takes over its sessions, depot telemetry waits at the pair; nothing is dropped.&quot;,&quot;seed&quot;:53,&quot;scale&quot;:1,&quot;durationMs&quot;:16000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;depot&quot;,&quot;node&quot;:&quot;depot-chargers&quot;,&quot;label&quot;:&quot;Depot chargers&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:60,&quot;durationMs&quot;:12000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;One firewall in the pair carries the depot's traffic; the other stands by.&quot;,&quot;focus&quot;:[&quot;depot-fw&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;depot-fw&quot;,&quot;props&quot;:{&quot;replicas&quot;:1}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The active unit fails. Traffic waits at the pair while the standby takes over.&quot;,&quot;focus&quot;:[&quot;depot-fw&quot;,&quot;depot-switch&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The standby carries everything. Nothing was lost, but the pair has no spare until the failed unit is replaced.&quot;,&quot;focus&quot;:[&quot;depot-fw&quot;,&quot;depot-router&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;waits&quot;,&quot;label&quot;:&quot;Telemetry waits during the failover&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;depot-fw&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:50,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;The firewall never drops a message&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;depot-fw&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;hot-spot&quot;,&quot;title&quot;:&quot;One partition runs hot&quot;,&quot;description&quot;:&quot;A misconfigured partition key sends every street charger's events to one Event Hubs partition. Each consumer group can use one reader per partition, so 63 of the twin updater's 64 replicas sit idle and lag grows; redistributing the key across 32 partitions drains it.&quot;,&quot;seed&quot;:54,&quot;scale&quot;:2,&quot;durationMs&quot;:20000,&quot;setup&quot;:{&quot;props&quot;:{&quot;events&quot;:{&quot;partitions&quot;:1},&quot;state&quot;:{&quot;replicas&quot;:64,&quot;concurrency&quot;:1,&quot;latencyMs&quot;:150}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;street&quot;,&quot;node&quot;:&quot;street&quot;,&quot;label&quot;:&quot;200 readings on one partition&quot;,&quot;messageType&quot;:&quot;MeterValues&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;durationMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every reading lands on one partition. One partition activates one twin updater; the other 63 replicas sit idle while lag grows.&quot;,&quot;focus&quot;:[&quot;events&quot;,&quot;state&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;events&quot;,&quot;props&quot;:{&quot;partitions&quot;:32}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The partition key is fixed and spread across 32 partitions. More replicas get work and the lag drains.&quot;,&quot;focus&quot;:[&quot;events&quot;,&quot;state&quot;,&quot;state-db&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;hot-lag&quot;,&quot;label&quot;:&quot;Lag builds on the hot partition&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;state&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:6000},{&quot;id&quot;:&quot;twins&quot;,&quot;label&quot;:&quot;Every reading reaches the twins&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;state-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The lag drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;events&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;state&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
