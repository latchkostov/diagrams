  <diagram id="dg-vwz8cz" name="IoT telemetry platform">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Partitioned device telemetry feeds a low-latency state projection and streaming lake, with threshold alerts." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;morning&quot;,&quot;title&quot;:&quot;Morning device check-in&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;check-ins&quot;,&quot;node&quot;:&quot;devices&quot;,&quot;messageType&quot;:&quot;TelemetryReading&quot;,&quot;label&quot;:&quot;1,000 devices check in as shifts start&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;startRate&quot;:100,&quot;stages&quot;:[{&quot;durationMs&quot;:5000,&quot;targetRate&quot;:300}]}},{&quot;id&quot;:&quot;temperature-alerts&quot;,&quot;node&quot;:&quot;devices&quot;,&quot;messageType&quot;:&quot;TemperatureExceeded&quot;,&quot;label&quot;:&quot;10 sensors exceed the temperature threshold&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;atMs&quot;:2500,&quot;count&quot;:10,&quot;spreadMs&quot;:500}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Morning check-ins ramp from 100 to 300 per second. Both consumer groups receive every reading.&quot;,&quot;focus&quot;:[&quot;devices&quot;,&quot;hub&quot;]}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Only TemperatureExceeded events go to the on-call mailbox.&quot;,&quot;focus&quot;:[&quot;hot&quot;,&quot;alerts&quot;,&quot;email&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;state&quot;,&quot;label&quot;:&quot;State&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;cosmos&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1010,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;lake&quot;,&quot;label&quot;:&quot;Lake&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;blob&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1010,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;alerts&quot;,&quot;label&quot;:&quot;Alerts&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:10,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Drained&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hub&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}],&quot;scale&quot;:10},{&quot;id&quot;:&quot;hot-spot&quot;,&quot;title&quot;:&quot;Event Hubs partition hot spot&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;check-ins&quot;,&quot;node&quot;:&quot;devices&quot;,&quot;messageType&quot;:&quot;TelemetryReading&quot;,&quot;label&quot;:&quot;200 readings on a hot partition&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;durationMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;One partition activates one replica per group; the other 63 replicas sit idle. Lag grows despite the configured service fleet.&quot;,&quot;focus&quot;:[&quot;hub&quot;,&quot;hot&quot;,&quot;stream&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;hub&quot;,&quot;props&quot;:{&quot;partitions&quot;:64}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The partition key is redistributed; the backlog drains.&quot;,&quot;focus&quot;:[&quot;hub&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;hot-lag&quot;,&quot;label&quot;:&quot;Hot lag&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hub&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;hot-state&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:6000},{&quot;id&quot;:&quot;state&quot;,&quot;label&quot;:&quot;State&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;cosmos&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;lake&quot;,&quot;label&quot;:&quot;Lake&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;blob&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Drained&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hub&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}],&quot;setup&quot;:{&quot;props&quot;:{&quot;hub&quot;:{&quot;partitions&quot;:1},&quot;hot&quot;:{&quot;replicas&quot;:64,&quot;concurrency&quot;:1},&quot;stream&quot;:{&quot;replicas&quot;:64,&quot;concurrency&quot;:1}}},&quot;scale&quot;:2}]">
          <mxCell />
