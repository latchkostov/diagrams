<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-7blioi" name="Serverless burst and buffer">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="Contoso compares direct Lambda admission with an SQS buffer and bounded invoker: reserved concurrency rejects direct excess while paced async calls finish." dg_direction="TB" dg_simulations="[{&quot;id&quot;:&quot;burst&quot;,&quot;title&quot;:&quot;Twenty jobs at once&quot;,&quot;description&quot;:&quot;Direct calls exceed the reserved allocation. A bounded invoker pulls queued jobs at 2/s. This explicit pacing is not a model of SQS trigger retries; managed allocation is instant and cold starts are excluded.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;requests&quot;,&quot;node&quot;:&quot;requests&quot;,&quot;messageType&quot;:&quot;Job&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:20,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:200}}],&quot;timeline&quot;:[{&quot;atMs&quot;:2000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Reserved concurrency is simultaneous executions, not requests per second. Direct excess is rejected; SQS waits behind a bounded invoker, which protects the async allocation.&quot;,&quot;focus&quot;:[&quot;direct&quot;,&quot;queue&quot;,&quot;invoker&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;direct-rejected-end&quot;,&quot;label&quot;:&quot;direct: rejected &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;direct&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;queue-lag-at&quot;,&quot;label&quot;:&quot;queue: lag &gt; 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:3000},{&quot;id&quot;:&quot;async-results-processed-end&quot;,&quot;label&quot;:&quot;async-results: processed == 20&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;async-results&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;async-rejected-end&quot;,&quot;label&quot;:&quot;async: rejected == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;async&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;queue-lag-end&quot;,&quot;label&quot;:&quot;queue: lag == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;queue&quot;,&quot;field&quot;:&quot;lag&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;paced&quot;,&quot;title&quot;:&quot;Paced requests fit&quot;,&quot;description&quot;:&quot;One job a second stays inside both allocations.&quot;,&quot;seed&quot;:41,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;requests&quot;,&quot;node&quot;:&quot;requests&quot;,&quot;messageType&quot;:&quot;Job&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:1,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[],&quot;expectations&quot;:[{&quot;id&quot;:&quot;direct-results-processed-end&quot;,&quot;label&quot;:&quot;direct-results: processed == 6&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;direct-results&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:6,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;async-results-processed-end&quot;,&quot;label&quot;:&quot;async-results: processed == 6&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;async-results&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:6,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;direct-rejected-end&quot;,&quot;label&quot;:&quot;direct: rejected == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;direct&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;async-rejected-end&quot;,&quot;label&quot;:&quot;async: rejected == 0&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;async&quot;,&quot;field&quot;:&quot;rejected&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
