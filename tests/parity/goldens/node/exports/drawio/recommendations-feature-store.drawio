<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1e31jyd" name="Recommendations with a feature store">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented streaming service, Meridian Media. Home pages get candidates from an embedding index and rankings from a model that reads an online feature store, kept fresh by streaming jobs and nightly bulk loads from an offline store. A canary takes 5% of rankings and a shadow model scores a 10% mirror; a drift monitor reads every prediction." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;friday-night&quot;,&quot;title&quot;:&quot;Friday night peak&quot;,&quot;description&quot;:&quot;Home-page loads climb fourfold in a few seconds. Ranker v7 scales on CPU while the feature server and online store keep up; the shadow model keeps scoring its mirrored 10% without answering anyone.&quot;,&quot;seed&quot;:61,&quot;scale&quot;:20,&quot;durationMs&quot;:30000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;tv&quot;,&quot;node&quot;:&quot;tv&quot;,&quot;label&quot;:&quot;TVs and web&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:0,&quot;startRate&quot;:300,&quot;stages&quot;:[{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:1200},{&quot;durationMs&quot;:16000,&quot;targetRate&quot;:1200},{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:300}]}},{&quot;id&quot;:&quot;phones&quot;,&quot;node&quot;:&quot;phones&quot;,&quot;label&quot;:&quot;App&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;ramp&quot;,&quot;fromMs&quot;:0,&quot;startRate&quot;:200,&quot;stages&quot;:[{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:800},{&quot;durationMs&quot;:16000,&quot;targetRate&quot;:800},{&quot;durationMs&quot;:4000,&quot;targetRate&quot;:200}]}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each home page asks for candidates, then ranks them: 95% on Ranker v7, 5% on the v8 canary, and 10% mirrored to the v9 shadow.&quot;,&quot;focus&quot;:[&quot;home-api&quot;,&quot;candidates&quot;,&quot;ranking-router&quot;,&quot;ranker-v7&quot;,&quot;ranker-v8&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Friday night: four times the home loads. Ranker v7 passes 70% CPU and its HPA adds pods.&quot;,&quot;focus&quot;:[&quot;ranking-router&quot;,&quot;ranker-v7&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every ranker reads the same online features, kept fresh by streaming jobs and bulk loads.&quot;,&quot;focus&quot;:[&quot;feature-server&quot;,&quot;online-store&quot;,&quot;ann-index&quot;]}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Predictions go to a log: the drift monitor watches them, and the lake keeps them for training.&quot;,&quot;focus&quot;:[&quot;predictions&quot;,&quot;drift&quot;,&quot;lake-sink&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;scored&quot;,&quot;label&quot;:&quot;Ranker v7 scores the peak&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ranker-v7&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:10000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-loss&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;feature-server&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;Prediction lag drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;predictions&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;drift&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;canary-rollback&quot;,&quot;title&quot;:&quot;The canary misbehaves&quot;,&quot;description&quot;:&quot;Argo CD rolls Ranker v8 out to 5% of home pages. Its new feature join times out on half its requests; the router keeps sending it 5% until the on-call engineer sets its weight to zero.&quot;,&quot;seed&quot;:62,&quot;scale&quot;:10,&quot;durationMs&quot;:22000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;tv&quot;,&quot;node&quot;:&quot;tv&quot;,&quot;label&quot;:&quot;TVs and web&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:18000}},{&quot;id&quot;:&quot;phones&quot;,&quot;node&quot;:&quot;phones&quot;,&quot;label&quot;:&quot;App&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:200,&quot;durationMs&quot;:18000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Argo CD has rolled Ranker v8 out as a canary: the router sends it 5% of rankings.&quot;,&quot;focus&quot;:[&quot;ranking-router&quot;,&quot;ranker-v7&quot;,&quot;ranker-v8&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;ranker-v8&quot;,&quot;props&quot;:{&quot;failureRate&quot;:0.5}}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;v8's new feature join times out on half its requests. Those members get a fallback row.&quot;,&quot;focus&quot;:[&quot;ranking-router&quot;,&quot;ranker-v8&quot;,&quot;feature-server&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;ranking-router&quot;,&quot;props&quot;:{&quot;routeTable&quot;:{&quot;rules&quot;:[],&quot;default&quot;:{&quot;targets&quot;:[{&quot;edgeId&quot;:&quot;ranking-router--ranker-v7&quot;,&quot;weight&quot;:100},{&quot;edgeId&quot;:&quot;ranking-router--ranker-v8&quot;,&quot;weight&quot;:0}]}}}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The quality dashboard shows the dip. On-call sets v8's weight to zero, and v7 takes every ranking again.&quot;,&quot;focus&quot;:[&quot;ranking-router&quot;,&quot;ranker-v7&quot;,&quot;ranker-v8&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;canary-failed&quot;,&quot;label&quot;:&quot;The canary fails rankings&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ranker-v8&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;v7-clean&quot;,&quot;label&quot;:&quot;Ranker v7 never fails&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;ranker-v7&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;slow-features&quot;,&quot;title&quot;:&quot;Drill: the feature server slows down&quot;,&quot;description&quot;:&quot;A drill: a bad client upgrade makes every feature lookup ten times slower for ten seconds. Rankings queue at the feature server, which every ranker shares, then drain once the slowdown clears.&quot;,&quot;seed&quot;:63,&quot;scale&quot;:10,&quot;durationMs&quot;:26000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;tv&quot;,&quot;node&quot;:&quot;tv&quot;,&quot;label&quot;:&quot;TVs and web&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:20000}},{&quot;id&quot;:&quot;phones&quot;,&quot;node&quot;:&quot;phones&quot;,&quot;label&quot;:&quot;App&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:200,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;All three rankers, and the weekly batch scorer, read features from one shared feature server.&quot;,&quot;focus&quot;:[&quot;ranker-v7&quot;,&quot;ranker-v8&quot;,&quot;ranker-v9&quot;,&quot;feature-server&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;drill&quot;:&quot;slow-dependency&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;feature-server&quot;,&quot;factor&quot;:10}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Slow dependency drill: feature lookups take ten times as long. The feature server's slots fill and rankings queue.&quot;,&quot;focus&quot;:[&quot;feature-server&quot;,&quot;online-store&quot;]}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;drill&quot;:&quot;slow-dependency&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;slow&quot;,&quot;node&quot;:&quot;feature-server&quot;,&quot;factor&quot;:1}}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The slowdown clears. The queue drains in a few seconds; nothing was dropped, but every queued home page waited.&quot;,&quot;focus&quot;:[&quot;feature-server&quot;,&quot;ranker-v7&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;queued&quot;,&quot;label&quot;:&quot;Rankings queue at the feature server&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;feature-server&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:100,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The queue drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;feature-server&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-loss&quot;,&quot;label&quot;:&quot;Nothing is dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;feature-server&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;sunday-picks&quot;,&quot;title&quot;:&quot;Sunday picks wake the batch scorer&quot;,&quot;description&quot;:&quot;At six on Sunday the schedule queues 6,000 members for their weekly email. KEDA wakes the batch scorer from zero on topic lag, scales it out to the partition count, then lets it sleep again.&quot;,&quot;seed&quot;:64,&quot;scale&quot;:10,&quot;durationMs&quot;:40000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;members&quot;,&quot;node&quot;:&quot;picks-schedule&quot;,&quot;label&quot;:&quot;6,000 members&quot;,&quot;messageType&quot;:&quot;ScoreMember&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:6000,&quot;atMs&quot;:1000,&quot;spreadMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The batch scorer has no pods: it sleeps until members to score arrive.&quot;,&quot;focus&quot;:[&quot;picks-schedule&quot;,&quot;pick-requests&quot;,&quot;batch-scorer&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;6,000 members queue in the topic. KEDA sees the lag and wakes the scorer, then adds pods, up to one per partition.&quot;,&quot;focus&quot;:[&quot;pick-requests&quot;,&quot;batch-scorer&quot;]}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Each scored member's picks are stored and mailed. The scorer shares the feature server with live home pages.&quot;,&quot;focus&quot;:[&quot;batch-scorer&quot;,&quot;feature-server&quot;,&quot;picks-db&quot;,&quot;picks-mailer&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;scored&quot;,&quot;label&quot;:&quot;Every member is scored&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;batch-scorer&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:6000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;mailed&quot;,&quot;label&quot;:&quot;Every member gets an email&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;picks-mailer&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:6000,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;drained&quot;,&quot;label&quot;:&quot;The topic drains&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;pick-requests&quot;,&quot;field&quot;:&quot;lag&quot;,&quot;group&quot;:&quot;scorer&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;,&quot;requestRoutes&quot;:[{&quot;id&quot;:&quot;home&quot;,&quot;label&quot;:&quot;Home page&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/v1/home&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:0,&quot;marker&quot;:&quot;circle&quot;}},{&quot;id&quot;:&quot;play-event&quot;,&quot;label&quot;:&quot;Playback event&quot;,&quot;address&quot;:{&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/v1/events/play&quot;},&quot;appearance&quot;:{&quot;paletteSlot&quot;:2,&quot;marker&quot;:&quot;square&quot;}}]}">
          <mxCell />
        </object>
