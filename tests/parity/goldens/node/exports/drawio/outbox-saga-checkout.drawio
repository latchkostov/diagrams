<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1sstvgh" name="Outbox and saga checkout">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="A transactional outbox publishes order events; a saga orchestrates inventory and payment, compensating when a step fails." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;happy-path&quot;,&quot;title&quot;:&quot;Twenty checkouts, happy path&quot;,&quot;description&quot;:&quot;Each order commits with its outbox row, then the saga reserves stock, charges the card and confirms.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;20 checkouts&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:20,&quot;spreadMs&quot;:4000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;trace&quot;,&quot;node&quot;:&quot;order-api&quot;}},{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The order row and its OrderCreated event commit in one database transaction. No dual write, so no lost events.&quot;,&quot;focus&quot;:[&quot;order-api&quot;,&quot;orders-db&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:900,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The outbox relay tails the write-ahead log and publishes each outbox row to Kafka.&quot;,&quot;focus&quot;:[&quot;orders-db&quot;,&quot;outbox-relay&quot;,&quot;order-events&quot;]}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The saga runs one step at a time: reserve stock, charge the card, then confirm the order. Every step is saved, so a restart resumes where it left off.&quot;,&quot;focus&quot;:[&quot;saga&quot;,&quot;saga-db&quot;,&quot;inventory-cmds&quot;,&quot;payment-cmds&quot;,&quot;saga-replies&quot;]}},{&quot;atMs&quot;:6000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;OrderConfirmed goes out through the same outbox, and the customer gets a receipt.&quot;,&quot;focus&quot;:[&quot;order-events&quot;,&quot;notifications&quot;,&quot;email&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;stock&quot;,&quot;label&quot;:&quot;20 reservations&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;inventory-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;charges&quot;,&quot;label&quot;:&quot;20 cards charged once each&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;stripe&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;receipts&quot;,&quot;label&quot;:&quot;20 receipts sent&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:20,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;orders&quot;,&quot;label&quot;:&quot;20 orders created, 20 confirmed&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;orders-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:40,&quot;when&quot;:&quot;end&quot;}]},{&quot;id&quot;:&quot;declines&quot;,&quot;title&quot;:&quot;Declines and flaky payments&quot;,&quot;description&quot;:&quot;Transient payment errors are retried with the same idempotency key; a fraud rule declines cards for three seconds and the saga compensates.&quot;,&quot;seed&quot;:7,&quot;scale&quot;:1,&quot;setup&quot;:{&quot;props&quot;:{&quot;payment-svc&quot;:{&quot;failureRate&quot;:0.2}}},&quot;traffic&quot;:[{&quot;id&quot;:&quot;checkouts&quot;,&quot;node&quot;:&quot;client&quot;,&quot;messageType&quot;:&quot;PlaceOrder&quot;,&quot;label&quot;:&quot;60 checkouts over 6 seconds&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:10,&quot;durationMs&quot;:6000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;One payment call in five times out. The consumer retries in place with the same Idempotency-Key, so a retry never charges twice.&quot;,&quot;focus&quot;:[&quot;payment-svc&quot;,&quot;stripe&quot;]}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;payment-svc&quot;,&quot;props&quot;:{&quot;emits&quot;:{&quot;ChargePayment&quot;:&quot;PaymentDeclined&quot;}}}},{&quot;atMs&quot;:2500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A fraud rule starts declining every card. The saga compensates: it releases the reserved stock, then cancels the order.&quot;,&quot;focus&quot;:[&quot;payment-svc&quot;,&quot;saga&quot;,&quot;inventory-cmds&quot;,&quot;order-api&quot;],&quot;pause&quot;:true}},{&quot;atMs&quot;:5500,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;payment-svc&quot;,&quot;props&quot;:{&quot;emits&quot;:{&quot;ChargePayment&quot;:&quot;PaymentCaptured&quot;}}}},{&quot;atMs&quot;:5500,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The rule is rolled back. Every customer still hears back: a receipt or a cancellation.&quot;,&quot;focus&quot;:[&quot;notifications&quot;,&quot;email&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;everyone&quot;,&quot;label&quot;:&quot;All 60 customers get an email&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;email&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:60,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;compensated&quot;,&quot;label&quot;:&quot;Declined orders release their stock&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;inventory-db&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:60,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;retried&quot;,&quot;label&quot;:&quot;Transient errors were retried&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payment-svc&quot;,&quot;field&quot;:&quot;failed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-dlq&quot;,&quot;label&quot;:&quot;Nothing is dead-lettered&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;payment-cmds&quot;,&quot;field&quot;:&quot;deadLettered&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]">
          <mxCell />
        </object>
        <mxCell id="1" parent="0" />
