<mxfile host="Diagrams" agent="Diagrams" version="24.0.0" type="device">
  <diagram id="dg-1oauomg" name="Hybrid enterprise network">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v2" dg_description="An invented retailer, Northwind Traders. Staff at the Manchester head office and four branches reach the ERP in the Leeds data centre over SD-WAN, through firewall pairs and a spine-and-leaf server farm. Customers reach the web shop through a DMZ, and a site-to-site VPN carries the nightly export to an AWS warehouse." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;leicester-fibre-cut&quot;,&quot;title&quot;:&quot;Drill: the Leicester fibre is cut&quot;,&quot;description&quot;:&quot;A digger cuts the Leicester branch's fibre. Its SD-WAN router health-checks both underlays, so every new session moves to the LTE tunnel; only requests already on the fibre are lost. The fibre comes back ten seconds later.&quot;,&quot;seed&quot;:91,&quot;scale&quot;:1,&quot;durationMs&quot;:24000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;leicester&quot;,&quot;node&quot;:&quot;leicester-staff&quot;,&quot;label&quot;:&quot;Leicester branch&quot;,&quot;messageType&quot;:&quot;ERP&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:20000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The Leicester router sends the branch's tunnels over fibre and a 4G backup, and health-checks both.&quot;,&quot;focus&quot;:[&quot;leicester-router&quot;,&quot;lte&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;drill&quot;:&quot;region-connectivity&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;link&quot;,&quot;edge&quot;:&quot;leicester-fibre&quot;,&quot;cut&quot;:true}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Region connectivity drill: the fibre is cut. Requests already on it are lost; the router sends every new one over LTE.&quot;,&quot;focus&quot;:[&quot;leicester-router&quot;,&quot;lte&quot;]}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;fault&quot;,&quot;drill&quot;:&quot;region-connectivity&quot;,&quot;fault&quot;:{&quot;kind&quot;:&quot;link&quot;,&quot;edge&quot;:&quot;leicester-fibre&quot;,&quot;cut&quot;:false}}},{&quot;atMs&quot;:14000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The fibre is back and shares the load again. Staff never noticed.&quot;,&quot;focus&quot;:[&quot;leicester-router&quot;,&quot;lte&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;on-lte&quot;,&quot;label&quot;:&quot;Sessions move to LTE&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;lte&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:150,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;The router never drops a session&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;leicester-router&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;},{&quot;id&quot;:&quot;on-the-wire&quot;,&quot;label&quot;:&quot;Only requests on the wire are lost&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hub&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;&lt;=&quot;,&quot;value&quot;:5,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;erp&quot;,&quot;label&quot;:&quot;Every request reaches the ERP&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;erp&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;dc-firewall-failover&quot;,&quot;title&quot;:&quot;The DC firewall fails over&quot;,&quot;description&quot;:&quot;The active unit of the data centre's firewall pair dies. For three seconds, while the standby takes over its sessions, traffic for the ERP and the shop waits at the pair; nothing is dropped.&quot;,&quot;seed&quot;:92,&quot;scale&quot;:50,&quot;durationMs&quot;:18000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;hq&quot;,&quot;node&quot;:&quot;hq-staff&quot;,&quot;label&quot;:&quot;HQ staff&quot;,&quot;messageType&quot;:&quot;ERP&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:14000}},{&quot;id&quot;:&quot;intranet&quot;,&quot;node&quot;:&quot;hq-intranet&quot;,&quot;label&quot;:&quot;HQ intranet&quot;,&quot;messageType&quot;:&quot;Intranet&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:120,&quot;durationMs&quot;:14000}},{&quot;id&quot;:&quot;leicester&quot;,&quot;node&quot;:&quot;leicester-staff&quot;,&quot;label&quot;:&quot;Leicester branch&quot;,&quot;messageType&quot;:&quot;ERP&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:20,&quot;durationMs&quot;:14000}},{&quot;id&quot;:&quot;shop&quot;,&quot;node&quot;:&quot;customers&quot;,&quot;label&quot;:&quot;Online customers&quot;,&quot;messageType&quot;:&quot;Web&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:200,&quot;durationMs&quot;:14000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Every flow into the data centre passes the firewall pair: one unit carries it, the other stands by.&quot;,&quot;focus&quot;:[&quot;dc-edge&quot;,&quot;hub&quot;,&quot;dc-fw&quot;]}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;dc-fw&quot;,&quot;props&quot;:{&quot;replicas&quot;:1}}},{&quot;atMs&quot;:4000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The active unit fails. Sessions wait at the pair while the standby takes over.&quot;,&quot;focus&quot;:[&quot;dc-fw&quot;,&quot;spine-1&quot;,&quot;dmz-switch&quot;]}},{&quot;atMs&quot;:9000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;The standby carries everything and the backlog drains. The pair has no spare until the unit is replaced.&quot;,&quot;focus&quot;:[&quot;dc-fw&quot;,&quot;spine-1&quot;,&quot;spine-2&quot;,&quot;leaf&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;waits&quot;,&quot;label&quot;:&quot;Traffic waits during the failover&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;dc-fw&quot;,&quot;field&quot;:&quot;backlog&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:500,&quot;when&quot;:&quot;eventually&quot;},{&quot;id&quot;:&quot;no-drops&quot;,&quot;label&quot;:&quot;The firewall never drops a session&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;dc-fw&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]},{&quot;id&quot;:&quot;guest-to-erp&quot;,&quot;title&quot;:&quot;A guest device probes the ERP&quot;,&quot;description&quot;:&quot;A visitor's laptop on guest Wi-Fi scans for the ERP. The HQ firewall's guest zone allows web traffic out to the internet only; its deny rule blocks every attempt to reach the data centre, while staff traffic carries on.&quot;,&quot;seed&quot;:93,&quot;scale&quot;:10,&quot;durationMs&quot;:16000,&quot;traffic&quot;:[{&quot;id&quot;:&quot;hq&quot;,&quot;node&quot;:&quot;hq-staff&quot;,&quot;label&quot;:&quot;HQ staff&quot;,&quot;messageType&quot;:&quot;ERP&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:300,&quot;durationMs&quot;:14000}},{&quot;id&quot;:&quot;guests&quot;,&quot;node&quot;:&quot;guests&quot;,&quot;label&quot;:&quot;Guest web&quot;,&quot;messageType&quot;:&quot;GuestWeb&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:60,&quot;durationMs&quot;:14000}},{&quot;id&quot;:&quot;probe&quot;,&quot;node&quot;:&quot;guests&quot;,&quot;label&quot;:&quot;Probe for the ERP&quot;,&quot;messageType&quot;:&quot;GuestERP&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;constant&quot;,&quot;ratePerSec&quot;:50,&quot;fromMs&quot;:3000,&quot;durationMs&quot;:8000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Staff and guests share the access switches, but the core keeps them in separate VRFs up to the firewall.&quot;,&quot;focus&quot;:[&quot;access&quot;,&quot;core&quot;,&quot;hq-fw&quot;]}},{&quot;atMs&quot;:3000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A guest device starts probing for the ERP. The guest zone's deny rule blocks it at the HQ firewall.&quot;,&quot;focus&quot;:[&quot;hq-fw&quot;,&quot;hq-wan&quot;,&quot;breakout&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Blocked attempts are counted, not dropped as failures; staff traffic to the data centre carries on.&quot;,&quot;focus&quot;:[&quot;hq-fw&quot;,&quot;hq-wan&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;blocked&quot;,&quot;label&quot;:&quot;The firewall blocks the probe&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hq-fw&quot;,&quot;field&quot;:&quot;blocked&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:300,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;staff-ok&quot;,&quot;label&quot;:&quot;Staff traffic is never dropped&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;hq-fw&quot;,&quot;field&quot;:&quot;dropped&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;always&quot;}]}]" dg_planning="{&quot;revision&quot;:&quot;p3-a1&quot;}">
          <mxCell />
        </object>
