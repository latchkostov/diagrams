  <diagram id="dg-1brd0kw" name="CDC search and analytics">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <object id="0" dg_format="diagrams/v1" dg_description="Debezium captures retail table changes for search projections, a warehouse and raw lake retention." dg_direction="LR" dg_simulations="[{&quot;id&quot;:&quot;backfill&quot;,&quot;title&quot;:&quot;Bulk backfill&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;snapshot&quot;,&quot;node&quot;:&quot;sql&quot;,&quot;messageType&quot;:&quot;OrderRowChanged&quot;,&quot;label&quot;:&quot;600 SQL Server snapshot rows&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:600,&quot;spreadMs&quot;:3000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;A SQL Server backfill produces order CDC envelopes. Customer subscriptions skip this batch.&quot;,&quot;focus&quot;:[&quot;sql&quot;,&quot;debezium&quot;,&quot;orders-topic&quot;]}},{&quot;atMs&quot;:5000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Independent groups build search projections and retain raw rows.&quot;,&quot;focus&quot;:[&quot;processor&quot;,&quot;s3-sink&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;search&quot;,&quot;label&quot;:&quot;Search&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;search&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:600,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;warehouse&quot;,&quot;label&quot;:&quot;Warehouse&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;warehouse&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:600,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;lake&quot;,&quot;label&quot;:&quot;Lake&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;lake&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:600,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;customer-filter&quot;,&quot;label&quot;:&quot;Customer filter&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;customers-topic&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;end&quot;}],&quot;scale&quot;:5},{&quot;id&quot;:&quot;search-slow&quot;,&quot;title&quot;:&quot;Elasticsearch slow&quot;,&quot;seed&quot;:7,&quot;traffic&quot;:[{&quot;id&quot;:&quot;changes&quot;,&quot;node&quot;:&quot;sql&quot;,&quot;messageType&quot;:&quot;OrderRowChanged&quot;,&quot;label&quot;:&quot;200 order updates&quot;,&quot;shape&quot;:{&quot;kind&quot;:&quot;burst&quot;,&quot;count&quot;:200,&quot;spreadMs&quot;:2000}}],&quot;timeline&quot;:[{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;search&quot;,&quot;props&quot;:{&quot;latencyMs&quot;:5000}}},{&quot;atMs&quot;:0,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Slow Elasticsearch writes remain in flight; the warehouse and raw lake continue.&quot;,&quot;focus&quot;:[&quot;search&quot;,&quot;warehouse&quot;,&quot;lake&quot;]}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;props&quot;,&quot;node&quot;:&quot;search&quot;,&quot;props&quot;:{&quot;latencyMs&quot;:40}}},{&quot;atMs&quot;:8000,&quot;action&quot;:{&quot;do&quot;:&quot;note&quot;,&quot;text&quot;:&quot;Index latency recovers. Every projection eventually lands.&quot;,&quot;focus&quot;:[&quot;search&quot;]}}],&quot;expectations&quot;:[{&quot;id&quot;:&quot;slow-writes&quot;,&quot;label&quot;:&quot;Slow writes&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;search&quot;,&quot;field&quot;:&quot;inFlight&quot;},&quot;op&quot;:&quot;&gt;&quot;,&quot;value&quot;:0,&quot;when&quot;:&quot;at&quot;,&quot;atMs&quot;:3000},{&quot;id&quot;:&quot;search&quot;,&quot;label&quot;:&quot;Search&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;search&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;warehouse&quot;,&quot;label&quot;:&quot;Warehouse&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;warehouse&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;lake&quot;,&quot;label&quot;:&quot;Lake&quot;,&quot;metric&quot;:{&quot;node&quot;:&quot;lake&quot;,&quot;field&quot;:&quot;processed&quot;},&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:200,&quot;when&quot;:&quot;end&quot;}],&quot;scale&quot;:2}]">
