{
  "format": "diagrams/v1",
  "title": "Event-driven data platform",
  "description": "Operational events stream through Kafka into Snowflake; dbt builds marts and reverse ETL publishes segments back to Kafka.",
  "direction": "LR",
  "groups": [
    {
      "id": "kafka",
      "label": "Kafka · Confluent Cloud",
      "tone": "neutral",
      "x": 760,
      "y": 40,
      "width": 340,
      "height": 592
    },
    {
      "id": "snowflake",
      "label": "Snowflake · ANALYTICS",
      "tone": "neutral",
      "x": 1520,
      "y": 160,
      "width": 340,
      "height": 392
    }
  ],
  "nodes": [
    {
      "id": "billing-webhooks",
      "stencil": "generic.webhook",
      "label": "Billing webhooks",
      "sublabel": "Stripe · invoice.paid",
      "x": 40,
      "y": 80,
      "props": {
        "ratePerSec": 5,
        "messageType": "InvoicePaid"
      }
    },
    {
      "id": "storefront",
      "stencil": "client.browser",
      "label": "Storefront",
      "sublabel": "Web and mobile checkout",
      "x": 40,
      "y": 200,
      "props": {
        "ratePerSec": 20,
        "messageType": "CheckoutRequest"
      }
    },
    {
      "id": "accounts-db",
      "stencil": "postgres",
      "label": "Accounts database",
      "sublabel": "OLTP · logical replication",
      "x": 40,
      "y": 320,
      "props": {
        "messageType": "AccountChanged",
        "latencyMs": 2
      }
    },
    {
      "id": "segment-cache",
      "stencil": "redis.cache",
      "label": "Segment cache",
      "sublabel": "customerId → segments",
      "x": 40,
      "y": 520,
      "props": {
        "latencyMs": 2
      }
    },
    {
      "id": "webhook-receiver",
      "stencil": "service.node",
      "label": "Webhook receiver",
      "sublabel": "Verify signature · ack 200",
      "x": 420,
      "y": 80,
      "props": {
        "concurrency": 64,
        "latencyMs": 80
      }
    },
    {
      "id": "checkout",
      "stencil": "service.go",
      "label": "Checkout service",
      "sublabel": "Commits order · publishes",
      "x": 420,
      "y": 200,
      "props": {
        "concurrency": 64,
        "latencyMs": 120,
        "emits": "OrderPlaced"
      }
    },
    {
      "id": "debezium",
      "stencil": "debezium",
      "label": "Debezium connector",
      "sublabel": "Postgres WAL → events",
      "x": 420,
      "y": 320,
      "props": {
        "ratePerSec": 10,
        "messageType": "AccountChanged"
      }
    },
    {
      "id": "personalization",
      "stencil": "service.java",
      "label": "Personalization service",
      "sublabel": "Next-best offer",
      "x": 420,
      "y": 520,
      "props": {
        "group": "personalization",
        "concurrency": 64,
        "latencyMs": 100
      }
    },
    {
      "id": "marketing",
      "stencil": "generic.marketing",
      "label": "Marketing automation",
      "sublabel": "Braze · campaigns",
      "x": 420,
      "y": 640,
      "props": {
        "group": "marketing-sync"
      }
    },
    {
      "id": "billing-topic",
      "stencil": "kafka.topic",
      "label": "billing.invoices.v1",
      "sublabel": "key: customerId",
      "x": 800,
      "y": 80,
      "group": "kafka",
      "props": {
        "partitions": 6
      }
    },
    {
      "id": "orders-topic",
      "stencil": "kafka.topic",
      "label": "orders.v1",
      "sublabel": "key: orderId",
      "x": 800,
      "y": 200,
      "group": "kafka",
      "props": {
        "partitions": 6
      }
    },
    {
      "id": "accounts-topic",
      "stencil": "kafka.topic",
      "label": "cdc.accounts.v1",
      "sublabel": "Debezium · key: accountId",
      "x": 800,
      "y": 320,
      "group": "kafka",
      "props": {
        "partitions": 6
      }
    },
    {
      "id": "segments-topic",
      "stencil": "kafka.topic",
      "label": "customer-segments.v1",
      "sublabel": "key: customerId",
      "x": 800,
      "y": 520,
      "group": "kafka",
      "props": {
        "partitions": 6
      }
    },
    {
      "id": "schema-registry",
      "stencil": "kafka.schema-registry",
      "label": "Schema registry",
      "sublabel": "Avro · backward compatible",
      "x": 1166,
      "y": 80,
      "props": {
        "compatibility": "BACKWARD"
      }
    },
    {
      "id": "snowpipe",
      "stencil": "snowflake.snowpipe",
      "label": "Snowflake connector",
      "sublabel": "Snowpipe Streaming",
      "x": 1180,
      "y": 200,
      "props": {
        "group": "snowflake-sink",
        "replicas": 6,
        "concurrency": 4,
        "latencyMs": 40,
        "emits": {
          "OrderPlaced": "RawOrderRow",
          "InvoicePaid": "RawInvoiceRow",
          "AccountChanged": "RawAccountRow"
        }
      }
    },
    {
      "id": "reverse-etl",
      "stencil": "generic.reverse-etl",
      "label": "Reverse ETL",
      "sublabel": "Hightouch · diffs only",
      "x": 1180,
      "y": 520,
      "props": {
        "concurrency": 400,
        "latencyMs": 1500,
        "emits": "CustomerSegmentChanged"
      }
    },
    {
      "id": "raw",
      "stencil": "snowflake",
      "label": "Raw tables",
      "sublabel": "RAW.KAFKA_* · VARIANT",
      "x": 1560,
      "y": 200,
      "group": "snowflake",
      "props": {
        "latencyMs": 1
      }
    },
    {
      "id": "marts",
      "stencil": "snowflake",
      "label": "Marts",
      "sublabel": "Segments · revenue · orders",
      "x": 1560,
      "y": 440,
      "group": "snowflake",
      "props": {
        "latencyMs": 1
      }
    },
    {
      "id": "airflow",
      "stencil": "airflow",
      "label": "Airflow",
      "sublabel": "dbt build · every 15 min",
      "x": 1932,
      "y": 80
    },
    {
      "id": "dbt",
      "stencil": "dbt",
      "label": "dbt models",
      "sublabel": "Incremental models",
      "x": 1940,
      "y": 320,
      "props": {
        "concurrency": 3000,
        "latencyMs": 2500,
        "emits": {
          "RawOrderRow": "CustomerSegmentRow",
          "RawInvoiceRow": "RevenueRow",
          "RawAccountRow": "CustomerRow"
        }
      }
    },
    {
      "id": "bi",
      "stencil": "tableau",
      "label": "Revenue dashboards",
      "sublabel": "Tableau · live",
      "x": 1940,
      "y": 560,
      "props": {}
    }
  ],
  "edges": [
    {
      "id": "billing-webhooks-to-webhook-receiver",
      "from": "billing-webhooks",
      "to": "webhook-receiver",
      "label": "HTTPS · signed",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "storefront-to-checkout",
      "from": "storefront",
      "to": "checkout",
      "label": "POST /checkout",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "accounts-db-to-debezium",
      "from": "accounts-db",
      "to": "debezium",
      "label": "WAL",
      "kind": "async",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "webhook-receiver-to-billing-topic",
      "from": "webhook-receiver",
      "to": "billing-topic",
      "label": "InvoicePaid",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "checkout-to-orders-topic",
      "from": "checkout",
      "to": "orders-topic",
      "label": "OrderPlaced",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "debezium-to-accounts-topic",
      "from": "debezium",
      "to": "accounts-topic",
      "label": "AccountChanged",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "billing-topic-to-snowpipe",
      "from": "billing-topic",
      "to": "snowpipe",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "group": "snowflake-sink"
      }
    },
    {
      "id": "orders-topic-to-snowpipe",
      "from": "orders-topic",
      "to": "snowpipe",
      "label": "group: snowflake-sink",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "group": "snowflake-sink"
      }
    },
    {
      "id": "accounts-topic-to-snowpipe",
      "from": "accounts-topic",
      "to": "snowpipe",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "group": "snowflake-sink"
      }
    },
    {
      "id": "snowpipe-to-schema-registry",
      "from": "snowpipe",
      "to": "schema-registry",
      "label": "Avro schemas",
      "kind": "async",
      "relation": "depends",
      "sourceSide": "top",
      "targetSide": "bottom"
    },
    {
      "id": "snowpipe-to-raw",
      "from": "snowpipe",
      "to": "raw",
      "label": "insertRows",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "raw-to-dbt",
      "from": "raw",
      "to": "dbt",
      "label": "New rows",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "Raw*"
        ]
      }
    },
    {
      "id": "airflow-to-dbt",
      "from": "airflow",
      "to": "dbt",
      "label": "dbt build",
      "kind": "async",
      "relation": "depends",
      "sourceSide": "bottom",
      "targetSide": "top"
    },
    {
      "id": "dbt-to-marts",
      "from": "dbt",
      "to": "marts",
      "label": "MERGE models",
      "kind": "sync",
      "props": {
        "travelMs": 200,
        "filter": [
          "CustomerSegmentRow",
          "RevenueRow",
          "CustomerRow"
        ]
      }
    },
    {
      "id": "bi-to-marts",
      "from": "bi",
      "to": "marts",
      "label": "Live queries",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "marts-to-reverse-etl",
      "from": "marts",
      "to": "reverse-etl",
      "label": "Changed segments",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "filter": [
          "CustomerSegmentRow"
        ]
      }
    },
    {
      "id": "reverse-etl-to-segments-topic",
      "from": "reverse-etl",
      "to": "segments-topic",
      "label": "Segment changes",
      "kind": "async",
      "props": {
        "travelMs": 300
      }
    },
    {
      "id": "segments-topic-to-personalization",
      "from": "segments-topic",
      "to": "personalization",
      "label": "group: personalization",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "group": "personalization"
      }
    },
    {
      "id": "segments-topic-to-marketing",
      "from": "segments-topic",
      "to": "marketing",
      "label": "group: marketing-sync",
      "kind": "async",
      "props": {
        "travelMs": 300,
        "group": "marketing-sync"
      }
    },
    {
      "id": "personalization-to-segment-cache",
      "from": "personalization",
      "to": "segment-cache",
      "label": "SET segments",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    }
  ],
  "simulations": [
    {
      "id": "one-order",
      "title": "Follow one order end to end",
      "description": "One checkout travels through Kafka, Snowflake and dbt, then comes back out as a segment change.",
      "seed": 7,
      "scale": 1,
      "traffic": [
        {
          "id": "order",
          "node": "storefront",
          "messageType": "CheckoutRequest",
          "label": "One checkout",
          "shape": {
            "kind": "burst",
            "count": 1
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "trace",
            "node": "checkout"
          }
        },
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "A shopper checks out. Follow this one order through Kafka, Snowflake and dbt, and back out to Kafka as a segment change.",
            "focus": [
              "storefront",
              "checkout",
              "orders-topic"
            ],
            "pause": true
          }
        },
        {
          "atMs": 1000,
          "action": {
            "do": "note",
            "text": "The Snowflake Kafka connector streams the event into a RAW table within about a second. There is no nightly batch window.",
            "focus": [
              "orders-topic",
              "snowpipe",
              "raw"
            ]
          }
        },
        {
          "atMs": 2600,
          "action": {
            "do": "note",
            "text": "dbt's incremental models turn the raw row into marts. This order moves the customer into a new segment.",
            "focus": [
              "raw",
              "dbt",
              "marts"
            ]
          }
        },
        {
          "atMs": 5600,
          "action": {
            "do": "note",
            "text": "Reverse ETL compares the mart with its last sync and publishes only the changed row to customer-segments.v1.",
            "focus": [
              "marts",
              "reverse-etl",
              "segments-topic"
            ]
          }
        },
        {
          "atMs": 8000,
          "action": {
            "do": "note",
            "text": "Personalization and the marketing tool consume the change like any other event, each in its own consumer group.",
            "focus": [
              "segments-topic",
              "personalization",
              "marketing"
            ],
            "pause": true
          }
        }
      ],
      "expectations": [
        {
          "id": "raw",
          "label": "The order lands in RAW",
          "metric": {
            "node": "raw",
            "field": "processed"
          },
          "op": "==",
          "value": 1,
          "when": "end"
        },
        {
          "id": "marts",
          "label": "dbt builds it into the marts",
          "metric": {
            "node": "marts",
            "field": "processed"
          },
          "op": "==",
          "value": 1,
          "when": "end"
        },
        {
          "id": "cache",
          "label": "Personalization caches the new segment",
          "metric": {
            "node": "segment-cache",
            "field": "processed"
          },
          "op": "==",
          "value": 1,
          "when": "end"
        },
        {
          "id": "marketing",
          "label": "The marketing tool receives it",
          "metric": {
            "node": "marketing",
            "field": "processed"
          },
          "op": "==",
          "value": 1,
          "when": "end"
        }
      ]
    },
    {
      "id": "load-spike",
      "title": "Warehouse load spike",
      "description": "Month-end invoices spike to 600/s on top of steady orders and CDC; Kafka absorbs the burst while the loader catches up.",
      "seed": 7,
      "scale": 20,
      "traffic": [
        {
          "id": "orders",
          "node": "storefront",
          "messageType": "CheckoutRequest",
          "label": "Steady orders: 200/s",
          "shape": {
            "kind": "constant",
            "ratePerSec": 200,
            "durationMs": 10000
          }
        },
        {
          "id": "invoices",
          "node": "billing-webhooks",
          "messageType": "InvoicePaid",
          "label": "Month-end invoices peak at 600/s",
          "shape": {
            "kind": "spike",
            "baseRate": 20,
            "peakRate": 600,
            "atMs": 3000,
            "peakMs": 3000,
            "durationMs": 10000
          }
        },
        {
          "id": "accounts",
          "node": "accounts-db",
          "messageType": "AccountChanged",
          "label": "Account changes: 50/s",
          "shape": {
            "kind": "constant",
            "ratePerSec": 50,
            "durationMs": 10000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "Orders, invoices and account changes all stream into Snowflake. Each dot is 20 events. The connector loads about 600 rows a second.",
            "focus": [
              "orders-topic",
              "billing-topic",
              "accounts-topic",
              "snowpipe"
            ]
          }
        },
        {
          "atMs": 3000,
          "action": {
            "do": "note",
            "text": "Month-end: invoice webhooks jump to 600 a second. The loader falls behind, and Kafka absorbs the burst as consumer lag.",
            "focus": [
              "billing-webhooks",
              "billing-topic",
              "snowpipe"
            ],
            "pause": true
          }
        },
        {
          "atMs": 6500,
          "action": {
            "do": "note",
            "text": "Producers never slowed down. Once the spike passes, the connector drains the lag and RAW catches up.",
            "focus": [
              "snowpipe",
              "raw"
            ]
          }
        },
        {
          "atMs": 9000,
          "action": {
            "do": "note",
            "text": "Only order-driven segment changes flow back out through reverse ETL. Invoices and account rows stay in the marts.",
            "focus": [
              "marts",
              "reverse-etl",
              "segments-topic"
            ]
          }
        }
      ],
      "expectations": [
        {
          "id": "lag",
          "label": "The loader falls behind during the spike",
          "metric": {
            "node": "billing-topic",
            "field": "lag",
            "group": "snowflake-sink"
          },
          "op": ">",
          "value": 0,
          "when": "at",
          "atMs": 5500
        },
        {
          "id": "drained",
          "label": "Lag drains to zero",
          "metric": {
            "node": "billing-topic",
            "field": "lag",
            "group": "snowflake-sink"
          },
          "op": "==",
          "value": 0,
          "when": "end"
        },
        {
          "id": "raw",
          "label": "All 4,440 events land in RAW",
          "metric": {
            "node": "raw",
            "field": "processed"
          },
          "op": "==",
          "value": 4440,
          "when": "end"
        },
        {
          "id": "no-drop",
          "label": "Nothing is dropped",
          "metric": {
            "node": "billing-topic",
            "field": "dropped"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        },
        {
          "id": "segments",
          "label": "2,000 segment changes reach marketing",
          "metric": {
            "node": "marketing",
            "field": "processed"
          },
          "op": "==",
          "value": 2000,
          "when": "end"
        }
      ]
    }
  ]
}
