    {
      "id": "note-cells",
      "kind": "note",
      "text": "A cell is a complete, fixed-size copy of the booking stack. Requests never cross cells or regions; only data replicates.",
      "x": 0,
      "y": 160,
      "width": 300,
      "height": 150
    }
  ],
  "simulations": [
    {
      "id": "region-evacuation",
      "title": "us-east-1 goes dark",
      "description": "Five seconds in, us-east-1's load balancer stops answering. DNS health checks send its travellers to the other two regions, whose cells were sized to absorb one region's share. Bookings keep flowing; the region returns at 18 s.",
      "seed": 21,
      "scale": 5,
      "durationMs": 30000,
      "traffic": [
        {
          "id": "web",
          "node": "travellers",
          "label": "Web bookings",
          "shape": {
            "kind": "constant",
            "ratePerSec": 120,
            "durationMs": 26000
          }
        },
        {
          "id": "app",
          "node": "mobile",
          "label": "App bookings",
          "shape": {
            "kind": "constant",
            "ratePerSec": 90,
            "durationMs": 26000
          }
        },
        {
          "id": "partners",
          "node": "agents",
          "label": "Agent bookings",
          "shape": {
            "kind": "constant",
            "ratePerSec": 30,
            "durationMs": 26000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "Three regions take bookings. Each region splits customers across two cells; no request ever leaves its cell.",
            "focus": [
              "travellers",
              "mobile",
              "agents",
              "dns"
            ]
          }
        },
        {
          "atMs": 5000,
          "action": {
            "do": "status",
            "node": "east-alb",
            "status": "down"
          }
        },
        {
          "atMs": 5000,
          "action": {
            "do": "note",
            "text": "us-east-1 goes dark. DNS health checks stop sending travellers there within one check.",
            "focus": [
              "dns",
              "east-alb",
              "east-router"
            ]
          }
        },
        {
          "atMs": 9000,
          "action": {
            "do": "note",
            "text": "us-west-2 takes half of the extra traffic. Its cells run hotter but stay under capacity: that headroom is the design.",
            "focus": [
              "west-alb",
              "west-router",
              "west-c1-api",
              "west-c2-api"
            ]
          }
        },
        {
          "atMs": 13000,
          "action": {
            "do": "note",
            "text": "eu-west-1 takes the other half, with the same headroom.",
            "focus": [
              "eu-alb",
              "eu-router",
              "eu-c1-api",
              "eu-c2-api"
            ]
          }
        },
        {
          "atMs": 18000,
          "action": {
            "do": "status",
            "node": "east-alb",
            "status": "up"
          }
        },
        {
          "atMs": 18000,
          "action": {
            "do": "note",
            "text": "us-east-1 is back and DNS sends its share home. Global tables replicated every booking while it was away.",
            "focus": [
              "east-alb",
              "east-router",
              "east-c1-db",
              "east-c2-db"
            ]
          }
        }
      ],
      "expectations": [
        {
          "id": "west-serves",
          "label": "us-west-2 keeps booking",
          "metric": {
            "node": "west-c1-api",
            "field": "failed"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        },
        {
          "id": "eu-serves",
          "label": "eu-west-1 keeps booking",
          "metric": {
            "node": "eu-c2-api",
            "field": "failed"
          },
          "op": "==",
          "value": 0,
          "when": "always"
        },
        {
          "id": "emails",
          "label": "Confirmations still go out",
          "metric": {
            "node": "email",
            "field": "processed"
          },
          "op": ">",
          "value": 4000,
          "when": "end"
        }
      ]
    },
    {
      "id": "bad-cell-deploy",
      "title": "A bad deploy stays in one cell",
      "description": "The release pipeline deploys to one canary cell first. The new build fails most bookings, but only in Cell 1 of us-east-1: about a sixth of traffic. The cell's alarm stops the rollout and rolls it back at 12 s.",
      "seed": 22,
      "scale": 5,
      "durationMs": 25000,
      "traffic": [
        {
          "id": "web",
          "node": "travellers",
          "label": "Web bookings",
          "shape": {
            "kind": "constant",
            "ratePerSec": 120,
            "durationMs": 20000
          }
        },
        {
          "id": "app",
          "node": "mobile",
          "label": "App bookings",
          "shape": {
            "kind": "constant",
            "ratePerSec": 90,
            "durationMs": 20000
          }
        },
        {
          "id": "partners",
          "node": "agents",
          "label": "Agent bookings",
          "shape": {
            "kind": "constant",
            "ratePerSec": 30,
            "durationMs": 20000
          }
        }
      ],
      "timeline": [
        {
          "atMs": 0,
          "action": {
            "do": "note",
            "text": "Six cells, each a complete copy of the booking stack. The release pipeline deploys to one cell at a time, starting here.",
            "focus": [
              "east-c1-api",
              "east-c1-avail",
              "east-c1-db",
              "east-c1-cache"
            ]
          }
        },
        {
          "atMs": 4000,
          "action": {
            "do": "props",
            "node": "east-c1-api",
            "props": {
              "failureRate": 0.8
            }
          }
        },
        {
          "atMs": 4000,
          "action": {
            "do": "note",
            "text": "Build 7.3 reaches the canary cell and fails most of its bookings.",
            "focus": [
              "east-c1-api",
              "east-c1-avail",
              "east-c1-db"
            ]
          }
        },
        {
          "atMs": 8000,
          "action": {
            "do": "note",
            "text": "Only that cell's customers notice. The neighbouring cell, and the four cells in the other regions, carry on untouched.",
            "focus": [
              "east-c1-api",
              "east-c2-api",
              "east-c1-db",
              "east-c2-db"
            ]
          }
        },
        {
          "atMs": 12000,
          "action": {
            "do": "props",
            "node": "east-c1-api",
            "props": {
              "failureRate": 0
            }
          }
        },
        {
          "atMs": 12000,
          "action": {
            "do": "note",
            "text": "The cell's CloudWatch alarm halts the rollout and rolls it back. Bookings succeed again.",
            "focus": [
              "east-c1-api",
              "east-c1-db"
            ]
          }
        }
      ],
      "expectations": [
        {
          "id": "contained",
          "label": "The bad build fails bookings in its cell",
