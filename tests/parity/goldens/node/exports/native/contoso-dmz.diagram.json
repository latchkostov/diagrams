  "edges": [
    {
      "id": "web-in",
      "from": "visitors",
      "to": "router",
      "label": "Web",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "probe-in",
      "from": "probes",
      "to": "router",
      "label": "Probe",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "perimeter",
      "from": "router",
      "to": "firewall",
      "label": "Inspect",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "allow-web",
      "from": "firewall",
      "to": "adc",
      "label": "Allow web",
      "kind": "sync",
      "props": {
        "travelMs": 200,
        "filter": [
          "WebRequest"
        ]
      }
    },
    {
      "id": "deny-admin",
      "from": "firewall",
      "to": "admin",
      "label": "Deny admin",
      "kind": "sync",
      "props": {
        "travelMs": 200,
        "filter": [
          "AdminProbe"
        ],
        "deny": true
      }
    },
    {
      "id": "to-switch",
      "from": "adc",
      "to": "switch",
      "label": "Forward",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "to-app",
      "from": "switch",
      "to": "app",
      "label": "Web",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    },
    {
      "id": "to-db",
      "from": "app",
      "to": "database",
      "label": "Query",
      "kind": "sync",
      "props": {
        "travelMs": 200
      }
    }
  ],
  "simulations": [
    {
