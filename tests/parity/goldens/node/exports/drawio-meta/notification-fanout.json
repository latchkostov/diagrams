          {
            "id": "shipping-wave",
            "title": "Holiday shipping wave",
            "description": "2,000 parcels ship in five seconds. Email and push keep up; SMS queues behind its 50-a-second limit.",
            "seed": 7,
            "scale": 10,
            "traffic": [
              {
                "id": "scans",
                "node": "carrier",
                "messageType": "ParcelScanned",
                "label": "400 parcels/s for 5 seconds",
                "shape": { "kind": "constant", "ratePerSec": 400, "durationMs": 5000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Every shipped parcel becomes one OrderShipped event. The router reads the customer's preferences and fans out to the channels they chose. Each dot is 10 events.", "focus": ["events", "router", "preferences"] }
              },
              {
                "atMs": 2500,
                "action": { "do": "note", "text": "SMS is limited to 50 a second to stay inside the provider's throughput. Its queue grows while email and push keep pace.", "focus": ["sms-q", "sms-limiter", "email-q", "push-q"], "pause": true }
              },
              {
                "atMs": 9000,
                "action": { "do": "note", "text": "The SMS queue drains at its own pace. Separate queues mean one slow channel never delays the others.", "focus": ["sms-q", "twilio"] }
              }
            ],
            "expectations": [
              {
                "id": "sms-backlog",
                "label": "SMS queues behind its rate limit",
                "metric": { "node": "sms-q", "field": "lag" },
                "op": ">",
                "value": 100,
                "when": "at",
                "atMs": 5000
              },
              {
                "id": "email-current",
                "label": "Email keeps up",
                "metric": { "node": "email-q", "field": "lag" },
                "op": "<=",
                "value": 200,
                "when": "always"
              },
              {
                "id": "sms-drained",
                "label": "Every SMS is eventually sent",
                "metric": { "node": "sms-q", "field": "lag" },
                "op": "==",
                "value": 0,
                "when": "end"
              },
              {
                "id": "preferences",
                "label": "Preferences read for all 2,000",
                "metric": { "node": "preferences", "field": "processed" },
                "op": "==",
                "value": 2000,
                "when": "end"
              }
            ]
          },
          {
            "id": "sms-outage",
            "title": "SMS provider outage",
            "description": "Twilio errors for five seconds; the circuit breaker pauses SMS while email and push carry on.",
            "seed": 7,
            "scale": 1,
            "traffic": [
              {
                "id": "scans",
                "node": "carrier",
                "messageType": "ParcelScanned",
                "label": "40 parcels/s for 8 seconds",
                "shape": { "kind": "constant", "ratePerSec": 40, "durationMs": 8000 }
              }
            ],
            "timeline": [
              { "atMs": 1500, "action": { "do": "status", "node": "sms-limiter", "status": "paused" } },
              {
                "atMs": 1500,
                "action": { "do": "note", "text": "Twilio starts returning errors. The circuit breaker opens and SMS sending pauses; messages wait in the queue instead of failing.", "focus": ["sms-limiter", "twilio", "sms-q"], "pause": true }
              },
              { "atMs": 6500, "action": { "do": "status", "node": "sms-limiter", "status": "up" } },
              {
                "atMs": 6500,
                "action": { "do": "note", "text": "The breaker closes. The backlog drains at 50 a second; email and push never noticed.", "focus": ["sms-q", "sms-limiter", "sendgrid", "push"] }
              }
            ],
            "expectations": [
              {
                "id": "waiting",
                "label": "SMS waits during the outage",
                "metric": { "node": "sms-q", "field": "lag" },
                "op": ">",
                "value": 20,
                "when": "at",
                "atMs": 6000
              },
              {
                "id": "drained",
                "label": "The SMS backlog drains",
