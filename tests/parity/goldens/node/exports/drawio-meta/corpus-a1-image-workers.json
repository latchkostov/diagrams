                "node": "source",
                "messageType": "ImageUploaded",
                "shape": { "kind": "constant", "ratePerSec": 48, "durationMs": 4000 }
              }
            ],
            "timeline": [
              {
                "atMs": 1000,
                "action": { "do": "note", "text": "Demand is above one worker’s target. New replicas start while Kafka holds the backlog.", "focus": ["uploads", "worker"] }
              },
              {
                "atMs": 7000,
                "action": { "do": "note", "text": "Ready workers drain the upload burst. Open Live details to see desired and ready replicas over time.", "focus": ["worker"] }
              }
            ],
            "expectations": [
              {
                "id": "buffered",
                "label": "Uploads wait for starting workers",
                "metric": { "node": "uploads", "field": "lag", "group": "thumbnails" },
                "op": ">",
