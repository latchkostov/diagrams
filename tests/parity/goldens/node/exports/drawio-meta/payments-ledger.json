        "simulations": [
          {
            "id": "psp-brownout",
            "title": "Adyen browns out",
            "description": "The PSP router sends 70% of card payments to Adyen and 30% to Stripe. Four seconds in, Adyen starts failing most authorizations; weights don't move by themselves. At nine seconds the on-call engineer shifts the router to Stripe, inside Stripe's contracted rate.",
            "seed": 31,
            "scale": 5,
            "durationMs": 22000,
            "traffic": [
              {
                "id": "merchant-traffic",
                "node": "merchants",
                "label": "Merchant API",
                "shape": { "kind": "constant", "ratePerSec": 300, "durationMs": 18000 }
              },
              {
                "id": "wallet-traffic",
                "node": "wallets",
                "label": "Wallet payments",
                "shape": { "kind": "constant", "ratePerSec": 120, "durationMs": 18000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Each payment checks its idempotency key, is tokenized inside the PCI zone, scored, and authorized by a durable workflow.", "focus": ["payments-api", "idem", "tokenizer", "risk", "saga"] }
              },
              { "atMs": 4000, "action": { "do": "props", "node": "adyen", "props": { "failureRate": 0.6 } } },
              {
                "atMs": 4000,
                "action": { "do": "note", "text": "Adyen starts failing 60% of authorizations. The router keeps its 70/30 split: weights don't move by themselves.", "focus": ["psp-router", "adyen", "stripe"] }
              },
              {
                "atMs": 9000,
                "action": {
                  "do": "props",
                  "node": "psp-router",
                  "props": {
                    "routeTable": {
                      "rules": [],
                      "default": {
                        "targets": [
                          { "edgeId": "psp-router--adyen", "weight": 0 },
                          { "edgeId": "psp-router--stripe", "weight": 100 }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "atMs": 9000,
                "action": { "do": "note", "text": "On-call shifts every card to Stripe. Stripe's contracted 500 requests a second covers the whole load, so failures stop.", "focus": ["psp-router", "stripe"] }
              },
              {
                "atMs": 14000,
                "action": { "do": "note", "text": "Every authorization, failed or not, is recorded through the outbox: the ledger and merchant webhooks never miss one.", "focus": ["payments-db", "outbox-relay", "payment-events", "poster", "hooks-out"] }
              }
            ],
            "expectations": [
              {
                "id": "adyen-failed",
                "label": "Adyen fails authorizations",
                "metric": { "node": "adyen", "field": "failed" },
                "op": ">",
                "value": 0,
                "when": "end"
              },
              {
                "id": "stripe-fits",
                "label": "Stripe takes over the load",
                "metric": { "node": "stripe", "field": "processed" },
                "op": ">",
                "value": 1500,
                "when": "end"
              },
              {
                "id": "ledger-complete",
                "label": "The ledger posts every payment event",
                "metric": { "node": "payment-events", "field": "lag", "group": "ledger" },
                "op": "==",
                "value": 0,
                "when": "end"
              }
            ]
          },
          {
            "id": "poison-dispute",
            "title": "A poison dispute notification",
            "description": "Adyen starts sending a new dispute format. The Disputes handler can't parse it: each one fails three times and lands in the PSP events DLQ, while charge updates in the same queue keep flowing. After the fix ships, redrive replays the parked disputes.",
            "seed": 32,
            "scale": 1,
            "durationMs": 22000,
            "setup": { "status": { "psp-redrive": "paused" } },
            "traffic": [
              {
                "id": "charges",
                "node": "psp-hooks",
                "label": "Charge notifications",
                "messageType": "ChargeSucceeded",
                "shape": { "kind": "constant", "ratePerSec": 20, "durationMs": 16000 }
              },
              {
                "id": "disputes",
                "node": "psp-hooks",
                "label": "New-format disputes",
                "messageType": "DisputeOpened",
                "shape": { "kind": "burst", "count": 12, "atMs": 3000, "spreadMs": 2000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "PSP notifications are verified, queued, and filtered by type: charge updates and disputes have their own consumers.", "focus": ["psp-hooks", "hook-ingest", "psp-q", "psp-events", "disputes"] }
              },
              { "atMs": 3000, "action": { "do": "props", "node": "disputes", "props": { "failureRate": 1 } } },
              {
                "atMs": 3000,
                "action": { "do": "note", "text": "Disputes arrive in a new format the handler can't parse.", "focus": ["psp-q", "disputes"] }
              },
              {
                "atMs": 6000,
                "action": { "do": "note", "text": "Each fails three times and parks in the DLQ. Charge updates keep flowing past them.", "focus": ["psp-q", "psp-dlq", "psp-events"] }
              },
              { "atMs": 12000, "action": { "do": "props", "node": "disputes", "props": { "failureRate": 0 } } },
              { "atMs": 12000, "action": { "do": "status", "node": "psp-redrive", "status": "up" } },
              {
                "atMs": 12000,
                "action": { "do": "note", "text": "The fix ships. Redrive replays the parked disputes and they succeed.", "focus": ["psp-dlq", "psp-redrive", "disputes"] }
              }
            ],
            "expectations": [
              {
                "id": "parked",
                "label": "Every new-format dispute is dead-lettered",
                "metric": { "node": "psp-q", "field": "deadLettered" },
                "op": "==",
                "value": 12,
                "when": "end"
              },
              {
                "id": "charges-flow",
                "label": "Charge updates never fail",
                "metric": { "node": "psp-events", "field": "failed" },
                "op": "==",
                "value": 0,
                "when": "always"
              },
              {
                "id": "replayed",
                "label": "Redrive replays every parked dispute",
                "metric": { "node": "psp-dlq", "field": "backlog" },
                "op": "==",
                "value": 0,
                "when": "end"
              }
            ]
          }
