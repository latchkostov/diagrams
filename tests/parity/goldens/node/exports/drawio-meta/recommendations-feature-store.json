            "id": "canary-rollback",
            "title": "The canary misbehaves",
            "description": "Argo CD rolls Ranker v8 out to 5% of home pages. Its new feature join times out on half its requests; the router keeps sending it 5% until the on-call engineer sets its weight to zero.",
            "seed": 62,
            "scale": 10,
            "durationMs": 22000,
            "traffic": [
              {
                "id": "tv",
                "node": "tv",
                "label": "TVs and web",
                "shape": { "kind": "constant", "ratePerSec": 300, "durationMs": 18000 }
              },
              {
                "id": "phones",
                "node": "phones",
                "label": "App",
                "shape": { "kind": "constant", "ratePerSec": 200, "durationMs": 18000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Argo CD has rolled Ranker v8 out as a canary: the router sends it 5% of rankings.", "focus": ["ranking-router", "ranker-v7", "ranker-v8"] }
              },
              { "atMs": 3000, "action": { "do": "props", "node": "ranker-v8", "props": { "failureRate": 0.5 } } },
              {
                "atMs": 3000,
                "action": { "do": "note", "text": "v8's new feature join times out on half its requests. Those members get a fallback row.", "focus": ["ranking-router", "ranker-v8", "feature-server"] }
              },
