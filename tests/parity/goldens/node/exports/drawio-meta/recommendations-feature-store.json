            "scale": 10,
            "durationMs": 26000,
            "traffic": [
              {
                "id": "tv",
                "node": "tv",
                "label": "TVs and web",
                "shape": { "kind": "constant", "ratePerSec": 300, "durationMs": 20000 }
              },
