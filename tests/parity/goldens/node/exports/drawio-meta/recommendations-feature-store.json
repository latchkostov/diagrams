            "id": "friday-night",
            "title": "Friday night peak",
            "description": "Home-page loads climb fourfold in a few seconds. Ranker v7 scales on CPU while the feature server and online store keep up; the shadow model keeps scoring its mirrored 10% without answering anyone.",
            "seed": 61,
            "scale": 20,
            "durationMs": 30000,
            "traffic": [
              {
                "id": "tv",
                "node": "tv",
                "label": "TVs and web",
                "shape": {
                  "kind": "ramp",
                  "fromMs": 0,
                  "startRate": 300,
                  "stages": [
                    { "durationMs": 4000, "targetRate": 1200 },
                    { "durationMs": 16000, "targetRate": 1200 },
                    { "durationMs": 4000, "targetRate": 300 }
                  ]
                }
              },
              {
                "id": "phones",
                "node": "phones",
                "label": "App",
                "shape": {
                  "kind": "ramp",
                  "fromMs": 0,
                  "startRate": 200,
                  "stages": [
                    { "durationMs": 4000, "targetRate": 800 },
                    { "durationMs": 16000, "targetRate": 800 },
                    { "durationMs": 4000, "targetRate": 200 }
                  ]
                }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Each home page asks for candidates, then ranks them: 95% on Ranker v7, 5% on the v8 canary, and 10% mirrored to the v9 shadow.", "focus": ["home-api", "candidates", "ranking-router", "ranker-v7", "ranker-v8"] }
              },
              {
                "atMs": 4000,
                "action": { "do": "note", "text": "Friday night: four times the home loads. Ranker v7 passes 70% CPU and its HPA adds pods.", "focus": ["ranking-router", "ranker-v7"] }
              },
              {
                "atMs": 9000,
                "action": { "do": "note", "text": "Every ranker reads the same online features, kept fresh by streaming jobs and bulk loads.", "focus": ["feature-server", "online-store", "ann-index"] }
              },
              {
                "atMs": 14000,
                "action": { "do": "note", "text": "Predictions go to a log: the drift monitor watches them, and the lake keeps them for training.", "focus": ["predictions", "drift", "lake-sink"] }
              }
            ],
            "expectations": [
              {
                "id": "scored",
                "label": "Ranker v7 scores the peak",
                "metric": { "node": "ranker-v7", "field": "processed" },
                "op": ">",
                "value": 10000,
                "when": "end"
              },
