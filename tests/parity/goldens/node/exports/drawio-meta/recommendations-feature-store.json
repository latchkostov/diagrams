                      }
                    }
                  }
                }
              },
              {
                "atMs": 8000,
                "action": { "do": "note", "text": "The quality dashboard shows the dip. On-call sets v8's weight to zero, and v7 takes every ranking again.", "focus": ["ranking-router", "ranker-v7", "ranker-v8"] }
