            "from": "rules",
            "to": "alertmanager",
            "label": "Firing",
            "kind": "async",
            "props": { "emits": "Alert", "share": 0.01 }
          },
          { "id": "alertmanager--pagerduty", "from": "alertmanager", "to": "pagerduty", "label": "Page", "kind": "sync" },
          { "id": "alertmanager--slack", "from": "alertmanager", "to": "slack", "label": "Notify", "kind": "sync" },
          {
            "id": "alertmanager--status-page",
            "from": "alertmanager",
            "to": "status-page",
            "label": "Incident",
            "kind": "sync",
            "props": { "share": 0.2 }
          },
          { "id": "grafana--loki-store", "from": "grafana", "to": "loki-store", "label": "LogQL", "kind": "async", "relation": "depends" },
          { "id": "gateways--vault", "from": "gateways", "to": "vault", "label": "Redaction keys", "kind": "async", "relation": "secret" },
          { "id": "gateways--roles", "from": "gateways", "to": "roles", "kind": "async", "relation": "identity" },
          { "id": "gateways--pipeline-config", "from": "gateways", "to": "pipeline-config", "label": "Sampling policy", "kind": "async", "relation": "config" },
          { "id": "tenant-limits--pipeline-config", "from": "tenant-limits", "to": "pipeline-config", "label": "Budgets", "kind": "async", "relation": "config" },
          { "id": "grafana--tempo", "from": "grafana", "to": "tempo", "label": "TraceQL", "kind": "async", "relation": "depends" },
          { "id": "grafana--prom", "from": "grafana", "to": "prom", "label": "PromQL", "kind": "async", "relation": "depends" }
        ],
        "simulations": [
          {
            "id": "log-storm",
            "title": "An incident log storm",
            "description": "A bad Checkout deploy logs every retry: telemetry jumps fivefold for ten seconds. Gateway collectors scale on CPU, Kafka absorbs the burst, and the log ingesters work through their lag without slowing traces or metrics.",
            "seed": 81,
            "scale": 20,
            "durationMs": 40000,
            "traffic": [
              {
                "id": "shop",
                "node": "shoppers",
                "label": "Shoppers",
                "shape": { "kind": "constant", "ratePerSec": 400, "durationMs": 30000 }
              },
              {
                "id": "storm",
                "node": "agent-shop",
                "label": "Checkout's retry logs",
                "messageType": "RetryLog",
                "shape": { "kind": "constant", "ratePerSec": 1600, "fromMs": 3000, "durationMs": 10000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Every request sends telemetry to the node agents, then to gateway collectors behind a load balancer that hashes by trace ID.", "focus": ["agent-shop", "otlp-lb", "gateways"] }
              },
              {
                "atMs": 3000,
                "action": { "do": "note", "text": "A bad Checkout deploy logs every retry: five times the telemetry. The gateway collectors' CPU climbs and their HPA adds pods.", "focus": ["agent-shop", "gateways", "tenant-limits"] }
              },
              {
                "atMs": 8000,
                "action": { "do": "note", "text": "Kafka absorbs the logs. The ingesters fall behind for a while; traces and metrics, in their own topics, don't.", "focus": ["logs", "ingesters", "spans", "metrics"] }
              },
              {
                "atMs": 20000,
                "action": { "do": "note", "text": "The deploy is rolled back and the ingesters catch up. Nothing was dropped.", "focus": ["logs", "ingesters", "loki-store"] }
              }
            ],
            "expectations": [
              {
                "id": "lag",
                "label": "Log ingestion falls behind",
                "metric": { "node": "logs", "field": "lag", "group": "loki" },
                "op": ">",
                "value": 500,
                "when": "eventually"
              },
              {
                "id": "caught-up",
                "label": "Log ingestion catches up",
                "metric": { "node": "logs", "field": "lag", "group": "loki" },
                "op": "==",
                "value": 0,
                "when": "end"
              },
              {
                "id": "spans-flow",
                "label": "Traces never fall behind",
                "metric": { "node": "spans", "field": "lag", "group": "tempo" },
                "op": "<",
                "value": 200,
                "when": "always"
              }
            ]
          },
          {
            "id": "loki-outage",
            "title": "Drill: Loki is down for ten seconds",
            "description": "Loki's write path fails. Kafka keeps every log for the ingesters while dashboards for traces and metrics carry on; when Loki returns, the backlog drains in order.",
            "seed": 82,
            "scale": 10,
            "durationMs": 35000,
            "traffic": [
              {
                "id": "shop",
                "node": "shoppers",
                "label": "Shoppers",
                "shape": { "kind": "constant", "ratePerSec": 400, "durationMs": 25000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Logs, spans and metrics each have their own topic and consumers.", "focus": ["logs", "spans", "metrics"] }
              },
              {
                "atMs": 4000,
                "action": { "do": "fault", "fault": { "kind": "boundary", "boundary": "loki", "down": true } }
              },
              {
                "atMs": 4000,
                "action": { "do": "note", "text": "Drill: take down the Loki boundary. Kafka keeps the logs: nothing is lost, it just waits.", "focus": ["logs", "ingesters", "loki-store"] }
              },
              {
                "atMs": 14000,
                "action": { "do": "fault", "fault": { "kind": "boundary", "boundary": "loki", "down": false } }
              },
              {
                "atMs": 14000,
                "action": { "do": "note", "text": "Loki is back and the ingesters drain the backlog. ClickHouse and the archive never stopped.", "focus": ["logs", "ingesters", "ch-sink", "s3-sink"] }
              }
            ],
            "expectations": [
              {
                "id": "held",
                "label": "Logs wait in Kafka during the outage",
                "metric": { "node": "logs", "field": "lag", "group": "loki" },
                "op": ">",
                "value": 1000,
                "when": "at",
                "atMs": 13000
              },
              {
                "id": "drained",
                "label": "The backlog drains",
                "metric": { "node": "logs", "field": "lag", "group": "loki" },
                "op": "==",
                "value": 0,
                "when": "end"
              },
              {
                "id": "no-loss",
                "label": "Nothing is dropped",
                "metric": { "node": "ingesters", "field": "dropped" },
                "op": "==",
                "value": 0,
                "when": "always"
              }
            ]
          }
        ]
      }
    }
  ]
}
