          {
            "id": "leicester-fibre-cut",
            "title": "Drill: the Leicester fibre is cut",
            "description": "A digger cuts the Leicester branch's fibre. Its SD-WAN router health-checks both underlays, so every new session moves to the LTE tunnel; only requests already on the fibre are lost. The fibre comes back ten seconds later.",
            "seed": 91,
            "scale": 1,
            "durationMs": 24000,
            "traffic": [
              {
                "id": "leicester",
                "node": "leicester-staff",
                "label": "Leicester branch",
                "messageType": "ERP",
                "shape": { "kind": "constant", "ratePerSec": 20, "durationMs": 20000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "The Leicester router sends the branch's tunnels over fibre and a 4G backup, and health-checks both.", "focus": ["leicester-router", "lte", "hub"] }
              },
              {
                "atMs": 4000,
                "action": {
                  "do": "fault",
                  "drill": "region-connectivity",
                  "fault": { "kind": "link", "edge": "leicester-fibre", "cut": true }
                }
              },
              {
                "atMs": 4000,
                "action": { "do": "note", "text": "Region connectivity drill: the fibre is cut. Requests already on it are lost; the router sends every new one over LTE.", "focus": ["leicester-router", "lte", "hub"] }
              },
              {
                "atMs": 14000,
                "action": {
