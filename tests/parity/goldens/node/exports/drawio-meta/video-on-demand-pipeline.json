                }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Almost every request is a video segment; a few start playback and need a manifest and a licence.", "focus": ["viewers", "cdn", "edge-cache"] }
              },
              {
                "atMs": 4000,
                "action": { "do": "note", "text": "Three times the viewers. The edge cache answers 97% of segments; the origin bucket only sees misses.", "focus": ["viewers", "cdn", "edge-cache"] }
              },
              {
                "atMs": 9000,
