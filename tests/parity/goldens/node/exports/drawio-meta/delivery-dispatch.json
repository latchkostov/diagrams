        ],
        "simulations": [
          {
            "id": "dinner-rush",
            "title": "Friday dinner rush",
            "description": "Orders climb from 30 to 90 a second and couriers report more often. KEDA scales the geo indexer on Kafka lag, and the dispatch matcher hits the maps provider's 50 calls a second: the excess is rejected, so ETAs fall back to the model.",
            "seed": 41,
            "scale": 20,
            "durationMs": 30000,
            "traffic": [
              {
                "id": "orders",
                "node": "diners",
                "label": "Diner app",
                "shape": {
                  "kind": "ramp",
                  "fromMs": 0,
                  "startRate": 150,
                  "stages": [
                    { "durationMs": 6000, "targetRate": 450 },
                    { "durationMs": 14000, "targetRate": 450 },
                    { "durationMs": 4000, "targetRate": 150 }
                  ]
                }
              },
              {
                "id": "ready",
                "node": "restaurants",
                "label": "Orders ready",
                "shape": {
                  "kind": "ramp",
                  "fromMs": 2000,
                  "startRate": 30,
                  "stages": [
                    { "durationMs": 6000, "targetRate": 90 },
                    { "durationMs": 14000, "targetRate": 90 },
                    { "durationMs": 4000, "targetRate": 30 }
                  ]
                }
              },
              {
                "id": "pings",
                "node": "couriers",
                "label": "Courier pings",
                "shape": {
                  "kind": "ramp",
                  "fromMs": 0,
                  "startRate": 1000,
                  "stages": [{ "durationMs": 6000, "targetRate": 1500 }, { "durationMs": 18000, "targetRate": 1500 }]
                }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "Two streams meet in dispatch: orders that are ready, and couriers' locations indexed by H3 cell.", "focus": ["ready-topic", "locations-topic", "matcher", "geo-index"] }
              },
              {
                "atMs": 4000,
                "action": { "do": "note", "text": "The rush starts. Location lag rises and KEDA adds geo indexers, one per partition at most.", "focus": ["locations-topic", "geo-indexer"] }
              },
              {
                "atMs": 9000,
                "action": { "do": "note", "text": "Ninety ready orders a second, but the maps API allows 50 calls: the rest are rejected and the matcher uses the model's ETA.", "focus": ["matcher", "maps", "eta-model"] }
              },
              {
                "atMs": 20000,
                "action": { "do": "note", "text": "The rush eases. Every ready order got a courier offer.", "focus": ["offers", "notifications", "push-sender"] }
              }
            ],
            "expectations": [
              {
                "id": "maps-limited",
                "label": "The maps API rejects calls over its quota",
                "metric": { "node": "maps", "field": "rejected" },
                "op": ">",
                "value": 0,
                "when": "end"
              },
              {
                "id": "offers-sent",
                "label": "Couriers get offers",
                "metric": { "node": "fcm", "field": "processed" },
                "op": ">",
                "value": 1500,
                "when": "end"
              },
              {
                "id": "located",
                "label": "Location lag drains",
                "metric": { "node": "locations-topic", "field": "lag", "group": "geo-index" },
                "op": "==",
                "value": 0,
                "when": "end"
              }
            ]
          },
          {
            "id": "partition-ceiling",
            "title": "Eight partitions, a stadium's worth of couriers",
            "description": "A stadium lets out and 3,600 pings a second arrive. KEDA wants more geo indexers, but a consumer group can't use more readers than the topic has partitions: eight. Lag grows until the team raises the topic to 24 partitions.",
            "seed": 42,
            "scale": 50,
            "durationMs": 30000,
            "traffic": [
              {
                "id": "pings",
                "node": "couriers",
                "label": "Courier pings",
                "shape": { "kind": "constant", "ratePerSec": 3600, "durationMs": 22000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "3,600 pings a second. Each geo indexer handles about 400.", "focus": ["couriers", "mqtt", "loc-ingest", "locations-topic"] }
              },
              {
                "atMs": 5000,
                "action": { "do": "note", "text": "KEDA scales to eight indexers and stops: the topic has eight partitions, so lag keeps growing.", "focus": ["locations-topic", "geo-indexer"] }
              },
              { "atMs": 12000, "action": { "do": "props", "node": "locations-topic", "props": { "partitions": 24 } } },
              {
                "atMs": 12000,
                "action": {
                  "do": "props",
                  "node": "geo-indexer",
                  "props": {
                    "autoscaling": {
                      "mode": "on",
                      "modelRevision": "a2",
                      "preset": "keda-kafka",
                      "presetRevision": "1",
                      "controller": {
                        "kind": "keda",
                        "minReplicas": 3,
                        "maxReplicas": 24,
                        "initialReplicas": 3,
                        "pollingMs": 1000,
                        "cooldownMs": 5000,
                        "initialCooldownMs": 0,
                        "triggers": [
                          {
                            "type": "kafka",
                            "source": { "node": "locations-topic", "group": "geo-index" },
                            "target": 500,
                            "activation": 0,
                            "useCachedMetrics": false,
                            "allowIdleConsumers": false
                          }
                        ],
                        "settings": {
                          "syncMs": 1000,
                          "tolerance": 0.1,
                          "initialReadinessDelayMs": 0,
                          "cpuInitializationPeriodMs": 0,
                          "metrics": [],
                          "up": {
                            "stabilizationMs": 0,
                            "selectPolicy": "Max",
                            "policies": [
                              { "type": "Pods", "value": 4, "periodMs": 3000 },
                              { "type": "Percent", "value": 100, "periodMs": 3000 }
                            ]
                          },
                          "down": {
                            "stabilizationMs": 300000,
                            "selectPolicy": "Max",
                            "policies": [{ "type": "Percent", "value": 100, "periodMs": 15000 }]
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "atMs": 12000,
                "action": { "do": "note", "text": "The team raises the topic to 24 partitions and KEDA's maximum to match. KEDA adds indexers and the lag drains.", "focus": ["locations-topic", "geo-indexer", "geo-index"] }
              }
            ],
            "expectations": [
              {
                "id": "capped",
                "label": "Lag builds at eight partitions",
                "metric": { "node": "locations-topic", "field": "lag", "group": "geo-index" },
                "op": ">",
                "value": 1000,
                "when": "at",
                "atMs": 11000
              },
              {
                "id": "drained",
                "label": "Lag drains after the change",
                "metric": { "node": "locations-topic", "field": "lag", "group": "geo-index" },
                "op": "==",
                "value": 0,
                "when": "end"
              }
            ]
          }
        ],
        "annotations": [
          { "id": "note-h3", "kind": "note", "text": "Pings are keyed by H3 cell, so one busy neighbourhood lands on one partition. Partitions cap how many indexers can help.", "x": 0, "y": 1500, "width": 280, "height": 150 }
