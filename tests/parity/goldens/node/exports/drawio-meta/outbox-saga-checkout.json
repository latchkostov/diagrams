                "value": 40,
                "when": "end"
              }
            ]
          },
          {
            "id": "declines",
            "title": "Declines and flaky payments",
            "description": "Transient payment errors are retried with the same idempotency key; a fraud rule declines cards for three seconds and the saga compensates.",
            "seed": 7,
            "scale": 1,
            "setup": { "props": { "payment-svc": { "failureRate": 0.2 } } },
            "traffic": [
              {
                "id": "checkouts",
                "node": "client",
                "messageType": "PlaceOrder",
                "label": "60 checkouts over 6 seconds",
                "shape": { "kind": "constant", "ratePerSec": 10, "durationMs": 6000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "One payment call in five times out. The consumer retries in place with the same Idempotency-Key, so a retry never charges twice.", "focus": ["payment-svc", "stripe"] }
              },
              {
                "atMs": 2500,
                "action": {
                  "do": "props",
                  "node": "payment-svc",
                  "props": { "emits": { "ChargePayment": "PaymentDeclined" } }
                }
              },
              {
                "atMs": 2500,
                "action": { "do": "note", "text": "A fraud rule starts declining every card. The saga compensates: it releases the reserved stock, then cancels the order.", "focus": ["payment-svc", "saga", "inventory-cmds", "order-api"], "pause": true }
              },
              {
                "atMs": 5500,
                "action": {
                  "do": "props",
                  "node": "payment-svc",
                  "props": { "emits": { "ChargePayment": "PaymentCaptured" } }
                }
              },
              {
                "atMs": 5500,
                "action": { "do": "note", "text": "The rule is rolled back. Every customer still hears back: a receipt or a cancellation.", "focus": ["notifications", "email"] }
              }
            ],
            "expectations": [
