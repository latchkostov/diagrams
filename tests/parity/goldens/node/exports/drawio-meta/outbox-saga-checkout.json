        "simulations": [
          {
            "id": "happy-path",
            "title": "Twenty checkouts, happy path",
            "description": "Each order commits with its outbox row, then the saga reserves stock, charges the card and confirms.",
            "seed": 7,
            "scale": 1,
            "traffic": [
              {
                "id": "checkouts",
                "node": "client",
                "messageType": "PlaceOrder",
                "label": "20 checkouts",
                "shape": { "kind": "burst", "count": 20, "spreadMs": 4000 }
              }
            ],
            "timeline": [
              { "atMs": 0, "action": { "do": "trace", "node": "order-api" } },
              {
                "atMs": 0,
                "action": { "do": "note", "text": "The order row and its OrderCreated event commit in one database transaction. No dual write, so no lost events.", "focus": ["order-api", "orders-db"], "pause": true }
              },
              {
                "atMs": 900,
                "action": { "do": "note", "text": "The outbox relay tails the write-ahead log and publishes each outbox row to Kafka.", "focus": ["orders-db", "outbox-relay", "order-events"] }
              },
              {
                "atMs": 2500,
                "action": { "do": "note", "text": "The saga runs one step at a time: reserve stock, charge the card, then confirm the order. Every step is saved, so a restart resumes where it left off.", "focus": ["saga", "saga-db", "inventory-cmds", "payment-cmds", "saga-replies"] }
              },
              {
                "atMs": 6000,
                "action": { "do": "note", "text": "OrderConfirmed goes out through the same outbox, and the customer gets a receipt.", "focus": ["order-events", "notifications", "email"] }
              }
            ],
            "expectations": [
              {
                "id": "stock",
                "label": "20 reservations",
                "metric": { "node": "inventory-db", "field": "processed" },
                "op": "==",
                "value": 20,
                "when": "end"
              },
