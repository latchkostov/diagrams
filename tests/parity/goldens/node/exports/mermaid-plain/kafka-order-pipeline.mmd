  payments -->|"Record authorization"| payment_db
  notifications -->|"SET NX · dedupe"| notify_cache
  payments -.->|"PaymentCompleted"| payment_events
  payment_events -.->|"group: orders-payments"| orders
  orders -->|"Fetch Avro schema"| schemas
  metrics -->|"GET /metrics"| orders
