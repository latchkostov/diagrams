{
  "file": { "sha256": "d69507c3b3e91b621d97d817181476df8cf54d02fb6a49dab7ae714c7b6f0cb4", "bytes": 16905 },
  "payload": {
    "version": 1,
    "diagram": {
      "format": "diagrams/v2",
      "planning": { "revision": "p3-w1" },
      "title": "Scale on busy threads",
      "description": "CPU stays low while threads wait on a slow partner, so CPU scaling never adds pods. Compare: scale on busy threads (up to 10 pods), or free the thread while waiting. The partner's replies vary by 10%.",
      "nodes": [
        {
          "id": "source",
          "stencil": "client.user",
          "label": "Applications submitted",
          "x": 0,
          "y": 180,
          "props": { "ratePerSec": 400 }
        },
        {
          "id": "applications",
          "stencil": "generic.topic",
          "label": "Applications",
          "x": 320,
          "y": 180,
          "props": { "partitions": 12 }
        },
        {
          "id": "caller",
          "stencil": "generic.service",
          "label": "Decision service",
          "sublabel": "4 replicas · 16 threads each",
          "x": 660,
          "y": 180,
          "props": {
            "replicas": 4,
            "concurrency": 16,
            "latencyMs": 10,
            "jitter": 0,
            "resources": {
              "preset": "io-service",
              "presetRevision": "1",
              "cpuMsPerMessage": 5,
              "baselineMemoryMiB": 128,
              "memoryMiBPerMessage": 2,
              "cpuRequestMilli": 1000,
              "cpuLimitMilli": 1000,
              "memoryRequestMiB": 512,
              "memoryLimitMiB": 1024,
              "startup": { "delayMs": 5000, "jitterFraction": 0 },
              "terminationGraceMs": 30000
            },
            "autoscaling": {
              "mode": "on",
              "modelRevision": "a1",
              "preset": "hpa-service",
              "presetRevision": "1",
              "controller": {
                "kind": "hpa",
                "initialReplicas": 4,
                "minReplicas": 4,
                "maxReplicas": 10,
                "settings": {
                  "syncMs": 1000,
                  "tolerance": 0.1,
                  "initialReadinessDelayMs": 30000,
                  "cpuInitializationPeriodMs": 300000,
                  "metrics": [
                    {
                      "source": { "kind": "resource", "resource": "cpu" },
                      "target": { "kind": "utilization", "percentOfRequest": 70 },
                      "windowMs": 1000,
                      "metricDelayMs": 0
                    }
                  ],
                  "up": {
                    "stabilizationMs": 0,
                    "selectPolicy": "Max",
                    "policies": [
                      { "type": "Pods", "value": 4, "periodMs": 15000 },
                      { "type": "Percent", "value": 100, "periodMs": 15000 }
                    ]
                  },
                  "down": {
                    "stabilizationMs": 5000,
                    "selectPolicy": "Max",
                    "policies": [{ "type": "Percent", "value": 100, "periodMs": 15000 }]
                  }
                }
              }
            }
          }
        },
        {
          "id": "partner",
          "stencil": "generic.external-api",
          "label": "Partner scoring API",
          "x": 1010,
          "y": 180,
          "props": { "latencyMs": 250, "api": { "latencyMs": 250 }, "jitter": 0.1 }
        },
        {
          "id": "decisions",
          "stencil": "generic.topic",
          "label": "Decisions",
          "x": 660,
          "y": 420,
          "props": { "partitions": 12 }
        },
        {
          "id": "store",
          "stencil": "generic.database",
          "label": "Case store",
          "x": 1010,
          "y": 420,
          "props": { "latencyMs": 1 }
        }
      ],
      "edges": [
        { "id": "submit", "from": "source", "to": "applications", "props": { "travelMs": 100 } },
        { "id": "consume", "from": "applications", "to": "caller", "props": { "travelMs": 10, "group": "decisions" } },
        { "id": "call", "from": "caller", "to": "partner", "kind": "sync", "props": { "travelMs": 200 } },
        { "id": "publish", "from": "caller", "to": "decisions", "props": { "travelMs": 100 } },
        { "id": "save", "from": "decisions", "to": "store", "props": { "travelMs": 100 } }
      ],
      "simulations": [
        {
          "id": "blocking",
          "title": "Threads held: CPU says all is well",
          "description": "At 400 requests/s the 64 threads fill. CPU scaling stays at four replicas while Applications pile up.",
          "seed": 17,
          "scale": 2,
          "durationMs": 50000,
          "traffic": [
            {
              "node": "source",
              "shape": { "kind": "constant", "ratePerSec": 400, "durationMs": 40000 },
              "id": "applications-0",
              "label": "Applications",
              "messageType": "ApplicationSubmitted"
            }
          ],
          "expectations": [
            {
              "id": "lag",
              "label": "Applications lag stays below 1,000",
              "metric": { "node": "applications", "field": "backlog" },
              "op": "<",
              "value": 1000,
              "when": "end"
            }
          ]
        },
        {
          "id": "busy-threads",
          "title": "Scale on busy threads",
          "description": "Scale at 70% of threads per pod: more pods start within ten seconds and the lag drains.",
          "seed": 17,
          "scale": 2,
          "durationMs": 50000,
          "traffic": [
            {
              "node": "source",
              "shape": { "kind": "constant", "ratePerSec": 400, "durationMs": 40000 },
              "id": "applications-0",
              "label": "Applications",
              "messageType": "ApplicationSubmitted"
            }
          ],
          "expectations": [
            {
              "id": "lag",
              "label": "Applications lag ends below 100",
              "metric": { "node": "applications", "field": "backlog" },
              "op": "<",
              "value": 100,
              "when": "end"
            }
          ],
          "setup": {
            "props": {
              "caller": {
                "autoscaling": {
                  "mode": "on",
                  "modelRevision": "a1",
                  "preset": "hpa-service",
                  "presetRevision": "1",
                  "controller": {
                    "kind": "hpa",
                    "initialReplicas": 4,
                    "minReplicas": 4,
                    "maxReplicas": 10,
                    "settings": {
                      "syncMs": 1000,
                      "tolerance": 0.1,
                      "initialReadinessDelayMs": 30000,
                      "cpuInitializationPeriodMs": 300000,
                      "metrics": [
                        {
                          "source": { "kind": "pods", "metric": "busyThreads" },
                          "target": { "kind": "utilization", "percentOfRequest": 70 },
                          "windowMs": 1000,
                          "metricDelayMs": 0
                        }
                      ],
                      "up": {
                        "stabilizationMs": 0,
                        "selectPolicy": "Max",
                        "policies": [
                          { "type": "Pods", "value": 4, "periodMs": 15000 },
                          { "type": "Percent", "value": 100, "periodMs": 15000 }
                        ]
                      },
                      "down": {
                        "stabilizationMs": 5000,
                        "selectPolicy": "Max",
                        "policies": [{ "type": "Percent", "value": 100, "periodMs": 15000 }]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "id": "free-thread",
          "title": "Free the thread while waiting",
          "description": "The same traffic runs on four pods when waiting calls free their threads.",
          "seed": 17,
          "scale": 2,
          "durationMs": 50000,
          "traffic": [
            {
              "node": "source",
              "shape": { "kind": "constant", "ratePerSec": 400, "durationMs": 40000 },
              "id": "applications-0",
              "label": "Applications",
              "messageType": "ApplicationSubmitted"
            }
          ],
          "expectations": [
            {
              "id": "lag",
              "label": "Applications lag ends below 100",
              "metric": { "node": "applications", "field": "backlog" },
              "op": "<",
              "value": 100,
              "when": "end"
            }
          ],
          "setup": { "edges": { "call": { "caller": { "wait": "non-blocking" } } } }
        }
      ]
    },
    "icons": {
      "client-user": { "sha256": "dffa37eace31e4c87ed5e2b0f49618146f847912a7b23f4d30271aeed9508da0", "bytes": 418 },
      "generic-database": { "sha256": "06a266a48958bdcedb816c4813ca231592e2cf39d848bb915f2ba64b12226c64", "bytes": 477 },
      "generic-external-api": { "sha256": "d3a95660f5a9fb8dbd298a79af1604cd83926a306583abeee407a7389b130be8", "bytes": 369 },
      "generic-service": { "sha256": "3fe5e72fd8c35eb0ef93e590677e2e7ffb6b3d31449533176a4e82fe9b6d0add", "bytes": 579 },
      "generic-topic": { "sha256": "377145cfe7f38bdd4d9c509e0e054e2b130bb8b30867cf051a505e0a3952cc6e", "bytes": 707 }
    },
    "options": { "theme": "light", "startSimulation": "blocking", "exportedOn": "2026-01-01" }
  }
