      "azure-functions": { "sha256": "a0db338f682176fb01465ae4590055ecdb3c7862ce174df80eefee3ab444d134", "bytes": 2399 },
      "azure-logic-apps": { "sha256": "52542d4ca7c53df0e72bf99fe34bb043d6d3a58bedcc3fab329ea2cf8afbbb9a", "bytes": 2455 },
