{
  "file": { "sha256": "a6e0e83f0e27112d73c2b492657e58536ad0014772ea646bc33e892102445eef", "bytes": 41801 },
  "payload": {
    "version": 1,
    "diagram": {
      "format": "diagrams/v1",
      "title": "IoT telemetry platform",
      "description": "Partitioned device telemetry feeds a low-latency state projection and streaming lake, with threshold alerts.",
      "direction": "LR",
      "groups": [
        { "id": "azure", "label": "Azure · industrial telemetry", "tone": "azure", "x": 380, "y": 0, "width": 1480, "height": 632 }
      ],
      "nodes": [
        {
          "id": "devices",
          "stencil": "client.iot",
          "label": "Factory sensors",
          "sublabel": "Temperature · vibration · deviceId",
          "x": 40,
          "y": 280,
          "props": { "ratePerSec": 2000, "messageType": "TelemetryReading" }
        },
        {
          "id": "hub",
          "stencil": "azure.event-hubs",
          "label": "plant.telemetry.v1",
          "sublabel": "Partition key: deviceId · retention: 7d",
          "x": 420,
          "y": 280,
          "group": "azure",
          "props": { "partitions": 64, "retentionDays": 7 }
        },
        {
          "id": "hot",
          "stencil": "azure.functions",
          "label": "Device state projector",
          "sublabel": "Consumer group: hot-state",
          "x": 800,
          "y": 160,
          "group": "azure",
          "props": {
            "group": "hot-state",
            "batchSize": 100,
            "concurrency": 128,
            "latencyMs": 150,
            "emits": { "TelemetryReading": "DeviceStateUpdated", "TemperatureExceeded": "TemperatureExceeded" }
          }
        },
        {
          "id": "stream",
          "stencil": "databricks",
          "label": "Telemetry streaming",
          "sublabel": "Consumer group: lake-stream",
          "x": 800,
          "y": 400,
          "group": "azure",
          "props": { "group": "lake-stream", "checkpointIntervalSec": 30, "concurrency": 128, "latencyMs": 150 }
        },
        {
          "id": "cosmos",
          "stencil": "azure.cosmos-db",
          "label": "Latest device state",
          "sublabel": "Partition key: /deviceId · TTL 7d",
          "x": 1180,
          "y": 160,
          "group": "azure",
          "props": { "ttlSec": 604800 }
        },
        {
          "id": "blob",
          "stencil": "azure.blob-storage",
          "label": "Telemetry lake",
          "sublabel": "Delta · plant/date/hour partitions",
          "x": 1180,
          "y": 400,
          "group": "azure",
          "props": {}
        },
        {
          "id": "alerts",
          "stencil": "azure.event-grid",
          "label": "plant.alerts",
          "sublabel": "TemperatureExceeded · DeviceOffline",
          "x": 1180,
          "y": 40,
          "group": "azure",
          "props": { "retryTtlSec": 86400, "partitions": 64 }
        },
        {
          "id": "delivery",
          "stencil": "azure.logic-apps",
          "label": "Alert delivery",
          "sublabel": "Severity filter · on-call routing",
          "x": 1560,
          "y": 40,
          "group": "azure",
          "props": { "concurrency": 128, "latencyMs": 150, "emits": "IncidentEmail" }
        },
        {
          "id": "email",
          "stencil": "generic.email",
          "label": "Plant operations",
          "sublabel": "On-call mailbox · incident details",
          "x": 1940,
          "y": 40,
          "props": {}
        },
        {
          "id": "grafana",
          "stencil": "grafana",
          "label": "Plant health dashboard",
          "sublabel": "Fleet health · live temperature",
          "x": 1560,
          "y": 160,
          "group": "azure",
          "props": {}
        },
        {
          "id": "metrics",
          "stencil": "prometheus",
          "label": "Streaming metrics",
          "sublabel": "Consumer lag · processing latency",
          "x": 1180,
          "y": 520,
          "group": "azure",
          "props": {}
        }
      ],
      "edges": [
        {
          "id": "devices-to-hub",
          "from": "devices",
          "to": "hub",
          "label": "AMQP/TLS · telemetry",
          "kind": "async",
          "props": { "travelMs": 100 }
        },
        {
          "id": "hub-to-hot",
          "from": "hub",
          "to": "hot",
          "label": "group: hot-state",
          "kind": "async",
          "props": { "travelMs": 100, "filter": ["TelemetryReading", "TemperatureExceeded"], "group": "hot-state" }
        },
        {
          "id": "hub-to-stream",
          "from": "hub",
          "to": "stream",
          "label": "group: lake-stream",
          "kind": "async",
          "props": { "travelMs": 100, "filter": ["TelemetryReading", "TemperatureExceeded"], "group": "lake-stream" }
        },
        {
          "id": "hot-to-cosmos",
          "from": "hot",
          "to": "cosmos",
          "label": "Upsert latest reading",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        {
          "id": "stream-to-blob",
          "from": "stream",
          "to": "blob",
          "label": "Commit Delta microbatch",
          "kind": "async",
          "props": { "travelMs": 200 }
        },
        {
          "id": "hot-to-alerts",
          "from": "hot",
          "to": "alerts",
          "label": "TemperatureExceeded",
          "kind": "async",
          "props": { "travelMs": 100, "filter": ["TemperatureExceeded"] }
        },
        {
          "id": "alerts-to-delivery",
          "from": "alerts",
          "to": "delivery",
          "label": "Filtered alert subscription",
          "kind": "async",
          "props": { "travelMs": 100, "filter": ["Temperature*"], "group": "on-call" }
        },
        {
          "id": "delivery-to-email",
          "from": "delivery",
          "to": "email",
          "label": "Incident notification",
          "kind": "async",
          "props": { "travelMs": 100 }
        },
        {
          "id": "grafana-to-cosmos",
          "from": "grafana",
          "to": "cosmos",
          "label": "Query device state",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        {
          "id": "metrics-to-stream",
          "from": "metrics",
          "to": "stream",
          "label": "Scrape streaming metrics",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        {
          "id": "grafana-to-metrics",
          "from": "grafana",
          "to": "metrics",
          "label": "PromQL",
          "kind": "sync",
          "props": { "travelMs": 200 }
        }
      ],
      "simulations": [
        {
          "id": "morning",
          "title": "Morning device check-in",
          "seed": 7,
          "traffic": [
            {
              "id": "check-ins",
              "node": "devices",
              "messageType": "TelemetryReading",
              "label": "1,000 devices check in as shifts start",
              "shape": { "kind": "ramp", "startRate": 100, "stages": [{ "durationMs": 5000, "targetRate": 300 }] }
            },
            {
              "id": "temperature-alerts",
              "node": "devices",
              "messageType": "TemperatureExceeded",
              "label": "10 sensors exceed the temperature threshold",
              "shape": { "kind": "burst", "atMs": 2500, "count": 10, "spreadMs": 500 }
            }
          ],
          "timeline": [
            {
              "atMs": 0,
              "action": { "do": "note", "text": "Morning check-ins ramp from 100 to 300 per second. Both consumer groups receive every reading.", "focus": ["devices", "hub"] }
            },
            {
              "atMs": 2500,
              "action": { "do": "note", "text": "Only TemperatureExceeded events go to the on-call mailbox.", "focus": ["hot", "alerts", "email"] }
            }
          ],
          "expectations": [
            {
              "id": "state",
              "label": "State",
              "metric": { "node": "cosmos", "field": "processed" },
              "op": "==",
              "value": 1010,
              "when": "end"
            },
            {
              "id": "lake",
              "label": "Lake",
              "metric": { "node": "blob", "field": "processed" },
              "op": "==",
              "value": 1010,
              "when": "end"
            },
            {
              "id": "alerts",
              "label": "Alerts",
              "metric": { "node": "email", "field": "processed" },
              "op": "==",
              "value": 10,
              "when": "end"
            },
            {
              "id": "drained",
              "label": "Drained",
              "metric": { "node": "hub", "field": "lag" },
              "op": "==",
              "value": 0,
              "when": "end"
            }
          ],
          "scale": 10
        },
        {
          "id": "hot-spot",
          "title": "Event Hubs partition hot spot",
          "seed": 7,
          "traffic": [
            {
              "id": "check-ins",
              "node": "devices",
              "messageType": "TelemetryReading",
              "label": "200 readings on a hot partition",
              "shape": { "kind": "constant", "ratePerSec": 50, "durationMs": 4000 }
            }
          ],
          "timeline": [
            {
              "atMs": 0,
              "action": { "do": "note", "text": "One partition activates one replica per group; the other 63 replicas sit idle. Lag grows despite the configured service fleet.", "focus": ["hub", "hot", "stream"], "pause": true }
            },
            { "atMs": 8000, "action": { "do": "props", "node": "hub", "props": { "partitions": 64 } } },
            {
              "atMs": 8000,
              "action": { "do": "note", "text": "The partition key is redistributed; the backlog drains.", "focus": ["hub"] }
            }
          ],
          "expectations": [
            {
              "id": "hot-lag",
              "label": "Hot lag",
              "metric": { "node": "hub", "field": "lag", "group": "hot-state" },
              "op": ">",
              "value": 0,
              "when": "at",
              "atMs": 6000
            },
            {
              "id": "state",
              "label": "State",
              "metric": { "node": "cosmos", "field": "processed" },
              "op": "==",
              "value": 200,
              "when": "end"
            },
            {
              "id": "lake",
              "label": "Lake",
              "metric": { "node": "blob", "field": "processed" },
              "op": "==",
              "value": 200,
              "when": "end"
            },
            {
              "id": "drained",
              "label": "Drained",
              "metric": { "node": "hub", "field": "lag" },
              "op": "==",
              "value": 0,
              "when": "end"
            }
          ],
          "setup": {
            "props": {
              "hub": { "partitions": 1 },
              "hot": { "replicas": 64, "concurrency": 1 },
              "stream": { "replicas": 64, "concurrency": 1 }
            }
          },
          "scale": 2
        }
      ]
    },
    "icons": {
