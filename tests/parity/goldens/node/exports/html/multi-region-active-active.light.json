      "aws-elb": { "sha256": "777ebfca0c9405a06395309d216150c7c3e85776c978410e4b9baa835b97bd3b", "bytes": 2092 },
      "aws-route53": { "sha256": "69f835db0625aa0cab32bd565dcbac89bef2b772fcdb0f6be3cb509b78dc2582", "bytes": 7825 },
      "client-user": { "sha256": "dffa37eace31e4c87ed5e2b0f49618146f847912a7b23f4d30271aeed9508da0", "bytes": 418 }
    },
    "options": { "theme": "light", "startSimulation": "failover", "exportedOn": "2026-01-01" }
  }
}
