          "to": "push-sender",
          "kind": "async",
          "props": { "travelMs": 300 }
        },
        {
          "id": "email-sender-to-sendgrid",
          "from": "email-sender",
          "to": "sendgrid",
          "label": "Mail Send API",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        {
          "id": "sms-limiter-to-twilio",
          "from": "sms-limiter",
          "to": "twilio",
          "label": "Messages API",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
