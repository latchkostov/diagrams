      "direction": "TB",
      "title": "Serverless burst and buffer",
      "description": "Contoso compares direct Lambda admission with an SQS buffer and bounded invoker: reserved concurrency rejects direct excess while paced async calls finish.",
      "nodes": [
        {
          "id": "requests",
          "stencil": "client.browser",
          "label": "Contoso requests",
          "sublabel": "6 requests/s to each path",
          "props": { "ratePerSec": 6, "messageType": "Job" },
          "x": 200,
          "y": 40
        },
        {
          "id": "gateway",
          "stencil": "aws.api-gateway",
          "label": "API Gateway",
          "sublabel": "Managed account preset",
          "props": {},
          "x": 40,
          "y": 200
        },
        {
          "id": "queue",
          "stencil": "aws.sqs",
          "label": "Async buffer",
          "sublabel": "Wait here for a free worker",
          "props": {},
          "x": 360,
          "y": 200
        },
        {
          "id": "direct",
          "stencil": "aws.lambda",
          "label": "Direct function",
          "sublabel": "2 concurrent executions · 1 s each",
          "props": {
            "preset": "managed-measured",
            "presetRevision": "2026-10-14",
            "jitter": 0,
            "failureRate": 0,
            "scaling": "auto",
            "maxConcurrency": 2,
            "latencyMs": 1000,
            "api": { "maxInFlight": 2 }
          },
          "x": 40,
          "y": 360
        },
        {
          "id": "invoker",
          "stencil": "service.node",
          "label": "Bounded async invoker",
          "sublabel": "2 slots · one-second pacing",
          "props": { "preset": "processor-lesson", "presetRevision": "1", "replicas": 1, "concurrency": 2, "latencyMs": 1000, "jitter": 0, "failureRate": 0 },
          "x": 360,
          "y": 360
        },
        {
          "id": "async",
          "stencil": "aws.lambda",
          "label": "Buffered function",
          "sublabel": "2 concurrent executions · 250 ms",
          "props": {
            "preset": "managed-measured",
            "presetRevision": "2026-10-14",
            "jitter": 0,
            "failureRate": 0,
            "scaling": "auto",
            "maxConcurrency": 2,
            "latencyMs": 250,
            "api": { "maxInFlight": 2 }
