          "id": "posting-sub-to-worker",
          "from": "posting-sub",
          "to": "worker",
          "label": "Peek-lock delivery",
          "kind": "async",
          "props": { "travelMs": 300, "filter": ["InvoiceAccepted"] }
        },
        {
          "id": "workflow-to-commands",
          "from": "workflow",
          "to": "commands",
          "label": "PostInvoice",
          "kind": "async",
          "props": { "travelMs": 300 }
        },
        {
          "id": "commands-to-worker",
          "from": "commands",
          "to": "worker",
          "label": "Execute command",
          "kind": "async",
          "props": { "travelMs": 300, "filter": ["PostInvoice"] }
        },
        {
          "id": "commands-to-dlq",
          "from": "commands",
          "to": "dlq",
          "label": "After 5 failed deliveries",
          "kind": "async",
          "props": { "travelMs": 300 }
        },
        {
          "id": "worker-to-cosmos",
          "from": "worker",
          "to": "cosmos",
          "label": "Upsert ledger",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        {
          "id": "ingest-to-blob",
          "from": "ingest",
          "to": "blob",
          "label": "Archive original PDF",
          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        { "id": "ingest-to-vault", "from": "ingest", "to": "vault", "kind": "sync", "relation": "secret" },
        { "id": "ingest-to-insights", "from": "ingest", "to": "insights", "label": "Traces / exceptions", "kind": "async", "relation": "telemetry" }
      ],
      "simulations": [
        {
          "id": "poison",
          "title": "Poison invoices",
          "seed": 7,
          "traffic": [
            {
              "id": "poison-batch",
              "node": "ingest",
              "messageType": "InvoiceHighValue",
              "label": "30 malformed posting requests",
              "shape": { "kind": "burst", "count": 30, "spreadMs": 1000 }
            }
          ],
          "timeline": [
            {
              "atMs": 0,
              "action": { "do": "note", "text": "A schema mismatch makes every ledger attempt fail. Commands are retried five times.", "focus": ["worker", "commands"] }
            },
            {
              "atMs": 10000,
              "action": { "do": "note", "text": "Poison commands are quarantined in the DLQ for operator replay.", "focus": ["commands", "dlq"], "pause": true }
            },
            { "atMs": 12000, "action": { "do": "props", "node": "worker", "props": { "failureRate": 0 } } }
          ],
          "expectations": [
            {
              "id": "quarantined",
              "label": "Poison invoices reach the DLQ",
              "metric": { "node": "commands", "field": "deadLettered" },
              "op": ">",
              "value": 0,
              "when": "end"
            },
            {
              "id": "dlq-retains",
              "label": "All 30 poison invoices are retained",
              "metric": { "node": "dlq", "field": "backlog" },
              "op": "==",
              "value": 30,
              "when": "end"
            },
            {
              "id": "no-ledger-write",
              "label": "No ledger write",
              "metric": { "node": "cosmos", "field": "processed" },
              "op": "==",
              "value": 0,
              "when": "end"
            }
          ],
          "setup": { "props": { "worker": { "failureRate": 1, "retry": "inplace", "retryBackoffMs": 100 } } },
          "durationMs": 20000,
          "scale": 1
        }
      ]
    },
