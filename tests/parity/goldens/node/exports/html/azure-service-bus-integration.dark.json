          "kind": "sync",
          "props": { "travelMs": 200 }
        },
        {
          "id": "ingest-to-invoices",
          "from": "ingest",
          "to": "invoices",
          "label": "InvoiceAccepted",
          "kind": "async",
          "props": { "travelMs": 300 }
        },
        {
          "id": "invoices-to-approval-sub",
          "from": "invoices",
          "to": "approval-sub",
          "label": "amount > 10000",
          "kind": "async",
