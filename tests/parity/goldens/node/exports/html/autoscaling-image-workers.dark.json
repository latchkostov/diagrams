{
  "file": { "sha256": "b9cb63fd9efa91dca99f0a3bbce550757c96cb6c664b2cdadf8929d054396473", "bytes": 19656 },
  "payload": {
    "version": 1,
    "diagram": {
      "format": "diagrams/v2",
      "planning": { "revision": "p3-a1" },
      "title": "Image workers absorb a burst",
      "description": "An invented image-processing pipeline: a Kafka topic buffers uploads while HPA starts workers. The saved burst shows backlog building, replicas becoming ready and the backlog draining within ten simulated seconds. This teaching model explicitly uses a 1 s sync, 1 s metric window, 2 s startup and 30 s downscale stabilization; these are not Kubernetes defaults. Open a worker’s Live details for replica history.",
      "nodes": [
        {
          "id": "source",
          "stencil": "client.browser",
          "label": "Upload clients",
          "x": 80,
          "y": 180,
          "props": { "ratePerSec": 4 }
        },
        {
          "id": "uploads",
          "stencil": "kafka.topic",
          "label": "Image uploads",
          "sublabel": "6 partitions",
          "x": 420,
          "y": 180,
          "props": { "partitions": 6 }
        },
        {
          "id": "worker",
          "stencil": "service.go",
          "label": "Thumbnail workers",
          "x": 780,
          "y": 180,
          "props": {
            "replicas": 1,
            "concurrency": 4,
            "latencyMs": 250,
            "jitter": 0,
            "resources": {
              "preset": "io-service",
              "presetRevision": "1",
              "cpuMsPerMessage": 40,
              "baselineMemoryMiB": 128,
              "memoryMiBPerMessage": 2,
              "cpuRequestMilli": 500,
              "cpuLimitMilli": 1000,
              "memoryRequestMiB": 256,
              "memoryLimitMiB": 512,
              "startup": { "delayMs": 2000, "jitterFraction": 0 },
              "terminationGraceMs": 30000
            },
            "autoscaling": {
              "mode": "on",
              "modelRevision": "a1",
              "preset": "hpa-service",
              "presetRevision": "1",
              "controller": {
                "kind": "hpa",
                "minReplicas": 1,
                "maxReplicas": 6,
                "initialReplicas": 1,
                "settings": {
                  "syncMs": 1000,
                  "tolerance": 0.1,
                  "initialReadinessDelayMs": 0,
                  "cpuInitializationPeriodMs": 0,
                  "metrics": [
                    {
                      "source": { "kind": "resource", "resource": "cpu" },
                      "target": { "kind": "utilization", "percentOfRequest": 70 },
                      "windowMs": 1000,
                      "metricDelayMs": 0
                    }
                  ],
                  "up": {
                    "stabilizationMs": 0,
                    "selectPolicy": "Max",
                    "policies": [
                      { "type": "Pods", "value": 4, "periodMs": 15000 },
                      { "type": "Percent", "value": 100, "periodMs": 15000 }
                    ]
                  },
                  "down": {
                    "stabilizationMs": 30000,
                    "selectPolicy": "Max",
                    "policies": [{ "type": "Percent", "value": 100, "periodMs": 15000 }]
                  }
                }
              }
            }
          }
        },
        {
          "id": "images",
          "stencil": "aws.s3",
          "label": "Thumbnails",
          "x": 1140,
          "y": 180,
          "props": { "latencyMs": 10, "jitter": 0 }
        }
      ],
      "edges": [
        { "id": "publish", "from": "source", "to": "uploads", "kind": "async", "props": { "travelMs": 10 } },
        {
          "id": "consume",
          "from": "uploads",
          "to": "worker",
          "kind": "async",
          "props": { "travelMs": 10, "group": "thumbnails" }
        },
        { "id": "save", "from": "worker", "to": "images", "kind": "async", "props": { "travelMs": 10 } }
      ],
      "simulations": [
        {
          "id": "settle-down",
          "title": "Quiet after the burst",
          "seed": 42,
          "scale": 1,
          "durationMs": 48000,
          "traffic": [
            {
              "id": "burst",
              "node": "source",
              "messageType": "ImageUploaded",
              "shape": { "kind": "constant", "ratePerSec": 48, "durationMs": 4000 }
            }
          ],
          "timeline": [
            {
              "atMs": 1000,
              "action": { "do": "note", "text": "Demand is above one worker’s target. New replicas start while Kafka holds the backlog.", "focus": ["uploads", "worker"] }
            },
            {
              "atMs": 7000,
              "action": { "do": "note", "text": "Ready workers drain the upload burst. Open Live details to see desired and ready replicas over time.", "focus": ["worker"] }
            }
          ],
          "expectations": [
            {
              "id": "buffered",
              "label": "Uploads wait for starting workers",
              "metric": { "node": "uploads", "field": "lag", "group": "thumbnails" },
              "op": ">",
              "value": 0,
              "when": "at",
              "atMs": 2000
            },
            {
              "id": "drained",
              "label": "Every upload finishes",
              "metric": { "node": "worker", "field": "processed" },
              "op": "==",
              "value": 192,
              "when": "end"
            },
            {
              "id": "empty",
              "label": "The topic backlog drains",
              "metric": { "node": "uploads", "field": "lag", "group": "thumbnails" },
              "op": "==",
              "value": 0,
              "when": "end"
            }
          ]
        }
      ]
    },
    "icons": {
      "aws-s3": { "sha256": "9eb9da8cd09cf6770410a45ab3dacc830aea6752f0d6be88305f249e70f713df", "bytes": 2031 },
      "client-browser": { "sha256": "c66b629864dc684d451c1c280107fe74cdd69ffb9d17be64673c90c7c92434f7", "bytes": 476 },
      "go": { "sha256": "f1f50429f38e0fa91b2c77cf600cee410845b58e30935a09cb206cfc88efff9c", "bytes": 2404 },
      "kafka": { "sha256": "938a96212aef8da520eca3435f23c1a3304ce25fbfaf0e5712ce548353abc5ef", "bytes": 4092 }
    },
    "options": { "theme": "dark", "banner": "Confidential: internal use only", "startSimulation": null, "exportedOn": "2026-01-01" }
  }
}
