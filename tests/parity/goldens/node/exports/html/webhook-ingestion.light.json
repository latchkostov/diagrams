      "cloudflare": { "sha256": "e4643ab45e6027dca904ae69c08a23830e3cc6b47327e261a28be93e3fc28fd1", "bytes": 1466 },
      "generic-webhook": { "sha256": "f73d0eda19274f25a80e339ef1119c82f8aed73222085462017cf001b6c0ebed", "bytes": 595 },
      "go": { "sha256": "f1f50429f38e0fa91b2c77cf600cee410845b58e30935a09cb206cfc88efff9c", "bytes": 2404 },
      "k8s-deployment": { "sha256": "68882565c6594f4a311c1ce5094f166716a0dfba535bc52336f2e5bc575a7b1e", "bytes": 3903 },
      "nodejs": { "sha256": "5d31625856d847dbfd22e16f061e65622e638f5621e5b49b8fec1fdde933de7e", "bytes": 1848 },
      "postgresql": { "sha256": "95779d4aab758053d1839595cc9716e1eedb1021a015a00331e54268a5daf5c0", "bytes": 7732 },
      "rabbitmq": { "sha256": "a3e993b69d514c43c7b3dc35a3223dd485b42ae557ec53eb1a123965d2798d40", "bytes": 854 },
      "redis": { "sha256": "985d03e20de4a6caf7eccc34ba6b73e2a5bab3aa1dc1b0d3e0613b5342a1e30e", "bytes": 3257 },
      "vault": { "sha256": "85504d51abd2458c156b7b65ae6590805bc10bf64065272705bb9cdd0f7eb7e5", "bytes": 549 }
    },
    "options": { "theme": "light", "startSimulation": "bulk-sync", "exportedOn": "2026-01-01" }
  }
}
