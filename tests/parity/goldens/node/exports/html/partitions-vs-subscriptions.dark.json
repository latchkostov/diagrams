  "payload": {
    "version": 1,
    "diagram": {
      "format": "diagrams/v2",
      "planning": { "revision": "p3" },
      "direction": "TB",
      "title": "Partitions versus subscriptions",
      "description": "Northwind publishes the same events to a three-partition Kafka topic and SNS: five Kafka readers sit idle while both subscriptions use all eight workers.",
      "nodes": [
        {
          "id": "publisher",
          "stencil": "generic.webhook",
          "label": "Northwind events",
          "sublabel": "6 events/s to both brokers",
          "props": { "ratePerSec": 6, "messageType": "OrderPlaced" },
          "x": 360,
          "y": 40
        },
        {
          "id": "log",
          "stencil": "kafka.topic",
          "label": "Order log",
          "sublabel": "3 partitions",
          "props": { "partitions": 3 },
          "x": 200,
          "y": 200
        },
        {
          "id": "fanout",
          "stencil": "aws.sns",
          "label": "Order notifications",
          "sublabel": "Independent subscriptions",
          "props": {},
          "x": 520,
          "y": 200
        },
        {
          "id": "log-readers",
          "stencil": "service.java",
          "label": "Kafka readers",
          "sublabel": "8 replicas · only 3 assigned",
          "props": { "preset": "processor-lesson", "presetRevision": "1", "replicas": 8, "concurrency": 1, "latencyMs": 1000, "jitter": 0, "failureRate": 0 },
          "x": 40,
          "y": 360
        },
        {
          "id": "receipts",
          "stencil": "service.node",
          "label": "Receipt subscription",
          "sublabel": "8 replicas · all available",
          "props": { "preset": "processor-lesson", "presetRevision": "1", "replicas": 8, "concurrency": 1, "latencyMs": 1000, "jitter": 0, "failureRate": 0 },
          "x": 360,
          "y": 360
        },
        {
          "id": "audit",
          "stencil": "service.go",
          "label": "Audit subscription",
          "sublabel": "8 replicas · independent copy",
          "props": { "preset": "processor-lesson", "presetRevision": "1", "replicas": 8, "concurrency": 1, "latencyMs": 1000, "jitter": 0, "failureRate": 0 },
          "x": 680,
          "y": 360
        }
      ],
      "edges": [
        {
          "id": "publish-log",
          "from": "publisher",
          "to": "log",
          "label": "Append",
          "kind": "async",
          "props": { "travelMs": 200 }
        },
        {
          "id": "publish-fanout",
          "from": "publisher",
          "to": "fanout",
          "label": "Publish",
          "kind": "async",
          "props": { "travelMs": 200 }
        },
        {
          "id": "read-log",
          "from": "log",
          "to": "log-readers",
          "label": "orders group",
          "kind": "async",
          "props": { "travelMs": 200, "group": "orders" }
        },
        {
          "id": "read-receipts",
          "from": "fanout",
          "to": "receipts",
          "label": "receipts",
          "kind": "async",
          "props": { "travelMs": 200, "group": "receipts" }
        },
        {
          "id": "read-audit",
          "from": "fanout",
          "to": "audit",
          "label": "audit",
          "kind": "async",
          "props": { "travelMs": 200, "group": "audit" }
        }
      ],
      "simulations": [
        {
          "id": "more-partitions",
          "title": "Give every reader a partition",
          "description": "Eight partitions remove the assignment bottleneck without changing the reader fleets.",
          "seed": 41,
          "scale": 1,
          "traffic": [
            {
              "id": "publisher",
              "node": "publisher",
              "messageType": "OrderPlaced",
              "shape": { "kind": "constant", "ratePerSec": 6, "durationMs": 6000 }
            }
          ],
          "timeline": [
            {
              "atMs": 1000,
              "action": { "do": "note", "text": "Only the Kafka partition count changed. SNS has no partition setting.", "focus": ["log", "fanout"] }
            }
          ],
          "expectations": [
            {
              "id": "log-lag-end",
              "label": "log: lag == 0",
              "metric": { "node": "log", "field": "lag" },
              "op": "==",
              "value": 0,
              "when": "end"
            },
            {
              "id": "log-readers-processed-end",
              "label": "log-readers: processed == 36",
              "metric": { "node": "log-readers", "field": "processed" },
              "op": "==",
              "value": 36,
              "when": "end"
            }
          ],
          "setup": { "props": { "log": { "partitions": 8 } } }
        }
      ]
    },
