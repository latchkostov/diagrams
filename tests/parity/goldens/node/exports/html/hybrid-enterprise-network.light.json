      "simulations": [
        {
          "id": "leicester-fibre-cut",
          "title": "Drill: the Leicester fibre is cut",
          "description": "A digger cuts the Leicester branch's fibre. Its SD-WAN router health-checks both underlays, so every new session moves to the LTE tunnel; only requests already on the fibre are lost. The fibre comes back ten seconds later.",
          "seed": 91,
          "scale": 1,
          "durationMs": 24000,
          "traffic": [
            {
              "id": "leicester",
              "node": "leicester-staff",
              "label": "Leicester branch",
              "messageType": "ERP",
              "shape": { "kind": "constant", "ratePerSec": 20, "durationMs": 20000 }
            }
          ],
          "timeline": [
            {
              "atMs": 0,
              "action": { "do": "note", "text": "The Leicester router sends the branch's tunnels over fibre and a 4G backup, and health-checks both.", "focus": ["leicester-router", "lte"] }
            },
            {
              "atMs": 4000,
              "action": {
                "do": "fault",
                "drill": "region-connectivity",
                "fault": { "kind": "link", "edge": "leicester-fibre", "cut": true }
              }
            },
            {
              "atMs": 4000,
              "action": { "do": "note", "text": "Region connectivity drill: the fibre is cut. Requests already on it are lost; the router sends every new one over LTE.", "focus": ["leicester-router", "lte"] }
            },
            {
              "atMs": 14000,
              "action": {
                "do": "fault",
                "drill": "region-connectivity",
                "fault": { "kind": "link", "edge": "leicester-fibre", "cut": false }
              }
            },
            {
              "atMs": 14000,
              "action": { "do": "note", "text": "The fibre is back and shares the load again. Staff never noticed.", "focus": ["leicester-router", "lte"] }
            }
          ],
          "expectations": [
            {
              "id": "on-lte",
              "label": "Sessions move to LTE",
              "metric": { "node": "lte", "field": "processed" },
              "op": ">",
              "value": 150,
              "when": "end"
            },
            {
              "id": "no-drops",
              "label": "The router never drops a session",
              "metric": { "node": "leicester-router", "field": "dropped" },
              "op": "==",
              "value": 0,
              "when": "always"
            },
            {
              "id": "on-the-wire",
              "label": "Only requests on the wire are lost",
              "metric": { "node": "hub", "field": "dropped" },
              "op": "<=",
              "value": 5,
              "when": "end"
            },
            {
              "id": "erp",
              "label": "Every request reaches the ERP",
              "metric": { "node": "erp", "field": "dropped" },
              "op": "==",
              "value": 0,
              "when": "always"
            }
          ]
        },
        {
          "id": "dc-firewall-failover",
          "title": "The DC firewall fails over",
          "description": "The active unit of the data centre's firewall pair dies. For three seconds, while the standby takes over its sessions, traffic for the ERP and the shop waits at the pair; nothing is dropped.",
          "seed": 92,
          "scale": 50,
          "durationMs": 18000,
          "traffic": [
            {
              "id": "hq",
              "node": "hq-staff",
