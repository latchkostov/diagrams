        {
          "id": "guest-to-erp",
          "title": "A guest device probes the ERP",
          "description": "A visitor's laptop on guest Wi-Fi scans for the ERP. The HQ firewall's guest zone allows web traffic out to the internet only; its deny rule blocks every attempt to reach the data centre, while staff traffic carries on.",
          "seed": 93,
          "scale": 10,
          "durationMs": 16000,
          "traffic": [
            {
              "id": "hq",
              "node": "hq-staff",
              "label": "HQ staff",
              "messageType": "ERP",
              "shape": { "kind": "constant", "ratePerSec": 300, "durationMs": 14000 }
            },
            {
              "id": "guests",
              "node": "guests",
              "label": "Guest web",
              "messageType": "GuestWeb",
              "shape": { "kind": "constant", "ratePerSec": 60, "durationMs": 14000 }
            },
            {
              "id": "probe",
              "node": "guests",
              "label": "Probe for the ERP",
              "messageType": "GuestERP",
              "shape": { "kind": "constant", "ratePerSec": 50, "fromMs": 3000, "durationMs": 8000 }
            }
          ],
          "timeline": [
            {
              "atMs": 0,
              "action": { "do": "note", "text": "Staff and guests share the access switches, but the core keeps them in separate VRFs up to the firewall.", "focus": ["access", "core", "hq-fw"] }
            },
            {
              "atMs": 3000,
              "action": { "do": "note", "text": "A guest device starts probing for the ERP. The guest zone's deny rule blocks it at the HQ firewall.", "focus": ["hq-fw", "hq-wan", "breakout"] }
            },
            {
              "atMs": 8000,
              "action": { "do": "note", "text": "Blocked attempts are counted, not dropped as failures; staff traffic to the data centre carries on.", "focus": ["hq-fw", "hq-wan"] }
            }
          ],
          "expectations": [
            {
              "id": "blocked",
              "label": "The firewall blocks the probe",
              "metric": { "node": "hq-fw", "field": "blocked" },
              "op": ">",
              "value": 300,
              "when": "end"
            },
            {
              "id": "staff-ok",
              "label": "Staff traffic is never dropped",
              "metric": { "node": "hq-fw", "field": "dropped" },
              "op": "==",
              "value": 0,
              "when": "always"
            }
          ]
        }
      ]
