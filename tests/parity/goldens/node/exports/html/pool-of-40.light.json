    "version": 1,
    "diagram": {
      "format": "diagrams/v2",
      "planning": {
        "revision": "p3-w1",
        "requestRoutes": [
          { "id": "checkout", "label": "Checkout", "address": { "method": "POST", "path": "/checkout" } },
          { "id": "status", "label": "Order status", "address": { "method": "GET", "path": "/status" } }
        ]
      },
      "title": "A pool of 40",
      "description": "Checkout handles payments and order status. Payment calls share forty connections. Compare holding threads while waiting for a connection with freeing them so order status can keep working.",
      "nodes": [
        {
          "id": "shop",
          "stencil": "client.user",
          "label": "Shop",
          "x": 0,
          "y": 180,
          "props": {
            "ratePerSec": 120,
            "trafficMix": {
              "mode": "rates",
              "entries": [{ "routeId": "checkout", "ratePerSec": 120 }, { "routeId": "status", "ratePerSec": 20 }]
            }
          }
        },
        { "id": "gateway", "stencil": "generic.adc", "label": "API gateway", "sublabel": "5 s timeout", "x": 320, "y": 180 },
        {
          "id": "checkout",
          "stencil": "generic.service",
          "label": "Checkout",
          "sublabel": "4 replicas · 25 threads each",
          "x": 660,
          "y": 180,
          "props": { "replicas": 4, "concurrency": 25, "latencyMs": 10, "jitter": 0 }
        },
        {
          "id": "payment",
          "stencil": "generic.external-api",
          "label": "Payment provider",
          "sublabel": "200 ms · slows ×10 at 3 s",
          "x": 1020,
          "y": 180,
          "props": { "latencyMs": 200, "api": { "latencyMs": 200 }, "jitter": 0 }
        },
        {
          "id": "orders",
          "stencil": "generic.database",
          "label": "Orders DB",
          "x": 1020,
          "y": 420,
          "props": { "latencyMs": 5, "jitter": 0 }
        }
      ],
      "edges": [
        { "id": "browse", "from": "shop", "to": "gateway", "kind": "sync", "props": { "travelMs": 100 } },
        {
          "id": "route",
          "from": "gateway",
          "to": "checkout",
          "kind": "sync",
          "props": { "travelMs": 100, "caller": { "deadlineMs": 5000 } }
        },
        {
          "id": "pay",
          "from": "checkout",
          "to": "payment",
          "kind": "sync",
          "props": {
            "travelMs": 200,
            "caller": { "wait": "non-blocking", "poolConnections": 40 },
            "requestFilter": { "methods": ["POST"] }
          }
        },
        {
          "id": "save",
          "from": "checkout",
          "to": "orders",
          "kind": "sync",
          "props": { "travelMs": 100, "requestFilter": { "methods": ["GET"] } }
        }
      ],
      "simulations": [
        {
          "id": "pool-40",
          "title": "Threads freed while waiting for the pool",
          "description": "Payment calls wait off-thread for one of forty connections. Order status only calls Orders DB and keeps completing during the slowdown. Payments queued longer than the gateway’s five-second timeout fail there; provider work continues.",
          "seed": 17,
          "scale": 1,
          "durationMs": 20000,
          "traffic": [
            {
              "id": "orders",
              "node": "shop",
              "messageType": "Checkout",
              "shape": { "kind": "constant", "ratePerSec": 120, "durationMs": 20000 }
            }
          ],
          "timeline": [
            { "atMs": 3000, "action": { "do": "fault", "fault": { "kind": "slow", "node": "payment", "factor": 10 } } }
          ],
          "expectations": [
            {
              "id": "status",
              "label": "Order status keeps completing",
              "metric": { "node": "orders", "field": "processed" },
              "op": ">",
              "value": 300,
