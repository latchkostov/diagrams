        "simulations": [
          {
            "id": "happy-path",
            "title": "Twenty checkouts, happy path",
            "description": "Each order commits with its outbox row, then the saga reserves stock, charges the card and confirms.",
            "seed": 7,
            "scale": 1,
            "traffic": [
              {
                "id": "checkouts",
                "node": "client",
                "messageType": "PlaceOrder",
                "label": "20 checkouts",
                "shape": { "kind": "burst", "count": 20, "spreadMs": 4000 }
              }
            ],
            "timeline": [
              { "atMs": 0, "action": { "do": "trace", "node": "order-api" } },
              {
                "atMs": 0,
                "action": { "do": "note", "text": "The order row and its OrderCreated event commit in one database transaction. No dual write, so no lost events.", "focus": ["order-api", "orders-db"], "pause": true }
              },
              {
                "atMs": 900,
                "action": { "do": "note", "text": "The outbox relay tails the write-ahead log and publishes each outbox row to Kafka.", "focus": ["orders-db", "outbox-relay", "order-events"] }
              },
              {
                "atMs": 2500,
                "action": { "do": "note", "text": "The saga runs one step at a time: reserve stock, charge the card, then confirm the order. Every step is saved, so a restart resumes where it left off.", "focus": ["saga", "saga-db", "inventory-cmds", "payment-cmds", "saga-replies"] }
              },
              {
                "atMs": 6000,
                "action": { "do": "note", "text": "OrderConfirmed goes out through the same outbox, and the customer gets a receipt.", "focus": ["order-events", "notifications", "email"] }
              }
            ],
            "expectations": [
              {
                "id": "stock",
                "label": "20 reservations",
                "metric": { "node": "inventory-db", "field": "processed" },
                "op": "==",
                "value": 20,
                "when": "end"
              },
              {
                "id": "charges",
                "label": "20 cards charged once each",
                "metric": { "node": "stripe", "field": "processed" },
                "op": "==",
                "value": 20,
                "when": "end"
              },
              {
                "id": "receipts",
                "label": "20 receipts sent",
                "metric": { "node": "email", "field": "processed" },
                "op": "==",
                "value": 20,
                "when": "end"
              },
              {
                "id": "orders",
                "label": "20 orders created, 20 confirmed",
                "metric": { "node": "orders-db", "field": "processed" },
                "op": "==",
                "value": 40,
                "when": "end"
              }
            ]
          },
          {
            "id": "declines",
            "title": "Declines and flaky payments",
            "description": "Transient payment errors are retried with the same idempotency key; a fraud rule declines cards for three seconds and the saga compensates.",
            "seed": 7,
            "scale": 1,
            "setup": { "props": { "payment-svc": { "failureRate": 0.2 } } },
            "traffic": [
              {
                "id": "checkouts",
                "node": "client",
                "messageType": "PlaceOrder",
                "label": "60 checkouts over 6 seconds",
                "shape": { "kind": "constant", "ratePerSec": 10, "durationMs": 6000 }
              }
            ],
            "timeline": [
              {
                "atMs": 0,
                "action": { "do": "note", "text": "One payment call in five times out. The consumer retries in place with the same Idempotency-Key, so a retry never charges twice.", "focus": ["payment-svc", "stripe"] }
              },
              {
                "atMs": 2500,
                "action": {
                  "do": "props",
                  "node": "payment-svc",
                  "props": { "emits": { "ChargePayment": "PaymentDeclined" } }
                }
              },
              {
                "atMs": 2500,
                "action": { "do": "note", "text": "A fraud rule starts declining every card. The saga compensates: it releases the reserved stock, then cancels the order.", "focus": ["payment-svc", "saga", "inventory-cmds", "order-api"], "pause": true }
              },
              {
                "atMs": 5500,
                "action": {
                  "do": "props",
                  "node": "payment-svc",
                  "props": { "emits": { "ChargePayment": "PaymentCaptured" } }
                }
              },
              {
                "atMs": 5500,
                "action": { "do": "note", "text": "The rule is rolled back. Every customer still hears back: a receipt or a cancellation.", "focus": ["notifications", "email"] }
              }
            ],
            "expectations": [
              {
                "id": "everyone",
                "label": "All 60 customers get an email",
                "metric": { "node": "email", "field": "processed" },
                "op": "==",
                "value": 60,
                "when": "end"
              },
              {
                "id": "compensated",
                "label": "Declined orders release their stock",
                "metric": { "node": "inventory-db", "field": "processed" },
                "op": ">",
                "value": 60,
                "when": "end"
              },
              {
                "id": "retried",
                "label": "Transient errors were retried",
                "metric": { "node": "payment-svc", "field": "failed" },
                "op": ">",
                "value": 0,
                "when": "end"
              },
              {
                "id": "no-dlq",
                "label": "Nothing is dead-lettered",
                "metric": { "node": "payment-cmds", "field": "deadLettered" },
                "op": "==",
                "value": 0,
                "when": "always"
              }
            ]
          }
