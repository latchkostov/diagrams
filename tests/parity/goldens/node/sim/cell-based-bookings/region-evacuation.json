  "notes": [
    { "atMs": 0, "text": "Three regions take bookings. Each region splits customers across two cells; no request ever leaves its cell.", "focus": ["travellers", "mobile", "agents", "dns"] },
    { "atMs": 5000, "text": "us-east-1 goes dark. DNS health checks stop sending travellers there within one check.", "focus": ["dns", "east-alb", "east-router"] },
    { "atMs": 9000, "text": "us-west-2 takes half of the extra traffic. Its cells run hotter but stay under capacity: that headroom is the design.", "focus": ["west-alb", "west-router", "west-c1-api", "west-c2-api"] },
    { "atMs": 13000, "text": "eu-west-1 takes the other half, with the same headroom.", "focus": ["eu-alb", "eu-router", "eu-c1-api", "eu-c2-api"] },
    { "atMs": 18000, "text": "us-east-1 is back and DNS sends its share home. Global tables replicated every booking while it was away.", "focus": ["east-alb", "east-router", "east-c1-db", "east-c2-db"] }
  ],
