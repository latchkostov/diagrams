  "notes": [
    { "atMs": 0, "text": "Every request sends telemetry to the node agents, then to gateway collectors behind a load balancer that hashes by trace ID.", "focus": ["agent-shop", "otlp-lb", "gateways"] },
    { "atMs": 3000, "text": "A bad Checkout deploy logs every retry: five times the telemetry. The gateway collectors' CPU climbs and their HPA adds pods.", "focus": ["agent-shop", "gateways", "tenant-limits"] },
    { "atMs": 8000, "text": "Kafka absorbs the logs. The ingesters fall behind for a while; traces and metrics, in their own topics, don't.", "focus": ["logs", "ingesters", "spans", "metrics"] },
    { "atMs": 20000, "text": "The deploy is rolled back and the ingesters catch up. Nothing was dropped.", "focus": ["logs", "ingesters", "loki-store"] }
  ],
