    "simulations": [
      {
        "id": "region-evacuation",
        "title": "us-east-1 goes dark",
        "description": "Five seconds in, us-east-1's load balancer stops answering. DNS health checks send its travellers to the other two regions, whose cells were sized to absorb one region's share. Bookings keep flowing; the region returns at 18 s.",
        "seed": 21,
        "scale": 5,
        "durationMs": 30000,
        "traffic": [
          {
            "id": "web",
            "node": "travellers",
            "label": "Web bookings",
            "shape": { "kind": "constant", "ratePerSec": 120, "durationMs": 26000 }
          },
          {
            "id": "app",
            "node": "mobile",
            "label": "App bookings",
            "shape": { "kind": "constant", "ratePerSec": 90, "durationMs": 26000 }
          },
          {
            "id": "partners",
            "node": "agents",
            "label": "Agent bookings",
            "shape": { "kind": "constant", "ratePerSec": 30, "durationMs": 26000 }
          }
        ],
        "timeline": [
          {
            "atMs": 0,
            "action": { "do": "note", "text": "Three regions take bookings. Each region splits customers across two cells; no request ever leaves its cell.", "focus": ["dns", "east-alb", "west-alb", "eu-alb"] }
          },
          { "atMs": 5000, "action": { "do": "status", "node": "east-alb", "status": "down" } },
          {
            "atMs": 5000,
            "action": { "do": "note", "text": "us-east-1 goes dark. DNS health checks stop sending travellers there within one check.", "focus": ["dns", "east-alb", "east-router"] }
          },
          {
            "atMs": 9000,
            "action": { "do": "note", "text": "us-west-2 and eu-west-1 take the extra half each. Their cells run hotter but stay under capacity: that headroom is the design.", "focus": ["west-c1-api", "west-c2-api", "eu-c1-api", "eu-c2-api"] }
          },
          { "atMs": 18000, "action": { "do": "status", "node": "east-alb", "status": "up" } },
          {
            "atMs": 18000,
            "action": { "do": "note", "text": "us-east-1 is back and DNS sends its share home. Global tables replicated every booking while it was away.", "focus": ["dns", "east-alb", "east-c1-db", "west-c1-db"] }
          }
        ],
        "expectations": [
          {
            "id": "west-serves",
            "label": "us-west-2 keeps booking",
            "metric": { "node": "west-c1-api", "field": "failed" },
            "op": "==",
            "value": 0,
            "when": "always"
          },
          {
            "id": "eu-serves",
            "label": "eu-west-1 keeps booking",
            "metric": { "node": "eu-c2-api", "field": "failed" },
            "op": "==",
            "value": 0,
            "when": "always"
          },
          {
            "id": "emails",
            "label": "Confirmations still go out",
            "metric": { "node": "email", "field": "processed" },
            "op": ">",
            "value": 4000,
            "when": "end"
          }
        ]
