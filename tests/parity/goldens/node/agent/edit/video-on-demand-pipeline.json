      {
        "id": "premiere-uploads",
        "title": "Premiere day: where the encode time goes",
        "description": "A studio delivers a festival slate: masters arrive six times faster for six seconds. Each becomes three encode jobs; KEDA adds 4K and HD encoders on queue depth. Hover the encoders and the packager for sampled p50, p95 and p99: the spike doubles them, and the growth is waiting, not encoding. Teaching timings: 1 s polling, 2 s startup.",
        "seed": 71,
        "scale": 1,
        "durationMs": 40000,
        "traffic": [
          {
            "id": "masters",
            "node": "studios",
            "label": "Festival slate",
            "messageType": "StudioMaster",
            "shape": { "kind": "spike", "baseRate": 1, "peakRate": 6, "atMs": 4000, "peakMs": 6000, "durationMs": 20000 }
          }
        ],
        "timeline": [
          {
            "atMs": 0,
            "action": { "do": "note", "text": "Each master lands in Originals; an S3 event starts the ingest workflow, which fans out one job per rendition ladder.", "focus": ["originals", "media-events", "workflow"] }
          },
          {
            "atMs": 4000,
            "action": { "do": "note", "text": "The slate arrives: six masters a second. A 4K encode takes two seconds, so jobs wait while KEDA adds encoders.", "focus": ["uhd-q", "uhd-enc", "hd-q", "hd-enc"] }
          },
          {
            "atMs": 12000,
            "action": { "do": "note", "text": "Hover 4K encoders: p95 has doubled to about five seconds. An encode still takes two; the rest is waiting for an encoder.", "focus": ["uhd-q", "uhd-enc"] }
          },
          {
            "atMs": 20000,
            "action": { "do": "note", "text": "Packaging fetches content keys under the DRM service's 40-a-second limit and publishes each title.", "focus": ["ready-q", "packager", "drm"] }
          }
        ],
        "expectations": [
          {
            "id": "uhd",
            "label": "Every 4K encode finishes",
            "metric": { "node": "uhd-enc", "field": "failed" },
            "op": "==",
            "value": 0,
            "when": "always"
          },
          {
            "id": "drained",
            "label": "The 4K queue drains",
            "metric": { "node": "uhd-q", "field": "backlog" },
            "op": "==",
            "value": 0,
            "when": "end"
          },
          {
            "id": "no-dlq",
            "label": "Nothing is dead-lettered",
            "metric": { "node": "encode-dlq", "field": "processed" },
            "op": "==",
            "value": 0,
            "when": "always"
          }
        ]
      },
      {
        "id": "corrupt-source",
        "title": "A batch of corrupt sources",
        "description": "A creator's export tool writes broken 4K masters for twenty seconds. Those encode jobs fail three times and go to the dead-letter queue; triage flags each upload and emails its creator. HD and audio renditions are unaffected.",
        "seed": 72,
        "scale": 1,
        "durationMs": 50000,
        "traffic": [
          {
            "id": "uploads",
            "node": "creators",
            "label": "Creator uploads",
            "messageType": "UploadVideo",
            "shape": { "kind": "constant", "ratePerSec": 1, "durationMs": 30000 }
          }
        ],
        "timeline": [
          {
            "atMs": 0,
            "action": { "do": "note", "text": "Uploads arrive steadily; three ladders encode each one independently.", "focus": ["uhd-q", "hd-q", "audio-q"] }
          },
          { "atMs": 3000, "action": { "do": "props", "node": "uhd-enc", "props": { "failureRate": 1 } } },
          {
            "atMs": 3000,
            "action": { "do": "note", "text": "A batch of 4K masters is corrupt. The 4K encoder fails them; SQS makes each visible again for a retry.", "focus": ["uhd-q", "uhd-enc"] }
          },
          { "atMs": 23000, "action": { "do": "props", "node": "uhd-enc", "props": { "failureRate": 0 } } },
          {
            "atMs": 9000,
            "action": { "do": "note", "text": "After three receives a job goes to the dead-letter queue, where triage flags its upload and emails the creator.", "focus": ["uhd-q", "encode-dlq", "triage"] }
          },
          {
            "atMs": 23000,
            "action": { "do": "note", "text": "The export tool is fixed. New 4K jobs encode again; HD and audio never stopped.", "focus": ["uhd-q", "uhd-enc", "hd-enc"] }
          }
        ],
        "expectations": [
          {
            "id": "parked",
