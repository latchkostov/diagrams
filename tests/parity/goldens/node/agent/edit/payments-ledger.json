            "id": "wallet-traffic",
            "node": "wallets",
            "label": "Wallet payments",
            "shape": { "kind": "constant", "ratePerSec": 120, "durationMs": 18000 }
          }
        ],
        "timeline": [
          {
            "atMs": 0,
            "action": { "do": "note", "text": "Each payment checks its idempotency key, is tokenized inside the PCI zone, scored, and authorized by a durable workflow.", "focus": ["payments-api", "idem", "tokenizer", "risk", "saga"] }
          },
          { "atMs": 4000, "action": { "do": "props", "node": "adyen", "props": { "failureRate": 0.6 } } },
          {
            "atMs": 4000,
            "action": { "do": "note", "text": "Adyen starts failing 60% of authorizations. The router keeps its 70/30 split: weights don't move by themselves.", "focus": ["psp-router", "adyen", "stripe"] }
          },
          {
            "atMs": 9000,
            "action": {
              "do": "props",
              "node": "psp-router",
              "props": {
                "routeTable": {
                  "rules": [],
                  "default": {
                    "targets": [
                      { "edgeId": "psp-router--adyen", "weight": 0 },
                      { "edgeId": "psp-router--stripe", "weight": 100 }
                    ]
                  }
                }
              }
            }
          },
          {
            "atMs": 9000,
            "action": { "do": "note", "text": "On-call shifts every card to Stripe. Stripe's contracted 500 requests a second covers the whole load, so failures stop.", "focus": ["psp-router", "stripe"] }
          },
          {
            "atMs": 14000,
            "action": { "do": "note", "text": "Every authorization, failed or not, is recorded through the outbox: the ledger and merchant webhooks never miss one.", "focus": ["payments-db", "outbox-relay", "payment-events", "poster", "hooks-out"] }
          }
        ],
        "expectations": [
