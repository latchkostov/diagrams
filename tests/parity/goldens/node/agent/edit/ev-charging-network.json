          },
          {
            "atMs": 3000,
            "action": { "do": "note", "text": "The charger vendor tries to open a remote shell into the depot. Its sessions reach the firewall.", "focus": ["vendor", "depot-router", "depot-fw"] }
          },
          {
            "atMs": 6000,
            "action": { "do": "note", "text": "The firewall's deny rule stops every one. Blocked is the rule working, not a loss; vendor support goes through a ticketed jump host instead.", "focus": ["depot-fw", "depot-switch"] }
