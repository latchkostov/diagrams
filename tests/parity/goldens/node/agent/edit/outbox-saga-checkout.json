        "id": "declines",
        "title": "Declines and flaky payments",
        "description": "Transient payment errors are retried with the same idempotency key; a fraud rule declines cards for three seconds and the saga compensates.",
        "seed": 7,
        "scale": 1,
        "setup": { "props": { "payment-svc": { "failureRate": 0.2 } } },
        "traffic": [
          {
            "id": "checkouts",
            "node": "client",
            "messageType": "PlaceOrder",
            "label": "60 checkouts over 6 seconds",
            "shape": { "kind": "constant", "ratePerSec": 10, "durationMs": 6000 }
          }
        ],
        "timeline": [
          {
            "atMs": 0,
            "action": { "do": "note", "text": "One payment call in five times out. The consumer retries in place with the same Idempotency-Key, so a retry never charges twice.", "focus": ["payment-svc", "stripe"] }
          },
          {
            "atMs": 2500,
