{
  // Type-checks the e2e specs and playwright.config.ts (the root tsconfig only covers src/).
  // Run: pnpm exec tsc --noEmit -p tests   (needs the @types/node dev dependency)
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "../playwright.config.ts"],
  // The parity harness has its own (it needs Vite's client types): tests/parity/tsconfig.json.
  "exclude": ["./parity"]
}
