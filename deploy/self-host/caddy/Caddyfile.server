# Generated by pnpm headers:self-host. Change :8080 to your domain for automatic HTTPS.
# Set LD_ORIGIN to the public origin; set LD_BASE=/ on diagrams.
# With only this proxy in front, set LD_TRUST_PROXY=1 and LD_TRUST_PROXY_HOPS=1 on diagrams.
# Keep diagrams reachable only through this proxy. Caddy supplies X-Forwarded-For safely by default.
:8080 {
    reverse_proxy diagrams:8080
}
